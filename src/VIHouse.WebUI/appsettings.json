{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // What is open to visitors. Everything the brief phases for later is off here and switched on
  // when it is ready — see VIHouse.Business/Options/FeatureOptions.cs. Phase 1 is the application
  // route: apply, be approved, pay, see your tickets.
  "Features": {
    "MembershipSales": false,
    "MemberDirectory": false,
    "Community": false
  },

  // Text messages, used for the private payment link and the payment confirmation. Off until a
  // gateway is set up: with Enabled false nothing is texted and nothing is logged, and approvals go
  // out by email exactly as before.
  //
  // The shape below is Twilio's. Other gateways only differ in what they call the three fields —
  // Vonage, for instance, is AuthScheme "None" with api_key/api_secret in ExtraFields and
  // to/text/from as the field names. Username and Password belong in user-secrets (Development) or
  // environment variables Sms__Username / Sms__Password (Production), never in this file.
  "Sms": {
    "Enabled": false,
    "Endpoint": "https://api.twilio.com/2010-04-01/Accounts/REPLACE_WITH_ACCOUNT_SID/Messages.json",
    "From": "",
    "AuthScheme": "Basic",
    "ToField": "To",
    "BodyField": "Body",
    "FromField": "From",
    "ExtraFields": {},
    // Applicants type their number the way they say it. Set this to the dialling code most of them
    // will be in — a number without one is skipped and logged rather than sent to another country.
    "DefaultCountryCode": ""
  },

  // Social profiles for the footer. An icon is rendered only when its URL is set, so an empty value
  // hides that icon rather than shipping a link to a profile that does not exist yet.
  "Site": {
    "Social": {
      "Instagram": "",
      "LinkedIn": "",
      "X": "",
      "YouTube": ""
    }
  }
}
@model AdminBookingDetailViewModel
@{
    var b = Model.Booking;
    ViewData["Title"] = b.BookingReference;
}

<div class="admin-toolbar" style="justify-content: space-between; align-items: center;">
    <span class="admin-badge">@Loc.Label(b.Status)</span>
    <a class="admin-btn admin-btn--ghost" asp-action="Index">@Loc["Admin.Bookings.BackToBookings"]</a>
</div>

<div class="admin-card">
    <h2>@Loc["Admin.Bookings.Booking"]</h2>
    <dl class="admin-detail-list">
        <div><dt>@Loc["Admin.Bookings.Reference"]</dt><dd>@b.BookingReference</dd></div>
        <div><dt>@Loc["Admin.Bookings.Customer"]</dt><dd>@(Model.CustomerEmail ?? "—")</dd></div>
        <div><dt>@Loc["Admin.Bookings.Experience"]</dt><dd>@Model.ExperienceLabel</dd></div>
        <div><dt>@Loc["Admin.Bookings.Quantity"]</dt><dd>@b.Quantity</dd></div>
        <div><dt>@Loc["Admin.Common.Amount"]</dt><dd>@MoneyFormatter.Format(b.AmountMinor, b.Currency)</dd></div>
        <div><dt>@Loc["Admin.Common.Created"]</dt><dd>@b.CreatedAt.ToString("dd MMM yyyy, HH:mm")</dd></div>
        <div><dt>@Loc["Admin.Bookings.Confirmed"]</dt><dd>@(b.ConfirmedAt?.ToString("dd MMM yyyy, HH:mm") ?? "—")</dd></div>
        @if (b.CancelledAt is not null)
        {
            <div><dt>@Loc["Admin.Bookings.Cancelled"]</dt><dd>@b.CancelledAt.Value.ToString("dd MMM yyyy, HH:mm")</dd></div>
        }
    </dl>
</div>

@if (Model.Payment is not null)
{
    var p = Model.Payment;
    <div class="admin-card">
        <h2>@Loc["Admin.Bookings.Payment"]</h2>
        <p style="font-size:0.75rem; color:#999; margin-top:-8px;">@Loc["Admin.Bookings.RefundsDisputesAreHandledInThe"]</p>
        <dl class="admin-detail-list">
            <div><dt>@Loc["Admin.Common.Status"]</dt><dd>@Loc.Label(p.Status)</dd></div>
            <div><dt>@Loc["Admin.Bookings.Provider"]</dt><dd>@Loc.Label(p.Provider)</dd></div>
            <div><dt>@Loc["Admin.Bookings.ProviderReference"]</dt><dd style="word-break:break-all;">@p.ProviderReference</dd></div>
            <div><dt>@Loc["Admin.Common.Amount"]</dt><dd>@MoneyFormatter.Format(p.AmountMinor, p.Currency)</dd></div>
            @if (!string.IsNullOrWhiteSpace(p.RefundStatus))
            {
                <div><dt>@Loc["Admin.Bookings.RefundStatus"]</dt><dd>@p.RefundStatus</dd></div>
            }
        </dl>
        <p style="margin-top:12px;"><a asp-area="Admin" asp-controller="AdminPayments" asp-action="Details" asp-route-id="@p.Id">@Loc["Admin.Bookings.ViewFullPaymentRecord"]</a></p>
    </div>
}

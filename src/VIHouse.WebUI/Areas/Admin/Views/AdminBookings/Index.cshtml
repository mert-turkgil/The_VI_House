@using VIHouse.Entities.Commerce
@model List<AdminBookingListItemViewModel>
@{
    ViewData["Title"] = Loc["Admin.Nav.AdminBookings"].Value;
    var selected = ViewData["SelectedStatus"] as BookingStatus?;

    string TabClass(BookingStatus? s) => selected == s ? "admin-tabs__link active" : "admin-tabs__link";
    string BadgeClass(BookingStatus s) => s switch
    {
        BookingStatus.Confirmed => "admin-badge admin-badge--open",
        BookingStatus.Cancelled => "admin-badge admin-badge--closed",
        BookingStatus.Refunded => "admin-badge admin-badge--closed",
        _ => "admin-badge",
    };
}

<nav class="admin-tabs">
    <a class="@TabClass(null)" asp-action="Index">@Loc["Admin.Bookings.All"]</a>
    <a class="@TabClass(BookingStatus.Pending)" asp-action="Index" asp-route-status="Pending">@Loc["Admin.Bookings.Pending"]</a>
    <a class="@TabClass(BookingStatus.Confirmed)" asp-action="Index" asp-route-status="Confirmed">@Loc["Admin.Bookings.Confirmed"]</a>
    <a class="@TabClass(BookingStatus.Cancelled)" asp-action="Index" asp-route-status="Cancelled">@Loc["Admin.Bookings.Cancelled"]</a>
    <a class="@TabClass(BookingStatus.Refunded)" asp-action="Index" asp-route-status="Refunded">@Loc["Admin.Bookings.Refunded"]</a>
</nav>

@if (Model.Count == 0)
{
    <p>@Loc["Admin.Bookings.NoBookingsHereYet"]</p>
}
else
{
    <div class="admin-table-scroll">
    <table class="admin-table" data-admin-table>
        <thead>
            <tr>
                <th>@Loc["Admin.Bookings.Reference"]</th>
                <th>@Loc["Admin.Bookings.Customer"]</th>
                <th>@Loc["Admin.Bookings.Experience"]</th>
                <th>@Loc["Admin.Common.Status"]</th>
                <th>@Loc["Admin.Common.Amount"]</th>
                <th>@Loc["Admin.Common.Created"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var b in Model)
            {
                <tr>
                    <td><a asp-action="Details" asp-route-id="@b.Id">@b.BookingReference</a></td>
                    <td>@(b.CustomerEmail ?? "—")</td>
                    <td>@b.ExperienceLabel</td>
                    <td><span class="@BadgeClass(b.Status)">@Loc.Label(b.Status)</span></td>
                    <td>@MoneyFormatter.Format(b.AmountMinor, b.Currency)</td>
                    <td>@b.CreatedAt.ToString("dd MMM yyyy")</td>
                    @* Reaching the payment behind a booking previously meant opening the booking,
                       reading the reference, then searching Payments for it. *@
                    <td class="admin-table__actions">
                        <a class="admin-icon-btn" asp-action="Details" asp-route-id="@b.Id">@Loc["Admin.Common.Open"]</a>
                        <a class="admin-icon-btn" asp-controller="AdminPayments" asp-action="Index">@Loc["Admin.Bookings.Payments"]</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

@using VIHouse.Business.Abstract
@using VIHouse.Entities.Commerce
@model PaymentTransactionDetail
@{
    var t = Model.Transaction;
    ViewData["Title"] = Loc["Admin.Payments.DetailTitle"].Value;

    string BadgeClass(PaymentTransactionStatus s) => s switch
    {
        PaymentTransactionStatus.Succeeded => "admin-badge admin-badge--paid",
        PaymentTransactionStatus.Pending or PaymentTransactionStatus.Processing or PaymentTransactionStatus.RequiresAction => "admin-badge admin-badge--pending",
        PaymentTransactionStatus.Failed => "admin-badge admin-badge--danger",
        PaymentTransactionStatus.Canceled or PaymentTransactionStatus.Expired => "admin-badge admin-badge--closed",
        PaymentTransactionStatus.Refunded or PaymentTransactionStatus.PartiallyRefunded => "admin-badge admin-badge--info",
        _ => "admin-badge admin-badge--draft",
    };

    string EventBadge(WebhookEventStatus status) => status switch
    {
        WebhookEventStatus.Processed => "admin-badge admin-badge--open",
        WebhookEventStatus.Failed => "admin-badge admin-badge--closed",
        WebhookEventStatus.Received => "admin-badge admin-badge--pending",
        _ => "admin-badge admin-badge--draft",
    };

        string StatusMeaning(PaymentTransactionStatus s) => Loc[$"Admin.Payments.Meaning.{s}"].Value;

    // Stripe dashboard deep links. Test-mode objects live under /test/ there.
    var live = Model.Events.FirstOrDefault()?.LiveMode ?? (t.ProviderSessionId?.StartsWith("cs_live") ?? false);
    var mode = live ? "" : "test/";
    string? Link(string? id, string path) => id is null ? null : $"https://dashboard.stripe.com/{mode}{path}/{id}";
}

<div class="admin-toolbar" style="justify-content: space-between; align-items: center;">
    <div>
        <span class="@BadgeClass(t.Status)">@Loc.Label(t.Status)</span>
        @if (t.Disputed)
        {
            <span class="admin-badge admin-badge--danger">@Loc["Admin.Payments.Disputed"]</span>
        }
        <span class="admin-table__sub" style="margin-left:8px;">@StatusMeaning(t.Status)</span>
    </div>
    <a class="admin-btn admin-btn--ghost" asp-action="Index">@Loc["Admin.Payments.BackToPayments"]</a>
</div>

<div class="admin-card">
    <h2>@MoneyFormatter.Format(t.AmountMinor, t.Currency) · @Loc.Label(t.Kind)</h2>
    <p style="font-size:0.75rem; color:#999; margin-top:-8px;">@Loc["Admin.Payments.DetailHint"]</p>
    <dl class="admin-detail-list">
        <div><dt>@Loc["Admin.Payments.Customer"]</dt><dd>
            @if (t.UserId is { } uid)
            {
                <a asp-controller="AdminUsers" asp-action="Details" asp-route-id="@uid">@(t.UserEmail ?? "—")</a>
            }
            else
            {
                @(t.UserEmail ?? "—")
                <span class="admin-table__sub">@Loc["Admin.Payments.NoAccountYetAJoinCheckout"]</span>
            }
            @if (!string.IsNullOrWhiteSpace(t.UserName)) { <span class="admin-table__sub"> · @t.UserName</span> }
        </dd></div>
        <div><dt>@Loc["Admin.Payments.For"]</dt><dd>
            @if (t.RelatedAdminPath is not null) { <a href="@t.RelatedAdminPath">@t.RelatedLabel</a> } else { @t.RelatedLabel }
            <span class="admin-table__sub"> · @t.RelatedEntityType</span>
        </dd></div>
        <div><dt>@Loc["Admin.Common.Amount"]</dt><dd>@MoneyFormatter.Format(t.AmountMinor, t.Currency)</dd></div>
        <div><dt>@Loc["Admin.Payments.Refunded"]</dt><dd>@(t.HasRefund ? $"{MoneyFormatter.Format(t.AmountRefundedMinor, t.Currency)}{(t.RefundedAt is { } ra ? $" on {ra:dd MMM yyyy, HH:mm}" : "")}" : "—")</dd></div>
        <div><dt>@Loc["Admin.Common.Created"]</dt><dd>@t.CreatedAt.ToString("dd MMM yyyy, HH:mm")</dd></div>
        <div><dt>@Loc["Admin.Common.Updated"]</dt><dd>@((t.UpdatedAt ?? t.CreatedAt).ToString("dd MMM yyyy, HH:mm"))</dd></div>
        <div><dt>@Loc["Admin.Payments.Paid"]</dt><dd>@(t.PaidAt?.ToString("dd MMM yyyy, HH:mm") ?? "—")</dd></div>
        @if (!string.IsNullOrWhiteSpace(t.FailureMessage) || !string.IsNullOrWhiteSpace(t.FailureCode))
        {
            <div><dt>@Loc["Admin.Payments.Failure"]</dt><dd>@t.FailureMessage <span class="admin-table__sub">@t.FailureCode</span></dd></div>
        }
        <div><dt>@Loc["Admin.Payments.LastEvent"]</dt><dd style="font-family:monospace; font-size:0.75rem;">@(t.LastEventId ?? "—")</dd></div>
    </dl>
</div>

<div class="admin-card">
    <h2>@Loc["Admin.Payments.StripeReferences"]</h2>
    <dl class="admin-detail-list">
        <div><dt>@Loc["Admin.Payments.CheckoutSession"]</dt><dd style="font-family:monospace; font-size:0.75rem; word-break:break-all;">@(t.ProviderSessionId ?? "—")</dd></div>
        <div><dt>@Loc["Admin.Payments.PaymentIntent"]</dt><dd style="font-family:monospace; font-size:0.75rem;">
            @if (Link(t.ProviderPaymentIntentId, "payments") is { } piHref) { <a href="@piHref" target="_blank" rel="noopener">@t.ProviderPaymentIntentId</a> } else { @("—") }
        </dd></div>
        <div><dt>@Loc["Admin.Payments.Subscription"]</dt><dd style="font-family:monospace; font-size:0.75rem;">
            @if (Link(t.ProviderSubscriptionId, "subscriptions") is { } subHref) { <a href="@subHref" target="_blank" rel="noopener">@t.ProviderSubscriptionId</a> } else { @("—") }
        </dd></div>
        <div><dt>@Loc["Admin.Payments.Invoice"]</dt><dd style="font-family:monospace; font-size:0.75rem;">
            @if (Link(t.ProviderInvoiceId, "invoices") is { } invHref) { <a href="@invHref" target="_blank" rel="noopener">@t.ProviderInvoiceId</a> } else { @("—") }
        </dd></div>
        <div><dt>@Loc["Admin.Payments.Customer"]</dt><dd style="font-family:monospace; font-size:0.75rem;">
            @if (Link(t.ProviderCustomerId, "customers") is { } cusHref) { <a href="@cusHref" target="_blank" rel="noopener">@t.ProviderCustomerId</a> } else { @("—") }
        </dd></div>
    </dl>
</div>

<div class="admin-card">
    <h2>@Loc["Admin.Payments.LiveStripeDetails"]</h2>
    @if (Model.LiveDetails is { } d)
    {
        <dl class="admin-detail-list">
            <div><dt>@Loc["Admin.Payments.SessionStatus"]</dt><dd>@(d.SessionStatus ?? "—")</dd></div>
            <div><dt>@Loc["Admin.Payments.PaymentStatus"]</dt><dd>@(d.PaymentStatus ?? "—")</dd></div>
            <div><dt>@Loc["Admin.Payments.IntentStatus"]</dt><dd>@(d.PaymentIntentStatus ?? "—")</dd></div>
            <div><dt>@Loc["Admin.Payments.ChargeStatus"]</dt><dd>@(d.ChargeStatus ?? "—")</dd></div>
            <div><dt>@Loc["Admin.Payments.Card"]</dt><dd>@(d.CardBrand is null ? "—" : $"{d.CardBrand} •••• {d.CardLast4}")</dd></div>
            @if (d.AmountCapturedMinor is { } captured)
            {
                <div><dt>@Loc["Admin.Payments.AmountCaptured"]</dt><dd>@MoneyFormatter.Format(captured, t.Currency)</dd></div>
            }
            <div><dt>@Loc["Admin.Payments.RefundedStripe"]</dt><dd>@(d.Refunded == true ? MoneyFormatter.Format(d.AmountRefundedMinor ?? 0, t.Currency) : Loc["Admin.Common.No"].Value)</dd></div>
            <div><dt>@Loc["Admin.Payments.DisputedStripe"]</dt><dd>@Loc[d.Disputed == true ? "Admin.Common.Yes" : "Admin.Common.No"]</dd></div>
            @if (!string.IsNullOrWhiteSpace(d.ReceiptUrl))
            {
                <div><dt>@Loc["Admin.Payments.Receipt"]</dt><dd><a href="@d.ReceiptUrl" target="_blank" rel="noopener">@Loc["Admin.Payments.ViewReceipt"]</a></dd></div>
            }
        </dl>
    }
    else if (t.ProviderSessionId is null)
    {
        <p style="font-size:0.8125rem; color:#999;">@Loc["Admin.Payments.NoCheckoutSessionOnThisRecord"]</p>
    }
    else
    {
        <p style="font-size:0.8125rem; color:#999;">@Loc["Admin.Payments.CouldnTReachStripeJustNow"]</p>
    }
</div>

<div class="admin-card">
    <h2>@Loc["Admin.Payments.EventTimeline"]</h2>
    @if (Model.Events.Count == 0)
    {
        <p style="font-size:0.8125rem; color:#999;">@Loc["Admin.Payments.NoProviderEventsRecordedAgainstThis"]</p>
    }
    else
    {
        <div class="admin-table-scroll">
            <table class="admin-table">
                <thead><tr><th>@Loc["Admin.Payments.Received"]</th><th>@Loc["Admin.Payments.Event"]</th><th>@Loc["Admin.Payments.Object"]</th><th>@Loc["Admin.Common.Status"]</th><th>@Loc["Admin.Payments.Attempts"]</th><th>@Loc["Admin.Payments.Error"]</th></tr></thead>
                <tbody>
                    @foreach (var e in Model.Events)
                    {
                        <tr>
                            <td>@e.ReceivedAt.ToString("dd MMM yyyy HH:mm:ss")</td>
                            <td>@e.Type<div class="admin-table__sub" style="font-family:monospace;">@e.EventId</div></td>
                            <td style="font-family:monospace; font-size:0.75rem; word-break:break-all;">@e.ObjectId</td>
                            <td><span class="@EventBadge(e.Status)">@Loc.Label(e.Status)</span></td>
                            <td>@e.Attempts</td>
                            <td class="admin-table__sub">@(e.LastError ?? "")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="admin-hint">@Loc["Admin.Payments.FailedEventsCanBeReRun"] <a asp-controller="AdminWebhooks" asp-action="Index" asp-route-status="Failed">@Loc["Admin.Payments.StripeEvents"]</a>.</p>
    }
</div>

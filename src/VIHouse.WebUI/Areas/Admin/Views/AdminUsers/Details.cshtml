@model AdminCustomerDetailViewModel
@{
    ViewData["Title"] = Model.Email;
    var allRoles = VIHouse.DataAccess.Identity.Roles.All;
}

@if (TempData["StatusMessage"] is string status)
{
    <div class="admin-status-message">@status</div>
}

<div class="admin-toolbar" style="justify-content: space-between; align-items: center;">
    <span></span>
    <a class="admin-btn admin-btn--ghost" asp-action="Index">&larr; Back to Customers</a>
</div>

<div class="admin-review-grid">
    <div class="admin-review-main">
        <div class="admin-card">
            <h2>Account</h2>
            <dl class="admin-detail-list">
                <div><dt>Email</dt><dd>@Model.Email</dd></div>
                <div><dt>Company</dt><dd>@(Model.Profile?.CompanyName ?? "—")</dd></div>
                <div><dt>Role</dt><dd>@(Model.Profile?.JobTitle ?? "—")</dd></div>
                <div><dt>Industry</dt><dd>@(Model.Profile?.Industry ?? "—")</dd></div>
            </dl>
        </div>

        <div class="admin-card">
            <h2>Applications</h2>
            @if (Model.Applications.Count == 0)
            {
                <p>No applications from this account.</p>
            }
            else
            {
                <table class="admin-table">
                    <thead><tr><th>Status</th><th>Submitted</th></tr></thead>
                    <tbody>
                        @foreach (var a in Model.Applications)
                        {
                            <tr>
                                <td><a asp-area="Admin" asp-controller="AdminApplications" asp-action="Details" asp-route-id="@a.Id">@a.Status.ToDisplayLabel()</a></td>
                                <td>@(a.SubmittedAt?.ToString("dd MMM yyyy") ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <div class="admin-card">
            <h2>Membership Payments</h2>
            @if (Model.MembershipPayments.Count == 0)
            {
                <p>No membership purchases from this account.</p>
            }
            else
            {
                <table class="admin-table">
                    <thead><tr><th>Date</th><th>Status</th><th>Amount</th><th>Stripe reference</th></tr></thead>
                    <tbody>
                        @foreach (var mp in Model.MembershipPayments)
                        {
                            <tr>
                                <td>@mp.CreatedAt.ToString("dd MMM yyyy")</td>
                                <td>@mp.Status</td>
                                <td>@MoneyFormatter.Format(mp.AmountMinor, mp.Currency)</td>
                                <td><code style="font-size:0.75rem;">@mp.ProviderReference</code></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <div class="admin-card">
            <h2>Experience Payments</h2>
            @if (Model.Payments.Count == 0)
            {
                <p>No experience payments from this account.</p>
            }
            else
            {
                <table class="admin-table">
                    <thead><tr><th>Date</th><th>Provider</th><th>Status</th><th>Amount</th></tr></thead>
                    <tbody>
                        @foreach (var p in Model.Payments)
                        {
                            <tr>
                                <td><a asp-area="Admin" asp-controller="AdminPayments" asp-action="Details" asp-route-id="@p.Id">@p.CreatedAt.ToString("dd MMM yyyy")</a></td>
                                <td>@p.Provider</td>
                                <td>@p.Status</td>
                                <td>@MoneyFormatter.Format(p.AmountMinor, p.Currency)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <div class="admin-card">
            <h2>Bookings</h2>
            @if (Model.Bookings.Count == 0)
            {
                <p>No bookings from this account.</p>
            }
            else
            {
                <table class="admin-table">
                    <thead><tr><th>Reference</th><th>Status</th><th>Amount</th></tr></thead>
                    <tbody>
                        @foreach (var b in Model.Bookings)
                        {
                            <tr>
                                <td><a asp-area="Admin" asp-controller="AdminBookings" asp-action="Details" asp-route-id="@b.Id">@b.BookingReference</a></td>
                                <td>@b.Status</td>
                                <td>@MoneyFormatter.Format(b.AmountMinor, b.Currency)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <div class="admin-review-side">
        <div class="admin-card">
            <h2>Account Health</h2>
            <dl class="admin-detail-list">
                <div><dt>Member status</dt><dd>@Model.MemberStatus</dd></div>
                <div>
                    <dt>Two-factor</dt>
                    <dd>
                        @* 2FA is mandatory site-wide (TwoFactorRequirementFilter), so "Not set up"
                           is also the answer to "why is this member stuck on a setup page?" *@
                        <span class="@(Model.TwoFactorEnabled ? "admin-badge admin-badge--open" : "admin-badge admin-badge--draft")">
                            @(Model.TwoFactorEnabled ? "Enabled" : "Not set up")
                        </span>
                    </dd>
                </div>
                <div>
                    <dt>Email confirmed</dt>
                    <dd>@(Model.EmailConfirmed ? "Yes" : "No")</dd>
                </div>
                @if (Model.IsLockedOut)
                {
                    <div>
                        <dt>Locked out</dt>
                        <dd><span class="admin-badge admin-badge--closed">Yes — too many failed attempts</span></dd>
                    </div>
                }
                <div><dt>Account created</dt><dd>@Model.CreatedAt.ToString("dd MMM yyyy")</dd></div>
                <div>
                    <dt>Last sign-in</dt>
                    <dd>@(Model.LastLoginAt?.ToString("dd MMM yyyy, HH:mm") ?? "Never signed in")</dd>
                </div>
            </dl>
        </div>

        <div class="admin-card">
            <h2>Roles</h2>
            <form asp-action="UpdateRoles" asp-route-id="@Model.UserId" method="post">
                <div style="display:flex; flex-direction:column; gap:8px; margin-bottom:16px;">
                    @foreach (var role in allRoles)
                    {
                        <label style="display:flex; align-items:center; gap:8px; font-size:0.875rem;">
                            <input type="checkbox" name="roles" value="@role" checked="@Model.Roles.Contains(role)" />
                            @role
                        </label>
                    }
                </div>
                <button type="submit" class="admin-btn" style="width:100%;">Save Roles</button>
            </form>
        </div>
    </div>
</div>

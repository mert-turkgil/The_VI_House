@using VIHouse.DataAccess.Identity
@model List<AdminCustomerListItemViewModel>
@{
    ViewData["Title"] = Loc["Admin.Nav.AdminUsers"].Value;
}

@if (TempData["StatusMessage"] is string status)
{
    <div class="admin-status-message">@status</div>
}

@* Only SuperAdmin can create staff accounts, so anyone else is not shown a button that would
   just refuse them. *@
@if (User.IsInRole(Roles.SuperAdmin))
{
    <div class="admin-toolbar">
        <a class="admin-btn" asp-action="Invite">@Loc["Admin.Users.InviteAdmin"]</a>
    </div>
}

@if (Model.Count == 0)
{
    <p>@Loc["Admin.Users.NoRegisteredAccountsYet"]</p>
}
else
{
    <div class="admin-table-scroll">
    <table class="admin-table" data-admin-table>
        <thead>
            <tr>
                <th>@Loc["Admin.Common.Email"]</th>
                <th>@Loc["Admin.Users.TitleProfession"]</th>
                <th>@Loc["Admin.Users.Roles"]</th>
                <th>@Loc["Admin.Users.Applications"]</th>
                <th>@Loc["Admin.Users.Bookings"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td><a asp-action="Details" asp-route-id="@u.UserId">@u.Email</a></td>
                    <td>@(u.JobTitle ?? "—")</td>
                    <td>@(u.Roles.Count == 0 ? "—" : string.Join(", ", u.Roles.Select(r => Loc["Admin.Role." + r].Value)))</td>
                    <td>@u.ApplicationCount</td>
                    <td>@u.BookingCount</td>
                    <td class="admin-table__actions">
                        <a class="admin-icon-btn" asp-action="Details" asp-route-id="@u.UserId">@Loc["Admin.Common.Open"]</a>
                        <a class="admin-icon-btn" href="mailto:@u.Email">@Loc["Admin.Common.Email"]</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

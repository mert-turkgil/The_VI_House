@using VIHouse.DataAccess.Identity
@model List<AdminCustomerListItemViewModel>
@{
    ViewData["Title"] = "Customers";
}

@if (TempData["StatusMessage"] is string status)
{
    <div class="admin-status-message">@status</div>
}

@* Only SuperAdmin can create staff accounts, so anyone else is not shown a button that would
   just refuse them. *@
@if (User.IsInRole(Roles.SuperAdmin))
{
    <div class="admin-toolbar">
        <a class="admin-btn" asp-action="Invite">+ Invite Admin</a>
    </div>
}

@if (Model.Count == 0)
{
    <p>No registered accounts yet.</p>
}
else
{
    <div class="admin-table-scroll">
    <table class="admin-table" data-admin-table>
        <thead>
            <tr>
                <th>Email</th>
                <th>Company</th>
                <th>Roles</th>
                <th>Applications</th>
                <th>Bookings</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td><a asp-action="Details" asp-route-id="@u.UserId">@u.Email</a></td>
                    <td>@(u.CompanyName ?? "—")</td>
                    <td>@(u.Roles.Count == 0 ? "—" : string.Join(", ", u.Roles))</td>
                    <td>@u.ApplicationCount</td>
                    <td>@u.BookingCount</td>
                    <td class="admin-table__actions">
                        <a class="admin-icon-btn" asp-action="Details" asp-route-id="@u.UserId">Open</a>
                        <a class="admin-icon-btn" href="mailto:@u.Email">Email</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

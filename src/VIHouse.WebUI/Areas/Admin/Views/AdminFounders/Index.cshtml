@using VIHouse.WebUI.Areas.Admin.Controllers
@model AdminFoundersViewModel
@{
    ViewData["Title"] = Loc["Admin.Nav.AdminFounders"].Value;
}

@if (TempData["StatusMessage"] is string status)
{
    <div class="admin-status-message">@status</div>
}

<p class="admin-hint">@Loc.Html("Admin.Founders.Intro", LocalizerHtml.Strong(Loc["Admin.Founders.IntroRule"].Value))</p>

<div class="admin-review-grid">
    <div class="admin-review-main">
        <div class="admin-card">
            <h2>@Loc["Admin.Founders.Programme"]</h2>
            <form asp-action="Save" method="post">
                <div class="admin-form__grid">
                    <div class="admin-field">
                        <label asp-for="Form.WindowEndsAtUtc"></label>
                        <input asp-for="Form.WindowEndsAtUtc" type="datetime-local" />
                        <p class="admin-field__hint">@Loc[Model.Form.WindowEndsAtUtc is null ? "Admin.Founders.WindowNotSet" : Model.IsWindowOpen ? "Admin.Founders.WindowOpen" : "Admin.Founders.WindowClosed"]</p>
                    </div>
                    <div class="admin-field">
                        <label asp-for="Form.ExtraDiscountPercent"></label>
                        <input asp-for="Form.ExtraDiscountPercent" type="number" min="0" max="100" />
                        <p class="admin-field__hint">@Loc["Admin.Founders.ExtraDiscountHint"]</p>
                    </div>
                    <div class="admin-field">
                        <label asp-for="Form.EarlyAccessDays"></label>
                        <input asp-for="Form.EarlyAccessDays" type="number" min="0" max="365" />
                        <p class="admin-field__hint">@Loc["Admin.Founders.EarlyAccessHint"]</p>
                    </div>
                    <div class="admin-field">
                        <label style="display:flex; gap:8px; align-items:center;">
                            <input asp-for="Form.BadgeEnabled" type="checkbox" />
                            <span>@Loc["Admin.Field.FounderBadgeEnabled"]</span>
                        </label>
                        <p class="admin-field__hint">@Loc["Admin.Founders.BadgeHint"]</p>
                    </div>
                </div>
                <button type="submit" class="admin-btn">@Loc["Admin.Founders.Save"]</button>
            </form>
        </div>

        <div class="admin-card">
            <h2>@Loc["Admin.Founders.ListHeading", Model.Founders.Count]</h2>
            @if (Model.Founders.Count == 0)
            {
                <p class="admin-hint">@Loc["Admin.Founders.None"]</p>
            }
            else
            {
                <div class="admin-table-scroll">
                    <table class="admin-table" data-admin-table data-admin-table-per-page="25">
                        <thead>
                            <tr>
                                <th>@Loc["Admin.Common.Name"]</th>
                                <th>@Loc["Admin.Common.Email"]</th>
                                <th>@Loc["Admin.Founders.Since"]</th>
                                <th>@Loc["Admin.Founders.CurrentPlan"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var f in Model.Founders)
                            {
                                <tr>
                                    <td><a asp-controller="AdminUsers" asp-action="Details" asp-route-id="@f.UserId">@(string.IsNullOrWhiteSpace(f.Name) ? "—" : f.Name)</a></td>
                                    <td>@f.Email</td>
                                    <td>@(f.FounderSince?.ToString("dd MMM yyyy") ?? "—")</td>
                                    <td>@(f.PlanName ?? Loc["Admin.Founders.NoPlan"].Value)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="admin-review-side">
        <div class="admin-card">
            <h2>@Loc["Admin.Founders.Backfill"]</h2>
            <p style="font-size:0.875rem;">@Loc["Admin.Founders.BackfillBody"]</p>
            <form asp-action="Backfill" method="post" data-confirm="@Loc["Admin.Founders.BackfillConfirm"]">
                <button type="submit" class="admin-btn admin-btn--ghost" style="width:100%;">@Loc["Admin.Founders.BackfillButton"]</button>
            </form>
        </div>
    </div>
</div>

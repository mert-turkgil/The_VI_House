@using VIHouse.Entities.Community
@model List<CommunityLink>
@{
    ViewData["Title"] = "Community Links";
}

@if (TempData["StatusMessage"] is string status)
{
    <div class="admin-status-message">@status</div>
}

<div class="admin-toolbar">
    <a class="admin-btn" asp-action="Create">+ New Link</a>
</div>

<p class="admin-hint">
    Shown to members with an active membership only — ticket holders never see these. Untick
    "visible" to pull a revoked invite without losing the record of it.
</p>

@if (Model.Count == 0)
{
    <p>No community links yet. Add the Discord invite to get started.</p>
}
else
{
    <table class="admin-table">
        <thead>
            <tr>
                <th>Label</th>
                <th>Kind</th>
                <th>URL</th>
                <th>Visible</th>
                <th>Order</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var link in Model)
            {
                <tr>
                    <td><a asp-action="Edit" asp-route-id="@link.Id">@link.Label</a></td>
                    <td>@link.Kind</td>
                    <td style="max-width:280px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                        <code style="font-size:0.75rem;">@link.Url</code>
                    </td>
                    <td>
                        <span class="@(link.IsActive ? "admin-badge admin-badge--open" : "admin-badge admin-badge--closed")">
                            @(link.IsActive ? "Visible" : "Hidden")
                        </span>
                    </td>
                    <td>@link.SortOrder</td>
                    <td>
                        <form asp-action="Delete" asp-route-id="@link.Id" method="post" onsubmit="return confirm('Delete &quot;@link.Label&quot;? Members will lose access to it immediately.');" style="display:inline;">
                            <button type="submit" class="admin-btn admin-btn--danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

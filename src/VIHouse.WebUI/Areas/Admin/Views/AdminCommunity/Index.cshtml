@using VIHouse.Entities.Community
@model List<CommunityLink>
@{
    ViewData["Title"] = Loc["Admin.Nav.AdminCommunity"].Value;
}

@if (TempData["StatusMessage"] is string status)
{
    <div class="admin-status-message">@status</div>
}

<div class="admin-toolbar">
    <a class="admin-btn" asp-action="Create">@Loc["Admin.Community.NewLink"]</a>
</div>

<p class="admin-hint">
    @Loc["Admin.Community.ShownToMembersWithAnActive"]
</p>

@if (Model.Count == 0)
{
    <p>@Loc["Admin.Community.NoCommunityLinksYetAddThe"]</p>
}
else
{
    <div class="admin-table-scroll">
    <table class="admin-table" data-admin-table>
        <thead>
            <tr>
                <th>@Loc["Admin.Community.Label"]</th>
                <th>@Loc["Admin.Community.Kind"]</th>
                <th>URL</th>
                <th>@Loc["Admin.Community.Visible"]</th>
                <th>@Loc["Admin.Community.Order"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var link in Model)
            {
                <tr>
                    <td><a asp-action="Edit" asp-route-id="@link.Id">@link.Label</a></td>
                    <td>@Loc.Label(link.Kind)</td>
                    <td style="max-width:280px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                        <code style="font-size:0.75rem;">@link.Url</code>
                    </td>
                    <td>
                        <span class="@(link.IsActive ? "admin-badge admin-badge--open" : "admin-badge admin-badge--closed")">
                            @Loc[link.IsActive ? "Admin.Community.Visible" : "Admin.Community.Hidden"]
                        </span>
                    </td>
                    <td>@link.SortOrder</td>
                    <td>
                        <form asp-action="Delete" asp-route-id="@link.Id" method="post" data-confirm="@Loc["Admin.Community.DeleteConfirm", link.Label]" style="display:inline;">
                            <button type="submit" class="admin-btn admin-btn--danger">@Loc["Admin.Common.Delete"]</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

@model List<AdminSeminarListItemViewModel>
@{
    ViewData["Title"] = Loc["Admin.Seminar.Index.Title"].Value;
}

@if (TempData["StatusMessage"] is string status)
{
    <div class="admin-status-message">@status</div>
}

<div class="admin-toolbar">
    <a class="admin-btn" asp-action="Create">+ @Loc["Admin.Seminar.New"]</a>
</div>

@if (Model.Count == 0)
{
    <p>@Loc["Admin.Seminar.Index.Empty"]</p>
}
else
{
    <table class="admin-table">
        <thead>
            <tr>
                <th>@Loc["Admin.Seminar.Title"]</th>
                <th>@Loc["Admin.Seminar.Status"]</th>
                <th>@Loc["Admin.Seminar.Visibility"]</th>
                <th>@Loc["Admin.Seminar.Languages"]</th>
                <th>@Loc["Admin.Seminar.StartAt"]</th>
                <th>@Loc["Admin.Seminar.Price"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id">@item.Title</a>
                        <div class="admin-table__sub">/sessions/@item.Slug</div>
                    </td>
                    <td>
                        <span class="@(item.Status == SeminarStatus.Published ? "admin-badge admin-badge--open" : "admin-badge admin-badge--draft")">
                            @Loc["Admin.Seminar.StatusName." + item.Status]
                        </span>
                    </td>
                    <td>@Loc["Admin.Seminar.VisibilityName." + item.Visibility]</td>
                    <td>
                        @* Which languages actually have copy. The fastest way to spot a session that
                           went live with three empty translations behind it. *@
                        @foreach (var site in SiteCultures.All)
                        {
                            var written = item.TranslatedCultures.Contains(site.Name, StringComparer.OrdinalIgnoreCase);
                            <span class="@(written ? "admin-lang-chip admin-lang-chip--on" : "admin-lang-chip")" title="@site.NativeLabel">@site.ShortLabel</span>
                        }
                    </td>
                    <td>@(item.StartAtUtc?.ToString("d MMM yyyy, HH:mm") ?? Loc["Admin.Seminar.OnDemand"].Value)</td>
                    <td>
                        @if (item.PriceMinor <= 0)
                        {
                            <text>@Loc["Seminars.Free"]</text>
                        }
                        else
                        {
                            @MoneyFormatter.Format(item.PriceMinor, item.Currency)
                            @if (item.IncludedWithMembership)
                            {
                                <div class="admin-table__sub">@Loc["Admin.Seminar.FreeForMembers"]</div>
                            }
                        }
                    </td>
                    <td>
                        <a class="admin-btn admin-btn--ghost admin-btn--sm" asp-action="Enrolments" asp-route-id="@item.Id">@Loc["Admin.Seminar.Enrolments"]</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

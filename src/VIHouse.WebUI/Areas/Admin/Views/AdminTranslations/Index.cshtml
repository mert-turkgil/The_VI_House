@model AdminTranslationsViewModel
@{
    ViewData["Title"] = Loc["Admin.Nav.AdminTranslations"].Value;
}

<p class="admin-hint">
    @Loc["Admin.Translations.EveryStringOnTheSiteIn"]
</p>

@if (!Model.IsEditable)
{
    <div class="admin-notice">
        <strong>@Loc["Admin.Translations.ReadOnly"]</strong> @Loc.Html("Admin.Translations.ReadOnlyHint", LocalizerHtml.Code(Model.ResourcesPath), LocalizerHtml.Code("Localization:ResourcesPath"), LocalizerHtml.Code("SharedResource.resx"))
    </div>
}

<div class="admin-stat-row">
    <div class="admin-stat">
        <span class="admin-stat__value">@Model.TotalKeys</span>
        <span class="admin-stat__label">@Loc["Admin.Translations.TranslationKeys"]</span>
    </div>
    <div class="admin-stat">
        <span class="admin-stat__value">@Model.Cultures.Count</span>
        <span class="admin-stat__label">@Loc["Admin.Translations.Languages"]</span>
    </div>
    <a class="admin-stat @(Model.UntranslatedOnly ? "admin-stat--active" : "")"
       asp-action="Index" asp-route-section="@Model.Section" asp-route-q="@Model.Query"
       asp-route-untranslated="@(!Model.UntranslatedOnly)">
        <span class="admin-stat__value">@Model.NeedsAttention</span>
        <span class="admin-stat__label">@Loc["Admin.Translations.StillReadingAsEnglish"]</span>
    </a>
</div>

@* A real GET form, so a filtered view is a URL you can send someone, and it works with scripting
   off. It searches the key and all four languages at once, ignoring case and accents — so "sehir"
   finds "şehir" and "uber" finds "über", which matters when nobody is on that language's keyboard. *@
<form class="admin-filter-bar" method="get" asp-action="Index">
    <div class="admin-field">
        <label for="section">@Loc["Admin.Translations.Section"]</label>
        <select id="section" name="section" onchange="this.form.submit()">
            <option value="">@Loc["Admin.Translations.AllSections"]</option>
            @foreach (var s in Model.Sections)
            {
                <option value="@s" selected="@(string.Equals(s, Model.Section, StringComparison.OrdinalIgnoreCase))">@s</option>
            }
        </select>
    </div>

    <div class="admin-field admin-field--grow">
        <label for="q">@Loc["Admin.Common.Search"]</label>
        <input id="q" name="q" value="@Model.Query"
               placeholder="@Loc["Admin.Translations.KeyOrTextInEnglishGerman"]" />
    </div>

    @if (Model.UntranslatedOnly)
    {
        <input type="hidden" name="untranslated" value="true" />
    }

    <button type="submit" class="admin-btn">@Loc["Admin.Common.Search"]</button>

    @if (!string.IsNullOrWhiteSpace(Model.Query) || !string.IsNullOrWhiteSpace(Model.Section) || Model.UntranslatedOnly)
    {
        <a class="admin-btn admin-btn--ghost" asp-action="Index">@Loc["Admin.Translations.Clear"]</a>
    }

    @if (User.IsInRole(VIHouse.DataAccess.Identity.Roles.SuperAdmin))
    {
        @* The way an edit made here gets back into git — see the controller's Export summary. *@
        <a class="admin-btn admin-btn--ghost" asp-action="Export" download>@Loc["Admin.Translations.DownloadResxFiles"]</a>
    }
</form>

<p class="admin-hint">
    @Loc["Admin.Translations.ShowingOf", Model.MatchedKeys, Model.TotalKeys]
    @Loc["Admin.Translations.ClickToEdit"] &middot; <kbd>Enter</kbd> @Loc["Admin.Translations.KeySaves"] &middot; <kbd>Shift</kbd>+<kbd>Enter</kbd>
    @Loc["Admin.Translations.KeyNewLine"] &middot; <kbd>Esc</kbd> @Loc["Admin.Translations.KeyCancels"]
</p>

@if (Model.Rows.Count == 0)
{
    <div class="admin-empty">
        <p class="admin-empty__title">@Loc["Admin.Translations.NothingMatchesThat"]</p>
        <p>@Loc["Admin.Translations.TryADifferentSectionOrClear"]</p>
    </div>
}
else
{
    <div class="admin-table-scroll">
        <table class="admin-table admin-table--translations"
               data-translations
               data-save-url="@Url.Action("Save")">
            <thead>
                <tr>
                    <th scope="col">@Loc["Admin.Translations.Key"]</th>
                    @foreach (var culture in Model.Cultures)
                    {
                        <th scope="col">
                            <span class="admin-lang-chip admin-lang-chip--on">@culture.ShortLabel</span>
                            @culture.NativeLabel
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr class="@(row.NeedsAttention ? "is-untranslated" : null)">
                        <th scope="row" class="admin-table__key">
                            <code>@row.Key</code>
                            @if (row.HasPlaceholders)
                            {
                                @* A translator needs to know before they start typing, not after
                                   the save is refused. *@
                                <span class="admin-table__flag" title="@Loc["Admin.Translations.Uses0StylePlaceholdersThatEvery"]">{ }</span>
                            }
                        </th>

                        @foreach (var culture in Model.Cultures)
                        {
                            var value = row.Values.GetValueOrDefault(culture.Name, "");
                            @* No data-original: HTML collapses newlines in an attribute value, so
                               a multi-line string would come back altered and every save would be
                               refused as a conflict. The editor reads the cell's text node instead. *@
                            <td class="admin-cell-edit"
                                data-key="@row.Key"
                                data-culture="@culture.Name"
                                tabindex="0"
                                role="button"
                                aria-label="Edit @culture.NativeLabel for @row.Key">@value</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    @* The antiforgery token for the fetch-based saves. AutoValidateAntiforgeryToken is global, so
       the POST is rejected without it. *@
    @Html.AntiForgeryToken()
}

@using VIHouse.Entities.Commerce
@model List<AdminPromoCodeListItemViewModel>
@{
    ViewData["Title"] = Loc["Admin.Nav.AdminPromoCodes"].Value;
}

@if (TempData["StatusMessage"] is string status)
{
    <div class="admin-status-message">@status</div>
}

<div class="admin-toolbar">
    <a class="admin-btn" asp-action="Create">@Loc["Admin.PromoCodes.NewCode"]</a>
</div>

<p class="admin-hint">
    @Loc["Admin.PromoCodes.AppliedAtCheckoutAgainstTheTicket"]
</p>

@if (Model.Count == 0)
{
    <p>@Loc["Admin.PromoCodes.NoPromoCodesYet"]</p>
}
else
{
    <div class="admin-table-scroll">
    <table class="admin-table" data-admin-table>
        <thead>
            <tr>
                <th>@Loc["Admin.PromoCodes.Code"]</th>
                <th>@Loc["Admin.PromoCodes.Discount"]</th>
                <th>@Loc["Admin.PromoCodes.AppliesTo"]</th>
                <th>@Loc["Admin.PromoCodes.Used"]</th>
                <th>@Loc["Admin.PromoCodes.Expires"]</th>
                <th>@Loc["Admin.PromoCodes.State"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var code in Model)
            {
                <tr>
                    <td><a asp-action="Edit" asp-route-id="@code.Id"><code>@code.Code</code></a></td>
                    <td>@code.ValueLabel</td>
                    <td>
                        @code.AppliesTo
                        @if (code.RestrictedToEmail is not null)
                        {
                            <span class="admin-table__sub">@Loc["Admin.PromoCodes.ForEmail", code.RestrictedToEmail]</span>
                        }
                    </td>
                    <td>@code.RedemptionCount@(code.MaxRedemptions is null ? "" : $" / {code.MaxRedemptions}")</td>
                    <td style="font-size:0.75rem;">@(code.ExpiresAt?.ToString("d MMM yyyy") ?? "—")</td>
                    <td>
                        @* "Usable" rather than "Active": a code can be ticked active and still be
                           refused because it expired or ran out, and that is exactly the case
                           somebody is trying to understand when they open this screen. *@
                        @if (code.IsUsable)
                        {
                            <span class="admin-badge admin-badge--open">@Loc["Admin.PromoCodes.Usable"]</span>
                        }
                        else if (!code.IsActive)
                        {
                            <span class="admin-badge admin-badge--closed">@Loc["Admin.PromoCodes.Off"]</span>
                        }
                        else if (code.ExpiresAt is not null && code.ExpiresAt <= DateTimeOffset.UtcNow)
                        {
                            <span class="admin-badge admin-badge--draft">@Loc["Admin.PromoCodes.Expired"]</span>
                        }
                        else
                        {
                            <span class="admin-badge admin-badge--draft">@Loc["Admin.PromoCodes.FullyRedeemed"]</span>
                        }
                    </td>
                    <td>
                        <form asp-action="Delete" asp-route-id="@code.Id" method="post"
                              data-confirm="@Loc["Admin.PromoCodes.DeleteConfirm", code.Code]"
                              style="display:inline;">
                            <button type="submit" class="admin-btn admin-btn--danger">@Loc["Admin.Common.Delete"]</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

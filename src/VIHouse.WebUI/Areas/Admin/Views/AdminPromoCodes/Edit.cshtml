@using VIHouse.Entities.Commerce
@using Microsoft.AspNetCore.Mvc.Rendering
@model AdminPromoCodeFormViewModel
@{
    ViewData["Title"] = Model.Id is null ? Loc["Admin.PromoCodes.NewTitle"].Value : Loc["Admin.PromoCodes.EditTitle", Model.Code ?? ""].Value;
    var experiences = ViewData["Experiences"] as List<SelectListItem> ?? [];
    var plans = ViewData["Plans"] as List<SelectListItem> ?? [];
    var redemptions = ViewData["RedemptionCount"] as int?;
}

<form asp-action="Save" method="post" class="admin-form">
    <div asp-validation-summary="ModelOnly" class="field-validation-error"></div>
    <input type="hidden" asp-for="Id" />

    <div class="admin-form__grid">
        <div class="admin-field">
            <label asp-for="Code"></label>
            <input asp-for="Code" placeholder="VI250" style="text-transform:uppercase;" />
            <span asp-validation-for="Code" class="field-validation-error"></span>
            <p class="admin-field__hint">@Loc["Admin.PromoCodes.CodeHint"]</p>
        </div>
        <div class="admin-field">
            <label asp-for="Type"></label>
            <select asp-for="Type" asp-items="Loc.Options<PromoCodeType>()"></select>
        </div>
    </div>

    <div class="admin-form__grid">
        <div class="admin-field">
            <label asp-for="Value"></label>
            <input asp-for="Value" type="number" step="0.01" min="0" />
            <span asp-validation-for="Value" class="field-validation-error"></span>
            <p class="admin-field__hint">@Loc["Admin.PromoCodes.APercentageTakes1100A"]</p>
        </div>
        <div class="admin-field">
            <label asp-for="Currency"></label>
            <input asp-for="Currency" maxlength="3" placeholder="GBP" />
            <p class="admin-field__hint">@Loc["Admin.PromoCodes.IgnoredForAPercentage"]</p>
        </div>
    </div>

    <div class="admin-field">
        <label asp-for="Scope"></label>
        <select asp-for="Scope" asp-items="Loc.Options<PromoScope>()"></select>
        <p class="admin-field__hint">@Loc["Admin.PromoCodes.ACodeIsForExperienceTickets"]</p>
    </div>

    <div class="admin-field" data-promo-scope="Experiences">
        <label asp-for="ExperienceId"></label>
        <select asp-for="ExperienceId" asp-items="experiences">
            <option value="">@Loc["Admin.PromoCodes.AnyExperience"]</option>
        </select>
    </div>

    <div class="admin-form__grid" data-promo-scope="Memberships">
        <div class="admin-field">
            <label asp-for="MembershipPlanId"></label>
            <select asp-for="MembershipPlanId" asp-items="plans">
                <option value="">@Loc["Admin.PromoCodes.AnyPlan"]</option>
            </select>
        </div>
        <div class="admin-field">
            <label asp-for="MembershipDuration"></label>
            <select asp-for="MembershipDuration" asp-items="Loc.Options<PromoDuration>()"></select>
            <p class="admin-field__hint">@Loc["Admin.PromoCodes.AppliedAsACouponOnThe"]</p>
        </div>
    </div>

    <div class="admin-field">
        <label asp-for="RestrictedToEmail"></label>
        <input asp-for="RestrictedToEmail" type="email" placeholder="name@example.com" />
        <p class="admin-field__hint">@Loc["Admin.PromoCodes.ReserveTheCodeForOnePerson"]</p>
        <span asp-validation-for="RestrictedToEmail" class="field-validation-error"></span>
    </div>

    <div class="admin-form__grid">
        <div class="admin-field">
            <label asp-for="MaxRedemptions"></label>
            <input asp-for="MaxRedemptions" type="number" min="1" />
            <span asp-validation-for="MaxRedemptions" class="field-validation-error"></span>
            @if (redemptions is > 0)
            {
                <p class="admin-field__hint">@Loc["Admin.PromoCodes.RedeemedSoFar", redemptions]</p>
            }
        </div>
        <div class="admin-field">
            <label asp-for="ExpiresAt"></label>
            <input asp-for="ExpiresAt" type="datetime-local" />
        </div>
    </div>

    <div class="admin-field">
        <label style="display:flex; align-items:center; gap:8px;">
            <input asp-for="IsActive" type="checkbox" />
            @Loc["Admin.PromoCodes.AcceptedAtCheckout"]
        </label>
    </div>

    <div>
        <button type="submit" class="admin-btn">@Loc[Model.Id is null ? "Admin.PromoCodes.CreateCode" : "Admin.Publish.Update"]</button>
        <a class="admin-btn admin-btn--ghost" asp-action="Index">@Loc["Admin.Common.Cancel"]</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

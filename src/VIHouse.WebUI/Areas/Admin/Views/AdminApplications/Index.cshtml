@model List<AdminApplicationListItemViewModel>
@{
    ViewData["Title"] = Loc["Admin.Nav.AdminApplications"].Value;
    var selected = ViewData["SelectedStatus"] as ApplicationStatus?;

    string TabClass(ApplicationStatus? s) =>
        selected == s ? "admin-tabs__link active" : "admin-tabs__link";
}

@if (TempData["StatusMessage"] is string status)
{
    <div class="admin-status-message">@status</div>
}

<nav class="admin-tabs">
    <a class="@TabClass(null)" asp-action="Index">@Loc["Admin.Applications.All"]</a>
    <a class="@TabClass(ApplicationStatus.Submitted)" asp-action="Index" asp-route-status="Submitted">@Loc["Admin.Applications.Submitted"]</a>
    <a class="@TabClass(ApplicationStatus.UnderReview)" asp-action="Index" asp-route-status="UnderReview">@Loc["Admin.Applications.UnderReview"]</a>
    <a class="@TabClass(ApplicationStatus.Shortlisted)" asp-action="Index" asp-route-status="Shortlisted">@Loc["Admin.Applications.Shortlisted"]</a>
    <a class="@TabClass(ApplicationStatus.Approved)" asp-action="Index" asp-route-status="Approved">@Loc["Admin.Applications.Approved"]</a>
    <a class="@TabClass(ApplicationStatus.Rejected)" asp-action="Index" asp-route-status="Rejected">@Loc["Admin.Applications.Rejected"]</a>
    <a class="@TabClass(ApplicationStatus.Waitlisted)" asp-action="Index" asp-route-status="Waitlisted">@Loc["Admin.Applications.Waitlisted"]</a>
</nav>

@if (Model.Count == 0)
{
    <p>@Loc["Admin.Applications.NoApplicationsHereYet"]</p>
}
else
{
    <div class="admin-table-scroll">
    <table class="admin-table" data-admin-table>
        <thead>
            <tr>
                <th>@Loc["Admin.Applications.Applicant"]</th>
                <th>@Loc["Admin.Common.Email"]</th>
                <th>@Loc["Admin.Applications.Experience"]</th>
                <th>@Loc["Admin.Common.Status"]</th>
                <th>@Loc["Admin.Applications.Submitted"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
                var badgeClass = a.Status switch
                {
                    ApplicationStatus.Approved => "admin-badge admin-badge--open",
                    ApplicationStatus.Paid => "admin-badge admin-badge--paid",
                    ApplicationStatus.Rejected => "admin-badge admin-badge--closed",
                    ApplicationStatus.Submitted => "admin-badge admin-badge--draft",
                    ApplicationStatus.Waitlisted or ApplicationStatus.PaymentPending => "admin-badge admin-badge--pending",
                    ApplicationStatus.UnderReview or ApplicationStatus.Shortlisted => "admin-badge admin-badge--info",
                    _ => "admin-badge",
                };
                <tr>
                    <td><a asp-action="Details" asp-route-id="@a.Id">@a.FirstName @a.LastName</a></td>
                    <td>@a.Email</td>
                    <td>@a.ExperienceLabel</td>
                    <td><span class="@badgeClass">@Loc.Label(a.Status)</span></td>
                    <td>@(a.SubmittedAt?.ToString("dd MMM yyyy") ?? "—")</td>
                    @* The row itself opens the review page; these are the destinations that
                       otherwise need opening it first. *@
                    <td class="admin-table__actions">
                        <a class="admin-icon-btn" asp-action="Details" asp-route-id="@a.Id">@Loc["Admin.Applications.Review"]</a>
                        <a class="admin-icon-btn" href="mailto:@a.Email">@Loc["Admin.Common.Email"]</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

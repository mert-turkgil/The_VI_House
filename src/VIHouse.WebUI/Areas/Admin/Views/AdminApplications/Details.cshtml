@model AdminApplicationDetailViewModel
@{
    var a = Model.Application;
    ViewData["Title"] = $"{a.FirstName} {a.LastName}";

    var badgeClass = a.Status switch
    {
        ApplicationStatus.Approved => "admin-badge admin-badge--open",
        ApplicationStatus.Rejected => "admin-badge admin-badge--closed",
        ApplicationStatus.Submitted => "admin-badge admin-badge--draft",
        _ => "admin-badge",
    };
}

@if (TempData["StatusMessage"] is string status)
{
    <div class="admin-status-message">@status</div>
}

<div class="admin-toolbar" style="justify-content: space-between; align-items: center;">
    <span class="@badgeClass" style="font-size:0.75rem;">@Loc.Label(a.Status)</span>
    <a class="admin-btn admin-btn--ghost" asp-action="Index">@Loc["Admin.Applications.BackToApplications"]</a>
</div>

<div class="admin-review-grid">
    <div class="admin-review-main">
        <div class="admin-card">
            <h2>@Loc["Admin.Applications.Applicant"]</h2>
            <dl class="admin-detail-list">
                <div><dt>@Loc["Admin.Common.Name"]</dt><dd>@a.FirstName @a.LastName</dd></div>
                <div><dt>@Loc["Admin.Common.Email"]</dt><dd>@a.Email</dd></div>
                <div><dt>@Loc["Admin.Applications.TitleProfession"]</dt><dd>@(a.JobTitle ?? "—")</dd></div>
                <div><dt>@Loc["Admin.Common.Phone"]</dt><dd>@(a.Phone ?? "—")</dd></div>
                <div>
                    <dt>@Loc["Admin.Applications.Address"]</dt>
                    <dd>
                        @{
                            var addressLines = new[] { a.AddressLine1, a.AddressLine2, string.Join(" ", new[] { a.PostalCode, a.City }.Where(x => !string.IsNullOrWhiteSpace(x))), Countries.NameFor(a.Country) }
                                .Where(x => !string.IsNullOrWhiteSpace(x)).ToList();
                        }
                        @for (var i = 0; i < addressLines.Count; i++)
                        {
                            @addressLines[i]@(i < addressLines.Count - 1 ? Html.Raw("<br />") : null)
                        }
                    </dd>
                </div>
                <div><dt>@Loc["Admin.Applications.AnnualEarnings"]</dt><dd>@(EarningsBand.LabelFor(a.EarningsBand) ?? "—")</dd></div>
                <div><dt>@Loc["Admin.Applications.Experience"]</dt><dd>@Model.ExperienceLabel</dd></div>
                <div><dt>@Loc["Admin.Applications.Submitted"]</dt><dd>@(a.SubmittedAt?.ToString("dd MMM yyyy, HH:mm") ?? "—")</dd></div>
                @if (!string.IsNullOrWhiteSpace(a.ReferralCode))
                {
                    <div><dt>@Loc["Admin.Applications.ReferralCode"]</dt><dd>@a.ReferralCode</dd></div>
                }
            </dl>
        </div>

        <div class="admin-card">
            <h2>@Loc["Admin.Applications.InTheirWords"]</h2>
            <p><strong>@Loc["Admin.Applications.DescribeYourselfOrYourBusiness"]</strong><br />@(string.IsNullOrWhiteSpace(a.AboutStatement) ? "—" : a.AboutStatement)</p>
            <p><strong>@Loc["Admin.Applications.HowMayWeHelpWithYour"]</strong><br />@(string.IsNullOrWhiteSpace(a.ExpectationsStatement) ? "—" : a.ExpectationsStatement)</p>
        </div>

        <div class="admin-card">
            <h2>@Loc["Admin.Applications.InternalNotes"]</h2>
            <p style="font-size:0.75rem; color:#999; margin-top:-8px;">@Loc["Admin.Applications.NeverShownToTheApplicant"]</p>
            <form asp-action="UpdateNotes" asp-route-id="@a.Id" method="post">
                <textarea name="internalNotes" rows="4" style="width:100%; padding:10px 12px; border:1px solid var(--vih-line-on-light); border-radius:4px; font-family:inherit;">@a.InternalNotes</textarea>
                <div style="margin-top:12px;">
                    <button type="submit" class="admin-btn">@Loc["Admin.Applications.SaveNotes"]</button>
                </div>
            </form>
        </div>

        <div class="admin-card">
            <h2>@Loc["Admin.Applications.Tags"]</h2>
            @if (a.Tags.Count > 0)
            {
                <div class="admin-inline-list">
                    @foreach (var tag in a.Tags)
                    {
                        <div class="admin-inline-list__row">
                            <span>@tag.Label</span>
                            <form asp-action="RemoveTag" asp-route-id="@a.Id" asp-route-tagId="@tag.Id" method="post">
                                <button type="submit" class="admin-btn admin-btn--danger">@Loc["Admin.Common.Remove"]</button>
                            </form>
                        </div>
                    }
                </div>
            }
            <form asp-action="AddTag" asp-route-id="@a.Id" method="post" class="admin-inline-form">
                <div class="admin-field">
                    <label for="tag-label">@Loc["Admin.Applications.AddTag"]</label>
                    <input id="tag-label" name="label" placeholder="@Loc["Admin.Applications.EGInvestorFintechVIP"]" required />
                </div>
                <button type="submit" class="admin-btn">@Loc["Admin.Common.Add"]</button>
            </form>
        </div>
    </div>

    <div class="admin-review-side">
        <div class="admin-card">
            <h2>@Loc["Admin.Applications.Review"]</h2>

            @if (Model.CanMarkUnderReview)
            {
                <form asp-action="MarkUnderReview" asp-route-id="@a.Id" method="post">
                    <button type="submit" class="admin-btn" style="width:100%;">@Loc["Admin.Applications.StartReview"]</button>
                </form>
            }
            else if (Model.CanShortlist)
            {
                <form asp-action="Shortlist" asp-route-id="@a.Id" method="post">
                    <button type="submit" class="admin-btn" style="width:100%;">@Loc["Admin.Applications.Shortlist"]</button>
                </form>
            }
            else if (Model.CanDecide)
            {
                @if (Model.IsWaitlisted)
                {
                    @* Waitlisted is a holding pattern, not a verdict: the answer changes when a seat
                       opens or the next cohort is announced, so the decision stays open here. *@
                    <p style="font-size:0.8125rem; color:#666; margin-top:-4px;">
                        @Loc["Admin.Applications.WaitlistedSince", a.DecisionAt?.ToString("dd MMM yyyy") ?? "—"]
                    </p>
                }

                <div style="display:flex; flex-direction:column; gap:10px;">
                    <form asp-action="Approve" asp-route-id="@a.Id" method="post">
                        <button type="submit" class="admin-btn" style="width:100%; background: var(--vih-gold); color: var(--vih-green-950);">@Loc["Admin.Applications.ApproveSendPaymentLink"]</button>
                    </form>
                    @if (!Model.IsWaitlisted)
                    {
                        <form asp-action="Waitlist" asp-route-id="@a.Id" method="post">
                            <button type="submit" class="admin-btn admin-btn--ghost" style="width:100%;">@Loc["Admin.Applications.Waitlist"]</button>
                        </form>
                    }
                    <form asp-action="Reject" asp-route-id="@a.Id" method="post" style="display:flex; flex-direction:column; gap:8px;">
                        <textarea name="reason" placeholder="@Loc["Admin.Applications.ReasonOptionalInternal"]" rows="2" style="padding:8px 10px; border:1px solid var(--vih-line-on-light); border-radius:4px; font-family:inherit; font-size:0.8125rem;"></textarea>
                        <button type="submit" class="admin-btn admin-btn--danger" style="width:100%;">@Loc["Admin.Applications.Reject"]</button>
                    </form>
                </div>
            }
            else
            {
                <p style="font-size:0.875rem; color:#666;">
                    @Loc["Admin.Applications.FinalStatus", Loc.Label(a.Status)]
                    @if (a.DecisionAt is not null)
                    {
                        <br />
                        <span>@(Model.ReviewedByEmail is null ? Loc["Admin.Applications.DecidedOn", a.DecisionAt.Value.ToString("dd MMM yyyy")] : Loc["Admin.Applications.DecidedOnBy", a.DecisionAt.Value.ToString("dd MMM yyyy"), Model.ReviewedByEmail])</span>
                    }
                </p>
                @if (!string.IsNullOrWhiteSpace(a.DecisionReason))
                {
                    <p style="font-size:0.8125rem; color:#666;"><strong>@Loc["Admin.Applications.Reason"]</strong> @a.DecisionReason</p>
                }
            }
        </div>

        @if (Model.Invitation is not null)
        {
            var inv = Model.Invitation;
            var isLive = !inv.IsUsed && inv.ExpiresAt >= DateTimeOffset.UtcNow;
            var invitationUrl = Url.Action("Show", "Invitation", new { area = "", code = inv.Code }, Context.Request.Scheme);

            <div class="admin-card">
                <h2>@Loc["Admin.Applications.PaymentLink"]</h2>
                <p style="font-size:0.75rem; color:#999; margin-top:-8px;">
                    @Loc["Admin.Applications.SentToThemByEmailAnd"]
                </p>
                <dl class="admin-detail-list">
                    <div><dt>@Loc["Admin.Common.Status"]</dt><dd>@Loc[inv.IsUsed ? "Admin.Applications.Invite.Used" : inv.ExpiresAt < DateTimeOffset.UtcNow ? "Admin.Applications.Invite.Expired" : "Admin.Applications.Invite.Active"]</dd></div>
                    <div><dt>@Loc["Admin.Applications.Expires"]</dt><dd>@inv.ExpiresAt.ToString("dd MMM yyyy, HH:mm")</dd></div>
                </dl>

                @if (isLive)
                {
                    @* The whole address, not the path: this gets copied into a WhatsApp message or
                       read down the phone, and a bare /invitation/… is no use in either. *@
                    <input value="@invitationUrl" readonly onclick="this.select();"
                           style="width:100%; margin-top:12px; font-family:monospace; font-size:0.72rem; padding:8px 10px; border:1px solid var(--vih-line-on-light); border-radius:6px; background:#faf9f6;" />
                }

                @if (Model.CanResendInvitation)
                {
                    <form asp-action="ResendInvitation" asp-route-id="@a.Id" method="post" style="margin-top:12px;">
                        <button type="submit" class="admin-btn admin-btn--ghost" style="width:100%;">
                            @Loc[isLive ? "Admin.Applications.SendAgain" : "Admin.Applications.IssueNewLink"]
                        </button>
                    </form>
                    <p style="font-size:0.72rem; color:#999; margin-top:8px;">
                        @Loc[string.IsNullOrWhiteSpace(a.Phone) ? "Admin.Applications.SendsEmailOnly" : "Admin.Applications.SendsEmailAndSms"]
                    </p>
                }
            </div>
        }

        @if (Model.Emails.Count > 0 || Model.TextMessages.Count > 0)
        {
            <div class="admin-card">
                <h2>@Loc["Admin.Applications.WhatWeSentThem"]</h2>
                <p style="font-size:0.75rem; color:#999; margin-top:-8px;">
                    @* The answer to "they say they never got it". A Failed row with a gateway error on
                       it and a Sent row plus their own spam folder are very different conversations. *@
                    @Loc["Admin.Applications.DeliveryAttempts"]
                </p>

                <div class="admin-inline-list" style="margin-top:8px;">
                    @foreach (var mail in Model.Emails)
                    {
                        <div class="admin-inline-list__row" style="align-items:flex-start;">
                            <span style="font-size:0.78rem;">
                                <strong>@Loc["Admin.Common.Email"]</strong> · @mail.TemplateKey
                                <div style="font-size:0.72rem; color:#999;">@mail.CreatedAt.ToString("d MMM yyyy HH:mm") · @mail.RecipientEmail</div>
                                @if (mail.Status == EmailStatus.Failed && !string.IsNullOrWhiteSpace(mail.ErrorMessage))
                                {
                                    <div style="font-size:0.72rem; color:var(--vih-danger);">@mail.ErrorMessage</div>
                                }
                            </span>
                            <span class="admin-badge @(mail.Status == EmailStatus.Sent ? "admin-badge--open" : mail.Status == EmailStatus.Failed ? "admin-badge--closed" : "admin-badge--draft")">@Loc.Label(mail.Status)</span>
                        </div>
                    }
                    @foreach (var text in Model.TextMessages)
                    {
                        <div class="admin-inline-list__row" style="align-items:flex-start;">
                            <span style="font-size:0.78rem;">
                                <strong>SMS</strong> · @text.TemplateKey
                                <div style="font-size:0.72rem; color:#999;">@text.CreatedAt.ToString("d MMM yyyy HH:mm") · @text.RecipientPhone</div>
                                @if (text.Status == EmailStatus.Failed && !string.IsNullOrWhiteSpace(text.ErrorMessage))
                                {
                                    <div style="font-size:0.72rem; color:var(--vih-danger);">@text.ErrorMessage</div>
                                }
                            </span>
                            <span class="admin-badge @(text.Status == EmailStatus.Sent ? "admin-badge--open" : text.Status == EmailStatus.Failed ? "admin-badge--closed" : "admin-badge--draft")">@Loc.Label(text.Status)</span>
                        </div>
                    }
                </div>

                @if (!Model.SmsConfigured)
                {
                    <p style="font-size:0.72rem; color:#999; margin-top:10px;">
                        @Loc["Admin.Applications.NoSMSGatewayIsConfiguredSo"] <code>Sms:Enabled</code> @Loc["Admin.Applications.ToSwitchItOn"]
                    </p>
                }
            </div>
        }

        @if (Model.Payment is { } pay)
        {
            <div class="admin-card">
                <h2>@Loc["Admin.Applications.Payment"]</h2>
                <dl class="admin-detail-list">
                    <div><dt>@Loc["Admin.Common.Status"]</dt><dd>@Loc.Label(pay.Status)</dd></div>
                    <div><dt>@Loc["Admin.Common.Amount"]</dt><dd>@MoneyFormatter.Format(pay.AmountMinor, pay.Currency)</dd></div>
                    <div><dt>@Loc["Admin.Common.Created"]</dt><dd>@pay.CreatedAt.ToString("dd MMM yyyy, HH:mm")</dd></div>
                </dl>
                @if (Model.LivePaymentDetails is { } d)
                {
                    <dl class="admin-detail-list" style="margin-top:8px;">
                        <div><dt>@Loc["Admin.Applications.Card"]</dt><dd>@(d.CardBrand is null ? "—" : $"{d.CardBrand} •••• {d.CardLast4}")</dd></div>
                        <div><dt>@Loc["Admin.Applications.ChargeStatus"]</dt><dd>@(d.ChargeStatus ?? "—")</dd></div>
                        <div><dt>@Loc["Admin.Applications.Refunded"]</dt><dd>@(d.Refunded == true ? MoneyFormatter.Format(d.AmountRefundedMinor ?? 0, pay.Currency) : Loc["Admin.Common.No"].Value)</dd></div>
                        @if (!string.IsNullOrWhiteSpace(d.ReceiptUrl))
                        {
                            <div><dt>@Loc["Admin.Applications.Receipt"]</dt><dd><a href="@d.ReceiptUrl" target="_blank" rel="noopener">@Loc["Admin.Applications.ViewReceipt"]</a></dd></div>
                        }
                    </dl>
                }
                else
                {
                    <p style="font-size:0.75rem; color:#999; margin-top:8px;">@Loc["Admin.Applications.CouldnTSyncWithStripeJust"]</p>
                }
                <a class="admin-btn admin-btn--ghost" asp-controller="AdminPayments" asp-action="Details" asp-route-id="@pay.Id" style="margin-top:12px; display:inline-block;">@Loc["Admin.Applications.ViewInPayments"]</a>
            </div>
        }
    </div>
</div>

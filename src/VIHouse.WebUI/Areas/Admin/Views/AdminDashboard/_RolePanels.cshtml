@model AdminDashboardViewModel
@* The panels that belong to one part of the House each. The controller fills a panel only for the
   roles that can open the section behind it, so a null panel is simply not this viewer's job. *@

@if (Model.Events is null && Model.Content is null && Model.Users is null && Model.Marketing is null)
{
    return;
}

<section class="admin-dashboard-grid">
    @if (Model.Events is { } events)
    {
        <article class="admin-card admin-card--elevated" data-reveal>
            <div class="admin-section-heading-wrap">
                <div>
                    <span class="admin-eyebrow">@Loc["Admin.Dashboard.Panel.Programme"]</span>
                    <h2>@Loc["Admin.Dashboard.Panel.ComingUp"]</h2>
                </div>
                <p>
                    @Loc["Admin.Dashboard.Panel.ComingUpIntro"]
                    @if (events.DraftExperiences + events.DraftSessions > 0)
                    {
                        @Loc["Admin.Dashboard.Panel.Drafts", events.DraftExperiences, events.DraftSessions]
                    }
                </p>
            </div>
            @if (events.LiveNow.Count + events.Upcoming.Count == 0)
            {
                <div class="admin-empty">
                    <h3 class="admin-empty__title">@Loc["Admin.Dashboard.Panel.NothingScheduled"]</h3>
                    <p>@Loc["Admin.Dashboard.Panel.NothingScheduledBody"]</p>
                </div>
            }
            else
            {
                <div class="admin-table-scroll">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>@Loc["Admin.Dashboard.Panel.WhenUtc"]</th>
                                <th>@Loc["Admin.Dashboard.Panel.What"]</th>
                                <th>@Loc["Admin.Dashboard.Panel.Attending"]</th>
                                <th>@Loc["Admin.Dashboard.Panel.Stream"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in events.LiveNow.Concat(events.Upcoming))
                            {
                                var isExperience = item.Kind == "Experience";
                                <tr>
                                    <td>@(item.StartAtUtc?.ToString("dd MMM, HH:mm") ?? Loc["Admin.Dashboard.Panel.OnDemand"].Value)</td>
                                    <td>
                                        <a asp-controller="@(isExperience ? "AdminExperiences" : "AdminSeminars")" asp-action="Edit" asp-route-id="@item.Id">@item.Title</a>
                                        <div class="admin-table__sub">@Loc[isExperience ? "Admin.Dashboard.KindExperience" : "Admin.Dashboard.KindSession"] · @item.Status</div>
                                    </td>
                                    <td>@item.Attendees</td>
                                    <td>
                                        @if (item.IsLiveNow)
                                        {
                                            <span class="admin-badge admin-badge--danger">@Loc["Admin.Dashboard.Panel.Live"]</span>
                                        }
                                        else if (item.HasStream)
                                        {
                                            <span class="admin-badge admin-badge--open">@Loc["Admin.Dashboard.Panel.LinkSet"]</span>
                                        }
                                        else
                                        {
                                            <span class="admin-badge admin-badge--draft">@Loc["Admin.Dashboard.Panel.NoLink"]</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </article>
    }

    @if (Model.Content is { } content)
    {
        <article class="admin-card admin-card--elevated" data-reveal data-reveal-delay="60">
            <div class="admin-section-heading-wrap">
                <div>
                    <span class="admin-eyebrow">@Loc["Admin.Dashboard.Panel.Journal"]</span>
                    <h2>@Loc["Admin.Dashboard.Panel.WritingQueue"]</h2>
                </div>
                <p>@Loc["Admin.Dashboard.Panel.WritingCounts", content.Drafts, content.Published] <a asp-controller="AdminJournal" asp-action="Index">@Loc["Admin.Dashboard.Panel.OpenJournal"]</a></p>
            </div>
            @if (content.RecentDrafts.Count == 0)
            {
                <div class="admin-empty">
                    <h3 class="admin-empty__title">@Loc["Admin.Dashboard.Panel.NoDrafts"]</h3>
                    <p>@Loc["Admin.Dashboard.Panel.NoDraftsBody"]</p>
                </div>
            }
            else
            {
                <ul style="list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:8px;">
                    @foreach (var draft in content.RecentDrafts)
                    {
                        <li>
                            <a asp-controller="AdminJournal" asp-action="Edit" asp-route-id="@draft.Id">@draft.Title</a>
                            <span class="admin-table__sub"> — @Loc["Admin.Dashboard.Panel.Edited", draft.UpdatedAt.ToString("dd MMM")]</span>
                        </li>
                    }
                </ul>
            }
        </article>
    }

    @if (Model.Users is { } users)
    {
        <article class="admin-card admin-card--elevated" data-reveal data-reveal-delay="120">
            <div class="admin-section-heading-wrap">
                <div>
                    <span class="admin-eyebrow">@Loc["Admin.Dashboard.Panel.People"]</span>
                    <h2>@Loc["Admin.Dashboard.Panel.MembersAccounts"]</h2>
                </div>
                <p>
                    @Loc["Admin.Dashboard.Panel.PeopleCounts", users.TotalUsers, users.Members, users.Founders]
                    <a asp-controller="AdminUsers" asp-action="Index">@Loc["Admin.Dashboard.Panel.OpenUsers"]</a>
                </p>
            </div>
            <div style="display:flex; gap:8px; flex-wrap:wrap; margin-bottom:12px;">
                <span class="admin-badge admin-badge--info">@Loc["Admin.Dashboard.Panel.NewThisWeek", users.NewSince]</span>
                @if (users.UnconfirmedEmail > 0)
                {
                    <span class="admin-badge admin-badge--pending">@Loc["Admin.Dashboard.Panel.UnconfirmedEmails", users.UnconfirmedEmail]</span>
                }
                @if (users.LockedOut > 0)
                {
                    <span class="admin-badge admin-badge--closed">@Loc["Admin.Dashboard.Panel.LockedCount", users.LockedOut]</span>
                }
            </div>
            @if (users.Newest.Count > 0)
            {
                <div class="admin-table-scroll">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>@Loc["Admin.Dashboard.Panel.NewAccount"]</th>
                                <th>@Loc["Admin.Users.Joined"]</th>
                                <th>@Loc["Admin.Users.Roles"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var u in users.Newest)
                            {
                                <tr>
                                    <td><a asp-controller="AdminUsers" asp-action="Details" asp-route-id="@u.UserId">@(string.IsNullOrWhiteSpace(u.Name) ? u.Email : u.Name)</a></td>
                                    <td>@u.CreatedAt.ToString("dd MMM")</td>
                                    <td>@(u.Roles.Count == 0 ? "—" : string.Join(", ", u.Roles.Select(r => Loc["Admin.Role." + r].Value)))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </article>
    }

    @if (Model.Marketing is { } marketing)
    {
        var windowOpen = marketing.FounderWindowEndsAtUtc is { } end && end > DateTimeOffset.UtcNow;
        <article class="admin-card admin-card--elevated" data-reveal data-reveal-delay="180">
            <div class="admin-section-heading-wrap">
                <div>
                    <span class="admin-eyebrow">@Loc["Admin.Dashboard.Panel.Launch"]</span>
                    <h2>@Loc["Admin.Dashboard.Panel.LaunchFounders"]</h2>
                </div>
                <p><a asp-controller="AdminFounders" asp-action="Index">@Loc["Admin.Dashboard.Panel.FounderProgramme"]</a> · <a asp-controller="AdminNotifySignups" asp-action="Index">@Loc["Admin.Dashboard.Panel.LaunchList"]</a></p>
            </div>
            <dl class="admin-detail-list">
                <div><dt>@Loc["Admin.Dashboard.Panel.LaunchListSignups"]</dt><dd>@marketing.LaunchListSignups</dd></div>
                <div><dt>@Loc["Admin.Dashboard.Panel.Founders"]</dt><dd>@marketing.Founders</dd></div>
                <div>
                    <dt>@Loc["Admin.Dashboard.Panel.FounderWindow"]</dt>
                    <dd>
                        @if (marketing.FounderWindowEndsAtUtc is null)
                        {
                            <span class="admin-badge admin-badge--draft">@Loc["Admin.Dashboard.Panel.NotSet"]</span>
                        }
                        else if (windowOpen)
                        {
                            var daysLeft = (int)Math.Ceiling((marketing.FounderWindowEndsAtUtc.Value - DateTimeOffset.UtcNow).TotalDays);
                            <span class="admin-badge admin-badge--open">@Loc["Admin.Dashboard.Panel.Open"]</span>
                            @Loc["Admin.Dashboard.Panel.ClosesOn", marketing.FounderWindowEndsAtUtc.Value.ToString("dd MMM yyyy"), daysLeft]
                        }
                        else
                        {
                            <span class="admin-badge admin-badge--closed">@Loc["Admin.Dashboard.Panel.Closed"]</span>
                            @marketing.FounderWindowEndsAtUtc.Value.ToString("dd MMM yyyy")
                        }
                    </dd>
                </div>
            </dl>
        </article>
    }
</section>

@using VIHouse.Business.Abstract
@using VIHouse.Entities.Commerce
@using System.Text.Json
@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";

    // Charts read their data from a data-chart-payload attribute rather than an inline <script>,
    // which keeps the page free of injected script and lets the module stay data-agnostic.
    // Amounts are converted to major units here — the same /100 the rest of the panel does via
    // MoneyFormatter — because the chart's axis labels format them as real currency.
    string Payload(IEnumerable<string> labels, IEnumerable<decimal> values, string? currency = null) =>
        JsonSerializer.Serialize(new { labels, values, currency });

    var money = Model.Payments;
    var primaryCurrency = money?.PrimaryCurrency;
    var revenueSeries = primaryCurrency is not null && money!.MonthlyNetByCurrency.TryGetValue(primaryCurrency, out var series) ? series : [];
    var revenuePayload = Payload(revenueSeries.Select(m => m.Label), revenueSeries.Select(m => m.AmountMinor / 100m), primaryCurrency);

    var funnelStatuses = new[]
    {
        ApplicationStatus.Submitted, ApplicationStatus.UnderReview, ApplicationStatus.Shortlisted,
        ApplicationStatus.Approved, ApplicationStatus.PaymentPending, ApplicationStatus.Paid,
        ApplicationStatus.Waitlisted, ApplicationStatus.Rejected,
    };

    var funnelPayload = Payload(
        funnelStatuses.Select(s => s.ToDisplayLabel()),
        funnelStatuses.Select(s => (decimal)Model.ApplicationsByStatus.GetValueOrDefault(s)));

    var bookingsPayload = Payload(
        Model.BookingsByStatus.Keys.Select(s => s.ToString()),
        Model.BookingsByStatus.Values.Select(v => (decimal)v));

    var paymentStatuses = Enum.GetValues<PaymentTransactionStatus>();
    var paymentsPayload = money is null ? "" : Payload(
        paymentStatuses.Select(s => s.ToString()),
        paymentStatuses.Select(s => (decimal)money.CountsByStatus.GetValueOrDefault(s)));

    var approvedApplications = Model.ApplicationsByStatus.GetValueOrDefault(ApplicationStatus.Approved);
    var underReviewApplications = Model.ApplicationsByStatus.GetValueOrDefault(ApplicationStatus.UnderReview)
        + Model.ApplicationsByStatus.GetValueOrDefault(ApplicationStatus.Shortlisted);
    var waitlistedApplications = Model.ApplicationsByStatus.GetValueOrDefault(ApplicationStatus.Waitlisted);
    var confirmedBookings = Model.BookingsByStatus.GetValueOrDefault(BookingStatus.Confirmed);

    string ApplicationBadgeClass(ApplicationStatus status) => status switch
    {
        ApplicationStatus.Approved => "admin-badge admin-badge--open",
        ApplicationStatus.Paid => "admin-badge admin-badge--paid",
        ApplicationStatus.Waitlisted or ApplicationStatus.PaymentPending => "admin-badge admin-badge--pending",
        ApplicationStatus.UnderReview or ApplicationStatus.Shortlisted => "admin-badge admin-badge--info",
        ApplicationStatus.Rejected => "admin-badge admin-badge--closed",
        _ => "admin-badge admin-badge--draft",
    };

    string BookingBadgeClass(BookingStatus status) => status switch
    {
        BookingStatus.Confirmed => "admin-badge admin-badge--open",
        BookingStatus.Pending => "admin-badge admin-badge--pending",
        BookingStatus.Cancelled or BookingStatus.Refunded => "admin-badge admin-badge--closed",
        _ => "admin-badge admin-badge--info",
    };

    string PaymentBadgeClass(PaymentTransactionStatus status) => status switch
    {
        PaymentTransactionStatus.Succeeded => "admin-badge admin-badge--paid",
        PaymentTransactionStatus.Pending or PaymentTransactionStatus.Processing or PaymentTransactionStatus.RequiresAction => "admin-badge admin-badge--pending",
        PaymentTransactionStatus.Failed => "admin-badge admin-badge--danger",
        PaymentTransactionStatus.Canceled or PaymentTransactionStatus.Expired => "admin-badge admin-badge--closed",
        PaymentTransactionStatus.Refunded or PaymentTransactionStatus.PartiallyRefunded => "admin-badge admin-badge--info",
        _ => "admin-badge admin-badge--draft",
    };

    string KindLabel(PaymentTransactionKind kind) => kind switch
    {
        PaymentTransactionKind.Experience => "Experience tickets",
        PaymentTransactionKind.Session => "Session seats",
        PaymentTransactionKind.Membership => "Membership sales",
        PaymentTransactionKind.MembershipRenewal => "Membership renewals",
        _ => kind.ToString(),
    };
}

<section class="admin-dashboard-hero" data-reveal>
    <div class="admin-dashboard-hero__content">
        <span class="admin-eyebrow">Today at a glance@(Model.RoleLabels.Count > 0 ? $" · {string.Join(", ", Model.RoleLabels)}" : "")</span>
        <h2>@(string.IsNullOrWhiteSpace(Model.FirstName) ? "Welcome back." : $"Welcome back, {Model.FirstName}.")</h2>
        <p>This page shows the parts of the House your role looks after — what needs attention first, then how things are trending.</p>
    </div>
    <div class="admin-dashboard-hero__summary">
        @if (Model.CanSeeApplications)
        {
            <div class="admin-dashboard-hero__pill">
                <strong>@Model.TotalApplications</strong>
                <span>Total applications</span>
            </div>
        }
        @if (Model.CanSeeBookings)
        {
            <div class="admin-dashboard-hero__pill">
                <strong>@confirmedBookings</strong>
                <span>Confirmed bookings</span>
            </div>
        }
        @if (Model.Events is { } heroEvents)
        {
            <div class="admin-dashboard-hero__pill">
                <strong>@heroEvents.Upcoming.Count</strong>
                <span>Upcoming in 60 days</span>
            </div>
        }
        @if (Model.Users is { } heroUsers)
        {
            <div class="admin-dashboard-hero__pill">
                <strong>@heroUsers.NewSince</strong>
                <span>New accounts this week</span>
            </div>
        }
        @if (Model.Content is { } heroContent)
        {
            <div class="admin-dashboard-hero__pill">
                <strong>@heroContent.Drafts</strong>
                <span>Draft articles</span>
            </div>
        }
        @if (money is not null)
        {
            <div class="admin-dashboard-hero__pill">
                <strong>@money.CurrentMembers</strong>
                <span>Current members</span>
            </div>
        }
    </div>
 </section>

@if (Model.Comms is { } comms && (comms.SmtpProblems.Count > 0 || comms.FailedEmailsLast7Days > 0))
{
    <div class="admin-status-message admin-status-message--error" data-reveal>
        <strong>Email needs attention.</strong>
        @if (comms.SmtpProblems.Count > 0)
        {
            @comms.SmtpProblems[0]
        }
        @if (comms.FailedEmailsLast7Days > 0)
        {
            @: @comms.FailedEmailsLast7Days email@(comms.FailedEmailsLast7Days == 1 ? "" : "s") failed in the last 7 days (@comms.SentEmailsLast7Days sent).
        }
        <a asp-controller="AdminEmails" asp-action="Index">Open Emails &amp; SMS</a> to send a test and retry.
    </div>
}

@if (Model.Events is { LiveNow.Count: > 0 } live)
{
    <div class="admin-status-message" data-reveal>
        <strong>Live now:</strong>
        @string.Join(" · ", live.LiveNow.Select(i => $"{i.Title} ({i.Kind.ToLowerInvariant()}{(i.HasStream ? ", streaming" : ", no stream link")})"))
    </div>
}

@if (Model.CanSeeApplications || Model.CanSeeBookings || money is not null)
{
<section class="admin-kpi-grid">
    @if (Model.CanSeeApplications)
    {
    <article class="admin-kpi-card" data-reveal data-reveal-delay="40">
        <div class="admin-kpi-card__icon"><partial name="_Icon" model='@("file-text")' /></div>
        <div class="admin-kpi-card__value">@Model.PendingApplications</div>
        <div class="admin-kpi-card__label">Applications awaiting review</div>
        <div class="admin-kpi-card__meta">Needs attention now</div>
    </article>
    }
    @if (Model.CanSeeBookings)
    {
    <article class="admin-kpi-card" data-reveal data-reveal-delay="80">
        <div class="admin-kpi-card__icon"><partial name="_Icon" model='@("calendar")' /></div>
        <div class="admin-kpi-card__value">@Model.TotalBookings</div>
        <div class="admin-kpi-card__label">Total bookings</div>
        <div class="admin-kpi-card__meta">@confirmedBookings confirmed</div>
    </article>
    }
    @if (Model.CanSeeApplications)
    {
    <article class="admin-kpi-card" data-reveal data-reveal-delay="120">
        <div class="admin-kpi-card__icon"><partial name="_Icon" model='@("check")' /></div>
        <div class="admin-kpi-card__value">@Model.ConversionToPaidPercent%</div>
        <div class="admin-kpi-card__label">Application to paid conversion</div>
        <div class="admin-kpi-card__meta">@approvedApplications approved so far</div>
    </article>
    <article class="admin-kpi-card" data-reveal data-reveal-delay="160">
        <div class="admin-kpi-card__icon"><partial name="_Icon" model='@("messages-square")' /></div>
        <div class="admin-kpi-card__value">@underReviewApplications</div>
        <div class="admin-kpi-card__label">Applications in motion</div>
        <div class="admin-kpi-card__meta">@waitlistedApplications waitlisted</div>
    </article>
    }
    @if (money is not null)
    {
        foreach (var c in money.CollectedByCurrency)
        {
            <article class="admin-kpi-card" data-reveal data-reveal-delay="200">
                <div class="admin-kpi-card__icon"><partial name="_Icon" model='@("credit-card")' /></div>
                <div class="admin-kpi-card__value">@MoneyFormatter.Format(c.NetMinor, c.Currency)</div>
                <div class="admin-kpi-card__label">Revenue collected (@c.Currency)</div>
                <div class="admin-kpi-card__meta">
                    @c.Count settled payment@(c.Count == 1 ? "" : "s")@(c.RefundedMinor > 0 ? $" · {MoneyFormatter.Format(c.RefundedMinor, c.Currency)} refunded" : "")
                </div>
            </article>
        }
        <article class="admin-kpi-card" data-reveal data-reveal-delay="240">
            <div class="admin-kpi-card__icon"><partial name="_Icon" model='@("layers")' /></div>
            <div class="admin-kpi-card__value">@money.MembershipSales</div>
            <div class="admin-kpi-card__label">Membership sales</div>
            <div class="admin-kpi-card__meta">@money.MembershipRenewals renewal@(money.MembershipRenewals == 1 ? "" : "s") collected</div>
        </article>
        <article class="admin-kpi-card" data-reveal data-reveal-delay="280">
            <div class="admin-kpi-card__icon"><partial name="_Icon" model='@("activity")' /></div>
            <div class="admin-kpi-card__value">@(money.PendingCount + money.ProcessingCount)</div>
            <div class="admin-kpi-card__label">Payments in flight</div>
            <div class="admin-kpi-card__meta">@money.PendingCount pending · @money.ProcessingCount processing / awaiting action</div>
        </article>
        <article class="admin-kpi-card" data-reveal data-reveal-delay="320">
            <div class="admin-kpi-card__icon"><partial name="_Icon" model='@("credit-card")' /></div>
            <div class="admin-kpi-card__value">@money.FailedCount</div>
            <div class="admin-kpi-card__label">Failed payments</div>
            <div class="admin-kpi-card__meta">@money.CanceledCount cancelled or expired</div>
        </article>
        <article class="admin-kpi-card" data-reveal data-reveal-delay="360">
            <div class="admin-kpi-card__icon"><partial name="_Icon" model='@("tag")' /></div>
            <div class="admin-kpi-card__value">@money.RefundedCount</div>
            <div class="admin-kpi-card__label">Refunds</div>
            <div class="admin-kpi-card__meta">@(money.DisputedCount > 0 ? $"{money.DisputedCount} disputed" : "No open disputes")</div>
        </article>
    }
</section>
}

<partial name="_RolePanels" model="Model" />

@if (Model.CanSeeApplications || Model.CanSeeBookings || money is not null)
{

<section class="admin-chart-grid">
    @if (money is not null)
    {
        <article class="admin-chart-card admin-chart-card--wide" data-reveal>
            <h2>Revenue Collected</h2>
            <span class="admin-chart-card__hint">
                @if (primaryCurrency is not null)
                {
                    @:Last 12 months, net of refunds, @primaryCurrency only — currencies aren't combined.
                }
                else
                {
                    @:Last 12 months.
                }
            </span>
            @if (revenueSeries.Any(m => m.AmountMinor != 0))
            {
                <div class="admin-chart-card__canvas">
                    <canvas data-chart="line" data-chart-payload="@revenuePayload"></canvas>
                </div>
            }
            else
            {
                <div class="admin-chart-empty">No payments collected yet.</div>
            }
        </article>
    }

    @if (Model.CanSeeApplications)
    {
    <article class="admin-chart-card" data-reveal data-reveal-delay="60">
        <h2>Application Funnel</h2>
        <span class="admin-chart-card__hint">Where every application currently sits.</span>
        @if (Model.TotalApplications > 0)
        {
            <div class="admin-chart-card__canvas">
                <canvas data-chart="bar" data-chart-payload="@funnelPayload"></canvas>
            </div>
        }
        else
        {
            <div class="admin-chart-empty">No applications yet.</div>
        }
    </article>
    }

    @if (Model.CanSeeBookings)
    {
    <article class="admin-chart-card" data-reveal data-reveal-delay="120">
        <h2>Bookings by Status</h2>
        <span class="admin-chart-card__hint">Across every experience.</span>
        @if (Model.BookingsByStatus.Count > 0)
        {
            <div class="admin-chart-card__canvas">
                <canvas data-chart="doughnut" data-chart-payload="@bookingsPayload"></canvas>
            </div>
        }
        else
        {
            <div class="admin-chart-empty">No bookings yet.</div>
        }
    </article>
    }

    @if (money is not null)
    {
        <article class="admin-chart-card" data-reveal data-reveal-delay="180">
            <h2>Payments by Status</h2>
            <span class="admin-chart-card__hint">Experience, session and membership payments together.</span>
            @if (money.CountsByStatus.Count > 0)
            {
                <div class="admin-chart-card__canvas">
                    <canvas data-chart="bar" data-chart-payload="@paymentsPayload"></canvas>
                </div>
            }
            else
            {
                <div class="admin-chart-empty">No payments yet.</div>
            }
        </article>
    }
</section>

<section class="admin-dashboard-grid">
    @if (Model.CanSeeApplications)
    {
    <article class="admin-card admin-card--elevated" data-reveal>
        <div class="admin-section-heading-wrap">
            <div>
                <span class="admin-eyebrow">Pipeline health</span>
                <h2>Application funnel</h2>
            </div>
            <p>Color-coded stages make it easy to spot where applications are slowing down.</p>
        </div>
        <div class="admin-table-scroll">
            <table class="admin-table" data-admin-table data-admin-table-per-page="8">
                <thead><tr><th>Status</th><th>Count</th><th>% of Total</th></tr></thead>
                <tbody>
                    @foreach (var status in funnelStatuses)
                    {
                        var count = Model.ApplicationsByStatus.GetValueOrDefault(status);
                        var pct = Model.TotalApplications == 0 ? 0 : Math.Round(count * 100.0 / Model.TotalApplications, 1);
                        <tr>
                            <td>
                                <span class="@ApplicationBadgeClass(status)">@status.ToDisplayLabel()</span>
                            </td>
                            <td>@count</td>
                            <td>@pct%</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </article>
    }

    @if (Model.CanSeeBookings)
    {
    <article class="admin-card admin-card--elevated" data-reveal data-reveal-delay="80">
        <div class="admin-section-heading-wrap">
            <div>
                <span class="admin-eyebrow">Operations status</span>
                <h2>Bookings by status</h2>
            </div>
            <p>Booking states are spaced out for quick scanning during fulfilment and support.</p>
        </div>
        @if (Model.BookingsByStatus.Count == 0)
        {
            <div class="admin-empty">
                <h3 class="admin-empty__title">No bookings yet</h3>
                <p>Once bookings start coming in, this panel will summarise how many are pending, confirmed or closed.</p>
            </div>
        }
        else
        {
            <div class="admin-table-scroll">
                <table class="admin-table" data-admin-table data-admin-table-per-page="8">
                    <thead><tr><th>Status</th><th>Count</th></tr></thead>
                    <tbody>
                        @foreach (var (status, count) in Model.BookingsByStatus.OrderBy(row => row.Key.ToString()))
                        {
                            <tr>
                                <td><span class="@BookingBadgeClass(status)">@status</span></td>
                                <td>@count</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </article>
    }

    @if (money is not null)
    {
        <article class="admin-card admin-card--elevated" data-reveal data-reveal-delay="120">
            <div class="admin-section-heading-wrap">
                <div>
                    <span class="admin-eyebrow">Money by type</span>
                    <h2>Payments by type and currency</h2>
                </div>
                <p>Settled payments only, net of refunds. Each currency stands on its own.</p>
            </div>
            @if (money.CollectedByKindAndCurrency.Count == 0)
            {
                <div class="admin-empty">
                    <h3 class="admin-empty__title">No settled payments yet</h3>
                    <p>Experience, session and membership payments will be broken down here once money has been collected.</p>
                </div>
            }
            else
            {
                <div class="admin-table-scroll">
                    <table class="admin-table" data-admin-table data-admin-table-per-page="12">
                        <thead><tr><th>Type</th><th>Currency</th><th>Payments</th><th>Collected</th><th>Refunded</th><th>Net</th></tr></thead>
                        <tbody>
                            @foreach (var row in money.CollectedByKindAndCurrency)
                            {
                                <tr>
                                    <td>@KindLabel(row.Kind)</td>
                                    <td>@row.Currency</td>
                                    <td>@row.Count</td>
                                    <td>@MoneyFormatter.Format(row.GrossMinor, row.Currency)</td>
                                    <td>@(row.RefundedMinor > 0 ? MoneyFormatter.Format(row.RefundedMinor, row.Currency) : "—")</td>
                                    <td><strong>@MoneyFormatter.Format(row.NetMinor, row.Currency)</strong></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </article>

        <article class="admin-card admin-card--elevated" data-reveal data-reveal-delay="160">
            <div class="admin-section-heading-wrap">
                <div>
                    <span class="admin-eyebrow">Money by state</span>
                    <h2>Payments by status</h2>
                </div>
                <p>Every payment's internal state. <a asp-controller="AdminPayments" asp-action="Index">Open the full list</a> to drill into any of them.</p>
            </div>
            <div class="admin-table-scroll">
                <table class="admin-table" data-admin-table data-admin-table-per-page="12">
                    <thead><tr><th>Status</th><th>Count</th></tr></thead>
                    <tbody>
                        @foreach (var status in paymentStatuses)
                        {
                            <tr>
                                <td><a asp-controller="AdminPayments" asp-action="Index" asp-route-status="@status"><span class="@PaymentBadgeClass(status)">@status</span></a></td>
                                <td>@money.CountsByStatus.GetValueOrDefault(status)</td>
                            </tr>
                        }
                        @foreach (var open in money.OpenByCurrency)
                        {
                            <tr>
                                <td><span class="admin-badge admin-badge--pending">In flight (@open.Currency)</span></td>
                                <td>@MoneyFormatter.Format(open.GrossMinor, open.Currency) across @open.Count</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </article>
    }
</section>
}

@using Microsoft.AspNetCore.Identity
@inject SignInManager<VIHouse.DataAccess.Identity.ApplicationUser> SignInManager
@inject UserManager<VIHouse.DataAccess.Identity.ApplicationUser> UserManager
@inject IConfiguration Configuration
@inject Microsoft.Extensions.Options.IOptions<VIHouse.Business.Options.FeatureOptions> Features
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var currentUser = User.Identity?.IsAuthenticated == true ? await UserManager.GetUserAsync(User) : null;
    var pageTitle = ViewData["Title"]?.ToString() ?? "Admin";

    // What this person may open, in sidebar order — one table drives both the menu and the
    // controllers' [Authorize] attributes, see Areas/Admin/AdminSections.cs.
    var navItems = VIHouse.WebUI.Areas.Admin.AdminSections.VisibleTo(User).ToList();
    var quickActions = VIHouse.WebUI.Areas.Admin.AdminSections.QuickActionsFor(User)
        .Select(q => (Area: "Admin", q.Controller, q.Action, q.Label)).ToList();
    string NavClass(string controllerName) =>
        string.Equals(currentController, controllerName, StringComparison.OrdinalIgnoreCase) ? "admin-sidebar__link active" : "admin-sidebar__link";

    string PageContext() =>
        string.Equals(currentController, "AdminDashboard", StringComparison.OrdinalIgnoreCase) && string.Equals(currentAction, "Index", StringComparison.OrdinalIgnoreCase)
            ? "A live view of applications, bookings, content and revenue."
            : "Fast, guided admin workflows for everyday operations.";

    var activeNav = VIHouse.WebUI.Areas.Admin.AdminSections.Find(currentController);
    var activeNavLabel = activeNav?.Label ?? pageTitle;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - The VI House Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    @* main.css carries the design tokens and the shared .admin-* component styles; admin.css adds
       only what the panel alone needs (rich text editor chrome, dashboard charts). *@
    <link rel="stylesheet" href="~/dist/main.css" asp-append-version="true" />
    @* CKEditor's own theme, from the same CDN as its script below. The .ck-* overrides in
       ClientApp/src/scss/admin.scss are custom-property assignments and apply to it unchanged. *@
    <link rel="stylesheet" href="https://cdn.ckeditor.com/ckeditor5/48.4.0/ckeditor5.css" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/dist/admin.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
@* The CKEditor licence key is host-locked and environment-specific, so it is configuration rather
   than a compiled-in constant. It lives in appsettings.Development.json locally and in
   appsettings.Production.json on the server — both gitignored and untracked, so neither reaches the
   repository. Absent (a GPL deployment, or Production before a commercial key is bought) the editor
   falls back to "GPL" on its own — see ClientApp modules/editor.ts.

   The key is also issued for a distribution *channel*, which is why the editor is loaded from
   CKEditor's CDN below rather than bundled from npm. A key for the "cloud" channel is rejected by
   the npm build (which reports itself as "sh") and the editor goes read-only with a licence error
   while looking, at a glance, like it simply will not accept typing. *@
<body class="admin-shell" data-ckeditor-license="@Configuration["CkEditor:LicenseKey"]">
    <a class="admin-skip-link" href="#admin-content">Skip to content</a>
    <aside class="admin-sidebar">
        <div class="admin-sidebar__top">
            <a class="admin-sidebar__brand" asp-area="Admin" asp-controller="AdminDashboard" asp-action="Index">
                <partial name="_Crest" />
                <span class="admin-sidebar__brand-wordmark">VI House Admin</span>
            </a>
            <button class="admin-sidebar__pin" type="button" data-admin-sidebar-collapse aria-pressed="false" aria-label="Collapse sidebar" title="Collapse sidebar">
                <span class="admin-sidebar__pin-icon" data-admin-sidebar-collapse-icon>
                    <partial name="_Icon" model='@("panel-left-close")' />
                </span>
            </button>
        </div>

        <div class="admin-sidebar__search">
            <label class="admin-searchbar admin-searchbar--sidebar">
                <span class="visually-hidden">Search admin pages</span>
                <span class="admin-searchbar__icon">
                    <partial name="_Icon" model='@("search")' />
                </span>
                <input type="search" data-admin-nav-search placeholder="Search admin pages" aria-label="Search admin pages" />
            </label>
        </div>

        <nav class="admin-sidebar__nav" aria-label="Admin">
            @foreach (var item in navItems)
            {
                <div class="admin-sidebar__item" data-nav-entry>
                    <a class="@NavClass(item.Controller)"
                       data-nav-label="@item.Label"
                       aria-label="@item.Label"
                       aria-current="@(string.Equals(item.Controller, currentController, StringComparison.OrdinalIgnoreCase) ? "page" : null)"
                       asp-area="Admin"
                       asp-controller="@item.Controller"
                       asp-action="@item.Action">
                        <span class="admin-sidebar__icon">
                            <partial name="_Icon" model="@item.Icon" />
                        </span>
                        <span class="admin-sidebar__text">@item.Label</span>
                    </a>
                </div>
            }
        </nav>
        <p class="admin-sidebar__empty" data-admin-nav-empty hidden>No matching admin pages.</p>

        <div class="admin-sidebar__footer">
            <div class="admin-sidebar__profile">
                <span class="admin-sidebar__avatar" aria-hidden="true">@((currentUser?.Email ?? "A")[0].ToString().ToUpperInvariant())</span>
                <div class="admin-sidebar__profile-copy">
                    <strong>@activeNavLabel</strong>
                    <span>@(currentUser?.Email ?? "Admin user")</span>
                </div>
            </div>
            <div class="admin-sidebar__footer-links">
                <a asp-area="" asp-controller="Home" asp-action="Index">
                    <partial name="_Icon" model='@("arrow-up-right")' />
                    <span>View site</span>
                </a>
            </div>
        </div>
    </aside>

    <div class="admin-workspace">
        <header class="admin-topbar" data-reveal>
            <div class="admin-topbar__intro">
                <p class="admin-eyebrow">Admin workspace</p>
                <h1>@pageTitle</h1>
                <p class="admin-topbar__meta">@PageContext()</p>
            </div>
            <div class="admin-topbar__actions">
                <label class="admin-searchbar">
                    <span class="visually-hidden">Jump to an admin page</span>
                    <span class="admin-searchbar__icon">
                        <partial name="_Icon" model='@("search")' />
                    </span>
                    <input type="search" data-admin-nav-search placeholder="Jump to a section" aria-label="Jump to a section" />
                </label>
                <div class="admin-quick-actions">
                    <span class="admin-quick-actions__label">Quick actions</span>
                    <div class="admin-quick-actions__links">
                        @foreach (var action in quickActions)
                        {
                            <a class="admin-btn admin-btn--ghost admin-btn--sm"
                               asp-area="@action.Area"
                               asp-controller="@action.Controller"
                               asp-action="@action.Action">@action.Label</a>
                        }
                    </div>
                </div>
                <details class="admin-user-menu">
                    <summary>
                        <span class="admin-user-menu__avatar" aria-hidden="true">@((currentUser?.Email ?? "A")[0].ToString().ToUpperInvariant())</span>
                        <span class="admin-user-menu__copy">
                            <strong>@(currentUser?.Email ?? "Admin")</strong>
                            <span>@activeNavLabel</span>
                        </span>
                        <span class="admin-user-menu__chevron">
                            <partial name="_Icon" model='@("chevron-down")' />
                        </span>
                    </summary>
                    <div class="admin-user-menu__panel">
                        <a asp-area="" asp-controller="Home" asp-action="Index">Open website</a>
                        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                            <button type="submit">Log out</button>
                        </form>
                    </div>
                </details>
            </div>
        </header>

        <main class="admin-main" id="admin-content">
            <div class="admin-page" data-reveal data-reveal-delay="60">
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @* CKEditor, from the CDN — see the comment above <body> for why it is not in admin.js, and
       ClientApp modules/editor.ts for how it is picked up (window.CKEDITOR).

       Version pinned here and nowhere else: an upgrade is these two URLs. A classic (non-module)
       script runs during parsing while admin.js is a module and therefore deferred, so CKEDITOR is
       always defined by the time the bundle looks for it. If the CDN is unreachable the panel still
       works — every editor stays a plain textarea. *@
    <script src="https://cdn.ckeditor.com/ckeditor5/48.4.0/ckeditor5.umd.js" crossorigin="anonymous"></script>
    <script type="module" src="~/dist/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

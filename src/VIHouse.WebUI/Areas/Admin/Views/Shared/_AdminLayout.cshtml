@using Microsoft.AspNetCore.Identity
@using System.Globalization
@inject SignInManager<VIHouse.DataAccess.Identity.ApplicationUser> SignInManager
@inject UserManager<VIHouse.DataAccess.Identity.ApplicationUser> UserManager
@inject IConfiguration Configuration
@inject Microsoft.Extensions.Options.IOptions<VIHouse.Business.Options.FeatureOptions> Features
@inject VIHouse.Business.Abstract.IJournalService JournalService
@inject VIHouse.Business.Abstract.IAmbassadorService AmbassadorService
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var currentUser = User.Identity?.IsAuthenticated == true ? await UserManager.GetUserAsync(User) : null;
    var pageTitle = ViewData["Title"]?.ToString() ?? Loc["Admin.Shell.Admin"].Value;
    // What this person may open, in sidebar order: one table drives both the menu and the
    // controllers' [Authorize] attributes, see Areas/Admin/AdminSections.cs.
    var navItems = VIHouse.WebUI.Areas.Admin.AdminSections.VisibleTo(User).ToList();
    var quickActions = VIHouse.WebUI.Areas.Admin.AdminSections.QuickActionsFor(User).ToList();
    string NavClass(string controllerName) =>
        string.Equals(currentController, controllerName, StringComparison.OrdinalIgnoreCase) ? "admin-sidebar__link active" : "admin-sidebar__link";
    var activeNav = VIHouse.WebUI.Areas.Admin.AdminSections.Find(currentController);
    var activeNavLabel = activeNav is null ? pageTitle : Loc[activeNav.LabelKey].Value;
    var description = activeNav is null ? null : Loc[activeNav.DescriptionKey];
    var uiCulture = VIHouse.Business.Options.SiteCultures.Describe(CultureInfo.CurrentUICulture.Name);
    var returnUrl = Context.Request.Path + Context.Request.QueryString;

    // Work waiting on someone in this panel, as a count beside the section: influencers' articles
    // for the editors, withdrawal requests for Finance. Asked only of sections this person sees.
    var waiting = new Dictionary<string, int>();
    if (navItems.Any(i => i.Controller == "AdminJournal")) waiting["AdminJournal"] = await JournalService.CountSubmittedAsync();
    if (navItems.Any(i => i.Controller == "AdminWithdrawals")) waiting["AdminWithdrawals"] = await AmbassadorService.CountOpenWithdrawalsAsync();
}
<!DOCTYPE html>
<html lang="@uiCulture.UrlCode">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] - The VI House Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    @* main.css carries the design tokens and the shared .admin-* component styles; admin.css adds
       what only the panel needs (editor chrome, charts, the writer, the publish card). *@
    <link rel="stylesheet" href="~/dist/main.css" asp-append-version="true" />
    @* CKEditor's own theme, from the same CDN as its script below. The .ck-* overrides in
       ClientApp/src/scss/admin.scss are custom-property assignments and apply to it unchanged. *@
    <partial name="/Views/Shared/_CkEditorAssets.cshtml" model='"styles"' />
    <link rel="stylesheet" href="~/dist/admin.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
@* The CKEditor licence key is host-locked and environment-specific, so it is configuration rather
   than a compiled-in constant (appsettings, never committed). Absent, the editor falls back to "GPL"
   on its own; see ClientApp modules/editor.ts. The key is issued for the CDN ("cloud") channel,
   which is why the editor is loaded from CKEditor's CDN below rather than bundled from npm.

   The data-* labels on <body> are for the panel's scripts, which cannot read the .resx files: the
   confirmation dialog, the unsaved-changes guard, the character counters and the editor's language. *@
<body class="admin-shell"
      data-status-error="@(TempData["StatusIsError"] is true ? "true" : null)"
      data-ckeditor-license="@Configuration["CkEditor:LicenseKey"]"
      data-ui-language="@uiCulture.UrlCode"
      data-confirm-title="@Loc["Admin.Confirm.Title"]"
      data-confirm-ok="@Loc["Admin.Confirm.Ok"]"
      data-confirm-cancel="@Loc["Admin.Confirm.Cancel"]"
      data-unsaved="@Loc["Admin.Form.Unsaved"]"
      data-counter-template="@Loc["Admin.Form.Counter"]"
      data-nav-open="@Loc["Admin.Shell.OpenMenu"]"
      data-nav-close="@Loc["Admin.Shell.CloseMenu"]"
      data-table-search="@Loc["Admin.Table.Search"]"
      data-table-per-page="@Loc["Admin.Table.PerPage"]"
      data-table-empty="@Loc["Admin.Table.Empty"]"
      data-table-no-results="@Loc["Admin.Table.NoResults"]"
      data-table-info="@Loc["Admin.Table.Info"]"
      data-table-search-label="@Loc["Admin.Table.SearchLabel"]"
      data-table-search-title="@Loc["Admin.Table.SearchTitle"]"
      data-table-page="@Loc["Admin.Table.Page"]"
      data-table-sort-hint="@Loc["Admin.Table.SortHint"]"
      data-editor-paragraph="@Loc["Admin.Editor.Paragraph"]"
      data-editor-heading="@Loc["Admin.Editor.Heading"]"
      data-editor-subheading="@Loc["Admin.Editor.Subheading"]"
      data-editor-minor="@Loc["Admin.Editor.MinorHeading"]">
    <a class="admin-skip-link" href="#admin-content">@Loc["Admin.Shell.SkipToContent"]</a>
    <aside class="admin-sidebar">
        <div class="admin-sidebar__top">
            <a class="admin-sidebar__brand" asp-area="Admin" asp-controller="AdminDashboard" asp-action="Index">
                <partial name="_Crest" />
                <span class="admin-sidebar__brand-wordmark">VI House Admin</span>
            </a>
            <button class="admin-sidebar__pin" type="button" data-admin-sidebar-collapse aria-pressed="false"
                    aria-label="@Loc["Admin.Shell.CollapseMenu"]" title="@Loc["Admin.Shell.CollapseMenu"]">
                <span class="admin-sidebar__pin-icon" data-admin-sidebar-collapse-icon>
                    <partial name="_Icon" model='@("panel-left-close")' />
                </span>
            </button>
        </div>
        <div class="admin-sidebar__search">
            <label class="admin-searchbar admin-searchbar--sidebar">
                <span class="visually-hidden">@Loc["Admin.Shell.SearchPages"]</span>
                <span class="admin-searchbar__icon">
                    <partial name="_Icon" model='@("search")' />
                </span>
                <input type="search" data-admin-nav-search placeholder="@Loc["Admin.Shell.SearchPages"]" aria-label="@Loc["Admin.Shell.SearchPages"]" />
            </label>
        </div>
        @* Quick actions live in the sidebar on a phone, where the top bar has no room for them. *@
        @if (quickActions.Count > 0)
        {
            <div class="admin-sidebar__quick">
                @foreach (var action in quickActions)
                {
                    <a class="admin-btn admin-btn--ghost admin-btn--sm" asp-area="Admin" asp-controller="@action.Controller" asp-action="@action.Action">+ @Loc[action.LabelKey]</a>
                }
            </div>
        }
        <nav class="admin-sidebar__nav" aria-label="@Loc["Admin.Shell.Admin"]">
            @foreach (var item in navItems)
            {
                var label = Loc[item.LabelKey].Value;
                <div class="admin-sidebar__item" data-nav-entry>
                    @* The search matches the localised label and the English one, so "Journal" still
                       finds Dergi for someone used to the English names. *@
                    <a class="@NavClass(item.Controller)"
                       data-nav-label="@label @item.Label"
                       aria-label="@label"
                       aria-current="@(string.Equals(item.Controller, currentController, StringComparison.OrdinalIgnoreCase) ? "page" : null)"
                       asp-area="Admin"
                       asp-controller="@item.Controller"
                       asp-action="@item.Action">
                        <span class="admin-sidebar__icon">
                            <partial name="_Icon" model="@item.Icon" />
                        </span>
                        <span class="admin-sidebar__text">@label</span>
                        @if (waiting.GetValueOrDefault(item.Controller) is > 0 and var count)
                        {
                            <span class="admin-sidebar__badge" title="@Loc["Admin.Shell.Waiting", count]">@count</span>
                        }
                    </a>
                </div>
            }
        </nav>
        <p class="admin-sidebar__empty" data-admin-nav-empty hidden>@Loc["Admin.Shell.NoMatch"]</p>
        <div class="admin-sidebar__footer">
            <div class="admin-sidebar__profile">
                <span class="admin-sidebar__avatar" aria-hidden="true">@((currentUser?.Email ?? "A")[0].ToString().ToUpperInvariant())</span>
                <div class="admin-sidebar__profile-copy">
                    @* Who is signed in — the section name is already the page's eyebrow. *@
                    <strong>@(string.Join(" ", new[] { currentUser?.FirstName, currentUser?.LastName }.Where(s => !string.IsNullOrWhiteSpace(s))) is { Length: > 0 } fullName ? fullName : Loc["Admin.Shell.Admin"].Value)</strong>
                    <span>@(currentUser?.Email ?? "")</span>
                </div>
            </div>
            <div class="admin-sidebar__footer-links">
                <a asp-area="" asp-controller="Home" asp-action="Index">
                    <partial name="_Icon" model='@("arrow-up-right")' />
                    <span>@Loc["Admin.Shell.ViewSite"]</span>
                </a>
            </div>
        </div>
    </aside>
    <div class="admin-workspace">
        <header class="admin-topbar">
            <div class="admin-topbar__intro">
                <p class="admin-eyebrow">@activeNavLabel</p>
                <h1>@pageTitle</h1>
                @if (description is { ResourceNotFound: false })
                {
                    <p class="admin-topbar__meta">@description</p>
                }
            </div>
            <div class="admin-topbar__actions">
                <label class="admin-searchbar">
                    <span class="visually-hidden">@Loc["Admin.Shell.JumpTo"]</span>
                    <span class="admin-searchbar__icon">
                        <partial name="_Icon" model='@("search")' />
                    </span>
                    <input type="search" data-admin-nav-search placeholder="@Loc["Admin.Shell.JumpTo"]" aria-label="@Loc["Admin.Shell.JumpTo"]" />
                </label>
                @if (quickActions.Count > 0)
                {
                    <div class="admin-quick-actions">
                        <span class="admin-quick-actions__label">@Loc["Admin.Shell.QuickActions"]</span>
                        <div class="admin-quick-actions__links">
                            @foreach (var action in quickActions)
                            {
                                <a class="admin-btn admin-btn--ghost admin-btn--sm" asp-area="Admin" asp-controller="@action.Controller" asp-action="@action.Action">@Loc[action.LabelKey]</a>
                            }
                        </div>
                    </div>
                }
                <details class="admin-user-menu">
                    <summary>
                        <span class="admin-user-menu__avatar" aria-hidden="true">@((currentUser?.Email ?? "A")[0].ToString().ToUpperInvariant())</span>
                        <span class="admin-user-menu__copy">
                            <strong>@(currentUser?.Email ?? "")</strong>
                            <span>@uiCulture.NativeLabel</span>
                        </span>
                        <span class="admin-user-menu__chevron">
                            <partial name="_Icon" model='@("chevron-down")' />
                        </span>
                    </summary>
                    <div class="admin-user-menu__panel">
                        @* The interface language of the panel. Separate from the language tabs on a
                           post or a session, which choose the language of the content. *@
                        <p class="admin-user-menu__label">@Loc["Admin.Shell.InterfaceLanguage"]</p>
                        <div class="admin-user-menu__langs">
                            @foreach (var culture in VIHouse.Business.Options.SiteCultures.All)
                            {
                                <a class="@(culture.Name == uiCulture.Name ? "is-active" : null)"
                                   href="/culture/set?culture=@culture.Name&returnUrl=@Uri.EscapeDataString(returnUrl)"
                                   lang="@culture.UrlCode" aria-current="@(culture.Name == uiCulture.Name ? "true" : null)">@culture.NativeLabel</a>
                            }
                        </div>
                        <p class="admin-user-menu__hint">@Loc["Admin.Shell.InterfaceLanguage.Hint"]</p>
                        <a asp-area="" asp-controller="Home" asp-action="Index">@Loc["Admin.Shell.OpenWebsite"]</a>
                        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                            <button type="submit">@Loc["Admin.Shell.LogOut"]</button>
                        </form>
                    </div>
                </details>
            </div>
        </header>

        <main class="admin-main" id="admin-content">
            <div class="admin-page">
                @* "How this works" for the section, when it has one (Admin.Help.<Controller>.*). *@
                <partial name="_AdminHelp" model="@currentController" />
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @* CKEditor, from the CDN — see _CkEditorAssets for why, and ClientApp modules/editor.ts for how
       it is picked up (window.CKEDITOR). *@
    <partial name="/Views/Shared/_CkEditorAssets.cshtml" model='"scripts"' />
    <script type="module" src="~/dist/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

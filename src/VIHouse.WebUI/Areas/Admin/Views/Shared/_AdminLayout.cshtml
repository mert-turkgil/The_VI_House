@using Microsoft.AspNetCore.Identity
@inject SignInManager<VIHouse.DataAccess.Identity.ApplicationUser> SignInManager
@inject UserManager<VIHouse.DataAccess.Identity.ApplicationUser> UserManager
@inject IConfiguration Configuration
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentUser = User.Identity?.IsAuthenticated == true ? await UserManager.GetUserAsync(User) : null;

    string NavClass(string controllerName) =>
        string.Equals(currentController, controllerName, StringComparison.OrdinalIgnoreCase) ? "admin-sidebar__link active" : "admin-sidebar__link";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - The VI House Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    @* main.css carries the design tokens and the shared .admin-* component styles; admin.css adds
       only what the panel alone needs (rich text editor chrome, dashboard charts). *@
    <link rel="stylesheet" href="~/dist/main.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/dist/admin.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
@* The CKEditor licence key is host-locked and environment-specific, so it is configuration rather
   than a compiled-in constant — and it follows the same policy as the Stripe and SMTP credentials:
   user-secrets in Development, the gitignored appsettings.Production.json on the server, never a
   committed file. Absent (a GPL deployment, or Production before a commercial key is bought) the
   editor falls back to "GPL" on its own — see ClientApp modules/editor.ts. *@
<body class="admin-shell" data-ckeditor-license="@Configuration["CkEditor:LicenseKey"]">
    <aside class="admin-sidebar">
        <a class="admin-sidebar__brand" asp-area="Admin" asp-controller="AdminDashboard" asp-action="Index">
            <partial name="_Crest" />
            <span>VI House Admin</span>
        </a>

        <nav class="admin-sidebar__nav" aria-label="Admin">
            <a class="@NavClass("AdminDashboard")" asp-area="Admin" asp-controller="AdminDashboard" asp-action="Index">Dashboard</a>
            <a class="@NavClass("AdminApplications")" asp-area="Admin" asp-controller="AdminApplications" asp-action="Index">Applications</a>
            <a class="@NavClass("AdminExperiences")" asp-area="Admin" asp-controller="AdminExperiences" asp-action="Index">Experiences</a>
            <a class="@NavClass("AdminMembershipPlans")" asp-area="Admin" asp-controller="AdminMembershipPlans" asp-action="Index">Membership Plans</a>
            <a class="@NavClass("AdminAmbassadors")" asp-area="Admin" asp-controller="AdminAmbassadors" asp-action="Index">Ambassadors</a>
            <a class="@NavClass("AdminBookings")" asp-area="Admin" asp-controller="AdminBookings" asp-action="Index">Bookings</a>
            <a class="@NavClass("AdminPayments")" asp-area="Admin" asp-controller="AdminPayments" asp-action="Index">Payments</a>
            <a class="@NavClass("AdminCms")" asp-area="Admin" asp-controller="AdminCms" asp-action="Index">Content</a>
            <a class="@NavClass("AdminSeminars")" asp-area="Admin" asp-controller="AdminSeminars" asp-action="Index">Sessions</a>
            <a class="@NavClass("AdminJournal")" asp-area="Admin" asp-controller="AdminJournal" asp-action="Index">Journal</a>
            <a class="@NavClass("AdminCommunity")" asp-area="Admin" asp-controller="AdminCommunity" asp-action="Index">Community</a>
            <a class="@NavClass("AdminUsers")" asp-area="Admin" asp-controller="AdminUsers" asp-action="Index">Customers</a>
        </nav>

        <div class="admin-sidebar__footer">
            @if (currentUser is not null)
            {
                <div class="admin-sidebar__user">@currentUser.Email</div>
            }
            <a asp-area="" asp-controller="Home" asp-action="Index">&larr; View site</a>
            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                <button type="submit" style="background:none;border:none;padding:6px 0;color:inherit;font:inherit;cursor:pointer;">Log out</button>
            </form>
        </div>
    </aside>

    <main class="admin-main">
        <div class="admin-header">
            <h1>@ViewData["Title"]</h1>
        </div>
        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script type="module" src="~/dist/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

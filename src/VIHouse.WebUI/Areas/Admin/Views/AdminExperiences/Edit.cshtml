@model AdminExperienceEditViewModel
@{
    ViewData["Title"] = Loc["Admin.Common.EditTitle", Model.Form.Title].Value;
    var experienceId = Model.Form.Id!.Value;
    var active = Model.Translations.First(t => t.Culture.Name == Model.ActiveCulture);
}

@if (TempData["StatusMessage"] is string status)
{
    <div class="admin-status-message">@status</div>
}

<div class="admin-toolbar">
    <a class="admin-btn admin-btn--ghost" asp-area="" asp-controller="Experiences" asp-action="Details"
       asp-route-slug="@Model.Form.Slug" target="_blank" rel="noopener">@Loc["Admin.Experiences.ViewOnTheSite"]</a>
    <a class="admin-btn admin-btn--ghost" asp-action="Index">@Loc["Admin.Experiences.AllExperiences"]</a>
</div>

@* --- Cover -------------------------------------------------------------------------------------- *@
@* Its own multipart form, separate from Details below: a file input inside that form would make
   every save a multipart post, and saving the text fields would then silently re-submit whatever
   file was sitting in the picker. Same arrangement as the hero slide editor. *@
<div class="admin-card" style="margin-bottom:24px;">
    <h2>@Loc["Admin.Experiences.CoverImage"]</h2>
    <p class="admin-hint">
        @Loc["Admin.Experiences.ShownAtTheTopOfThe"]
    </p>

    @if (!string.IsNullOrWhiteSpace(Model.CoverPreviewUrl))
    {
        <img src="@Model.CoverPreviewUrl" alt=""
             style="max-width:420px; width:100%; border-radius:8px; display:block; margin-bottom:12px;" />
    }
    else
    {
        <div class="admin-empty" style="margin-bottom:12px;">
            <p class="admin-empty__title">@Loc["Admin.Experiences.NoCoverYet"]</p>
            <p>@Loc["Admin.Experiences.UploadOneBelowOrTypeA"]</p>
        </div>
    }

    <form asp-action="UploadCover" asp-route-id="@experienceId" method="post" enctype="multipart/form-data"
          class="admin-inline-form">
        <div class="admin-field">
            <label for="cover-file">@Loc["Admin.Experiences.UploadACover"]</label>
            <input id="cover-file" type="file" name="file" accept="image/jpeg,image/png,image/webp,image/avif"
                   required />
        </div>
        <button type="submit" class="admin-btn">@Loc["Admin.Common.Upload"]</button>
    </form>

    @if (Model.HasUploadedCover)
    {
        <form asp-action="RemoveCover" asp-route-id="@experienceId" method="post" style="margin-top:10px;"
              data-confirm="@Loc["Admin.Experiences.RemoveTheUploadedCoverTheFile"]">
            <button type="submit" class="admin-btn admin-btn--danger">@Loc["Admin.Experiences.RemoveUploadedCover"]</button>
        </form>
    }
</div>

@* --- Copy, per language ------------------------------------------------------------------------- *@
@* A page per language rather than four panels on one, matching the seminar and journal editors: the
   URL carries ?culture=de-DE, so a half-written German draft can be bookmarked and handed to
   whoever is actually writing the German. *@
<div class="admin-card" style="margin-bottom:24px;">
    <h2>@Loc["Admin.Experiences.Copy"]</h2>

    <nav class="admin-lang-tabs" aria-label="@Loc["Admin.Experiences.Languages"]">
        @foreach (var tab in Model.Translations)
        {
            <a class="@(tab.Culture.Name == Model.ActiveCulture ? "admin-lang-tab active" : "admin-lang-tab")"
               asp-action="Edit" asp-route-id="@experienceId" asp-route-culture="@tab.Culture.Name">
                @tab.Culture.NativeLabel
                @if (tab.IsDefault)
                {
                    <span class="admin-lang-tab__flag">@Loc["Admin.Experiences.Default"]</span>
                }
                else if (!tab.IsWritten)
                {
                    <span class="admin-lang-tab__flag admin-lang-tab__flag--missing">@Loc["Admin.Experiences.NotTranslated"]</span>
                }
            </a>
        }
    </nav>

    @if (active.IsDefault)
    {
        <p class="admin-hint">
            @Loc["Admin.Experiences.TheEnglishCopyLivesOnThe"]
        </p>
    }
    else if (!active.IsWritten)
    {
        <p class="admin-notice">
            @Loc["Admin.Experiences.NothingWrittenIn", active.Culture.NativeLabel]
        </p>
    }

    <form asp-action="SaveTranslation" asp-route-id="@experienceId" method="post" class="admin-form">
        @* Posted rather than read back from the query string, so a stale tab cannot save English
           words over the German row. *@
        <input type="hidden" name="Culture" value="@active.Culture.Name" />
        <input type="hidden" name="ExperienceId" value="@experienceId" />

        <div class="admin-field">
            <label>@Loc["Admin.Common.Title"]</label>
            <input name="Title" value="@active.Form.Title" maxlength="200" required />
        </div>

        <div class="admin-field">
            <label>@Loc["Admin.Experiences.ShortSummary"]</label>
            <input name="ShortSummary" value="@active.Form.ShortSummary" maxlength="400" />
        </div>

        <div class="admin-field">
            <label>@Loc["Admin.Common.Description"]</label>
            <textarea name="Description" rows="10" data-ckeditor>@active.Form.Description</textarea>
        </div>

        <div class="admin-form__grid">
            <div class="admin-field">
                <label>@Loc["Admin.Experiences.Venue"]</label>
                <input name="Venue" value="@active.Form.Venue" maxlength="200" />
            </div>
            <div class="admin-field">
                <label>@Loc["Admin.Experiences.WhoIsInTheRoomComma"]</label>
                <input name="AudienceTags" value="@active.Form.AudienceTags" maxlength="300" />
            </div>
        </div>

        <div class="admin-form__grid">
            <div class="admin-field">
                <label>@Loc["Admin.Experiences.SEOTitle"]</label>
                <input name="SeoTitle" value="@active.Form.SeoTitle" maxlength="200" />
            </div>
            <div class="admin-field">
                <label>@Loc["Admin.Experiences.CoverImageDescription"]</label>
                <input name="CoverImageAlt" value="@active.Form.CoverImageAlt" maxlength="300" />
            </div>
        </div>

        <div class="admin-field">
            <label>@Loc["Admin.Experiences.SEODescription"]</label>
            <input name="SeoDescription" value="@active.Form.SeoDescription" maxlength="400" />
        </div>

        <div>
            <button type="submit" class="admin-btn">@Loc["Admin.Common.SaveNamed", active.Culture.NativeLabel]</button>
        </div>
    </form>

    @if (!active.IsDefault && active.IsWritten)
    {
        <form asp-action="DeleteTranslation" asp-route-id="@experienceId" method="post" style="margin-top:12px;"
              data-confirm="@Loc["Admin.Experiences.RemoveCopyConfirm", active.Culture.NativeLabel]">
            <input type="hidden" name="culture" value="@active.Culture.Name" />
            <button type="submit" class="admin-btn admin-btn--danger">@Loc["Admin.Experiences.RemoveCopy", active.Culture.NativeLabel]</button>
        </form>
    }
</div>

@* --- Details ------------------------------------------------------------------------------------ *@
<div class="admin-card" style="margin-bottom:24px;">
    <h2>@Loc["Admin.Common.Details"]</h2>
    <form asp-action="Edit" asp-route-id="@experienceId" method="post" class="admin-form">
        <div asp-validation-summary="ModelOnly" class="field-validation-error"></div>
        @{
            ViewData["HasUploadedCover"] = Model.HasUploadedCover;
        }
        <partial name="_FormFields" model="Model.Form" view-data="ViewData" />
        <div>
            <button type="submit" class="admin-btn">@Loc["Admin.Experiences.SaveChanges"]</button>
            <a class="admin-btn admin-btn--ghost" asp-action="Index">@Loc["Admin.Experiences.BackToList"]</a>
        </div>
    </form>
</div>

@* --- Member access ------------------------------------------------------------------------------ *@
<div class="admin-card" style="margin-bottom:24px;">
    <h2>@Loc["Admin.Experiences.MemberAccess"]</h2>
    <p class="admin-hint">
        @Loc["Admin.Experiences.MembersOnATickedPlanJoin"]
    </p>

    @if (Model.MemberAccess.Count == 0)
    {
        <div class="admin-empty">
            <p class="admin-empty__title">@Loc["Admin.Experiences.NoMembershipPlansYet"]</p>
            <p>@Loc["Admin.Experiences.CreateOneUnderMembershipPlansFirst"]</p>
        </div>
    }
    else
    {
        <form asp-action="SetMemberAccess" asp-route-id="@experienceId" method="post" class="admin-form">
            <div class="admin-role-list">
                @foreach (var plan in Model.MemberAccess)
                {
                    <label class="admin-role-option">
                        <input type="checkbox" name="planIds" value="@plan.PlanId" checked="@plan.Admitted" />
                        <span>@plan.Name <span class="admin-table__sub">@plan.PriceLabel</span></span>
                    </label>
                }
            </div>
            <div>
                <button type="submit" class="admin-btn">@Loc["Admin.Experiences.SaveMemberAccess"]</button>
            </div>
        </form>
    }
</div>

@* --- Gallery ------------------------------------------------------------------------------------ *@
<div class="admin-card" style="margin-bottom:24px;">
    <h2>@Loc["Admin.Experiences.Gallery"]</h2>
    <p class="admin-hint">
        @Loc["Admin.Experiences.GalleryHint"]
    </p>

    @if (Model.Gallery.Count == 0)
    {
        <div class="admin-empty">
            <p class="admin-empty__title">@Loc["Admin.Experiences.NoPhotographsYet"]</p>
        </div>
    }
    else
    {
        <div class="admin-media-grid">
            @foreach (var image in Model.Gallery)
            {
                var src = image.StorageKey is null
                    ? image.Url
                    : Url.Action("ExperienceGalleryImage", "Media", new
                    {
                        area = "",
                        id = image.Id,
                        v = (image.UpdatedAt ??
        image.CreatedAt).ToUnixTimeSeconds()
                    });

                <figure class="admin-media-card">
                    <img class="admin-media-card__file" src="@src" alt="" loading="lazy" />

                    <form asp-action="UpdateGalleryImage" asp-route-id="@experienceId" method="post" class="admin-form"
                          style="gap:8px;">
                        <input type="hidden" name="imageId" value="@image.Id" />
                        <div class="admin-field">
                            <label>@Loc["Admin.Experiences.Caption"]</label>
                            <input name="altText" value="@image.AltText" maxlength="300" />
                        </div>
                        <div class="admin-media-card__actions">
                            <button type="submit" class="admin-icon-btn">@Loc["Admin.Common.Save"]</button>
                        </div>
                    </form>

                    <div class="admin-media-card__actions">
                        @* Two single-button forms in a flex row: each is a POST of its own, and left
                           to themselves they would stack because .admin-inline-form is block-level. *@
                        <form asp-action="MoveGalleryImage" asp-route-id="@experienceId" method="post">
                            <input type="hidden" name="imageId" value="@image.Id" />
                            <input type="hidden" name="delta" value="-1" />
                            <button type="submit" class="admin-icon-btn" aria-label="@Loc["Admin.Experiences.MoveEarlier"]">&uarr;</button>
                        </form>
                        <form asp-action="MoveGalleryImage" asp-route-id="@experienceId" method="post">
                            <input type="hidden" name="imageId" value="@image.Id" />
                            <input type="hidden" name="delta" value="1" />
                            <button type="submit" class="admin-icon-btn" aria-label="@Loc["Admin.Experiences.MoveLater"]">&darr;</button>
                        </form>
                        <form asp-action="RemoveGalleryImage" asp-route-id="@experienceId" method="post"
                              data-confirm="@Loc["Admin.Experiences.RemoveThisPhotograph"]">
                            <input type="hidden" name="imageId" value="@image.Id" />
                            <button type="submit" class="admin-icon-btn" style="color:var(--vih-danger);">@Loc["Admin.Common.Remove"]</button>
                        </form>
                    </div>
                </figure>
            }
        </div>
    }

    <form asp-action="AddGalleryImage" asp-route-id="@experienceId" method="post" enctype="multipart/form-data"
          class="admin-inline-form" style="margin-top:16px;">
        <div class="admin-field">
            <label for="gallery-file">@Loc["Admin.Common.Upload"]</label>
            <input id="gallery-file" type="file" name="file" accept="image/jpeg,image/png,image/webp,image/avif" />
        </div>
        <div class="admin-field">
            <label for="gallery-url">@Loc["Admin.Experiences.OrAPathAlreadyOnThe"]</label>
            <input id="gallery-url" name="url" placeholder="/img/gallery/dinner-1600.jpg" />
        </div>
        <div class="admin-field" style="flex:2;">
            <label for="gallery-alt">@Loc["Admin.Experiences.Caption"]</label>
            <input id="gallery-alt" name="altText" maxlength="300"
                   placeholder="@Loc["Admin.Experiences.ALongTableSetForA"]" />
        </div>
        <button type="submit" class="admin-btn">@Loc["Admin.Common.Add"]</button>
    </form>
</div>

@* --- Programme ---------------------------------------------------------------------------------- *@
@* These three lists are scoped to the language tab above. They are not translations of each other
   row for row — what is included reads as a different number of lines in different languages — so a
   row belongs to a language, and the public page shows the set for the reader's, falling back to
   English when a language has none. *@
<div class="admin-card" style="margin-bottom:24px;">
    <h2>@Loc["Admin.Experiences.Programme"] <span class="admin-lang-chip admin-lang-chip--on">@active.Culture.ShortLabel</span></h2>
    <p class="admin-hint">
        @Loc["Admin.Experiences.ProgrammeHint", active.Culture.NativeLabel, Model.Form.TimeZoneId]
    </p>

    @foreach (var day in Model.ProgramDays.Where(d => d.Culture == Model.ActiveCulture))
    {
        <div class="admin-panel" style="margin-bottom:16px;">
            <div class="admin-panel__note">
                <strong>@Loc["Admin.Experiences.DayN", day.DayNumber]</strong> — @day.Title
                @if (!string.IsNullOrWhiteSpace(day.DateLabel))
                {
                    <span class="admin-table__sub">@day.DateLabel</span>
                }
            </div>

            <div class="admin-inline-list">
                @foreach (var session in day.Sessions.OrderBy(s => s.StartTime))
                {
                    <div class="admin-inline-list__row">
                        <span>
                            <strong>@session.StartTime.ToString(@"hh\:mm")–@session.EndTime.ToString(@"hh\:mm")</strong>
                            @session.Title
                            @if (!string.IsNullOrWhiteSpace(session.SpeakerName))
                            {
                                <span class="admin-table__sub">@session.SpeakerName</span>
                            }
                        </span>
                        <form asp-action="RemoveSession" asp-route-id="@experienceId" method="post">
                            <input type="hidden" name="sessionId" value="@session.Id" />
                            <button type="submit" class="admin-icon-btn" style="color:var(--vih-danger);">@Loc["Admin.Common.Remove"]</button>
                        </form>
                    </div>
                }
            </div>

            <form asp-action="AddSession" asp-route-id="@experienceId" method="post" class="admin-inline-form">
                <input type="hidden" name="dayId" value="@day.Id" />
                <div class="admin-field"><label>@Loc["Admin.Experiences.From"]</label><input type="time" name="startTime" required /></div>
                <div class="admin-field"><label>@Loc["Admin.Experiences.To"]</label><input type="time" name="endTime" required /></div>
                <div class="admin-field" style="flex:2;"><label>@Loc["Admin.Experiences.Session"]</label><input name="title" required /></div>
                <div class="admin-field"><label>@Loc["Admin.Experiences.Speaker"]</label><input name="speakerName" /></div>
                <button type="submit" class="admin-btn">@Loc["Admin.Experiences.AddSession"]</button>
            </form>

            <form asp-action="RemoveProgramDay" asp-route-id="@experienceId" method="post" style="margin-top:10px;"
                  data-confirm="@Loc["Admin.Experiences.RemoveThisDayAndAllOf"]">
                <input type="hidden" name="dayId" value="@day.Id" />
                <button type="submit" class="admin-icon-btn" style="color:var(--vih-danger);">@Loc["Admin.Experiences.RemoveDayN", day.DayNumber]</button>
                </form>
            </div>
        }

        <form asp-action="AddProgramDay" asp-route-id="@experienceId" method="post" class="admin-inline-form">
            <input type="hidden" name="culture" value="@active.Culture.Name" />
            <div class="admin-field"><label>@Loc["Admin.Experiences.DayNumber"]</label><input type="number" name="dayNumber" min="1"
                                                                         value="@(Model.ProgramDays.Count + 1)" required /></div>
                <div class="admin-field" style="flex:2;"><label>@Loc["Admin.Common.Title"]</label><input name="title"
                                                                                        placeholder="@Loc["Admin.Experiences.ArrivalAndOpeningDinner"]" required /></div>
                    <div class="admin-field"><label>@Loc["Admin.Experiences.DateLabel"]</label><input name="dateLabel" placeholder="@Loc["Admin.Experiences.Thursday17September"]" />
                    </div>
                    <button type="submit" class="admin-btn">@Loc["Admin.Experiences.AddDay"]</button>
                </form>
            </div>

            @* --- Ticket types ------------------------------------------------------------------------------- *@
            <div class="admin-card" style="margin-bottom:24px;">
                <h2>@Loc["Admin.Experiences.TicketTypes"]</h2>

                @if (Model.TicketTypes.Count == 0)
                {
                    <div class="admin-empty">
                        <p class="admin-empty__title">@Loc["Admin.Experiences.NoTicketTypesYet"]</p>
                    </div>
                }

                @foreach (var t in Model.TicketTypes)
                {
                    <div class="admin-panel" style="margin-bottom:12px;">
                        <form asp-action="UpdateTicketType" asp-route-id="@experienceId" method="post" class="admin-form">
                            <input type="hidden" name="Id" value="@t.Id" />
                            <div class="admin-form__grid">
                                <div class="admin-field"><label>@Loc["Admin.Common.Title"]</label><input name="Title" value="@t.Title" required /></div>
                                <div class="admin-field"><label>@Loc["Admin.Experiences.PriceMinorUnits"]</label><input name="PriceMinor" type="number"
                                                                                                      min="0" value="@t.PriceMinor" required /></div>
                                    <div class="admin-field"><label>@Loc["Admin.Common.Currency"]</label><input name="Currency" value="@t.Currency" maxlength="3"
                                                                                               required /></div>
                                        <div class="admin-field"><label>@Loc["Admin.Experiences.MaxPerOrder"]</label><input name="MaxQuantityPerOrder" type="number"
                                                                                                        min="1" value="@t.MaxQuantityPerOrder" /></div>
                                            <div class="admin-field"><label>@Loc["Admin.Experiences.Order"]</label><input name="SortOrder" type="number"
                                                                                                    value="@t.SortOrder" /></div>
                                            </div>
                                            <div class="admin-field"><label>@Loc["Admin.Common.Description"]</label><input name="Description" value="@t.Description" /></div>
                                            <div class="admin-field"><label>@Loc["Admin.Experiences.Perks"]</label><textarea name="PerksText" rows="2">@t.PerksText</textarea>
                                            </div>

                                            @* Inventory is shown but not editable: it is the no-oversell counter, moved only by
                   the atomic reservation. A number typed here from a stale page would undo sales. *@
                                            <p class="admin-field__hint">@Loc["Admin.Experiences.PlacesLeft", t.Inventory]</p>

                                                <div class="admin-panel__actions">
                                                    <button type="submit" class="admin-btn">@Loc["Admin.Experiences.SaveTicketType"]</button>
                                                </div>
                                            </form>

                                            <form asp-action="RemoveTicketType" method="post" data-confirm="@Loc["Admin.Experiences.RemoveThisTicketType"]">
                                                <input type="hidden" name="experienceId" value="@experienceId" />
                                                <input type="hidden" name="ticketTypeId" value="@t.Id" />
                                                <button type="submit" class="admin-icon-btn" style="color:var(--vih-danger);">@Loc["Admin.Common.Remove"]</button>
                                            </form>
                                        </div>
                                    }

                                    <form asp-action="AddTicketType" method="post" class="admin-inline-form">
                                        <input type="hidden" name="ExperienceId" value="@experienceId" />
                                        <div class="admin-field"><label>@Loc["Admin.Common.Title"]</label><input name="Title" placeholder="Standard Experience" required />
                                        </div>
                                        <div class="admin-field"><label>@Loc["Admin.Experiences.PriceMinorUnits"]</label><input name="PriceMinor" type="number" min="0"
                                                                                                              required /></div>
                                            <div class="admin-field"><label>@Loc["Admin.Common.Currency"]</label><input name="Currency" value="GBP" maxlength="3" required />
                                            </div>
                                            <div class="admin-field"><label>@Loc["Admin.Experiences.Inventory"]</label><input name="Inventory" type="number" min="0" required /></div>
                                            <button type="submit" class="admin-btn">@Loc["Admin.Common.Add"]</button>
                                        </form>
                                    </div>

                                    @* --- Included / Not included -------------------------------------------------------------------- *@
                                    <div class="admin-card" style="margin-bottom:24px;">
                                        <h2>@Loc["Admin.Experiences.IncludedNotIncluded"] <span class="admin-lang-chip admin-lang-chip--on">@active.Culture.ShortLabel</span></h2>

                                        @foreach (var i in Model.Inclusions.Where(i => i.Culture == Model.ActiveCulture))
                                        {
                                            <form asp-action="UpdateInclusion" asp-route-id="@experienceId" method="post" class="admin-inline-form">
                                                <input type="hidden" name="inclusionId" value="@i.Id" />
                                                <div class="admin-field" style="flex:3;"><label>@Loc["Admin.Experiences.Text"]</label><input name="text" value="@i.Text" required /></div>
                                                <div class="admin-field admin-field--checkbox">
                                                    <input type="checkbox" name="isIncluded" value="true" checked="@i.IsIncluded" />
                                                    <label>@Loc["Admin.Experiences.Included"]</label>
                                                </div>
                                                <div class="admin-field"><label>@Loc["Admin.Experiences.Order"]</label><input name="sortOrder" type="number" value="@i.SortOrder" /></div>
                                                <button type="submit" class="admin-icon-btn">@Loc["Admin.Common.Save"]</button>
                                            </form>
                                            <form asp-action="RemoveInclusion" method="post" style="margin:-8px 0 12px;">
                                                <input type="hidden" name="experienceId" value="@experienceId" />
                                                <input type="hidden" name="inclusionId" value="@i.Id" />
                                                <button type="submit" class="admin-icon-btn" style="color:var(--vih-danger);">@Loc["Admin.Common.Remove"]</button>
                                            </form>
                                        }

                                        <form asp-action="AddInclusion" method="post" class="admin-inline-form">
                                            <input type="hidden" name="ExperienceId" value="@experienceId" />
                                            <input type="hidden" name="Culture" value="@active.Culture.Name" />
                                            <div class="admin-field" style="flex:3;"><label>@Loc["Admin.Experiences.Text"]</label><input name="Text" required /></div>
                                            <div class="admin-field admin-field--checkbox"><input type="checkbox" name="IsIncluded" value="true"
                                                                                                      checked /><label>@Loc["Admin.Experiences.Included"]</label></div>
                                                <button type="submit" class="admin-btn">@Loc["Admin.Common.Add"]</button>
                                            </form>
                                        </div>

                                        @* --- FAQ ---------------------------------------------------------------------------------------- *@
                                        <div class="admin-card" style="margin-bottom:24px;">
                                            <h2>@Loc["Admin.Experiences.FAQ"] <span class="admin-lang-chip admin-lang-chip--on">@active.Culture.ShortLabel</span></h2>

                                            @foreach (var f in Model.Faqs.Where(f => f.Culture == Model.ActiveCulture))
                                            {
                                                <div class="admin-panel" style="margin-bottom:12px;">
                                                    <form asp-action="UpdateFaq" asp-route-id="@experienceId" method="post" class="admin-form">
                                                        <input type="hidden" name="faqId" value="@f.Id" />
                                                        <div class="admin-field"><label>@Loc["Admin.Experiences.Question"]</label><input name="question" value="@f.Question" required /></div>
                                                        <div class="admin-field"><label>@Loc["Admin.Experiences.Answer"]</label><textarea name="answer" rows="3" required>@f.Answer</textarea>
                                                        </div>
                                                        <div class="admin-field"><label>@Loc["Admin.Experiences.Order"]</label><input name="sortOrder" type="number" value="@f.SortOrder" />
                                                        </div>
                                                        <div class="admin-panel__actions">
                                                            <button type="submit" class="admin-btn">@Loc["Admin.Common.Save"]</button>
                                                        </div>
                                                    </form>
                                                    <form asp-action="RemoveFaq" method="post">
                                                        <input type="hidden" name="experienceId" value="@experienceId" />
                                                        <input type="hidden" name="faqId" value="@f.Id" />
                                                        <button type="submit" class="admin-icon-btn" style="color:var(--vih-danger);">@Loc["Admin.Common.Remove"]</button>
                                                    </form>
                                                </div>
                                            }

                                            <form asp-action="AddFaq" method="post" class="admin-inline-form">
                                                <input type="hidden" name="ExperienceId" value="@experienceId" />
                                                <input type="hidden" name="Culture" value="@active.Culture.Name" />
                                                <div class="admin-field" style="flex:2;"><label>@Loc["Admin.Experiences.Question"]</label><input name="Question" required /></div>
                                                <div class="admin-field" style="flex:3;"><label>@Loc["Admin.Experiences.Answer"]</label><input name="Answer" required /></div>
                                                <button type="submit" class="admin-btn">@Loc["Admin.Common.Add"]</button>
                                            </form>
                                        </div>

                                        @* --- Waitlist ----------------------------------------------------------------------------------- *@
                                        <div class="admin-card" style="margin-bottom:24px;">
                                            <h2>@Loc["Admin.Experiences.Waitlist"] <span class="admin-lang-chip">@Model.Waitlist.Count</span></h2>
                                            <p class="admin-hint">
                                                @Loc["Admin.Experiences.PeopleWhoSignedUpWhileThis"] <strong>@Loc["Admin.Experiences.Waitlist"]</strong>@Loc["Admin.Experiences.PositionsAreNotRenumberedWhenYou"]
                                            </p>

                                            @if (Model.Waitlist.Count == 0)
                                            {
                                                <div class="admin-empty">
                                                    <p class="admin-empty__title">@Loc["Admin.Experiences.NobodyIsWaiting"]</p>
                                                    <p>@Loc["Admin.Experiences.SetTheStatusToWaitlistAnd"]</p>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="admin-table-scroll">
                                                    <table class="admin-table">
                                                        <thead>
                                                            <tr>
                                                                <th scope="col">#</th>
                                                                <th scope="col">@Loc["Admin.Common.Name"]</th>
                                                                <th scope="col">@Loc["Admin.Common.Email"]</th>
                                                                <th scope="col">@Loc["Admin.Experiences.Joined"]</th>
                                                                <th scope="col"></th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var entry in Model.Waitlist)
                                                            {
                                                                <tr>
                                                                    <td>@entry.Position</td>
                                                                    <td>@entry.FullName</td>
                                                                    @* mailto so reaching out is one click, which is the entire point of
                               having captured the address. *@
                                                                    <td><a href="mailto:@entry.Email">@entry.Email</a></td>
                                                                    <td>@entry.CreatedAt.ToLocalTime().ToString("d MMM yyyy, HH:mm")</td>
                                                                    <td>
                                                                        <form asp-action="RemoveWaitlistEntry" method="post">
                                                                            <input type="hidden" name="experienceId" value="@experienceId" />
                                                                            <input type="hidden" name="entryId" value="@entry.Id" />
                                                                            <button type="submit" class="admin-icon-btn"
                                                                                    style="color:var(--vih-danger);">@Loc["Admin.Common.Remove"]</button>
                                                                        </form>
                                                                    </td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            }
                                        </div>

                                        @* --- Notify ------------------------------------------------------------------------------------- *@
                                        <div class="admin-card">
                                            <h2>@Loc["Admin.Experiences.NotifyAttendees"]</h2>
                                            <p class="admin-hint">@Loc["Admin.Experiences.SendsAnInPortalNotificationTo"]</p>
                                            <form asp-action="NotifyAttendees" method="post" class="admin-form">
                                                <input type="hidden" name="ExperienceId" value="@experienceId" />
                                                <div class="admin-form__grid">
                                                    <div class="admin-field">
                                                        <label>@Loc["Admin.Common.Type"]</label>
                                                        <select name="Type">
                                                            <option value="EventUpdate">@Loc["Admin.Experiences.EventUpdate"]</option>
                                                            <option value="NewSchedule">@Loc["Admin.Experiences.NewSchedule"]</option>
                                                        </select>
                                                    </div>
                                                    <div class="admin-field">
                                                        <label>@Loc["Admin.Common.Title"]</label>
                                                        <input name="Title" maxlength="200" required />
                                                    </div>
                                                </div>
                                                <div class="admin-field">
                                                    <label>@Loc["Admin.Experiences.Body"]</label>
                                                    <textarea name="Body" rows="3" maxlength="1000" required></textarea>
                                                </div>
                                                <button type="submit" class="admin-btn">@Loc["Admin.Experiences.NotifyAttendees"]</button>
                                            </form>
                                        </div>

                                        @section Scripts {
                                            <partial name="_ValidationScriptsPartial" />
                                        }

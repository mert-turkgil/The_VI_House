@model List<AdminExperienceListItemViewModel>
@{
    ViewData["Title"] = "Experiences";
}

@if (TempData["StatusMessage"] is string status)
{
    <div class="admin-status-message">@status</div>
}

<div class="admin-toolbar">
    <a class="admin-btn" asp-action="Create">+ New Experience</a>
</div>

@if (Model.Count == 0)
{
    <p>No experiences yet.</p>
}
else
{
    <table class="admin-table">
        <thead>
            <tr>
                <th>Title</th>
                <th>Location</th>
                <th>Starts</th>
                <th>Status</th>
                <th>Tickets</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in Model)
            {
                var badgeClass = e.Status switch
                {
                    VIHouse.Entities.Experiences.ExperienceStatus.ApplicationsOpen => "admin-badge admin-badge--open",
                    VIHouse.Entities.Experiences.ExperienceStatus.Draft => "admin-badge admin-badge--draft",
                    VIHouse.Entities.Experiences.ExperienceStatus.ApplicationsClosed or VIHouse.Entities.Experiences.ExperienceStatus.Completed => "admin-badge admin-badge--closed",
                    _ => "admin-badge",
                };
                <tr>
                    <td><a asp-action="Edit" asp-route-id="@e.Id">@e.Title</a></td>
                    <td>@e.City, @e.Country</td>
                    <td>@e.StartAtUtc.ToString("dd MMM yyyy")</td>
                    <td><span class="@badgeClass">@e.Status.ToDisplayLabel()</span></td>
                    <td>@e.TicketTypeCount</td>
                    <td>
                        <form asp-action="Delete" asp-route-id="@e.Id" method="post" onsubmit="return confirm('Delete this experience?');" style="display:inline;">
                            <button type="submit" class="admin-btn admin-btn--danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

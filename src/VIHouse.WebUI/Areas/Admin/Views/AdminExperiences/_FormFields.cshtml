@model AdminExperienceFormViewModel

<div class="admin-form__grid">
    <div class="admin-field">
        <label asp-for="Title"></label>
        <input asp-for="Title" />
        <span asp-validation-for="Title" class="field-validation-error"></span>
    </div>
    <div class="admin-field">
        <label asp-for="Slug"></label>
        <input asp-for="Slug" placeholder="izmir-founder-experience-2026" />
        <span asp-validation-for="Slug" class="field-validation-error"></span>
    </div>
</div>

<div class="admin-field">
    <label asp-for="ShortSummary"></label>
    <input asp-for="ShortSummary" />
</div>

<div class="admin-field">
    <label asp-for="Description"></label>
    <textarea asp-for="Description" rows="10" data-ckeditor></textarea>
    <span asp-validation-for="Description" class="field-validation-error"></span>
</div>

<div class="admin-form__grid">
    <div class="admin-field">
        <label asp-for="City"></label>
        <input asp-for="City" />
        <span asp-validation-for="City" class="field-validation-error"></span>
    </div>
    <div class="admin-field">
        <label asp-for="Country"></label>
        <input asp-for="Country" placeholder="GB" maxlength="2" />
        <span asp-validation-for="Country" class="field-validation-error"></span>
    </div>
    <div class="admin-field">
        <label asp-for="Venue"></label>
        <input asp-for="Venue" />
    </div>
    <div class="admin-field">
        <label asp-for="TimeZoneId"></label>
        <input asp-for="TimeZoneId" placeholder="Europe/London" />
    </div>
</div>

<div class="admin-form__grid">
    <div class="admin-field">
        <label asp-for="StartAtUtc"></label>
        <input asp-for="StartAtUtc" type="datetime-local" />
        <span asp-validation-for="StartAtUtc" class="field-validation-error"></span>
    </div>
    <div class="admin-field">
        <label asp-for="EndAtUtc"></label>
        <input asp-for="EndAtUtc" type="datetime-local" />
        <span asp-validation-for="EndAtUtc" class="field-validation-error"></span>
    </div>
    <div class="admin-field">
        <label asp-for="Capacity"></label>
        <input asp-for="Capacity" type="number" />
    </div>
    <div class="admin-field">
        <label asp-for="MemberDiscountPercent"></label>
        <input asp-for="MemberDiscountPercent" type="number" min="0" max="100" />
        <p class="admin-field__hint">@Loc["Admin.Experiences.PercentageOffEveryTicketForCurrent"]</p>
        <span asp-validation-for="MemberDiscountPercent" class="field-validation-error"></span>
    </div>
    <div class="admin-field">
        <label asp-for="MembersOpenAtUtc"></label>
        <input asp-for="MembersOpenAtUtc" type="datetime-local" />
        <p class="admin-field__hint">When members whose plan is admitted may join. Empty = straight away. Founders get in earlier by the early-access days set under Founders.</p>
    </div>
</div>

<div class="admin-form__grid">
    <div class="admin-field">
        <label asp-for="Status"></label>
        <select asp-for="Status"
                asp-items="Loc.Options<VIHouse.Entities.Experiences.ExperienceStatus>()"></select>
    </div>
    <div class="admin-field">
        <label asp-for="Visibility"></label>
        <select asp-for="Visibility"
                asp-items="Loc.Options<VIHouse.Entities.Experiences.ExperienceVisibility>()"></select>
        <p class="admin-field__hint">
            @Loc["Admin.Experiences.MembersOnlySignedInMembersWith"]
        </p>
    </div>
    <div class="admin-field">
        <label asp-for="AttendanceMode"></label>
        <select asp-for="AttendanceMode"
                asp-items="Loc.Options<VIHouse.Entities.Experiences.ExperienceAttendanceMode>()"></select>
        <p class="admin-field__hint">@Loc["Admin.Experiences.WhenBothAreAllowedWhoeverJoins"]</p>
        </div>
    </div>

    <div class="admin-form__grid">
        <div class="admin-field">
            <label asp-for="MeetingUrl"></label>
            <input asp-for="MeetingUrl" type="url" placeholder="https://zoom.us/j/…" />
            <p class="admin-field__hint">@Loc["Admin.Experiences.OnlineBothOnlyShownToConfirmed"]</p>
            <span asp-validation-for="MeetingUrl" class="field-validation-error"></span>
        </div>
        <div class="admin-field">
            <label asp-for="LiveStreamUrl"></label>
            <input asp-for="LiveStreamUrl" type="url" placeholder="https://www.youtube.com/watch?v=…" />
            <p class="admin-field__hint">@Loc["Admin.Experiences.AYouTubeLiveOrPremiereEmbedded"]</p>
            <span asp-validation-for="LiveStreamUrl" class="field-validation-error"></span>
        </div>
    </div>

    @{
        // The Cover image panel above this form owns the upload. When one exists it wins outright, so the
        // path box is disabled rather than left looking editable while changing nothing.
        var hasUpload = (ViewData["HasUploadedCover"] as bool?) ?? false;
    }

    <div class="admin-form__grid">
        <div class="admin-field">
            <label asp-for="CoverImageUrl"></label>
            <input asp-for="CoverImageUrl" disabled="@hasUpload" />
            <p class="admin-field__hint">
                @Loc[hasUpload ? "Admin.Experiences.CoverUploadInUse" : "Admin.Experiences.CoverPathHint"]
            </p>
        </div>
        <div class="admin-field">
            <label asp-for="CoverImageAlt"></label>
            <input asp-for="CoverImageAlt" />
            <p class="admin-field__hint">@Loc["Admin.Experiences.UsuallyLeaveThisEmptyTheHeading"]</p>
            </div>
        </div>

        <div class="admin-field">
            <label asp-for="AudienceTags"></label>
            <input asp-for="AudienceTags" placeholder="@Loc["Admin.Experiences.FoundersOperatorsInvestors"]" />
            <p class="admin-field__hint">@Loc["Admin.Experiences.RenderedAsTheChipsUnderWho"]</p>
        </div>

        <div class="admin-form__grid">
            <div class="admin-field">
                <label asp-for="ApplicationOpenAt"></label>
                <input asp-for="ApplicationOpenAt" type="datetime-local" />
            </div>
            <div class="admin-field">
                <label asp-for="ApplicationCloseAt"></label>
                <input asp-for="ApplicationCloseAt" type="datetime-local" />
            </div>
            <div class="admin-field">
                <label asp-for="SalesOpenAt"></label>
                <input asp-for="SalesOpenAt" type="datetime-local" />
            </div>
            <div class="admin-field">
                <label asp-for="SalesCloseAt"></label>
                <input asp-for="SalesCloseAt" type="datetime-local" />
            </div>
        </div>

        <div class="admin-form__grid">
            <div class="admin-field">
                <label asp-for="SeoTitle"></label>
                <input asp-for="SeoTitle" />
            </div>
            <div class="admin-field">
                <label asp-for="SortOrder"></label>
                <input asp-for="SortOrder" type="number" />
            </div>
        </div>

        <div class="admin-field">
            <label asp-for="SeoDescription"></label>
            <input asp-for="SeoDescription" />
        </div>

        <div class="admin-field">
            <label asp-for="SeoOgImageUrl"></label>
            <input asp-for="SeoOgImageUrl" />
            <p class="admin-field__hint">@Loc["Admin.Experiences.UsedWhenALinkToThis"]</p>
            </div>

            <div class="admin-field admin-field--checkbox">
                <input asp-for="IsSignature" />
                <label asp-for="IsSignature"></label>
            </div>

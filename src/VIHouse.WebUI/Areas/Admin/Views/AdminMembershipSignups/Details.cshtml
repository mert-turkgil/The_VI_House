@model AdminMembershipSignupDetailViewModel
@{
    var j = Model.Join;
    ViewData["Title"] = $"{j.FirstName} {j.LastName}";
    var address = new[] { j.AddressLine1, j.AddressLine2, string.Join(" ", new[] { j.PostalCode, j.City }.Where(x => !string.IsNullOrWhiteSpace(x))), Countries.NameFor(j.Country) }
        .Where(x => !string.IsNullOrWhiteSpace(x)).ToList();
    string Or(string? v) => string.IsNullOrWhiteSpace(v) ? "—" : v;
}

<div class="admin-toolbar" style="justify-content: space-between; align-items: center;">
    <span class="@(j.Status == PendingJoinStatus.Paid ? "admin-badge admin-badge--open" : "admin-badge admin-badge--draft")" style="font-size:0.75rem;">
        @Loc.Label(j.Status)
    </span>
    <a class="admin-btn admin-btn--ghost" asp-action="Index">@Loc["Admin.MembershipSignups.BackToSignUps"]</a>
</div>

@if (j.PurgedAt is { } purged)
{
    <div class="admin-status-message">
        @Loc["Admin.MembershipSignups.Purged", purged.ToLocalTime().ToString("d MMM yyyy")]
    </div>
}

<div class="admin-review-grid">
    <div class="admin-review-main">
        <div class="admin-card">
            <h2>@Loc["Admin.MembershipSignups.Applicant"]</h2>
            <dl class="admin-detail-list">
                <div><dt>@Loc["Admin.Common.Name"]</dt><dd>@j.FirstName @j.LastName</dd></div>
                <div><dt>@Loc["Admin.Common.Email"]</dt><dd><a href="mailto:@j.Email">@j.Email</a></dd></div>
                <div><dt>@Loc["Admin.Common.Phone"]</dt><dd>@Or(j.Phone)</dd></div>
                <div><dt>@Loc["Admin.MembershipSignups.TitleProfession"]</dt><dd>@Or(j.JobTitle)</dd></div>
                <div><dt>@Loc["Admin.MembershipSignups.Address"]</dt><dd>@if (address.Count == 0) { <text>—</text> } else { foreach (var line in address) { @line<br /> } }</dd></div>
                <div><dt>@Loc["Admin.MembershipSignups.AnnualEarnings"]</dt><dd>@(VIHouse.Entities.Users.EarningsBand.LabelFor(j.EarningsBand) ?? "—")</dd></div>
                <div><dt>@Loc["Admin.Common.Language"]</dt><dd>@SiteCultures.Describe(j.PreferredCulture).NativeLabel</dd></div>
            </dl>
        </div>

        <div class="admin-card">
            <h2>@Loc["Admin.MembershipSignups.InTheirWords"]</h2>
            <p><strong>@Loc["Admin.MembershipSignups.About"]</strong><br /><span style="white-space:pre-line;">@Or(j.About)</span></p>
            <p><strong>@Loc["Admin.MembershipSignups.Expectations"]</strong><br /><span style="white-space:pre-line;">@Or(j.Expectations)</span></p>
        </div>
    </div>

    <div class="admin-review-side">
        <div class="admin-card">
            <h2>@Loc["Admin.MembershipSignups.Membership"]</h2>
            <dl class="admin-detail-list">
                <div><dt>@Loc["Admin.MembershipSignups.Plan"]</dt><dd>@Model.PlanName</dd></div>
                <div><dt>@Loc["Admin.MembershipSignups.PromoCode"]</dt><dd>@Or(Model.PromoCode)</dd></div>
                <div><dt>@Loc["Admin.MembershipSignups.ReferralCode"]</dt><dd>@Or(j.ReferralCode)</dd></div>
                <div><dt>@Loc["Admin.MembershipSignups.FormSent"]</dt><dd>@j.CreatedAt.ToLocalTime().ToString("d MMM yyyy, HH:mm")</dd></div>
                <div><dt>@Loc["Admin.MembershipSignups.Paid"]</dt><dd>@(j.PaidAt?.ToLocalTime().ToString("d MMM yyyy, HH:mm") ?? "—")</dd></div>
            </dl>
            @* Only offered to roles that can open the Users section, so the link never ends in "access denied". *@
            @if (Model.AccountId is { } accountId && AdminSections.Find("AdminUsers")?.IsVisibleTo(User) == true)
            {
                <p style="margin-top:12px;">
                    <a class="admin-btn admin-btn--ghost admin-btn--sm" asp-controller="AdminUsers" asp-action="Details" asp-route-id="@accountId">@Loc["Admin.MembershipSignups.OpenAccount"]</a>
                </p>
                @if (!Model.AccountEverSignedIn)
                {
                    <p class="admin-hint" style="margin:8px 0 0;">@Loc["Admin.MembershipSignups.TheyHavenTSignedInYet"]</p>
                }
            }
        </div>
    </div>
</div>

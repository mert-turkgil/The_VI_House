@model AdminMembershipSignupsViewModel
@{
    ViewData["Title"] = Loc["Admin.Nav.AdminMembershipSignups"].Value;

    string FilterClass(PendingJoinStatus? s) => Model.Status == s ? "admin-btn" : "admin-btn admin-btn--ghost";
    string Badge(PendingJoinStatus s) => s switch
    {
        PendingJoinStatus.Paid => "admin-badge admin-badge--open",
        PendingJoinStatus.Pending => "admin-badge admin-badge--draft",
        _ => "admin-badge",
    };
    
    // Built by hand: "page" is a reserved route value, so asp-route-page gives an empty href.
    string PageHref(int n) => Url.Action("Index") + "?" + (Model.Status is { } st ? $"status={st}&" : "") + $"page={n}";
}

<p class="admin-hint">
    @Loc["Admin.MembershipSignups.Intro", Model.PaidCount]
</p>

<div class="admin-toolbar">
    <a class="@FilterClass(null)" asp-action="Index">@Loc["Admin.MembershipSignups.All"]</a>
    <a class="@FilterClass(PendingJoinStatus.Paid)" asp-action="Index" asp-route-status="@PendingJoinStatus.Paid">@Loc["Admin.MembershipSignups.Paid"]</a>
    <a class="@FilterClass(PendingJoinStatus.Pending)" asp-action="Index" asp-route-status="@PendingJoinStatus.Pending">@Loc["Admin.MembershipSignups.NotPaidYet"]</a>
    <a class="@FilterClass(PendingJoinStatus.Expired)" asp-action="Index" asp-route-status="@PendingJoinStatus.Expired">@Loc["Admin.MembershipSignups.Expired"]</a>
</div>

@if (Model.Rows.Count == 0)
{
    <p class="admin-empty">@Loc[Model.Status is null ? "Admin.MembershipSignups.Empty" : "Admin.MembershipSignups.EmptyForStatus"]</p>
}
else
{
    <div class="admin-table-scroll">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>@Loc["Admin.MembershipSignups.When"]</th>
                    <th>@Loc["Admin.Common.Name"]</th>
                    <th>@Loc["Admin.Common.Email"]</th>
                    <th>@Loc["Admin.MembershipSignups.Plan"]</th>
                    <th>@Loc["Admin.Common.Country"]</th>
                    <th>@Loc["Admin.Common.Status"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td style="font-size:0.75rem; white-space:nowrap;">@row.CreatedAt.ToLocalTime().ToString("d MMM yyyy HH:mm")</td>
                        <td>@row.FirstName @row.LastName</td>
                        <td><a href="mailto:@row.Email">@row.Email</a></td>
                        <td>@(Model.PlanNames.TryGetValue(row.PlanId, out var plan) ? plan : "—")</td>
                        <td>@Countries.NameFor(row.Country)</td>
                        <td><span class="@Badge(row.Status)">@Loc.Label(row.Status)</span></td>
                        <td class="admin-table__actions"><a class="admin-icon-btn" asp-action="Details" asp-route-id="@row.Id">@Loc["Admin.MembershipSignups.ViewForm"]</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="admin-toolbar" style="margin-top:16px;">
        @if (Model.HasPrevious)
        {
            <a class="admin-btn admin-btn--ghost" href="@PageHref(Model.Page - 1)">@Loc["Admin.MembershipSignups.Newer"]</a>
        }
        <span class="admin-hint" style="margin:0;">@Loc["Admin.MembershipSignups.PageOf", Model.Page, Model.TotalPages, Model.TotalCount]</span>
        @if (Model.HasNext)
        {
            <a class="admin-btn admin-btn--ghost" href="@PageHref(Model.Page + 1)">@Loc["Admin.MembershipSignups.Older"]</a>
        }
    </div>
}

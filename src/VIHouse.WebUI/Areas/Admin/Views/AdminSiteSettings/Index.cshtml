@model AdminSiteSettingsViewModel
@{
    ViewData["Title"] = Loc["Admin.Nav.AdminSiteSettings"].Value;
    var active = Model.Translations.First(t => t.Culture.Name == Model.ActiveCulture);
    Model.CultureOgImageUrls.TryGetValue(active.Culture.Name, out var activeOgImage);
}

@if (TempData["StatusMessage"] is string status)
{
    <div class="admin-status-message">@status</div>
}

<p class="admin-hint">
    @Loc["Admin.SiteSettings.Intro"]
</p>

@* --- The thing that makes all of this work ---------------------------------------------------- *@
<div class="admin-notice">
    <strong>@Loc["Admin.SiteSettings.EveryPageNowHasOneURL"]</strong>
    @Loc.Html("Admin.SiteSettings.UrlNotice", LocalizerHtml.Code("/experiences"), LocalizerHtml.Code("/de/experiences"), LocalizerHtml.Code("/tr/experiences"), LocalizerHtml.Code("/et/experiences"))
</div>

<div class="admin-stat-row">
    <div class="admin-stat">
        <span class="admin-stat__value">@Model.SitemapPageCount</span>
        <span class="admin-stat__label">@Loc["Admin.SiteSettings.PagesInTheSitemap"]</span>
    </div>
    <div class="admin-stat">
        <span class="admin-stat__value">@Model.SitemapUrlCount</span>
        <span class="admin-stat__label">@Loc["Admin.SiteSettings.URLsOnceLanguagesAreCounted"]</span>
    </div>
    <a class="admin-stat" href="/sitemap.xml" target="_blank" rel="noopener">
        <span class="admin-stat__value">XML</span>
        <span class="admin-stat__label">@Loc["Admin.SiteSettings.ViewSitemapXml"]</span>
    </a>
    <a class="admin-stat" href="/robots.txt" target="_blank" rel="noopener">
        <span class="admin-stat__value">TXT</span>
        <span class="admin-stat__label">@Loc["Admin.SiteSettings.ViewRobotsTxt"]</span>
    </a>
    <a class="admin-stat" href="/llms.txt@(Model.ActiveCulture == SiteCultures.Default ? "" : "?lang=" + SiteCultures.Describe(Model.ActiveCulture).UrlCode)" target="_blank" rel="noopener">
        <span class="admin-stat__value">LLM</span>
        <span class="admin-stat__label">@Loc["Admin.SiteSettings.ViewLlms", SiteCultures.Describe(Model.ActiveCulture).NativeLabel] &rarr;</span>
    </a>
</div>
@if (Model.ComingSoonOn)
{
    <div class="admin-notice">
        @Loc.Html("Admin.SiteSettings.ComingSoonOn", LocalizerHtml.Code("/coming-soon"))
    </div>
}
<p class="admin-hint">@Loc["Admin.SiteSettings.ChangesHereOnThePagesList"]</p>

@* --- Per-language copy -------------------------------------------------------------------------
   Page-per-language rather than tab panels, following the experience and seminar editors: the URL
   is shareable, so a half-written German draft can be handed to whoever writes the German. *@
<div class="admin-card" style="margin-bottom:24px;">
    <h2>@Loc["Admin.SiteSettings.WhatTheSiteSaysAboutItself"]</h2>

    <div class="admin-lang-tabs">
        @foreach (var tab in Model.Translations)
        {
            <a class="admin-lang-chip @(tab.Culture.Name == Model.ActiveCulture ? "admin-lang-chip--on" : "")"
               asp-action="Index" asp-route-culture="@tab.Culture.Name">
                @tab.Culture.NativeLabel
                @if (!tab.IsWritten)
                {
                    <span title="@Loc["Admin.SiteSettings.NotWrittenYetFallsBackTo"]">&bull;</span>
                }
            </a>
        }
    </div>

    @* Plain name/value rather than asp-for. These inputs bind to AdminSiteSettingsTranslationForm,
       which is not this view's model, and the input tag helper derives the posted name from the
       expression it is given — so asp-for would have posted "active.Form.SiteName" and every field
       would have arrived null. *@
    <form asp-action="SaveTranslation" method="post" class="admin-form">
        <input type="hidden" name="SiteSettingId" value="@active.Form.SiteSettingId" />
        <input type="hidden" name="Culture" value="@active.Form.Culture" />

        <div class="admin-form__grid">
            <div class="admin-field">
                <label for="SiteName">@Loc["Admin.SiteSettings.SiteName"]</label>
                <input id="SiteName" name="SiteName" value="@active.Form.SiteName" maxlength="120" required />
                <span class="admin-hint">@Loc["Admin.SiteSettings.UsuallyTheSameInEveryLanguage"]</span>
            </div>

            <div class="admin-field">
                <label for="TitleTemplate">@Loc["Admin.SiteSettings.TitleTemplate"]</label>
                <input id="TitleTemplate" name="TitleTemplate" value="@active.Form.TitleTemplate" maxlength="120" required />
                <span class="admin-hint">
                    @Loc.Html("Admin.SiteSettings.TitleTemplateHint", LocalizerHtml.Code("{0}"))
                </span>
            </div>
        </div>

        <div class="admin-field">
            <label for="HomeTitle">@Loc["Admin.SiteSettings.HomepageTitle"]</label>
            <input id="HomeTitle" name="HomeTitle" value="@active.Form.HomeTitle" maxlength="200" />
            <span class="admin-hint">
                @Loc["Admin.SiteSettings.UsedAsIsWithoutTheTemplate"]
            </span>
        </div>

        <div class="admin-field">
            <label for="DefaultMetaDescription">@Loc["Admin.SiteSettings.DefaultDescription"]</label>
            <textarea id="DefaultMetaDescription" name="DefaultMetaDescription" rows="2" maxlength="320">@active.Form.DefaultMetaDescription</textarea>
            <span class="admin-hint">
                @Loc["Admin.SiteSettings.TheSentenceUnderTheBlueLink"]
            </span>
        </div>

        <div class="admin-field">
            <label for="OrganizationDescription">@Loc["Admin.SiteSettings.WhatTheOrganisationIs"]</label>
            <textarea id="OrganizationDescription" name="OrganizationDescription" rows="2" maxlength="500">@active.Form.OrganizationDescription</textarea>
            <span class="admin-hint">@Loc["Admin.SiteSettings.OneLineDescribingTheHouseItself"]</span>
        </div>

        <div class="admin-field">
            <label for="LlmsNotes">@Loc["Admin.SiteSettings.NotesForAIAssistantsLlmsTxt"]</label>
            <textarea id="LlmsNotes" name="LlmsNotes" rows="6" maxlength="4000">@active.Form.LlmsNotes</textarea>
            <span class="admin-hint">
                @Loc["Admin.SiteSettings.LlmsNotesHint"]
            </span>
        </div>

        <div class="admin-field">
            <label for="OgImageAlt">@Loc["Admin.SiteSettings.SocialImageDescription"]</label>
            <input id="OgImageAlt" name="OgImageAlt" value="@active.Form.OgImageAlt" maxlength="300" />
        </div>

        <div class="admin-field">
            <label for="OgImageUrl">@Loc["Admin.SiteSettings.SocialImageURLForThisLanguage"]</label>
            <input id="OgImageUrl" name="OgImageUrl" value="@active.Form.OgImageUrl" maxlength="500"
                   placeholder="@Loc["Admin.SiteSettings.OptionalOnlyWhenThisLanguageNeeds"]" />
            <span class="admin-hint">
                @Loc["Admin.SiteSettings.OgImageHint", active.Culture.NativeLabel]
            </span>
        </div>

        <button type="submit" class="admin-btn">@Loc["Admin.Common.SaveNamed", active.Culture.NativeLabel]</button>
    </form>

    @* Per-language social image upload, its own form so it cannot clobber the copy above. *@
    <div class="admin-panel" style="margin-top:16px;">
        <h3>@Loc["Admin.SiteSettings.SocialImageFor", active.Culture.NativeLabel]</h3>

        @if (!string.IsNullOrWhiteSpace(activeOgImage))
        {
            <img src="@activeOgImage" alt="" style="max-width:320px;display:block;margin-bottom:8px;border-radius:8px;" />
            <form asp-action="RemoveOgImage" method="post" style="display:inline;">
                <input type="hidden" name="culture" value="@active.Culture.Name" />
                <button type="submit" class="admin-icon-btn" style="color:var(--vih-danger);">@Loc["Admin.Common.Remove"]</button>
            </form>
        }

        <form asp-action="UploadOgImage" method="post" enctype="multipart/form-data" class="admin-inline-form">
            <input type="hidden" name="culture" value="@active.Culture.Name" />
            <div class="admin-field" style="flex:2;">
                <label>@Loc["Admin.SiteSettings.Upload1200630WorksEverywhere"]</label>
                <input type="file" name="file" accept="image/*" required />
            </div>
            <button type="submit" class="admin-btn">@Loc["Admin.Common.Upload"]</button>
        </form>
    </div>
</div>

@* --- Per-page search titles and descriptions ------------------------------------------------------ *@
<div class="admin-card" id="pages" style="margin-bottom:24px;">
    <h2>@Loc["Admin.SiteSettings.PagesFor", active.Culture.NativeLabel]</h2>
    <p class="admin-hint" style="margin-top:0;">
        @Loc["Admin.SiteSettings.PagesHint", active.Culture.NativeLabel]
    </p>
    <form asp-action="SavePages" method="post" class="admin-form">
        <input type="hidden" name="culture" value="@active.Culture.Name" />
        <table class="admin-table admin-table--compact">
            <thead><tr><th style="width:130px;">@Loc["Admin.SiteSettings.Page"]</th><th>@Loc["Admin.Common.Title"]</th><th>@Loc["Admin.Common.Description"]</th></tr></thead>
            <tbody>
                @foreach (var p in Model.Pages)
                {
                    <tr>
                        <td><strong>@p.Label</strong><div class="admin-table__sub"><a href="@(VIHouse.Business.SiteUrls.InCulture(p.Path, active.Culture.Name))" target="_blank" rel="noopener">@p.Path</a></div></td>
                        <td>
                            <input name="Pages[@p.Key].Title" value="@p.Title" maxlength="120" placeholder="@p.DefaultTitle" data-count="60" style="width:100%;" />
                        </td>
                        <td>
                            <textarea name="Pages[@p.Key].Description" rows="2" maxlength="320" placeholder="@(p.DefaultDescription ?? Loc["Admin.SiteSettings.DefaultDescriptionAbove"].Value)" data-count="155" style="width:100%;">@p.Description</textarea>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <button type="submit" class="admin-btn" style="margin-top:12px;">@Loc["Admin.SiteSettings.SavePages", active.Culture.NativeLabel]</button>
    </form>
</div>

<script>
    // A live character count under each field, amber past Google's visible length.
    document.querySelectorAll('#pages [data-count]').forEach(function (field) {
        var limit = parseInt(field.getAttribute('data-count'), 10);
        var note = document.createElement('span');
        note.className = 'admin-hint';
        note.style.display = 'block';
        field.insertAdjacentElement('afterend', note);
        var update = function () {
            var n = field.value.length;
            note.textContent = n === 0 ? 'Using the built-in wording' : n + ' / ~' + limit;
            note.style.color = n > limit ? 'var(--vih-warning, #b7791f)' : '';
        };
        field.addEventListener('input', update);
        update();
    });
</script>

@* --- Everything that is the same in every language --------------------------------------------- *@
<form asp-action="Index" method="post" class="admin-form">
    <input type="hidden" name="culture" value="@Model.ActiveCulture" />

    <div class="admin-card" style="margin-bottom:24px;">
        <h2>@Loc["Admin.SiteSettings.Identity"]</h2>

        <div class="admin-form__grid">
            <div class="admin-field">
                <label asp-for="Form.CanonicalBaseUrl"></label>
                <input asp-for="Form.CanonicalBaseUrl" placeholder="https://thevihouse.com" />
                <span asp-validation-for="Form.CanonicalBaseUrl" class="admin-error"></span>
                <span class="admin-hint">
                    @Loc["Admin.SiteSettings.EveryAbsoluteAddressTheSitePublishes"]
                </span>
            </div>

            <div class="admin-field">
                <label asp-for="Form.OrganizationType"></label>
                <select asp-for="Form.OrganizationType">
                    <option value="Organization">Organization</option>
                    <option value="LocalBusiness">LocalBusiness</option>
                    <option value="EventVenue">EventVenue</option>
                    <option value="Corporation">Corporation</option>
                </select>
                <span class="admin-hint">@Loc["Admin.SiteSettings.OnlyChangeThisIfYouKnow"]</span>
            </div>

            <div class="admin-field">
                <label asp-for="Form.LegalName"></label>
                <input asp-for="Form.LegalName" />
            </div>

            <div class="admin-field">
                <label asp-for="Form.FoundingDate"></label>
                <input asp-for="Form.FoundingDate" placeholder="2024" />
            </div>
        </div>
    </div>

    <div class="admin-card" style="margin-bottom:24px;">
        <h2>@Loc["Admin.SiteSettings.SocialAccounts"]</h2>
        <p class="admin-hint">
            @Loc.Html("Admin.SiteSettings.SameAsHint", LocalizerHtml.Code("sameAs"))
        </p>

        <div class="admin-form__grid">
            <div class="admin-field"><label asp-for="Form.InstagramUrl"></label><input asp-for="Form.InstagramUrl" placeholder="https://instagram.com/..." /></div>
            <div class="admin-field"><label asp-for="Form.LinkedInUrl"></label><input asp-for="Form.LinkedInUrl" placeholder="https://linkedin.com/company/..." /></div>
            <div class="admin-field"><label asp-for="Form.XUrl"></label><input asp-for="Form.XUrl" placeholder="https://x.com/..." /></div>
            <div class="admin-field"><label asp-for="Form.FacebookUrl"></label><input asp-for="Form.FacebookUrl" /></div>
            <div class="admin-field"><label asp-for="Form.YouTubeUrl"></label><input asp-for="Form.YouTubeUrl" /></div>
            <div class="admin-field"><label asp-for="Form.TikTokUrl"></label><input asp-for="Form.TikTokUrl" /></div>

            <div class="admin-field">
                <label asp-for="Form.TwitterHandle"></label>
                <input asp-for="Form.TwitterHandle" placeholder="thevihouse" />
                <span class="admin-hint">@Loc["Admin.SiteSettings.TwitterHint"]</span>
            </div>
        </div>
    </div>

    <div class="admin-card" style="margin-bottom:24px;">
        <h2>@Loc["Admin.SiteSettings.ContactAndAddress"]</h2>
        <p class="admin-hint">
            @Loc["Admin.SiteSettings.PublishedAsStructuredDataWorthFilling"]
        </p>

        <div class="admin-form__grid">
            <div class="admin-field"><label asp-for="Form.ContactEmail"></label><input asp-for="Form.ContactEmail" /></div>
            <div class="admin-field"><label asp-for="Form.ContactPhone"></label><input asp-for="Form.ContactPhone" placeholder="+44 20 7000 0000" /></div>
            <div class="admin-field"><label asp-for="Form.StreetAddress"></label><input asp-for="Form.StreetAddress" /></div>
            <div class="admin-field"><label asp-for="Form.AddressLocality"></label><input asp-for="Form.AddressLocality" placeholder="London" /></div>
            <div class="admin-field"><label asp-for="Form.AddressRegion"></label><input asp-for="Form.AddressRegion" /></div>
            <div class="admin-field"><label asp-for="Form.PostalCode"></label><input asp-for="Form.PostalCode" /></div>
            <div class="admin-field">
                <label asp-for="Form.AddressCountry"></label>
                <input asp-for="Form.AddressCountry" placeholder="GB" maxlength="2" />
                <span asp-validation-for="Form.AddressCountry" class="admin-error"></span>
            </div>
        </div>
    </div>

    <div class="admin-card" style="margin-bottom:24px;">
        <h2>@Loc["Admin.SiteSettings.SearchVisibility"]</h2>

        <div class="admin-field admin-field--check">
            <label>
                <input asp-for="Form.AllowIndexing" type="checkbox" />
                @Loc["Admin.SiteSettings.AllowSearchEnginesToIndexThis"]
            </label>
            <span class="admin-hint">
                <strong>@Loc["Admin.SiteSettings.TheMasterSwitch"]</strong> @Loc.Html("Admin.SiteSettings.IndexingOffHint", LocalizerHtml.Code("Disallow: /"), LocalizerHtml.Code("noindex"))
            </span>
        </div>

        <div class="admin-field admin-field--check">
            <label>
                <input asp-for="Form.PublishLlmsTxt" type="checkbox" />
                @Loc["Admin.SiteSettings.PublishLlmsTxt"]
            </label>
            <span class="admin-hint">
                @Loc["Admin.SiteSettings.APlainLanguageIndexOfThe"]
            </span>
        </div>

        <div class="admin-form__grid">
            <div class="admin-field">
                <label asp-for="Form.GoogleSiteVerification"></label>
                <input asp-for="Form.GoogleSiteVerification" />
                <span class="admin-hint">
                    @Loc.Html("Admin.SiteSettings.VerificationHint", LocalizerHtml.Code("<meta>"))
                </span>
            </div>

            <div class="admin-field">
                <label asp-for="Form.BingSiteVerification"></label>
                <input asp-for="Form.BingSiteVerification" />
            </div>
        </div>

        <div class="admin-field">
            <label asp-for="Form.RobotsExtra"></label>
            <textarea asp-for="Form.RobotsExtra" rows="4"
                      placeholder="Disallow: /some-path&#10;Crawl-delay: 5"></textarea>
            <span class="admin-hint">
                @Loc["Admin.SiteSettings.AddedToRobotsTxtAsWritten"]
            </span>
        </div>
    </div>

    <button type="submit" class="admin-btn">@Loc["Admin.SiteSettings.SaveSettings"]</button>
</form>

@* --- Images that are the same in every language ------------------------------------------------ *@
<div class="admin-card" style="margin-top:24px;">
    <h2>@Loc["Admin.SiteSettings.DefaultSocialImage"]</h2>
    <p class="admin-hint">
        @Loc.Html("Admin.SiteSettings.DefaultImageHint", LocalizerHtml.Strong("1200×630"))
    </p>

    @if (!string.IsNullOrWhiteSpace(Model.OgImagePreviewUrl))
    {
        <img src="@Model.OgImagePreviewUrl" alt="" style="max-width:400px;display:block;margin-bottom:8px;border-radius:8px;" />
        @if (Model.HasUploadedOgImage)
        {
            <form asp-action="RemoveOgImage" method="post" style="display:inline;">
                <button type="submit" class="admin-icon-btn" style="color:var(--vih-danger);">@Loc["Admin.Common.Remove"]</button>
            </form>
        }
    }

    <form asp-action="UploadOgImage" method="post" enctype="multipart/form-data" class="admin-inline-form">
        <div class="admin-field" style="flex:2;">
            <label>@Loc["Admin.SiteSettings.UploadDefaultSocialImage"]</label>
            <input type="file" name="file" accept="image/*" required />
        </div>
        <button type="submit" class="admin-btn">@Loc["Admin.Common.Upload"]</button>
    </form>
</div>

<div class="admin-card" style="margin-top:24px;">
    <h2>@Loc["Admin.SiteSettings.Logo"]</h2>
    <p class="admin-hint">@Loc["Admin.SiteSettings.SquareAtLeast112112Published"]</p>

    @if (!string.IsNullOrWhiteSpace(Model.LogoPreviewUrl))
    {
        <img src="@Model.LogoPreviewUrl" alt="" style="max-width:160px;display:block;margin-bottom:8px;border-radius:8px;" />
        @if (Model.HasUploadedLogo)
        {
            <form asp-action="RemoveLogo" method="post" style="display:inline;">
                <button type="submit" class="admin-icon-btn" style="color:var(--vih-danger);">@Loc["Admin.Common.Remove"]</button>
            </form>
        }
    }

    <form asp-action="UploadLogo" method="post" enctype="multipart/form-data" class="admin-inline-form">
        <div class="admin-field" style="flex:2;">
            <label>@Loc["Admin.SiteSettings.UploadLogo"]</label>
            <input type="file" name="file" accept="image/*" required />
        </div>
        <button type="submit" class="admin-btn">@Loc["Admin.Common.Upload"]</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

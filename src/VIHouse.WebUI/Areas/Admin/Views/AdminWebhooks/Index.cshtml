@using VIHouse.Entities.Commerce
@model AdminWebhookEventsViewModel
@{
    ViewData["Title"] = Loc["Admin.Nav.AdminWebhooks"].Value;

    string FilterClass(WebhookEventStatus? status) =>
        Model.Status == status ? "admin-btn" : "admin-btn admin-btn--ghost";

    string StatusBadge(WebhookEventStatus status) => status switch
    {
        WebhookEventStatus.Processed => "admin-badge admin-badge--open",
        WebhookEventStatus.Failed => "admin-badge admin-badge--closed",
        WebhookEventStatus.Received => "admin-badge admin-badge--pending",
        _ => "admin-badge admin-badge--draft",
    };

    // The Stripe object an event is about, as a link into the Stripe dashboard. Test-mode objects
    // live under /test/ there; the row knows which mode it came from.
    string? StripeHref(WebhookEvent e)
    {
        if (string.IsNullOrEmpty(e.ObjectId)) return null;
        var mode = e.LiveMode ? "" : "test/";
        var prefix = e.ObjectId.Split('_')[0];
        return prefix switch
        {
            "cs" => null, // Checkout Sessions have no dashboard page of their own
            "in" => $"https://dashboard.stripe.com/{mode}invoices/{e.ObjectId}",
            "sub" => $"https://dashboard.stripe.com/{mode}subscriptions/{e.ObjectId}",
            "pi" => $"https://dashboard.stripe.com/{mode}payments/{e.ObjectId}",
            "ch" => $"https://dashboard.stripe.com/{mode}payments/{e.ObjectId}",
            "dp" or "du" => $"https://dashboard.stripe.com/{mode}disputes/{e.ObjectId}",
            _ => null,
        };
    }
}

@if (TempData["StatusMessage"] is string status)
{
    <div class="admin-status-message">@status</div>
}

<p class="admin-hint">
    @Loc.Html("Admin.Webhooks.Intro", LocalizerHtml.Strong(Loc["Admin.Webhooks.Processed"].Value), LocalizerHtml.Strong(Loc["Admin.Webhooks.Failed"].Value), LocalizerHtml.Strong(Loc["Admin.Webhooks.ReRun"].Value), LocalizerHtml.Strong(Loc["Admin.Webhooks.Ignored"].Value))
</p>

<div class="admin-toolbar">
    <a class="@FilterClass(null)" asp-action="Index">@Loc["Admin.Webhooks.All"] <span class="admin-table__sub">@Model.Total</span></a>
    <a class="@FilterClass(WebhookEventStatus.Failed)" asp-action="Index" asp-route-status="Failed">@Loc["Admin.Webhooks.Failed"] <span class="admin-table__sub">@Model.Count(WebhookEventStatus.Failed)</span></a>
    <a class="@FilterClass(WebhookEventStatus.Received)" asp-action="Index" asp-route-status="Received">@Loc["Admin.Webhooks.InProgress"] <span class="admin-table__sub">@Model.Count(WebhookEventStatus.Received)</span></a>
    <a class="@FilterClass(WebhookEventStatus.Processed)" asp-action="Index" asp-route-status="Processed">@Loc["Admin.Webhooks.Processed"] <span class="admin-table__sub">@Model.Count(WebhookEventStatus.Processed)</span></a>
    <a class="@FilterClass(WebhookEventStatus.Ignored)" asp-action="Index" asp-route-status="Ignored">@Loc["Admin.Webhooks.Ignored"] <span class="admin-table__sub">@Model.Count(WebhookEventStatus.Ignored)</span></a>
</div>

@if (Model.Count(WebhookEventStatus.Failed) > 0 && Model.Status != WebhookEventStatus.Failed)
{
    <div class="admin-status-message">
        @Loc["Admin.Webhooks.FailedWaiting", Model.Count(WebhookEventStatus.Failed)]
        <a asp-action="Index" asp-route-status="Failed">@Loc["Admin.Webhooks.ShowThem"]</a>.
    </div>
}

@if (Model.Rows.Count == 0)
{
    <p class="admin-hint">@(Model.Status is { } s ? Loc["Admin.Webhooks.EmptyForStatus", Loc.Label(s)].Value : Loc["Admin.Webhooks.Empty"].Value)</p>
}
else
{
    <div class="admin-table-scroll">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>@Loc["Admin.Webhooks.Received"]</th>
                    <th>@Loc["Admin.Webhooks.Event"]</th>
                    <th>@Loc["Admin.Webhooks.Object"]</th>
                    <th>@Loc["Admin.Common.Status"]</th>
                    <th>@Loc["Admin.Webhooks.Attempts"]</th>
                    <th>@Loc["Admin.Webhooks.LastError"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var e in Model.Rows)
                {
                    <tr>
                        <td>
                            <time datetime="@e.ReceivedAt.ToString("o")">@e.ReceivedAt.ToString("d MMM yyyy, HH:mm:ss")</time>
                            @if (!e.LiveMode)
                            {
                                <span class="admin-table__sub">@Loc["Admin.Webhooks.TestMode"]</span>
                            }
                        </td>
                        <td>
                            <code>@e.Type</code>
                            <div class="admin-table__sub" style="font-family:ui-monospace,monospace;">@e.EventId</div>
                        </td>
                        <td>
                            @if (StripeHref(e) is { } href)
                            {
                                <a href="@href" target="_blank" rel="noopener" style="font-family:ui-monospace,monospace; font-size:0.8125rem;">@e.ObjectId</a>
                            }
                            else
                            {
                                <span style="font-family:ui-monospace,monospace; font-size:0.8125rem;">@(e.ObjectId ?? "—")</span>
                            }
                        </td>
                        <td><span class="@StatusBadge(e.Status)">@Loc.Label(e.Status)</span></td>
                        <td>@e.Attempts</td>
                        <td class="admin-table__sub" style="max-width:360px; word-break:break-word;">@(e.LastError ?? "—")</td>
                        <td>
                            @if (e.Status is WebhookEventStatus.Failed or WebhookEventStatus.Received)
                            {
                                <form asp-action="Rerun" asp-route-eventId="@e.EventId" method="post" data-confirm="@Loc["Admin.Webhooks.FetchThisEventFromStripeAgain"]">
                                    <button type="submit" class="admin-btn admin-btn--sm">@Loc["Admin.Webhooks.ReRun"]</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Rows.Count == Model.Take)
    {
        <p class="admin-hint">@Loc["Admin.Webhooks.ShowingNewest", Model.Take]</p>
    }
}

@model AdminMembershipPlanFormViewModel
@{
    ViewData["Title"] = Model.Name;
    var usage = Model.Usage ?? new PlanUsage(0, 0);
}

@if (TempData["StatusMessage"] is string status)
{
    <div class="admin-status-message">@status</div>
}

<div class="admin-review-grid">
    <div class="admin-review-main">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="admin-form">
            <div asp-validation-summary="ModelOnly" class="field-validation-error"></div>
            <partial name="_FormFields" model="Model" />
            <div>
                <button type="submit" class="admin-btn">@Loc["Admin.MembershipPlans.SaveSync"]</button>
                <a class="admin-btn admin-btn--ghost" asp-action="Index">@Loc["Admin.MembershipPlans.BackToPlans"]</a>
            </div>
        </form>
    </div>

    <div class="admin-review-side">
        @* --- The Stripe mirror -------------------------------------------------------------- *@
        <div class="admin-card">
            <h2>Stripe</h2>

            @if (Model.ProviderSyncError is not null)
            {
                <p class="admin-sync-state admin-sync-state--error">
                    <span class="admin-badge admin-badge--danger">@Loc["Admin.MembershipPlans.SyncFailed"]</span>
                    @Model.ProviderSyncError
                </p>
            }
            else if (Model.IsProviderSynced)
            {
                <p class="admin-sync-state admin-sync-state--ok">
                    <span class="admin-badge admin-badge--paid">@Loc["Admin.MembershipPlans.Synced"]</span>
                    @Loc["Admin.MembershipPlans.LastPushed", Model.ProviderSyncedAt?.ToLocalTime().ToString("d MMM yyyy, HH:mm") ?? "—"]
                </p>
            }
            else
            {
                <p class="admin-sync-state">
                    <span class="admin-badge admin-badge--pending">@Loc["Admin.MembershipPlans.NotSynced"]</span>
                    @Loc["Admin.MembershipPlans.CheckoutUsesAnInlinePriceUntil"]
                </p>
            }

            <dl class="admin-detail-list admin-detail-list--compact">
                <div>
                    <dt>@Loc["Admin.MembershipPlans.Product"]</dt>
                    <dd>
                        @if (Model.ProviderProductId is null) { <text>&mdash;</text> }
                        else { <a href="@Model.StripeProductUrl" target="_blank" rel="noopener"><code>@Model.ProviderProductId</code></a> }
                    </dd>
                </div>
                <div>
                    <dt>@Loc["Admin.Common.Price"]</dt>
                    <dd>@if (Model.ProviderPriceId is null) { <text>&mdash;</text> } else { <code>@Model.ProviderPriceId</code> }</dd>
                </div>
            </dl>

            <form asp-action="Sync" asp-route-id="@Model.Id" method="post" style="margin-top:12px;">
                <button type="submit" class="admin-btn admin-btn--ghost" style="width:100%;">@Loc["Admin.MembershipPlans.SyncNow"]</button>
            </form>
            <p class="admin-hint">
                @Loc["Admin.MembershipPlans.StripePricesAreImmutableChangingThe"]
            </p>
        </div>

        @* --- Usage & lifecycle -------------------------------------------------------------- *@
        <div class="admin-card">
            <h2>@Loc["Admin.MembershipPlans.Usage"]</h2>
            <dl class="admin-detail-list admin-detail-list--compact">
                <div><dt>@Loc["Admin.MembershipPlans.Memberships"]</dt><dd>@usage.Memberships</dd></div>
                <div><dt>@Loc["Admin.MembershipPlans.Payments"]</dt><dd>@usage.Payments</dd></div>
            </dl>

            @if (Model.Status == MembershipPlanStatus.Active)
            {
                <form asp-action="Archive" asp-route-id="@Model.Id" method="post" style="margin-top:12px;"
                      data-confirm="@Loc["Admin.MembershipPlans.ArchiveThisPlanItWillStop"]">
                    <button type="submit" class="admin-btn admin-btn--ghost" style="width:100%;">@Loc["Admin.MembershipPlans.ArchivePlan"]</button>
                </form>
            }

            @if (usage.CanDelete)
            {
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" style="margin-top:8px;"
                      data-confirm="@Loc["Admin.MembershipPlans.DeleteThisPlanPermanentlyTheStripe"]">
                    <button type="submit" class="admin-btn admin-btn--danger" style="width:100%;">@Loc["Admin.MembershipPlans.DeletePlan"]</button>
                </form>
            }
            else
            {
                <p class="admin-hint">
                    @Loc["Admin.MembershipPlans.ThisPlanCanTBeDeleted"]
                </p>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

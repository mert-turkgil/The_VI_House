@model AdminMembershipPlanFormViewModel
@{
    ViewData["Title"] = Model.Name;
}

@if (TempData["StatusMessage"] is string status)
{
    <div class="admin-status-message">@status</div>
}

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="admin-form">
    <div asp-validation-summary="ModelOnly" class="field-validation-error"></div>
    <partial name="_FormFields" model="Model" />
    <div>
        <button type="submit" class="admin-btn">Save Changes</button>
        <a class="admin-btn admin-btn--ghost" asp-action="Index">Back to Plans</a>
    </div>
</form>

<form asp-action="Archive" asp-route-id="@Model.Id" method="post" style="margin-top:16px;" onsubmit="return confirm('Archive this plan? It will stop appearing on the public Membership page.');">
    <button type="submit" class="admin-btn admin-btn--danger">Archive Plan</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

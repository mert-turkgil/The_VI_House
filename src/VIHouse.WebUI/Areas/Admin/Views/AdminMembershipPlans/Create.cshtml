@model AdminMembershipPlanFormViewModel
@{
    ViewData["Title"] = Loc["Admin.MembershipPlans.NewTitle"].Value;
}

<p class="admin-lede">
    @Loc["Admin.MembershipPlans.ThePlanIsSavedHereAnd"]
</p>

<form asp-action="Create" method="post" class="admin-form">
    <div asp-validation-summary="ModelOnly" class="field-validation-error"></div>
    <partial name="_FormFields" model="Model" />
    <div>
        <button type="submit" class="admin-btn">@Loc["Admin.MembershipPlans.CreateSyncToStripe"]</button>
        <a class="admin-btn admin-btn--ghost" asp-action="Index">@Loc["Admin.Common.Cancel"]</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

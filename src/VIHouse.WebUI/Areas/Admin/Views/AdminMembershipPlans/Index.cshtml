@model List<MembershipPlan>
@inject Microsoft.Extensions.Options.IOptions<VIHouse.Business.Options.FeatureOptions> SalesOpen
@{
    ViewData["Title"] = Loc["Admin.Nav.AdminMembershipPlans"].Value;
    var stripeConfigured = ViewData["StripeConfigured"] is true;
    var stripeLive = ViewData["StripeLive"] is true;
    var unsynced = Model.Count(p => !p.IsProviderSynced);

    string PeriodLabel(MembershipBillingPeriod period) => period switch
    {
                MembershipBillingPeriod.Monthly => Loc["Admin.MembershipPlans.PerMonth"].Value,
        MembershipBillingPeriod.Annual => Loc["Admin.MembershipPlans.PerYear"].Value,
        _ => Loc["Admin.MembershipPlans.OneTime"].Value,
    };
}

@if (TempData["StatusMessage"] is string status)
{
    <div class="admin-status-message">@status</div>
}

@* --- Where the mirror stands ------------------------------------------------------------------ *@
<div class="admin-sync-bar @(stripeConfigured ? (unsynced == 0 ? "admin-sync-bar--ok" : "admin-sync-bar--warn") : "admin-sync-bar--off")">
    <div class="admin-sync-bar__status">
        <span class="admin-sync-bar__dot" aria-hidden="true"></span>
        @if (!stripeConfigured)
        {
            <span><strong>@Loc["Admin.MembershipPlans.StripeIsNotConfigured"]</strong> @Loc.Html("Admin.MembershipPlans.SaveLocally", LocalizerHtml.Code("Stripe:SecretKey"))</span>
        }
        else if (unsynced == 0)
        {
            <span><strong>@Loc["Admin.MembershipPlans.InSyncWithStripe"]</strong> @Loc[stripeLive ? "Admin.MembershipPlans.InSyncLive" : "Admin.MembershipPlans.InSyncTest"]</span>
        }
        else
        {
            <span><strong>@Loc["Admin.MembershipPlans.NotMirroredCount", unsynced]</strong> @Loc["Admin.MembershipPlans.NotMirroredHint"]</span>
        }
    </div>
    <div class="admin-sync-bar__actions">
        <form asp-action="Import" method="post">
            <button type="submit" class="admin-btn admin-btn--ghost admin-btn--sm" disabled="@(!stripeConfigured)"
                    title="@Loc["Admin.MembershipPlans.CreateAPlanHereForEvery"]">@Loc["Admin.MembershipPlans.ImportFromStripe"]</button>
        </form>
        <form asp-action="SyncAll" method="post">
            <button type="submit" class="admin-btn admin-btn--sm" disabled="@(!stripeConfigured)">@Loc["Admin.MembershipPlans.SyncAllToStripe"]</button>
        </form>
    </div>
</div>

@if (!SalesOpen.Value.MembershipSales)
{
    <p class="admin-lede">
        @Loc.Html("Admin.MembershipPlans.SalesClosed", LocalizerHtml.Code("Features:MembershipSales"))
    </p>
}

<div class="admin-toolbar">
    <a class="admin-btn" asp-action="Create">@Loc["Admin.MembershipPlans.NewPlan"]</a>
</div>

@if (Model.Count == 0)
{
    <p>@Loc["Admin.MembershipPlans.NoMembershipPlansYetCreateOne"]</p>
}
else
{
    <div class="admin-table-scroll">
    <table class="admin-table" data-admin-table>
        <thead>
            <tr>
                <th>@Loc["Admin.Common.Name"]</th>
                <th>@Loc["Admin.Common.Price"]</th>
                <th>@Loc["Admin.MembershipPlans.Billing"]</th>
                <th>@Loc["Admin.Common.Status"]</th>
                <th>@Loc["Admin.MembershipPlans.Seats"]</th>
                <th>Stripe</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var plan in Model)
            {
                <tr>
                    <td>
                        <a asp-action="Edit" asp-route-id="@plan.Id">@plan.Name</a>
                        @if (!string.IsNullOrWhiteSpace(plan.Description))
                        {
                            <div class="admin-table__sub">@plan.Description</div>
                        }
                    </td>
                    <td>@MoneyFormatter.Format(plan.PriceMinor, plan.Currency) <span class="admin-table__sub">@PeriodLabel(plan.BillingPeriod)</span></td>
                    <td>@Loc.Label(plan.BillingPeriod)</td>
                    <td><span class="@(plan.Status == MembershipPlanStatus.Active ? "admin-badge admin-badge--open" : "admin-badge admin-badge--closed")">@Loc.Label(plan.Status)</span></td>
                    <td>
                        @if (ViewBag.Availability is Dictionary<Guid, VIHouse.Business.Abstract.PlanAvailability> availability && availability.TryGetValue(plan.Id, out var seats))
                        {
                            if (seats.Max is { } max)
                            {
                                <span class="@(seats.IsFull ? "admin-badge admin-badge--closed" : "")">@seats.Taken / @max</span>
                            }
                            else
                            {
                                <span class="admin-table__sub">@seats.Taken · @Loc["Admin.MembershipPlans.Unlimited"]</span>
                            }
                        }
                    </td>
                    <td>
                        @if (plan.ProviderSyncError is not null)
                        {
                            <span class="admin-badge admin-badge--danger" title="@plan.ProviderSyncError">@Loc["Admin.MembershipPlans.SyncFailed"]</span>
                        }
                        else if (plan.IsProviderSynced)
                        {
                            <span class="admin-badge admin-badge--paid" title="@plan.ProviderPriceId">@Loc["Admin.MembershipPlans.Synced"]</span>
                            <div class="admin-table__sub">@plan.ProviderSyncedAt?.ToLocalTime().ToString("d MMM, HH:mm")</div>
                        }
                        else
                        {
                            <span class="admin-badge admin-badge--pending">@Loc["Admin.MembershipPlans.NotSynced"]</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

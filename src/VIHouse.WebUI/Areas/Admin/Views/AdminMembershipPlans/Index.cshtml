@model List<MembershipPlan>
@inject Microsoft.Extensions.Options.IOptions<VIHouse.Business.Options.FeatureOptions> SalesOpen
@{
    ViewData["Title"] = "Membership Plans";
    var stripeConfigured = ViewData["StripeConfigured"] is true;
    var stripeLive = ViewData["StripeLive"] is true;
    var unsynced = Model.Count(p => !p.IsProviderSynced);

    string PeriodLabel(MembershipBillingPeriod period) => period switch
    {
        MembershipBillingPeriod.Monthly => "/ month",
        MembershipBillingPeriod.Annual => "/ year",
        _ => "one-time",
    };
}

@if (TempData["StatusMessage"] is string status)
{
    <div class="admin-status-message">@status</div>
}
@if (TempData["ErrorMessage"] is string error)
{
    <div class="admin-status-message admin-status-message--error" role="alert">@error</div>
}

@* --- Where the mirror stands ------------------------------------------------------------------ *@
<div class="admin-sync-bar @(stripeConfigured ? (unsynced == 0 ? "admin-sync-bar--ok" : "admin-sync-bar--warn") : "admin-sync-bar--off")">
    <div class="admin-sync-bar__status">
        <span class="admin-sync-bar__dot" aria-hidden="true"></span>
        @if (!stripeConfigured)
        {
            <span><strong>Stripe is not configured.</strong> Plans save locally; add <code>Stripe:SecretKey</code> to mirror them.</span>
        }
        else if (unsynced == 0)
        {
            <span><strong>In sync with Stripe</strong> (@(stripeLive ? "live" : "test") mode) &mdash; every plan has a matching product and price.</span>
        }
        else
        {
            <span><strong>@unsynced plan(s) not mirrored.</strong> Their checkout still works with an inline price; sync to put them under a named Stripe product.</span>
        }
    </div>
    <div class="admin-sync-bar__actions">
        <form asp-action="Import" method="post">
            <button type="submit" class="admin-btn admin-btn--ghost admin-btn--sm" disabled="@(!stripeConfigured)"
                    title="Create a plan here for every Stripe product that doesn't have one yet">Import from Stripe</button>
        </form>
        <form asp-action="SyncAll" method="post">
            <button type="submit" class="admin-btn admin-btn--sm" disabled="@(!stripeConfigured)">Sync all to Stripe</button>
        </form>
    </div>
</div>

@if (!SalesOpen.Value.MembershipSales)
{
    <p class="admin-lede">
        Membership sales are currently closed (<code>Features:MembershipSales</code> is off), so
        none of these plans appear on the public page yet. They can still be prepared and mirrored
        to Stripe here, ready for the day sales open.
    </p>
}

<div class="admin-toolbar">
    <a class="admin-btn" asp-action="Create">+ New Plan</a>
</div>

@if (Model.Count == 0)
{
    <p>No membership plans yet. Create one here, or import the products you already have in Stripe.</p>
}
else
{
    <div class="admin-table-scroll">
    <table class="admin-table" data-admin-table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Price</th>
                <th>Billing</th>
                <th>Status</th>
                <th>Seats</th>
                <th>Stripe</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var plan in Model)
            {
                <tr>
                    <td>
                        <a asp-action="Edit" asp-route-id="@plan.Id">@plan.Name</a>
                        @if (!string.IsNullOrWhiteSpace(plan.Description))
                        {
                            <div class="admin-table__sub">@plan.Description</div>
                        }
                    </td>
                    <td>@MoneyFormatter.Format(plan.PriceMinor, plan.Currency) <span class="admin-table__sub">@PeriodLabel(plan.BillingPeriod)</span></td>
                    <td>@plan.BillingPeriod</td>
                    <td><span class="@(plan.Status == MembershipPlanStatus.Active ? "admin-badge admin-badge--open" : "admin-badge admin-badge--closed")">@plan.Status</span></td>
                    <td>
                        @if (ViewBag.Availability is Dictionary<Guid, VIHouse.Business.Abstract.PlanAvailability> availability && availability.TryGetValue(plan.Id, out var seats))
                        {
                            if (seats.Max is { } max)
                            {
                                <span class="@(seats.IsFull ? "admin-badge admin-badge--closed" : "")">@seats.Taken / @max</span>
                            }
                            else
                            {
                                <span class="admin-table__sub">@seats.Taken · unlimited</span>
                            }
                        }
                    </td>
                    <td>
                        @if (plan.ProviderSyncError is not null)
                        {
                            <span class="admin-badge admin-badge--danger" title="@plan.ProviderSyncError">Sync failed</span>
                        }
                        else if (plan.IsProviderSynced)
                        {
                            <span class="admin-badge admin-badge--paid" title="@plan.ProviderPriceId">Synced</span>
                            <div class="admin-table__sub">@plan.ProviderSyncedAt?.ToLocalTime().ToString("d MMM, HH:mm")</div>
                        }
                        else
                        {
                            <span class="admin-badge admin-badge--pending">Not synced</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

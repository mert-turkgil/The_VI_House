@model AdminMembershipPlanFormViewModel

<div class="admin-form__grid">
    <div class="admin-field">
        <label asp-for="Name"></label>
        <input asp-for="Name" placeholder="Founding Member" />
        <span asp-validation-for="Name" class="field-validation-error"></span>
    </div>
    <div class="admin-field">
        <label asp-for="Status"></label>
        <select asp-for="Status" asp-items="Loc.Options<VIHouse.Entities.Membership.MembershipPlanStatus>()"></select>
    </div>
</div>

<div class="admin-field">
    <label asp-for="Description"></label>
    <textarea asp-for="Description" rows="2" placeholder="@Loc["Admin.MembershipPlans.OneSentenceShownUnderThePlan"]"></textarea>
    <span asp-validation-for="Description" class="field-validation-error"></span>
</div>

<div class="admin-form__grid admin-form__grid--3">
    <div class="admin-field">
        <label asp-for="Price">@Loc["Admin.MembershipPlans.PriceEG250000"]</label>
        <input asp-for="Price" type="number" step="0.01" min="0" inputmode="decimal" />
        <span asp-validation-for="Price" class="field-validation-error"></span>
    </div>
    <div class="admin-field">
        <label asp-for="Currency"></label>
        <input asp-for="Currency" placeholder="GBP" maxlength="3" style="text-transform:uppercase;" />
        <span asp-validation-for="Currency" class="field-validation-error"></span>
    </div>
    <div class="admin-field">
        <label asp-for="BillingPeriod"></label>
        <select asp-for="BillingPeriod" asp-items="Loc.Options<VIHouse.Entities.Membership.MembershipBillingPeriod>()"></select>
    </div>
</div>

<div class="admin-field">
    <label asp-for="Features"></label>
    <textarea asp-for="Features" rows="5" placeholder="@Loc["Admin.MembershipPlans.PriorityBookingFoundingMemberBadgeInvitation"]"></textarea>
    <span asp-validation-for="Features" class="field-validation-error"></span>
</div>

<div class="admin-field" style="max-width:200px;">
    <label asp-for="SortOrder">@Loc["Admin.MembershipPlans.SortOrder"]</label>
    <input asp-for="SortOrder" type="number" />
</div>

<div class="admin-field" style="max-width:260px;">
    <label asp-for="MaxMembers">@Loc["Admin.MembershipPlans.MaximumMembers"]</label>
    <input asp-for="MaxMembers" type="number" min="1" placeholder="@Loc["Admin.MembershipPlans.Unlimited"]" />
    <p class="admin-field__hint">@Loc["Admin.MembershipPlans.MaxMembersHint"]</p>
    <span asp-validation-for="MaxMembers" class="field-validation-error"></span>
</div>

<fieldset class="admin-field" style="border:none; padding:0; margin:0 0 16px;">
    <legend style="font-weight:600; font-size:0.875rem; margin-bottom:8px;">@Loc["Admin.MembershipPlans.WhatThisTierIncludes"]</legend>
    <p class="admin-field__hint" style="margin-top:0;">@Loc["Admin.MembershipPlans.TheseDecideWhatAMemberOn"]</p>
    <div style="display:grid; gap:8px; grid-template-columns:repeat(auto-fit, minmax(240px, 1fr));">
        <label style="display:flex; align-items:center; gap:8px; font-size:0.875rem;"><input asp-for="IncludesSessions" /> @Loc["Admin.MembershipPlans.SessionsMarkedIncludedWithMembership"]</label>
        <label style="display:flex; align-items:center; gap:8px; font-size:0.875rem;"><input asp-for="IncludesCommunity" /> @Loc["Admin.MembershipPlans.CommunityChannelsDiscordCalls"]</label>
        <label style="display:flex; align-items:center; gap:8px; font-size:0.875rem;"><input asp-for="IncludesDirectory" /> @Loc["Admin.MembershipPlans.MemberDirectory"]</label>
        <label style="display:flex; align-items:center; gap:8px; font-size:0.875rem;"><input asp-for="IncludesMemberCard" /> @Loc["Admin.MembershipPlans.DigitalMemberCard"]</label>
    </div>
</fieldset>

<div class="admin-field" style="max-width:320px;">
    <label asp-for="DiscordRoleId">@Loc["Admin.MembershipPlans.DiscordRoleId"]</label>
    <input asp-for="DiscordRoleId" placeholder="@Loc["Admin.MembershipPlans.Optional"]" />
    <p class="admin-field__hint">@Loc["Admin.MembershipPlans.OnlyUsedWhenTheDiscordBot"]</p>
    <span asp-validation-for="DiscordRoleId" class="field-validation-error"></span>
</div>

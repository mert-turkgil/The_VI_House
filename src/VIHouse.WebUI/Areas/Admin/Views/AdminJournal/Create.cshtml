@model AdminJournalStartViewModel
@{
    ViewData["Title"] = Loc["Admin.Journal.New"].Value;
}

@*
    "New article": a headline and a category is all it takes to start. The web address is made from
    the headline, and the article itself is written on the next screen, where images can already be
    dragged in (a file needs a post to belong to).
*@
<div class="writer-start">
    <partial name="_ErrorSummary" model="@Loc["Admin.Journal.ErrorTitle"].Value" />

    <form asp-action="Create" method="post" class="admin-form writer-start__form" data-guard>
        <div class="admin-field">
            <label asp-for="Title">@Loc["Admin.Journal.Title.Column"]</label>
            <input asp-for="Title" class="writer__title writer__title--start" maxlength="200" autofocus
                   placeholder="@Loc["Admin.Writer.TitlePlaceholder"]" autocomplete="off" />
            <span asp-validation-for="Title" class="field-validation-error"></span>
            <p class="admin-field__hint">@Loc["Admin.Writer.Start.TitleHint"]</p>
        </div>

        <fieldset class="admin-field admin-choice-group">
            <legend>@Loc["Admin.Journal.Category"]</legend>
            <div class="admin-choice-group__options admin-choice-group__options--grid">
                @foreach (var category in Enum.GetValues<JournalCategory>())
                {
                    <label class="admin-choice">
                        <input type="radio" asp-for="Category" value="@category" />
                        <span class="admin-choice__body">
                            <strong>@Loc["Journal.Category." + category]</strong>
                            <span>@Loc["Admin.Journal.Category." + category + ".Help"]</span>
                        </span>
                    </label>
                }
            </div>
        </fieldset>

        <div class="admin-form__grid">
            <div class="admin-field">
                <label asp-for="AuthorName">@Loc["Admin.Journal.AuthorName"]</label>
                <input asp-for="AuthorName" maxlength="150" />
                <p class="admin-field__hint">@Loc["Admin.Writer.Start.AuthorHint"]</p>
            </div>
            <div class="admin-field">
                <label asp-for="Excerpt">@Loc["Admin.Journal.Excerpt"] <span class="admin-optional">@Loc["Admin.Form.Optional"]</span></label>
                <textarea asp-for="Excerpt" rows="3" maxlength="500" placeholder="@Loc["Admin.Writer.StandfirstPlaceholder"]"></textarea>
            </div>
        </div>

        <div class="writer-start__actions">
            <button type="submit" class="admin-btn">@Loc["Admin.Writer.Start.Submit"] &rarr;</button>
            <a class="admin-btn admin-btn--ghost" asp-action="Index">@Loc["Admin.Journal.Cancel"]</a>
        </div>
        <p class="admin-field__hint">@Loc["Admin.Writer.Start.After"]</p>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

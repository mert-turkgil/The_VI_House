@model AdminJournalPostFormViewModel

<div class="admin-form__grid">
    <div class="admin-field">
        <label asp-for="Title"></label>
        <input asp-for="Title" />
        <span asp-validation-for="Title" class="field-validation-error"></span>
    </div>
    <div class="admin-field">
        <label asp-for="Slug"></label>
        <input asp-for="Slug" placeholder="why-we-built-the-vi-house" />
        <span asp-validation-for="Slug" class="field-validation-error"></span>
    </div>
</div>

<div class="admin-form__grid">
    <div class="admin-field">
        <label asp-for="Category"></label>
        <select asp-for="Category" asp-items="Html.GetEnumSelectList<JournalCategory>()"></select>
    </div>
    <div class="admin-field">
        <label asp-for="Status"></label>
        <select asp-for="Status" asp-items="Html.GetEnumSelectList<JournalPostStatus>()"></select>
    </div>
</div>

<div class="admin-field">
    <label asp-for="Excerpt"></label>
    <textarea asp-for="Excerpt" rows="2"></textarea>
    <span asp-validation-for="Excerpt" class="field-validation-error"></span>
</div>

<div class="admin-field">
    <label asp-for="Body"></label>
    @* data-ckeditor upgrades this into a rich text editor (see ClientApp modules/editor.ts). The
       textarea stays the real form field and keeps working on its own if that script fails. *@
    <textarea asp-for="Body" rows="16" data-ckeditor></textarea>
    <span asp-validation-for="Body" class="field-validation-error"></span>
</div>

<div class="admin-form__grid">
    <div class="admin-field">
        <label asp-for="CoverImageUrl"></label>
        <input asp-for="CoverImageUrl" />
    </div>
    <div class="admin-field">
        <label asp-for="AuthorName"></label>
        <input asp-for="AuthorName" />
    </div>
</div>

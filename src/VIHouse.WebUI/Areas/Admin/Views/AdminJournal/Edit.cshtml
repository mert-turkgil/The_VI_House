@model AdminJournalEditViewModel
@{
    var active = Model.Translations.First(t => t.Culture.Name == Model.ActiveCulture);
    var postId = Model.Form.Id!.Value;
    var englishTitle = Model.Translations.First(t => t.IsDefault).Form.Title;
    ViewData["Title"] = string.IsNullOrWhiteSpace(englishTitle) ? Loc["Admin.Journal.Untitled"].Value : englishTitle;

    // The id of the body textarea for the language on screen. The media library's Insert buttons
    // address the editor through it (see ClientApp modules/editor.ts), and it has to be per-culture
    // so switching tabs cannot leave a button pointing at a textarea that is no longer there.
    var bodyFieldId = $"journal-body-{active.Culture.Name}";
}

@*
    The writer. One form (#journal-writer) holds the article and every setting; the sidebar's fields
    sit outside it in the markup and join it with form="journal-writer". Only the cover upload and
    the delete have forms of their own, because a file upload cannot ride along with the article.

    Every button saves: "Save draft" / "Update" keep the status, "Publish" and "Unpublish" change it
    (AdminJournalController.Save). modules/journalWriter.ts adds the word count, the local autosave
    with "restore", focus mode, the slug and search previews; modules/adminForms.ts adds the
    character counters, Ctrl/Cmd+S and the unsaved-changes guard.
*@
@if (TempData["StatusMessage"] is string status)
{
    <div class="admin-status-message">@status</div>
}

@* An influencer's article: who wrote it, where it stands, and the one decision only the editors
   make here besides publishing — sending it back with a note. *@
@if (Model.Submission is { } submission)
{
    <div class="admin-card admin-submission">
        <p style="margin:0;">
            <strong>@Loc["Admin.Journal.SubmittedBy", submission.AuthorName]</strong>
            @if (submission.InfluencerId is { } influencerId)
            {
                <a asp-controller="AdminAmbassadors" asp-action="Edit" asp-route-id="@influencerId">@Loc["Admin.Journal.OpenInfluencer"]</a>
            }
        </p>
        <p class="admin-hint" style="margin:6px 0 0;">
            @(submission.Status switch
            {
                JournalPostStatus.Submitted => Loc["Admin.Journal.SubmissionWaiting", submission.SubmittedAt?.ToString("d MMM yyyy, HH:mm") ?? "—"].Value,
                JournalPostStatus.ChangesRequested => Loc["Admin.Journal.SubmissionReturned"].Value,
                JournalPostStatus.Published => Loc["Admin.Journal.SubmissionPublished"].Value,
                _ => Loc["Admin.Journal.SubmissionDraft"].Value,
            })
        </p>
        @if (submission.ReviewNote is { } lastNote && submission.Status != JournalPostStatus.Published)
        {
            <p class="admin-hint" style="margin:6px 0 0;"><strong>@Loc["Admin.Journal.LastNote"]</strong> @lastNote</p>
        }
        @if (submission.Status == JournalPostStatus.Submitted)
        {
            <details class="admin-disclosure">
                <summary class="admin-btn admin-btn--ghost admin-btn--sm">@Loc["Admin.Journal.RequestChanges"]</summary>
                <form asp-action="RequestChanges" asp-route-id="@postId" method="post" class="admin-form" style="margin-top:12px;">
                    <div class="admin-field">
                        <label for="review-note">@Loc["Admin.Journal.NoteForAuthor"]</label>
                        <textarea id="review-note" name="note" rows="3" maxlength="1000" required></textarea>
                        <p class="admin-field__hint">@Loc["Admin.Journal.NoteForAuthorHint"]</p>
                    </div>
                    <div><button type="submit" class="admin-btn">@Loc["Admin.Journal.SendBack"]</button></div>
                </form>
            </details>
        }
    </div>
}

<partial name="_ErrorSummary" model="@Loc["Admin.Journal.ErrorTitle"].Value" />

<div class="writer" data-writer
     data-post-id="@postId" data-culture="@active.Culture.Name" data-updated-at="@Model.UpdatedAtMs"
     data-url-base="@Model.PublicUrlBase"
     data-words-label="@Loc["Admin.Writer.Words"]" data-minutes-label="@Loc["Admin.Writer.Minutes"]"
     data-autosaved-label="@Loc["Admin.Writer.Autosaved"]" data-restore-label="@Loc["Admin.Writer.Restore"]"
     data-restore-yes="@Loc["Admin.Writer.RestoreYes"]" data-restore-no="@Loc["Admin.Writer.RestoreNo"]">

    <div class="writer__main">
        @* Which language is being written. Each tab is a page of its own (a hidden editor computes a
           zero height and comes back broken), and the URL (?culture=de-DE) can be shared. *@
        <nav class="admin-lang-tabs writer__langs" aria-label="@Loc["Admin.Journal.Languages"]" id="writer">
            @foreach (var tab in Model.Translations)
            {
                <a class="@(tab.Culture.Name == Model.ActiveCulture ? "admin-lang-tab active" : "admin-lang-tab")"
                   asp-action="Edit" asp-route-id="@postId" asp-route-culture="@tab.Culture.Name"
                   aria-current="@(tab.Culture.Name == Model.ActiveCulture ? "page" : null)">
                    <span class="admin-lang-tab__dot @(tab.IsWritten ? "is-written" : null)" aria-hidden="true"></span>
                    @tab.Culture.NativeLabel
                    @if (tab.IsDefault)
                    {
                        <span class="admin-lang-tab__flag">@Loc["Admin.Journal.DefaultLanguage"]</span>
                    }
                    else if (!tab.IsWritten)
                    {
                        <span class="admin-lang-tab__flag admin-lang-tab__flag--missing">@Loc["Admin.Journal.NotTranslated"]</span>
                    }
                </a>
            }
        </nav>

        @if (!active.IsDefault && !active.IsWritten)
        {
            <p class="admin-notice">@Loc["Admin.Journal.FallbackNotice", SiteCultures.Describe(SiteCultures.Default).NativeLabel]</p>
        }

        <form id="journal-writer" asp-action="Save" asp-route-id="@postId" method="post" class="writer__form" data-guard data-save-shortcut>
            @* Which language this form is editing. Posted, not taken from the query string, so a stale
               tab cannot save English words into the German row. *@
            <input type="hidden" name="Copy.Culture" value="@active.Culture.Name" />
            <input type="hidden" name="Post.Status" value="@Model.Form.Status" />

            <label class="visually-hidden" for="writer-title">@Loc["Admin.Journal.Title.Column"]</label>
            <input id="writer-title" class="writer__title" name="Copy.Title" value="@active.Form.Title" maxlength="200" required
                   placeholder="@Loc["Admin.Writer.TitlePlaceholder"]" autocomplete="off" data-writer-title />
            <span class="field-validation-error" data-valmsg-for="Copy.Title">@Html.ValidationMessage("Copy.Title")</span>

            <label class="visually-hidden" for="writer-standfirst">@Loc["Admin.Journal.Excerpt"]</label>
            <textarea id="writer-standfirst" class="writer__standfirst" name="Copy.Excerpt" rows="2" maxlength="500"
                      placeholder="@Loc["Admin.Writer.StandfirstPlaceholder"]" data-writer-excerpt>@active.Form.Excerpt</textarea>

            <div class="writer__editor">
                @* data-upload-url: images and GIFs dropped into the editor are uploaded straight away
                   (UploadInline) and inserted as /media/journal/{id}. The antiforgery token travels as
                   a header because the editor posts its own request. *@
                <textarea id="@bodyFieldId" name="Copy.Body" rows="20" data-ckeditor data-writer-body
                          data-placeholder="@Loc["Admin.Writer.BodyPlaceholder"]"
                          data-upload-url="@Url.Action("UploadInline", new { id = postId })"
                          data-upload-token-field="__RequestVerificationToken">@active.Form.Body</textarea>
            </div>

            <div class="writer__status" aria-live="polite">
                <span data-writer-count>&nbsp;</span>
                <span class="writer__autosave" data-writer-autosave></span>
                <button type="button" class="writer__focus" data-writer-focus aria-pressed="false"
                        data-label-on="@Loc["Admin.Writer.FocusOn"]" data-label-off="@Loc["Admin.Writer.FocusOff"]">@Loc["Admin.Writer.FocusOn"]</button>
            </div>

            @* The same buttons as the publish card, at the bottom of the article where the writer is. *@
            <div class="writer__actions">
                @if (Model.PublishCard.IsPublished)
                {
                    <button type="submit" class="admin-btn" name="intent" value="save" data-default-save>@Loc["Admin.Publish.Update"]</button>
                }
                else
                {
                    <button type="submit" class="admin-btn admin-btn--ghost" name="intent" value="save" data-default-save>@Loc["Admin.Publish.SaveDraft"]</button>
                    <button type="submit" class="admin-btn" name="intent" value="publish" disabled="@(!Model.PublishCard.CanPublish)">@Loc["Admin.Publish.PublishNow"]</button>
                }
                <span class="writer__shortcut">@Loc["Admin.Writer.Shortcut"]</span>
            </div>
        </form>

        @if (!active.IsDefault && active.IsWritten)
        {
            <form asp-action="DeleteTranslation" asp-route-id="@postId" method="post" class="admin-inline-form writer__delete-translation"
                  data-confirm="@Loc["Admin.Journal.ConfirmDeleteTranslation"]" data-confirm-danger>
                <input type="hidden" name="culture" value="@active.Culture.Name" />
                <button type="submit" class="admin-btn admin-btn--ghost admin-btn--sm">@Loc["Admin.Journal.DeleteTranslation", active.Culture.NativeLabel]</button>
            </form>
        }
    </div>

    <aside class="writer__side" aria-label="@Loc["Admin.Writer.Settings"]">
        <partial name="_PublishCard" model="Model.PublishCard" />

        @* --- Cover -------------------------------------------------------------------------- *@
        <details class="writer-card" id="cover" open>
            <summary>@Loc["Admin.Journal.Section.Cover"]</summary>
            <div class="writer-card__body">
                @if (!string.IsNullOrWhiteSpace(Model.CoverPreviewUrl))
                {
                    @* Decorative: the headline names it, and this sits under a heading that says what it is. *@
                    <img class="writer-card__cover" src="@Model.CoverPreviewUrl" alt="" />
                }
                else
                {
                    <p class="writer-card__empty">@Loc["Admin.Journal.NoCoverYet"]</p>
                }

                @* Uploading a cover replaces the previous one outright; the file it replaces is deleted
                   rather than left in the library as a copy of a picture nothing shows. *@
                <form asp-action="UploadCover" asp-route-id="@postId" method="post" enctype="multipart/form-data" class="writer-card__upload">
                    <input type="file" name="file" accept="image/jpeg,image/png,image/webp,image/avif" required id="cover-file" />
                    <button type="submit" class="admin-btn admin-btn--sm">@Loc["Admin.Journal.UploadCover"]</button>
                </form>

                @if (Model.CoverMediaId is not null || !string.IsNullOrWhiteSpace(Model.Form.CoverImageUrl))
                {
                    <form asp-action="RemoveCover" asp-route-id="@postId" method="post" class="admin-inline-form"
                          data-confirm="@Loc["Admin.Journal.ConfirmRemoveCover"]">
                        <button type="submit" class="admin-btn admin-btn--ghost admin-btn--sm">@Loc["Admin.Journal.RemoveCover"]</button>
                    </form>
                }
                <p class="admin-field__hint">@Loc["Admin.Journal.CoverHint"]</p>

                <div class="admin-field">
                    <label for="cover-alt">@Loc["Admin.Journal.CoverImageAlt"]</label>
                    <input id="cover-alt" form="journal-writer" name="Post.CoverImageAlt" value="@Model.Form.CoverImageAlt" maxlength="300" />
                    <p class="admin-field__hint">@Loc["Admin.Journal.CoverImageAlt.Hint"]</p>
                </div>

                @if (Model.CoverMediaId is null)
                {
                    <details class="writer-card__advanced">
                        <summary>@Loc["Admin.Journal.CoverImageUrl"]</summary>
                        <input form="journal-writer" name="Post.CoverImageUrl" value="@Model.Form.CoverImageUrl"
                               placeholder="/img/journal/why-we-built-the-vi-house-1600.jpg" maxlength="1000" data-no-counter />
                        <span class="field-validation-error">@Html.ValidationMessage("Post.CoverImageUrl")</span>
                        <p class="admin-field__hint">@Loc["Admin.Journal.CoverUrlHint"]</p>
                    </details>
                }
            </div>
        </details>

        @* --- Details: category, author, address ------------------------------------------------ *@
        <details class="writer-card" open>
            <summary>@Loc["Admin.Journal.Section.Settings"]</summary>
            <div class="writer-card__body">
                <fieldset class="admin-field admin-choice-group admin-choice-group--compact">
                    <legend>@Loc["Admin.Journal.Category"]</legend>
                    <div class="admin-choice-group__options">
                        @foreach (var category in Enum.GetValues<JournalCategory>())
                        {
                            <label class="admin-choice">
                                <input type="radio" form="journal-writer" name="Post.Category" value="@category" checked="@(Model.Form.Category == category)" />
                                <span class="admin-choice__body">
                                    <strong>@Loc["Journal.Category." + category]</strong>
                                    <span>@Loc["Admin.Journal.Category." + category + ".Help"]</span>
                                </span>
                            </label>
                        }
                    </div>
                </fieldset>

                <div class="admin-field">
                    <label for="post-author">@Loc["Admin.Journal.AuthorName"]</label>
                    <input id="post-author" form="journal-writer" name="Post.AuthorName" value="@Model.Form.AuthorName" maxlength="150" />
                </div>

                <div class="admin-field">
                    <label for="post-slug">@Loc["Admin.Journal.Slug"]</label>
                    <input id="post-slug" form="journal-writer" name="Post.Slug" value="@Model.Form.Slug" maxlength="200" data-writer-slug data-no-counter />
                    <span class="field-validation-error">@Html.ValidationMessage("Post.Slug")</span>
                    <p class="admin-field__hint writer-card__url" data-writer-url>@Model.PublicUrlBase@Model.Form.Slug</p>
                    <p class="admin-field__hint">@Loc["Admin.Journal.Slug.Hint"]</p>
                </div>
            </div>
        </details>

        @* --- Search ------------------------------------------------------------------------------ *@
        <details class="writer-card" id="seo">
            <summary>@Loc["Admin.Writer.SearchCard"]</summary>
            <div class="writer-card__body">
                <p class="admin-field__hint">@Loc["Admin.Writer.SearchIntro"]</p>
                @* How the post will look in a search result, as the fields are typed. *@
                <div class="serp-preview" aria-hidden="true">
                    <span class="serp-preview__url" data-serp-url>@Model.PublicUrlBase@Model.Form.Slug</span>
                    <span class="serp-preview__title" data-serp-title></span>
                    <span class="serp-preview__desc" data-serp-desc></span>
                </div>
                <div class="admin-field">
                    <label for="seo-title">@Loc["Admin.Journal.SeoTitle"]</label>
                    <input id="seo-title" form="journal-writer" name="Copy.SeoTitle" value="@active.Form.SeoTitle" maxlength="70" data-writer-seo-title />
                    <p class="admin-field__hint">@Loc["Admin.Journal.SeoTitle.Hint"]</p>
                </div>
                <div class="admin-field">
                    <label for="seo-description">@Loc["Admin.Journal.SeoDescription"]</label>
                    <textarea id="seo-description" form="journal-writer" name="Copy.SeoDescription" rows="3" maxlength="160" data-writer-seo-desc>@active.Form.SeoDescription</textarea>
                    <p class="admin-field__hint">@Loc["Admin.Journal.SeoDescription.Hint"]</p>
                </div>
            </div>
        </details>

        @* --- Delete ------------------------------------------------------------------------------ *@
        <details class="writer-card writer-card--danger">
            <summary>@Loc["Admin.Writer.DangerZone"]</summary>
            <div class="writer-card__body">
                <p class="admin-field__hint">@Loc["Admin.Writer.DeleteHint"]</p>
                <form asp-action="Delete" asp-route-id="@postId" method="post" data-confirm="@Loc["Admin.Journal.ConfirmDelete"]" data-confirm-danger>
                    <button type="submit" class="admin-btn admin-btn--danger admin-btn--sm">@Loc["Admin.Journal.Delete"]</button>
                </form>
            </div>
        </details>
    </aside>
</div>

@* --- Media library -------------------------------------------------------------------------------- *@
<h2 class="admin-section-heading" id="media-library">@Loc["Admin.Journal.Section.Media"]</h2>

<div class="admin-panel">
    <form asp-action="UploadMedia" asp-route-id="@postId" method="post" enctype="multipart/form-data" class="admin-inline-form">
        <input type="file" name="file" accept="@MediaPolicy.AcceptAttribute" required />
        <input type="text" name="title" maxlength="200" placeholder="@Loc["Admin.Journal.MediaTitlePlaceholder"]" />
        <button type="submit" class="admin-btn">@Loc["Admin.Journal.UploadMedia"]</button>
    </form>
    <p class="admin-field__hint">@Loc["Admin.Journal.MediaHint"]</p>
</div>

@if (Model.Media.Count > 0)
{
    var galleryCount = Model.Media.Count(m => m.ShowInGallery && m.Id != Model.CoverMediaId && m.Kind is SeminarMediaKind.Image or SeminarMediaKind.Animation);

    @* One form for the whole library: order (drag, or the arrow buttons), captions per language and
       "show in gallery" are saved together by Save gallery. Delete and Use as cover are buttons of
       this same form with their own formaction, since forms cannot nest. modules/mediaLibrary.ts adds
       the dragging and the unsaved-changes bar; without it the arrows still work as plain buttons
       that move nothing, and the captions and toggles still save. *@
    <form asp-action="SaveGallery" asp-route-id="@postId" method="post" class="media-library" data-media-library>
        <input type="hidden" name="culture" value="@active.Culture.Name" />

        <div class="media-library__intro">
            <p>@Loc["Admin.Journal.Gallery.Intro"]</p>
            <a class="admin-btn admin-btn--ghost" asp-area="" asp-controller="Journal" asp-action="Details" asp-route-slug="@Model.Form.Slug" asp-fragment="journal-gallery-title" target="_blank" rel="noopener">@Loc["Admin.Journal.Gallery.View", galleryCount]</a>
        </div>

        <ol class="media-library__list" data-media-list>
            @{ var galleryPosition = 0; }
            @for (var i = 0; i < Model.Media.Count; i++)
            {
                var media = Model.Media[i];
                var url = $"/media/journal/{media.Id}";
                var isPicture = media.Kind is SeminarMediaKind.Image or SeminarMediaKind.Animation;
                var isCover = media.Id == Model.CoverMediaId;
                var captions = JournalMediaCaptions.Read(media);
                var activeCaption = captions.TryGetValue(active.Culture.Name, out var c) ? c : null;
                var field = $"items[{media.Id}]";
                var cardId = $"media-{media.Id:N}";
                var shownInGallery = isPicture && !isCover && media.ShowInGallery;
                if (shownInGallery) galleryPosition++;
                // What the Insert button drops into the article. Images go in as a figure, with the
                // caption in the language being edited when there is one; audio goes in as a player:
                // CKEditor has no audio plugin, so the markup it will finally be is what gets
                // inserted, and GeneralHtmlSupport keeps it intact through the model.
                var encodedCaption = System.Net.WebUtility.HtmlEncode(activeCaption ?? string.Empty);
                var insertHtml = media.Kind == SeminarMediaKind.Audio
                    ? $"<p><audio controls src=\"{url}\"></audio></p>"
                    : string.IsNullOrWhiteSpace(activeCaption)
                        ? $"<figure class=\"image\"><img src=\"{url}\" alt=\"\"></figure>"
                        : $"<figure class=\"image\"><img src=\"{url}\" alt=\"{encodedCaption}\"><figcaption>{encodedCaption}</figcaption></figure>";

                <li class="media-card @(isPicture && !isCover && !media.ShowInGallery ? "is-hidden-from-gallery" : "")"
                    id="@cardId" data-media-item draggable="true">
                    <input type="hidden" name="items.Index" value="@media.Id" />
                    <input type="hidden" name="@(field).MediaId" value="@media.Id" />

                    <div class="media-card__grip" data-media-grip aria-hidden="true" title="@Loc["Admin.Journal.Gallery.Drag"]">
                        <svg viewBox="0 0 24 24"><circle cx="9" cy="6" r="1.4" /><circle cx="15" cy="6" r="1.4" /><circle cx="9" cy="12" r="1.4" /><circle cx="15" cy="12" r="1.4" /><circle cx="9" cy="18" r="1.4" /><circle cx="15" cy="18" r="1.4" /></svg>
                    </div>

                    <a class="media-card__thumb" href="@url" target="_blank" rel="noopener" draggable="false">
                        @if (isPicture)
                        {
                            <img src="@url" alt="" loading="lazy" decoding="async" draggable="false" />
                        }
                        else
                        {
                            <span class="media-card__kind">@media.Kind</span>
                        }
                        <span class="media-card__position" data-media-position>@(shownInGallery ? galleryPosition.ToString() : "")</span>
                    </a>

                    <div class="media-card__body">
                        <div class="media-card__meta">
                            <strong title="@media.OriginalFileName">@(media.Title ?? media.OriginalFileName ?? url)</strong>
                            <span>@media.Kind · @((media.SizeBytes / 1024).ToString("N0")) KB</span>
                            @if (isCover)
                            {
                                <span class="admin-badge admin-badge--open">@Loc["Admin.Journal.IsCover"]</span>
                            }
                        </div>

                        @if (isPicture)
                        {
                            <fieldset class="media-card__captions">
                                <legend>@Loc["Admin.Journal.Gallery.Captions"]</legend>
                                @foreach (var culture in SiteCultures.All)
                                {
                                    var value = captions.TryGetValue(culture.Name, out var v) ? v : null;
                                    var inputId = $"{cardId}-{culture.UrlCode}";
                                    <div class="media-card__caption @(culture.Name == active.Culture.Name ? "is-active" : "")">
                                        <label for="@inputId" title="@culture.NativeLabel">@culture.ShortLabel</label>
                                        <input id="@inputId" type="text" name="@(field).Captions[@culture.Name]" value="@value"
                                               maxlength="@JournalMediaCaptions.MaxLength" lang="@culture.UrlCode"
                                               placeholder="@(culture.Name == SiteCultures.Default ? Loc["Admin.Journal.Gallery.CaptionPlaceholder"].Value : Loc["Admin.Journal.Gallery.CaptionInherits"].Value)" />
                                    </div>
                                }
                            </fieldset>

                            @if (isCover)
                            {
                                <p class="media-card__note">@Loc["Admin.Journal.Gallery.CoverNote"]</p>
                                <input type="hidden" name="@(field).ShowInGallery" value="@(media.ShowInGallery ? "true" : "false")" />
                            }
                            else
                            {
                                <label class="media-card__toggle">
                                    <input type="checkbox" name="@(field).ShowInGallery" value="true" @(media.ShowInGallery ? "checked" : null) />
                                    <span class="media-card__switch" aria-hidden="true"></span>
                                    @Loc["Admin.Journal.Gallery.Show"]
                                </label>
                            }
                        }
                        else
                        {
                            <input type="hidden" name="@(field).ShowInGallery" value="false" />
                        }

                        <div class="media-card__actions">
                            @if (media.Kind is SeminarMediaKind.Image or SeminarMediaKind.Animation or SeminarMediaKind.Audio)
                            {
                                <button type="button" class="admin-btn admin-btn--ghost"
                                        data-insert-html="@insertHtml"
                                        data-insert-target="@bodyFieldId">@Loc["Admin.Journal.Insert"]</button>
                            }
                            @if (media.Kind == SeminarMediaKind.Image && !isCover)
                            {
                                <button type="submit" class="admin-btn admin-btn--ghost" formnovalidate
                                        asp-action="SetCover" asp-route-id="@postId" name="mediaId" value="@media.Id">@Loc["Admin.Journal.UseAsCover"]</button>
                            }
                            <button type="submit" class="admin-btn admin-btn--danger" formnovalidate
                                    asp-action="RemoveMedia" asp-route-id="@postId" name="mediaId" value="@media.Id"
                                    data-confirm="@Loc["Admin.Journal.ConfirmRemoveMedia"]">@Loc["Admin.Journal.Delete"]</button>
                        </div>
                    </div>

                    <div class="media-card__move">
                        <button type="button" class="media-card__arrow" data-media-move="-1" aria-label="@Loc["Admin.Journal.Gallery.MoveUp"]">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 15l6-6 6 6" /></svg>
                        </button>
                        <button type="button" class="media-card__arrow" data-media-move="1" aria-label="@Loc["Admin.Journal.Gallery.MoveDown"]">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
                        </button>
                    </div>
                </li>
            }
        </ol>

        <div class="media-library__bar" data-media-bar>
            <span class="media-library__dirty" data-media-dirty hidden>@Loc["Admin.Journal.Gallery.Unsaved"]</span>
            <p class="media-library__announce visually-hidden" aria-live="polite" data-media-announce
               data-template="@Loc["Admin.Journal.Gallery.Moved"]"></p>
            <button type="submit" class="admin-btn">@Loc["Admin.Journal.Gallery.Save"]</button>
        </div>
    </form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

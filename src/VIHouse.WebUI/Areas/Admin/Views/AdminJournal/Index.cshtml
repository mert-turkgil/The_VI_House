@model List<AdminJournalListItemViewModel>
@{
    ViewData["Title"] = Loc["Admin.Journal.Title"].Value;
    var drafts = Model.Count(p => p.Status != JournalPostStatus.Published);
    var showSubmissions = ViewData["ShowSubmissions"] is true;
    var submitted = ViewData["SubmittedCount"] as int? ?? 0;

    string StatusBadge(JournalPostStatus status) => status switch
    {
        JournalPostStatus.Published => "admin-badge admin-badge--open",
        JournalPostStatus.Submitted => "admin-badge admin-badge--pending",
        JournalPostStatus.ChangesRequested => "admin-badge admin-badge--info",
        _ => "admin-badge admin-badge--draft",
    };
}

@if (TempData["StatusMessage"] is string status)
{
    <div class="admin-status-message">@status</div>
}

<div class="admin-toolbar">
    <a class="admin-btn" asp-action="Create">+ @Loc["Admin.Journal.New"]</a>
    <a class="admin-btn admin-btn--ghost" asp-area="" asp-controller="Journal" asp-action="Index" target="_blank" rel="noopener">@Loc["Admin.Journal.ViewJournal"]</a>
    @if (Model.Count > 0 && !showSubmissions)
    {
        <span class="admin-toolbar__note">@Loc["Admin.Journal.Summary", Model.Count - drafts, drafts]</span>
    }
</div>

@* Influencers' articles waiting for the editors. *@
<div class="admin-toolbar">
    <a class="@(showSubmissions ? "admin-btn admin-btn--ghost" : "admin-btn")" asp-action="Index">@Loc["Admin.Journal.Filter.All"]</a>
    <a class="@(showSubmissions ? "admin-btn" : "admin-btn admin-btn--ghost")" asp-action="Index" asp-route-show="submissions">@Loc["Admin.Journal.Filter.Submissions", submitted]</a>
</div>

@if (Model.Count == 0)
{
    @* An empty list explains itself and offers the one thing to do next. *@
    <div class="admin-empty">
        <span class="admin-empty__icon" aria-hidden="true"><partial name="_Icon" model="@("pen-square")" /></span>
        <h2 class="admin-empty__title">@Loc["Admin.Journal.EmptyTitle"]</h2>
        <p class="admin-empty__body">@Loc["Admin.Journal.EmptyBody"]</p>
        <a class="admin-btn" asp-action="Create">+ @Loc["Admin.Journal.New"]</a>
    </div>
}
else
{
    <div class="admin-table-scroll">
        <table class="admin-table" data-admin-table>
            <thead>
                <tr>
                    <th>@Loc["Admin.Journal.Title.Column"]</th>
                    <th>@Loc["Admin.Journal.Category"]</th>
                    <th>@Loc["Admin.Journal.Languages"]</th>
                    <th>@Loc["Admin.Journal.Status"]</th>
                    <th>@Loc["Admin.Journal.Published"]</th>
                    <th><span class="visually-hidden">@Loc["Admin.Table.Actions"]</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var post in Model)
                {
                    <tr>
                        <td>
                            <a class="admin-table__primary" asp-action="Edit" asp-route-id="@post.Id">@post.Title</a>
                            <div class="admin-table__sub">/journal/@post.Slug</div>
                            @if (post.SubmittedBy is not null)
                            {
                                <div class="admin-table__sub">@Loc["Admin.Journal.ByInfluencer", post.SubmittedBy]</div>
                            }
                        </td>
                        <td>@Loc["Journal.Category." + post.Category]</td>
                        <td>
                            @* Which languages are written, in site order, so a post that went live with
                               three empty translations is visible at a glance. *@
                            @foreach (var culture in SiteCultures.All)
                            {
                                var written = post.TranslatedCultures.Contains(culture.Name, StringComparer.OrdinalIgnoreCase);
                                <span class="@(written ? "admin-badge admin-badge--open" : "admin-badge admin-badge--draft")"
                                      title="@culture.NativeLabel: @(written ? Loc["Admin.Journal.Written"] : Loc["Admin.Journal.NotTranslated"])">@culture.ShortLabel</span>
                            }
                        </td>
                        <td>
                            <span class="@StatusBadge(post.Status)">@Loc["Admin.Publish.Status." + post.Status]</span>
                        </td>
                        <td class="admin-table__muted">@(post.PublishedAt?.ToString("d MMM yyyy") ?? "—")</td>
                        <td class="admin-table__actions">
                            <a class="admin-btn admin-btn--ghost admin-btn--sm" asp-action="Edit" asp-route-id="@post.Id">@Loc["Admin.Journal.Write"]</a>
                            <form asp-action="Delete" asp-route-id="@post.Id" method="post" class="admin-inline-form"
                                  data-confirm="@Loc["Admin.Journal.ConfirmDelete"]">
                                <button type="submit" class="admin-btn admin-btn--danger admin-btn--sm">@Loc["Admin.Journal.Delete"]</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

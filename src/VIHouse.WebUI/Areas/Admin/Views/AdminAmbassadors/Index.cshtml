@model List<Ambassador>
@{
    ViewData["Title"] = Loc["Admin.Nav.AdminAmbassadors"].Value;
}

@if (TempData["StatusMessage"] is string status)
{
    <div class="admin-status-message">@status</div>
}

<div class="admin-toolbar">
    <a class="admin-btn" asp-action="Create">@Loc["Admin.Ambassadors.InviteAnAmbassador"]</a>
</div>

@if (Model.Count == 0)
{
    <p>@Loc["Admin.Ambassadors.NoAmbassadorsYet"]</p>
}
else
{
    <div class="admin-table-scroll">
    <table class="admin-table" data-admin-table>
        <thead>
            <tr>
                <th>@Loc["Admin.Common.Name"]</th>
                <th>@Loc["Admin.Ambassadors.Code"]</th>
                <th>@Loc["Admin.Ambassadors.ReferralLink84"]</th>
                <th>@Loc["Admin.Ambassadors.Commission92"]</th>
                <th>@Loc["Admin.Common.Status"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td><a asp-action="Edit" asp-route-id="@a.Id">@a.Name</a></td>
                    <td>@a.Code</td>
                    <td>/r/@a.Code</td>
                    <td>@a.CommissionPercent%</td>
                    <td>
                        @if (a.Status == AmbassadorStatus.Pending)
                        {
                            var expired = a.InviteExpiresAt < DateTimeOffset.UtcNow;
                            <span class="admin-badge @(expired ? "admin-badge--danger" : "admin-badge--pending")">@Loc[expired ? "Admin.Ambassadors.InvitationExpired" : "Admin.Ambassadors.Invited"]</span>
                            <div class="admin-table__sub">@a.InviteEmail</div>
                        }
                        else
                        {
                            <span class="@(a.Status == AmbassadorStatus.Active ? "admin-badge admin-badge--open" : "admin-badge admin-badge--closed")">@Loc.Label(a.Status)</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

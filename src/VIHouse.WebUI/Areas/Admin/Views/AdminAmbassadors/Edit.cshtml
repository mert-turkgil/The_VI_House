@model AdminAmbassadorEditViewModel
@{
    ViewData["Title"] = Model.Name;
    var amb = Model.Ambassador;
    var pending = Model.Status == AmbassadorStatus.Pending;
    var inviteExpired = pending && amb.InviteExpiresAt < DateTimeOffset.UtcNow;
    var stats = Model.Stats;
    var purchases = stats?.Purchases ?? 0;
    var titleByTarget = stats?.Targets.ToDictionary(t => (t.Kind, t.Id), t => t.Title) ?? [];
    // Visits are only counted on /r/{code}; a typed code converts without one, so the rate is capped rather than shown above 100.
    var conversionRate = stats is { Visits: > 0 } ? Math.Min(100, (double)purchases / stats.Visits * 100) : 0;

    
}

@if (TempData["StatusMessage"] is string status)
{
    <div class="admin-status-message">@status</div>
}

<div class="admin-toolbar" style="justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap;">
    <div style="display:flex; align-items:center; gap:10px;">
        @if (pending)
        {
            <span class="admin-badge @(inviteExpired ? "admin-badge--danger" : "admin-badge--pending")">@Loc[inviteExpired ? "Admin.Ambassadors.InvitationExpired" : "Admin.Ambassadors.InvitedWaiting"]</span>
        }
        else
        {
            <span class="admin-badge @(Model.Status == AmbassadorStatus.Active ? "admin-badge--open" : "admin-badge--draft")">@Loc.Label(Model.Status)</span>
        }
        <span class="admin-table__sub">@Loc["Admin.Ambassadors.Since", Model.CreatedAt.ToString("d MMM yyyy")]</span>
    </div>
    <div style="display:flex; gap:8px; flex-wrap:wrap;">
        @if (Model.UserId is { } userId)
        {
            <a class="admin-btn admin-btn--ghost" asp-controller="AdminUsers" asp-action="Details" asp-route-id="@userId">@Loc["Admin.Ambassadors.OpenUserRecord"]</a>
        }
        <a class="admin-btn admin-btn--ghost" asp-action="Index">@Loc["Admin.Ambassadors.AllAmbassadors"]</a>
    </div>
</div>

<div class="admin-review-grid">
    <div class="admin-review-main">
        @* --- What is still missing before they can be paid ------------------------------------ *@
        <div class="admin-card" id="requirements">
            <h2>@Loc["Admin.Influencer.Requirements"]</h2>
            @if (Model.Missing.Count == 0)
            {
                <p class="admin-hint" style="margin-top:0;">@Loc["Admin.Influencer.RequirementsComplete"]</p>
            }
            else
            {
                <p class="admin-hint" style="margin-top:0;">@Loc["Admin.Influencer.RequirementsIntro"]</p>
            }
            <ul class="admin-checklist">
                @foreach (var requirement in Enum.GetValues<InfluencerRequirement>())
                {
                    var done = !Model.Missing.Contains(requirement);
                    <li class="admin-checklist__item @(done ? "is-done" : "is-missing")">
                        <span class="admin-checklist__mark" aria-hidden="true">@(done ? "✓" : "•")</span>
                        <span>@Loc.Label(requirement)</span>
                        <span class="admin-checklist__who">@Loc[requirement is InfluencerRequirement.Terms ? "Admin.Influencer.Who.Influencer" : requirement is InfluencerRequirement.LegalName or InfluencerRequirement.BillingAddress or InfluencerRequirement.BankDetails ? "Admin.Influencer.Who.Finance" : "Admin.Influencer.Who.Marketing"]</span>
                    </li>
                }
            </ul>
        </div>

        @* --- Public profile: Marketing keeps it, the influencer can too ------------------------ *@
        <div class="admin-card" id="profile">
            <h2>@Loc["Admin.Influencer.Section.Profile"]</h2>
            <div class="admin-influencer-photo">
                @if (Model.PhotoUrl is not null)
                {
                    <img src="@Model.PhotoUrl" alt="" width="96" height="96" loading="lazy" />
                }
                else
                {
                    <span class="admin-influencer-photo__empty" aria-hidden="true">@Model.Name[..1]</span>
                }
                @if (Model.CanEditProfile)
                {
                    <div class="admin-influencer-photo__actions">
                        <form asp-action="UploadPhoto" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="admin-inline-upload">
                            <label class="admin-btn admin-btn--ghost admin-btn--sm">
                                <input type="file" name="photo" accept=".jpg,.jpeg,.png,.webp,.avif" class="visually-hidden" data-autosubmit />
                                @Loc[Model.PhotoUrl is null ? "Admin.Influencer.AddPhoto" : "Admin.Influencer.ReplacePhoto"]
                            </label>
                            <noscript><button type="submit" class="admin-btn admin-btn--sm">@Loc["Admin.Common.Upload"]</button></noscript>
                        </form>
                        @if (Model.PhotoUrl is not null)
                        {
                            <form asp-action="RemovePhoto" asp-route-id="@Model.Id" method="post" data-confirm="@Loc["Admin.Influencer.RemovePhotoConfirm"]">
                                <button type="submit" class="admin-btn admin-btn--ghost admin-btn--sm">@Loc["Admin.Influencer.RemovePhoto"]</button>
                            </form>
                        }
                        <p class="admin-field__hint">@Loc["Admin.Influencer.PhotoHint"]</p>
                    </div>
                }
            </div>
            @if (Model.CanEditProfile)
            {
                <form asp-action="SaveProfile" asp-route-id="@Model.Id" method="post" class="admin-form" style="max-width:none;">
                    <partial name="_ProfileFields" model="Model.ProfileForm" view-data='@(new ViewDataDictionary(ViewData) { ["Prefix"] = "ProfileForm" })' />
                    <div><button type="submit" class="admin-btn">@Loc["Admin.Influencer.SaveProfile"]</button></div>
                </form>
            }
            else
            {
                <dl class="admin-detail-list">
                    <div><dt>@Loc["Admin.Influencer.Niche"]</dt><dd>@(amb.Niche ?? "—")</dd></div>
                    <div><dt>@Loc["Admin.Influencer.Bio"]</dt><dd style="white-space:pre-line;">@(amb.Bio ?? "—")</dd></div>
                    <div>
                        <dt>@Loc["Admin.Influencer.Channels"]</dt>
                        <dd>
                            @if (amb.Channels.Count == 0) { <text>—</text> }
                            @foreach (var c in amb.Channels)
                            {
                                <div>@Loc.Label(c.Platform): <a href="@c.Url" target="_blank" rel="noopener noreferrer">@VIHouse.Business.SocialLinks.Handle(c.Url)</a>@if (c.Audience is { } audience) { <span class="admin-table__sub"> · @audience.ToString("N0")</span> }</div>
                            }
                        </dd>
                    </div>
                </dl>
            }
        </div>

        @if (pending)
        {
            <div class="admin-card">
                <h2>@Loc["Admin.Ambassadors.Invitation"]</h2>
                <p class="admin-hint" style="margin-top:0;">
                    @Loc.Html("Admin.Ambassadors.NotAcceptedYet", Model.Name, LocalizerHtml.Code(Model.Code))
                </p>
                <dl class="admin-detail-list">
                    <div><dt>@Loc["Admin.Ambassadors.SentTo"]</dt><dd>@amb.InviteEmail</dd></div>
                    <div><dt>@Loc["Admin.Common.Language"]</dt><dd>@SiteCultures.Describe(amb.PreferredCulture).NativeLabel</dd></div>
                    <div><dt>@Loc["Admin.Ambassadors.LastSent"]</dt><dd>@amb.InviteSentAt?.ToLocalTime().ToString("d MMM yyyy, HH:mm")</dd></div>
                    <div><dt>@Loc[inviteExpired ? "Admin.Ambassadors.InviteExpired" : "Admin.Ambassadors.InviteExpires"]</dt><dd>@amb.InviteExpiresAt?.ToLocalTime().ToString("d MMM yyyy, HH:mm")</dd></div>
                </dl>
                @if (User.IsInRole(VIHouse.DataAccess.Identity.Roles.SuperAdmin) || User.IsInRole(VIHouse.DataAccess.Identity.Roles.Marketing))
                {
                    <form asp-action="ResendInvite" asp-route-id="@Model.Id" method="post" class="admin-form" style="margin-top:12px;">
                        <div class="admin-form__grid">
                            <div class="admin-field">
                                <label for="resend-email">@Loc["Admin.Common.Email"]</label>
                                <input id="resend-email" name="email" type="email" value="@amb.InviteEmail" maxlength="256" />
                                <p class="admin-field__hint">@Loc["Admin.Ambassadors.CorrectItHereIfItWas"]</p>
                            </div>
                            <div class="admin-field">
                                <label for="resend-culture">@Loc["Admin.Common.Language"]</label>
                                <select id="resend-culture" name="culture">
                                    @foreach (var c in SiteCultures.All)
                                    {
                                        <option value="@c.Name" selected="@(c.Name == SiteCultures.Normalise(amb.PreferredCulture))">@c.NativeLabel</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <button type="submit" class="admin-btn">@Loc["Admin.Ambassadors.ReSendInvitation"]</button>
                        <span class="admin-table__sub">@Loc["Admin.Ambassadors.NewLinkValidFor", (int)VIHouse.Business.Abstract.IAmbassadorService.InviteLifetime.TotalDays]</span>
                    </form>
                    <form asp-action="WithdrawInvite" asp-route-id="@Model.Id" method="post" style="margin-top:12px;"
                          data-confirm="@Loc["Admin.Ambassadors.WithdrawConfirm", Model.Code]">
                        <button type="submit" class="admin-btn admin-btn--ghost admin-btn--sm">@Loc["Admin.Ambassadors.WithdrawInvitation"]</button>
                    </form>
                }
            </div>
        }
        else
        {

        @* --- The link ------------------------------------------------------------------------ *@
        <div class="admin-card referral-card">
            <div class="referral-card__main">
                <h2>@Loc["Admin.Ambassadors.ReferralLink"]</h2>
                <p class="admin-hint" style="margin-top:0;">@Loc["Admin.Ambassadors.LinkHint", Model.Name]</p>

                <div class="referral-card__link">
                    <code data-referral-url="@Model.ReferralUrl">@Model.ReferralUrl</code>
                    <button type="button" class="admin-btn admin-btn--sm" data-copy="@Model.ReferralUrl" data-copied-label="@Loc["Admin.Ambassadors.Copied"]">@Loc["Admin.Ambassadors.CopyLink"]</button>
                </div>

                <div class="referral-card__row">
                    <span class="referral-card__code">@Loc["Admin.Ambassadors.Code"] <strong data-copy="@Model.Code" data-copied-label="@Loc["Admin.Ambassadors.Copied"]" role="button" tabindex="0" title="@Loc["Admin.Ambassadors.ClickToCopy"]">@Model.Code</strong></span>
                    <a class="admin-btn admin-btn--ghost admin-btn--sm" href="@Model.ReferralUrl" target="_blank" rel="noopener">@Loc["Admin.Ambassadors.OpenInNewTab"]</a>
                </div>

                @if (Model.Email is not null)
                {
                    @* One click, from the House, with the absolute URL and the code — instead of an
                       admin pasting "/r/CODE" into a mail by hand. *@
                    <details class="referral-card__send">
                        <summary class="admin-btn admin-btn--sm">@Loc["Admin.Ambassadors.EmailLinkTo", Model.Email]</summary>
                        <form asp-action="SendLink" asp-route-id="@Model.Id" method="post" class="admin-form" style="margin-top:12px;">
                            <div class="admin-field">
                                <label for="send-note">@Loc["Admin.Ambassadors.PersonalNoteOptional"]</label>
                                <textarea id="send-note" name="note" rows="3" maxlength="600" placeholder="@Loc["Admin.Ambassadors.EGLovelyToHaveYou"]"></textarea>
                            </div>
                            <button type="submit" class="admin-btn admin-btn--sm">@Loc["Admin.Ambassadors.SendEmail"]</button>
                        </form>
                    </details>
                }
            </div>
            <figure class="referral-card__qr" aria-label="@Loc["Admin.Ambassadors.QRCodeForTheReferralLink"]">
                @Html.Raw(Model.QrSvg)
                <figcaption>@Loc["Admin.Ambassadors.ScanOrDropOnASlide"]</figcaption>
            </figure>
        </div>

        @* --- One link per experience and session --------------------------------------------- *@
        @if (Model.Links is not null)
        {
            <div class="admin-card">
                <h2>@Loc["Admin.Ambassadors.LinksPerExperienceAndSession"]</h2>
                <p class="admin-hint" style="margin-top:0;">@Loc["Admin.Ambassadors.PerPageLinksHint", Model.Name]</p>
                <partial name="/Views/Shared/_ReferralLinks.cshtml" model="Model.Links" />
            </div>
        }

        @* --- Tracked links -------------------------------------------------------------------- *@
        <div class="admin-card" data-utm-builder data-utm-base="@Model.ReferralUrl">
            <h2>@Loc["Admin.Ambassadors.TrackedLinkForAChannel"]</h2>
            <p class="admin-hint" style="margin-top:0;">@Loc["Admin.Ambassadors.GiveEachChannelItsOwnLink"]</p>
            <div class="admin-form__grid">
                @if (Model.Links is not null && Model.Links.Targets.Count > 0)
                {
                    <div class="admin-field">
                        <label for="utm-target">@Loc["Admin.Ambassadors.Link"]</label>
                        <select id="utm-target" data-utm-target>
                            <option value="@Model.ReferralUrl">@Loc["Admin.Ambassadors.SiteLink"]</option>
                            @foreach (var t in Model.Links.Targets)
                            {
                                <option value="@Model.Links.LinkFor(t)">@Loc.Label(t.Kind): @t.Title</option>
                            }
                        </select>
                    </div>
                }
                <div class="admin-field">
                    <label for="utm-source">@Loc["Admin.Ambassadors.Source"]</label>
                    <input id="utm-source" data-utm="source" list="utm-sources" placeholder="instagram" autocomplete="off" />
                    <datalist id="utm-sources">
                        <option value="instagram"></option><option value="linkedin"></option><option value="youtube"></option>
                        <option value="tiktok"></option><option value="newsletter"></option><option value="podcast"></option><option value="whatsapp"></option>
                    </datalist>
                </div>
                <div class="admin-field">
                    <label for="utm-medium">@Loc["Admin.Ambassadors.Medium"]</label>
                    <input id="utm-medium" data-utm="medium" list="utm-mediums" placeholder="story" autocomplete="off" />
                    <datalist id="utm-mediums">
                        <option value="post"></option><option value="story"></option><option value="bio"></option><option value="video"></option><option value="email"></option>
                    </datalist>
                </div>
                <div class="admin-field">
                    <label for="utm-campaign">@Loc["Admin.Ambassadors.Campaign"]</label>
                    <input id="utm-campaign" data-utm="campaign" placeholder="lisbon-2026" autocomplete="off" />
                </div>
            </div>
            <div class="referral-card__link">
                <code data-utm-preview>@Model.ReferralUrl</code>
                <button type="button" class="admin-btn admin-btn--sm" data-copy="@Model.ReferralUrl" data-utm-copy data-copied-label="@Loc["Admin.Ambassadors.Copied"]">@Loc["Admin.Ambassadors.CopyTrackedLink"]</button>
            </div>
        </div>

        @* --- Performance ---------------------------------------------------------------------- *@
        <div class="admin-card">
            <h2>@Loc["Admin.Ambassadors.Performance"]</h2>
            <p class="admin-hint" style="margin-top:0;">@Loc["Admin.Ambassadors.CountsAndRevenueOnlyNoNames"]</p>
            @if (stats is not null)
            {
                <div class="admin-kpi-grid">
                    <div class="admin-kpi-card">
                        <div class="admin-kpi-card__value">@stats.Visits</div>
                        <div class="admin-kpi-card__label">@Loc["Admin.Ambassadors.Visits"]</div>
                    </div>
                    <div class="admin-kpi-card">
                        <div class="admin-kpi-card__value">@stats.Applications</div>
                        <div class="admin-kpi-card__label">@Loc["Admin.Ambassadors.Applications"]</div>
                    </div>
                    <div class="admin-kpi-card">
                        <div class="admin-kpi-card__value">@stats.ApprovedApplications</div>
                        <div class="admin-kpi-card__label">@Loc["Admin.Ambassadors.Approved"]</div>
                    </div>
                    <div class="admin-kpi-card">
                        <div class="admin-kpi-card__value">@purchases</div>
                        <div class="admin-kpi-card__label">@Loc["Admin.Ambassadors.Purchases"] <span class="admin-table__sub">@Loc["Admin.Ambassadors.PurchaseSplit", stats.TicketPurchases, stats.MembershipPurchases, stats.SessionPurchases]</span></div>
                    </div>
                    <div class="admin-kpi-card">
                        <div class="admin-kpi-card__value">@conversionRate.ToString("0.#")%</div>
                        <div class="admin-kpi-card__label">@Loc["Admin.Ambassadors.VisitPurchase"]</div>
                    </div>
                    @foreach (var (currency, amountMinor) in stats.RevenueByCurrency)
                    {
                        <div class="admin-kpi-card">
                            <div class="admin-kpi-card__value">@MoneyFormatter.Format(amountMinor, currency)</div>
                            <div class="admin-kpi-card__label">@Loc["Admin.Ambassadors.RevenueIn", currency]</div>
                        </div>
                    }
                    @foreach (var (currency, amountMinor) in stats.CommissionByCurrency)
                    {
                        <div class="admin-kpi-card admin-kpi-card--accent">
                            <div class="admin-kpi-card__value">@MoneyFormatter.Format(amountMinor, currency)</div>
                            <div class="admin-kpi-card__label">@Loc["Admin.Ambassadors.CommissionEarnedIn", currency] <span class="admin-table__sub">@Loc["Admin.Ambassadors.NetOfRefunds"]</span></div>
                        </div>
                    }
                </div>
            }

            @if (stats is { Targets.Count: > 0 })
            {
                <h3>@Loc["Admin.Ambassadors.WhichLinkIsWorking"]</h3>
                <table class="admin-table admin-table--compact">
                    <thead><tr><th>@Loc["Admin.Ambassadors.Link"]</th><th style="text-align:right;">@Loc["Admin.Ambassadors.Visits"]</th><th style="text-align:right;">@Loc["Admin.Ambassadors.Applications"]</th><th style="text-align:right;">@Loc["Admin.Ambassadors.Purchases"]</th></tr></thead>
                    <tbody>
                        @foreach (var t in stats.Targets)
                        {
                            <tr>
                                <td><span class="admin-badge admin-badge--draft">@Loc.Label(t.Kind)</span> @(t.Kind == ReferralTargetKind.Site ? Loc["Admin.Ambassadors.WholeSite"].Value : t.Title ?? Loc["Admin.Influencer.NoLongerListed"].Value)</td>
                                <td style="text-align:right;">@t.Visits</td>
                                <td style="text-align:right;">@t.Applications</td>
                                <td style="text-align:right;">@t.Purchases</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            <div class="referral-split">
                <section>
                    <h3>@Loc["Admin.Ambassadors.VisitsBySource"]</h3>
                    @if (Model.VisitSources.Count == 0)
                    {
                        <p class="admin-hint" style="margin-top:0;">@Loc["Admin.Ambassadors.NoVisitsYet"]</p>
                    }
                    else
                    {
                        <table class="admin-table admin-table--compact">
                            <thead><tr><th>@Loc["Admin.Ambassadors.Source"]</th><th>@Loc["Admin.Ambassadors.Medium"]</th><th style="text-align:right;">@Loc["Admin.Ambassadors.Visits"]</th></tr></thead>
                            <tbody>
                                @foreach (var s in Model.VisitSources)
                                {
                                    <tr>
                                        <td>@(s.Source ?? "direct / untagged")</td>
                                        <td>@(s.Medium ?? "—")</td>
                                        <td style="text-align:right;">@s.Visits</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </section>
                <section>
                    <h3>@Loc["Admin.Ambassadors.RecentActivity"]</h3>
                    @if (Model.Conversions.Count == 0)
                    {
                        <p class="admin-hint" style="margin-top:0;">@Loc["Admin.Ambassadors.NothingYetEachApplicationApprovalAnd"]</p>
                    }
                    else
                    {
                        <ol class="ambassador-timeline">
                            @foreach (var c in Model.Conversions)
                            {
                                <li class="ambassador-timeline__item">
                                    <time datetime="@c.OccurredAt.ToString("o")">@c.OccurredAt.ToString("d MMM yyyy, HH:mm")</time>
                                    <span class="ambassador-timeline__what">
                                        @Loc.Label(c.Kind)
                                        @if (c.TargetKind != ReferralTargetKind.Site && titleByTarget.TryGetValue((c.TargetKind, c.TargetId), out var about))
                                        {
                                            <em class="ambassador-timeline__about">&middot; @about</em>
                                        }
                                    </span>
                                    @if (c.AmountMinor is { } amount && c.Currency is not null)
                                    {
                                        <span class="ambassador-timeline__money">
                                            @MoneyFormatter.Format(amount, c.Currency)
                                            @if (c.CommissionMinor is { } commission)
                                            {
                                                <em>&middot; commission @MoneyFormatter.Format(c.NetCommissionMinor, c.Currency)@if (c.CommissionReversedMinor > 0) { <text> (of @MoneyFormatter.Format(commission, c.Currency))</text> }</em>
                                            }
                                        </span>
                                        <span class="ambassador-timeline__flags" style="display:flex; gap:6px; flex-wrap:wrap; margin-top:4px;">
                                            @if (c.IsSelfReferral)
                                            {
                                                <span class="admin-badge admin-badge--danger" title="@Loc["Admin.Ambassadors.TheBuyerSAccountIsThe"]">@Loc["Admin.Ambassadors.SelfReferral"]</span>
                                            }
                                            @if (c.ReversedAt is not null)
                                            {
                                                <span class="admin-badge admin-badge--draft">@Loc["Admin.Ambassadors.Refunded"]</span>
                                            }
                                            else if (c.RefundedMinor > 0)
                                            {
                                                <span class="admin-badge admin-badge--draft">@Loc["Admin.Ambassadors.PartlyRefunded", MoneyFormatter.Format(c.RefundedMinor, c.Currency)]</span>
                                            }
                                            @if (c.VoidedAt is not null)
                                            {
                                                <span class="admin-badge admin-badge--draft" title="@c.VoidReason">@Loc["Admin.Ambassadors.CommissionWithdrawn"]</span>
                                            }
                                            @if (c.PayoutId is not null)
                                            {
                                                <span class="admin-badge admin-badge--paid">@Loc["Admin.Ambassadors.PaidOut"]</span>
                                            }
                                            else if (c.NetCommissionMinor > 0)
                                            {
                                                <span class="admin-badge admin-badge--pending">@Loc["Admin.Ambassadors.Owed"]</span>
                                            }
                                        </span>
                                        @if (c.VoidedAt is not null && c.VoidReason is not null)
                                        {
                                            <span class="admin-table__sub">@Loc["Admin.Ambassadors.WithdrawnOn", c.VoidedAt.Value.ToString("d MMM yyyy"), c.VoidReason ?? ""]</span>
                                        }
                                        @if (Model.CanSettle && c.VoidedAt is null && c.NetCommissionMinor > 0)
                                        {
                                            <details style="margin-top:4px;">
                                                <summary class="admin-table__sub" style="cursor:pointer;">@Loc["Admin.Ambassadors.WithdrawCommission"]</summary>
                                                <form asp-action="VoidConversion" asp-route-id="@Model.Id" asp-route-conversionId="@c.Id" method="post" class="admin-form" style="margin-top:6px;">
                                                    <input name="reason" maxlength="300" required placeholder="@Loc["Admin.Ambassadors.ReasonEGSelfReferral"]" />
                                                    <button type="submit" class="admin-btn admin-btn--ghost admin-btn--sm">@Loc["Admin.Ambassadors.Withdraw"]</button>
                                                </form>
                                            </details>
                                        }
                                    }
                                </li>
                            }
                        </ol>
                    }
                </section>
            </div>
        </div>
        }

        @* --- Their journal articles ---------------------------------------------------------- *@
        @if (Model.UserId is not null)
        {
            <div class="admin-card" id="journal">
                <h2>@Loc["Admin.Influencer.Journal"]</h2>
                @if (Model.Posts.Count == 0)
                {
                    <p class="admin-hint" style="margin-top:0;">@Loc["Admin.Influencer.JournalNone"]</p>
                }
                else
                {
                    <table class="admin-table admin-table--compact">
                        <thead><tr><th>@Loc["Admin.Common.Title"]</th><th>@Loc["Admin.Common.Status"]</th><th>@Loc["Admin.Common.Date"]</th></tr></thead>
                        <tbody>
                            @foreach (var post in Model.Posts)
                            {
                                <tr>
                                    <td><a asp-controller="AdminJournal" asp-action="Edit" asp-route-id="@post.Id">@JournalContent.Title(post, SiteCultures.Default)</a></td>
                                    <td><span class="admin-badge @(post.Status switch { JournalPostStatus.Published => "admin-badge--open", JournalPostStatus.Submitted => "admin-badge--pending", _ => "admin-badge--draft" })">@Loc["Admin.Publish.Status." + post.Status]</span></td>
                                    <td>@((post.PublishedAt ?? post.SubmittedAt ?? post.CreatedAt).ToLocalTime().ToString("d MMM yyyy"))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        }
    </div>

    <div class="admin-review-side">
        @* --- Commission: earned, paid, owed ------------------------------------------------------ *@
        <div class="admin-card">
            <h2>@Loc["Admin.Ambassadors.Commission92"]</h2>
            @if (stats is null || stats.Balances.Count == 0)
            {
                <p class="admin-hint" style="margin-top:0;">@Loc["Admin.Ambassadors.NothingEarnedYet"]</p>
            }
            else
            {
                foreach (var b in stats.Balances)
                {
                    <dl class="admin-detail-list">
                        <div><dt>@Loc["Admin.Ambassadors.EarnedIn", b.Currency]</dt><dd>@MoneyFormatter.Format(b.EarnedMinor, b.Currency)</dd></div>
                        <div><dt>@Loc["Admin.Ambassadors.Paid"]</dt><dd>@MoneyFormatter.Format(b.PaidMinor, b.Currency)</dd></div>
                        <div>
                            <dt>@Loc[b.OwedMinor < 0 ? "Admin.Ambassadors.Overpaid" : "Admin.Ambassadors.Owed"]</dt>
                            <dd><strong>@MoneyFormatter.Format(Math.Abs(b.OwedMinor), b.Currency)</strong></dd>
                        </div>
                    </dl>
                    @if (b.OwedMinor < 0)
                    {
                        <p class="admin-hint">@Loc["Admin.Ambassadors.ARefundLandedAfterThisWas"]</p>
                    }
                    else if (b.OwedMinor > 0 && Model.CanSettle)
                    {
                        <form asp-action="RecordPayout" asp-route-id="@Model.Id" method="post" class="admin-form" style="margin-bottom:16px;">
                            <input type="hidden" name="currency" value="@b.Currency" />
                            <input type="hidden" name="expectedOwedMinor" value="@b.OwedMinor" />
                            <div class="admin-field">
                                <label for="payout-ref-@b.Currency">@Loc["Admin.Ambassadors.TransferReference"]</label>
                                <input id="payout-ref-@b.Currency" name="reference" maxlength="100" placeholder="@Loc["Admin.Ambassadors.EGBankTransferRef"]" />
                            </div>
                            <div class="admin-field">
                                <label for="payout-note-@b.Currency">@Loc["Admin.Ambassadors.NoteOptional"]</label>
                                <input id="payout-note-@b.Currency" name="note" maxlength="500" />
                            </div>
                            <label class="admin-checkbox" style="display:flex; gap:8px; align-items:flex-start; margin-bottom:10px;">
                                <input type="checkbox" name="confirmed" value="true" required />
                                <span>@Loc["Admin.Ambassadors.IHaveSent", MoneyFormatter.Format(b.OwedMinor, b.Currency), Model.Name]</span>
                            </label>
                            <button type="submit" class="admin-btn" style="width:100%;">@Loc["Admin.Ambassadors.MarkAsPaid", MoneyFormatter.Format(b.OwedMinor, b.Currency)]</button>
                        </form>
                    }
                }
                <p class="admin-hint" style="margin-top:0;">@Loc["Admin.Ambassadors.CommissionRule"]@(Model.CanSettle ? "" : " " + Loc["Admin.Ambassadors.FinanceRecordsPayouts"].Value)</p>
            }

            @if (Model.Payouts.Count > 0)
            {
                <h3>@Loc["Admin.Ambassadors.Payouts"]</h3>
                <table class="admin-table admin-table--compact">
                    <thead><tr><th>@Loc["Admin.Common.Date"]</th><th>@Loc["Admin.Ambassadors.Reference"]</th><th style="text-align:right;">@Loc["Admin.Common.Amount"]</th></tr></thead>
                    <tbody>
                        @foreach (var p in Model.Payouts)
                        {
                            <tr>
                                <td>@p.PaidAt.ToLocalTime().ToString("d MMM yyyy")</td>
                                <td>@(p.Reference ?? "—")@if (p.Note is not null) { <div class="admin-table__sub">@p.Note</div> }</td>
                                <td style="text-align:right;">@MoneyFormatter.Format(p.AmountMinor, p.Currency)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            @if (Model.Withdrawals.Count > 0)
            {
                <h3 id="withdrawals">@Loc["Admin.Influencer.WithdrawalRequests"]</h3>
                <ul class="admin-inline-list" style="margin-bottom:0;">
                    @foreach (var w in Model.Withdrawals.Take(10))
                    {
                        <li class="admin-inline-list__row">
                            <span>
                                <strong>@MoneyFormatter.Format(w.RequestedMinor, w.Currency)</strong>
                                <span class="admin-table__sub">@w.RequestedAt.ToLocalTime().ToString("d MMM yyyy")</span>
                            </span>
                            <span class="admin-badge @(w.Status == WithdrawalStatus.Open ? "admin-badge--pending" : w.Status == WithdrawalStatus.Paid ? "admin-badge--open" : "admin-badge--draft")">@Loc.Label(w.Status)</span>
                        </li>
                    }
                </ul>
                @if (Model.Withdrawals.Any(w => w.Status == WithdrawalStatus.Open))
                {
                    <p class="admin-hint"><a asp-controller="AdminWithdrawals" asp-action="Index">@Loc["Admin.Influencer.OpenInWithdrawals"]</a></p>
                }
            }
        </div>

        @* --- Fraud signals ---------------------------------------------------------------------- *@
        @if (Model.Signals is { } sig)
        {
            <div class="admin-card">
                <h2>@Loc["Admin.Ambassadors.Signals"]</h2>
                @if (sig.Warnings.Count == 0)
                {
                    <p class="admin-hint" style="margin-top:0;">@Loc["Admin.Ambassadors.NothingUnusual", sig.WindowDays]</p>
                }
                else
                {
                    <ul style="margin:0 0 12px; padding-left:18px;">
                        @foreach (var w in sig.Warnings)
                        {
                            <li style="margin-bottom:6px;">@Loc[w.Key, w.Args]</li>
                        }
                    </ul>
                }
                <dl class="admin-detail-list">
                    <div><dt>@Loc["Admin.Ambassadors.VisitsInDays", sig.WindowDays]</dt><dd>@sig.Visits</dd></div>
                    <div><dt>@Loc["Admin.Ambassadors.DistinctNetworks"]</dt><dd>@sig.DistinctNetworks</dd></div>
                    <div><dt>@Loc["Admin.Ambassadors.BusiestNetwork"]</dt><dd>@sig.TopNetworkVisits (@sig.TopNetworkShare.ToString("P0"))</dd></div>
                    <div><dt>@Loc["Admin.Ambassadors.AutomatedLooking"]</dt><dd>@sig.AutomatedVisits</dd></div>
                    <div><dt>@Loc["Admin.Ambassadors.OwnClicks"]</dt><dd>@sig.OwnVisits</dd></div>
                    <div><dt>@Loc["Admin.Ambassadors.SelfReferrals"]</dt><dd>@sig.SelfReferrals</dd></div>
                </dl>
                <p class="admin-hint">@Loc["Admin.Ambassadors.IPAddressesAreStoredOnlyAs"]</p>
            </div>
        }

        <div class="admin-card">
            <h2>@Loc["Admin.Ambassadors.Settings"]</h2>
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="admin-form">
                <div asp-validation-summary="ModelOnly" class="field-validation-error"></div>
                <div class="admin-field">
                    <label asp-for="Name">@Loc["Admin.Ambassadors.DisplayName"]</label>
                    <input asp-for="Name" />
                    <span asp-validation-for="Name" class="field-validation-error"></span>
                </div>
                <div class="admin-field">
                    <label asp-for="CommissionPercent">@Loc["Admin.Ambassadors.Commission"]</label>
                    <input asp-for="CommissionPercent" type="number" step="0.01" min="0" max="100" />
                    <p class="admin-field__hint">@Loc["Admin.Ambassadors.RateHint"]@(pending ? " " + Loc["Admin.Ambassadors.RateHintPending"].Value : "")</p>
                    <span asp-validation-for="CommissionPercent" class="field-validation-error"></span>
                </div>
                <div class="admin-field">
                    <label asp-for="Status"></label>
                    @if (pending)
                    {
                        <input type="hidden" asp-for="Status" />
                        <p style="margin:0;">@Loc["Admin.Ambassadors.PendingBecomesActiveWhenTheyAccept"]</p>
                    }
                    else
                    {
                        <select asp-for="Status">
                            <option value="@AmbassadorStatus.Active">@Loc["Admin.Common.Active"]</option>
                            <option value="@AmbassadorStatus.Inactive">@Loc["Admin.Ambassadors.Inactive"]</option>
                        </select>
                        <p class="admin-field__hint">@Loc["Admin.Ambassadors.InactiveHint"]</p>
                    }
                </div>
                @if (User.IsInRole(VIHouse.DataAccess.Identity.Roles.SuperAdmin) || User.IsInRole(VIHouse.DataAccess.Identity.Roles.Marketing))
                {
                    <button type="submit" class="admin-btn" style="width:100%;">@Loc["Admin.Ambassadors.SaveChanges"]</button>
                }
            </form>
        </div>

        <div class="admin-card">
            <h2>@Loc["Admin.Ambassadors.Account"]</h2>
            <dl class="admin-detail-list">
                <div><dt>@Loc["Admin.Common.Email"]</dt><dd>@(Model.Email ?? "—")@if (Model.UserId is null) { <span class="admin-table__sub"> @Loc["Admin.Ambassadors.InvitedNoAccountYet"]</span> }</dd></div>
                @if (Model.AccountName is { Length: > 0 } realName)
                {
                    <div><dt>@Loc["Admin.Ambassadors.NameOnAccount"]</dt><dd>@realName</dd></div>
                }
                <div><dt>@Loc["Admin.Ambassadors.Code"]</dt><dd><code>@Model.Code</code> <span class="admin-table__sub">@Loc["Admin.Ambassadors.FixedLinksAlreadySharedDependOn"]</span></dd></div>
                <div><dt>@Loc["Admin.Ambassadors.TheirDashboard"]</dt><dd><a asp-area="" asp-controller="Influencer" asp-action="Index" target="_blank" rel="noopener">/influencer</a> <span class="admin-table__sub">@Loc["Admin.Ambassadors.WhatTheySeeWhenSignedIn"]</span></dd></div>
            </dl>
        </div>

        @if (!pending)
        {
            <div class="admin-card">
                <h2>@Loc["Admin.Ambassadors.Terms"]</h2>
                @if (amb.TermsAcceptedAt is { } accepted)
                {
                    <dl class="admin-detail-list">
                        <div><dt>@Loc["Admin.Ambassadors.Accepted"]</dt><dd>@accepted.ToLocalTime().ToString("d MMM yyyy, HH:mm")</dd></div>
                        <div><dt>@Loc["Admin.Ambassadors.Version"]</dt><dd>@amb.TermsVersion</dd></div>
                        <div><dt>@Loc["Admin.Ambassadors.RateInTheTerms"]</dt><dd>@amb.TermsCommissionPercent?.ToString("0.##")%</dd></div>
                    </dl>
                    @if (amb.TermsCommissionPercent is { } agreed && agreed != amb.CommissionPercent)
                    {
                        <p class="admin-hint" style="color:var(--vih-danger);">@Loc["Admin.Ambassadors.RateChanged", amb.CommissionPercent.ToString("0.##"), agreed.ToString("0.##")]</p>
                    }
                }
                else
                {
                    <p class="admin-hint" style="margin-top:0;">@Loc["Admin.Ambassadors.NoAmbassadorTermsOnRecordThis"]</p>
                }
            </div>

        }

        @* --- Legal identity and bank: what the House pays against. Finance keeps it. ---------- *@
        <div class="admin-card" id="payout-details">
            <h2>@Loc["Admin.Ambassadors.BillingPayout"]</h2>
            @if (amb.HasPayoutDetails)
            {
                <dl class="admin-detail-list">
                    @if (amb.LegalFirstName is not null)
                    {
                        <div><dt>@Loc["Admin.Influencer.LegalName"]</dt><dd>@amb.LegalFirstName @amb.LegalLastName</dd></div>
                    }
                    <div><dt>@Loc["Admin.Ambassadors.AccountHolder"]</dt><dd>@amb.PayoutAccountHolder</dd></div>
                    <div><dt>IBAN</dt><dd><code>@(Model.CanSettle ? Iban.Format(amb.PayoutIban) : Iban.Mask(amb.PayoutIban))</code></dd></div>
                    @if (Model.CanSettle && amb.PayoutBic is not null)
                    {
                        <div><dt>BIC</dt><dd><code>@amb.PayoutBic</code></dd></div>
                    }
                    <div><dt>@Loc["Admin.Ambassadors.BillingAddress"]</dt><dd>@amb.BillingAddressLine1@if (amb.BillingAddressLine2 is not null) { <br />@amb.BillingAddressLine2 }<br />@amb.BillingPostalCode @amb.BillingCity<br />@Countries.NameFor(amb.BillingCountry)</dd></div>
                    @if (amb.TaxId is not null)
                    {
                        <div><dt>@Loc["Admin.Ambassadors.TaxVATId"]</dt><dd>@amb.TaxId</dd></div>
                    }
                    <div><dt>@Loc["Admin.Influencer.BankChanged"]</dt><dd>@amb.PayoutDetailsUpdatedAt?.ToLocalTime().ToString("d MMM yyyy")</dd></div>
                </dl>
                @if (!Model.CanSettle)
                {
                    <p class="admin-hint">@Loc["Admin.Ambassadors.FullBankDetailsAreShownTo"]</p>
                }
            }
            else
            {
                <p class="admin-hint" style="margin-top:0;">@Loc["Admin.Influencer.NoPayoutDetails"]</p>
            }

            @if (Model.CanSettle)
            {
                <details class="admin-disclosure" open="@Model.EditPayoutDetails">
                    <summary class="admin-btn admin-btn--ghost admin-btn--sm">@Loc["Admin.Influencer.EditPayoutDetails"]</summary>
                    <form asp-action="SavePayoutDetails" asp-route-id="@Model.Id" method="post" class="admin-form" style="margin-top:12px;">
                        <div asp-validation-summary="ModelOnly" class="field-validation-error"></div>
                        <partial name="_PayoutFields" model="Model.PayoutForm" view-data='@(new ViewDataDictionary(ViewData) { ["Prefix"] = "PayoutForm" })' />
                        <p class="admin-field__hint">@Loc["Admin.Influencer.PayoutAudited"]</p>
                        <div><button type="submit" class="admin-btn">@Loc["Admin.Influencer.SavePayoutDetails"]</button></div>
                    </form>
                </details>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

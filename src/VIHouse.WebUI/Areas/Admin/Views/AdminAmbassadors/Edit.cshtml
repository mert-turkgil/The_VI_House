@model AdminAmbassadorEditViewModel
@{
    ViewData["Title"] = Model.Name;
    var stats = Model.Stats;
    var purchases = stats?.Purchases ?? 0;
    var titleByTarget = stats?.Targets.ToDictionary(t => (t.Kind, t.Id), t => t.Title) ?? [];
    // Visits are only counted on /r/{code}; a typed code converts without one, so the rate is capped rather than shown above 100.
    var conversionRate = stats is { Visits: > 0 } ? Math.Min(100, (double)purchases / stats.Visits * 100) : 0;

    string KindLabel(ReferralConversionKind kind) => kind switch
    {
        ReferralConversionKind.Application => "Applied to an experience",
        ReferralConversionKind.Approved => "Application approved",
        ReferralConversionKind.TicketPurchase => "Bought a ticket",
        ReferralConversionKind.SessionPurchase => "Bought a place on a session",
        _ => "Became a member",
    };
}

@if (TempData["StatusMessage"] is string status)
{
    <div class="admin-status-message">@status</div>
}

<div class="admin-toolbar" style="justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap;">
    <div style="display:flex; align-items:center; gap:10px;">
        <span class="admin-badge @(Model.Status == AmbassadorStatus.Active ? "admin-badge--open" : "admin-badge--draft")">@Model.Status</span>
        <span class="admin-table__sub">Ambassador since @Model.CreatedAt.ToString("d MMM yyyy")</span>
    </div>
    <div style="display:flex; gap:8px; flex-wrap:wrap;">
        <a class="admin-btn admin-btn--ghost" asp-controller="AdminUsers" asp-action="Details" asp-route-id="@Model.UserId">Open user record</a>
        <a class="admin-btn admin-btn--ghost" asp-action="Index">&larr; All ambassadors</a>
    </div>
</div>

<div class="admin-review-grid">
    <div class="admin-review-main">

        @* --- The link ------------------------------------------------------------------------ *@
        <div class="admin-card referral-card">
            <div class="referral-card__main">
                <h2>Referral link</h2>
                <p class="admin-hint" style="margin-top:0;">Absolute, ready to paste. Anyone who lands on it is cookied for 30 days and credited to @Model.Name when they apply, join or pay.</p>

                <div class="referral-card__link">
                    <code data-referral-url="@Model.ReferralUrl">@Model.ReferralUrl</code>
                    <button type="button" class="admin-btn admin-btn--sm" data-copy="@Model.ReferralUrl" data-copied-label="Copied">Copy link</button>
                </div>

                <div class="referral-card__row">
                    <span class="referral-card__code">Code <strong data-copy="@Model.Code" data-copied-label="Copied" role="button" tabindex="0" title="Click to copy">@Model.Code</strong></span>
                    <a class="admin-btn admin-btn--ghost admin-btn--sm" href="@Model.ReferralUrl" target="_blank" rel="noopener">Open in new tab</a>
                </div>

                @if (Model.Email is not null)
                {
                    @* One click, from the House, with the absolute URL and the code — instead of an
                       admin pasting "/r/CODE" into a mail by hand. *@
                    <details class="referral-card__send">
                        <summary class="admin-btn admin-btn--sm">Email the link to @Model.Email</summary>
                        <form asp-action="SendLink" asp-route-id="@Model.Id" method="post" class="admin-form" style="margin-top:12px;">
                            <div class="admin-field">
                                <label for="send-note">Personal note (optional)</label>
                                <textarea id="send-note" name="note" rows="3" maxlength="600" placeholder="e.g. Lovely to have you on board — here is your link for the launch post."></textarea>
                            </div>
                            <button type="submit" class="admin-btn admin-btn--sm">Send email</button>
                        </form>
                    </details>
                }
            </div>
            <figure class="referral-card__qr" aria-label="QR code for the referral link">
                @Html.Raw(Model.QrSvg)
                <figcaption>Scan or drop on a slide</figcaption>
            </figure>
        </div>

        @* --- One link per experience and session --------------------------------------------- *@
        @if (Model.Links is not null)
        {
            <div class="admin-card">
                <h2>Links per experience and session</h2>
                <p class="admin-hint" style="margin-top:0;">Each published experience and session has its own link and QR code. A visitor lands straight on that page, the visit is counted against it, and whatever they do next — apply, buy a ticket, enrol — is credited to @Model.Name under that link. These are the same links and downloads @Model.Name sees on their own dashboard.</p>
                <partial name="/Views/Shared/_ReferralLinks.cshtml" model="Model.Links" />
            </div>
        }

        @* --- Tracked links -------------------------------------------------------------------- *@
        <div class="admin-card" data-utm-builder data-utm-base="@Model.ReferralUrl">
            <h2>Tracked link for a channel</h2>
            <p class="admin-hint" style="margin-top:0;">Give each channel its own link so "Visits by source" below shows where the traffic comes from. Tags are appended as UTM parameters and recorded on every visit.</p>
            <div class="admin-form__grid">
                @if (Model.Links is not null && Model.Links.Targets.Count > 0)
                {
                    <div class="admin-field">
                        <label for="utm-target">Link</label>
                        <select id="utm-target" data-utm-target>
                            <option value="@Model.ReferralUrl">Site link</option>
                            @foreach (var t in Model.Links.Targets)
                            {
                                <option value="@Model.Links.LinkFor(t)">@(t.Kind == ReferralTargetKind.Experience ? "Experience" : "Session"): @t.Title</option>
                            }
                        </select>
                    </div>
                }
                <div class="admin-field">
                    <label for="utm-source">Source</label>
                    <input id="utm-source" data-utm="source" list="utm-sources" placeholder="instagram" autocomplete="off" />
                    <datalist id="utm-sources">
                        <option value="instagram"></option><option value="linkedin"></option><option value="youtube"></option>
                        <option value="tiktok"></option><option value="newsletter"></option><option value="podcast"></option><option value="whatsapp"></option>
                    </datalist>
                </div>
                <div class="admin-field">
                    <label for="utm-medium">Medium</label>
                    <input id="utm-medium" data-utm="medium" list="utm-mediums" placeholder="story" autocomplete="off" />
                    <datalist id="utm-mediums">
                        <option value="post"></option><option value="story"></option><option value="bio"></option><option value="video"></option><option value="email"></option>
                    </datalist>
                </div>
                <div class="admin-field">
                    <label for="utm-campaign">Campaign</label>
                    <input id="utm-campaign" data-utm="campaign" placeholder="lisbon-2026" autocomplete="off" />
                </div>
            </div>
            <div class="referral-card__link">
                <code data-utm-preview>@Model.ReferralUrl</code>
                <button type="button" class="admin-btn admin-btn--sm" data-copy="@Model.ReferralUrl" data-utm-copy data-copied-label="Copied">Copy tracked link</button>
            </div>
        </div>

        @* --- Performance ---------------------------------------------------------------------- *@
        <div class="admin-card">
            <h2>Performance</h2>
            <p class="admin-hint" style="margin-top:0;">Counts and revenue only — no names or contact details of referred people are shown (brief §49).</p>
            @if (stats is not null)
            {
                <div class="admin-kpi-grid">
                    <div class="admin-kpi-card">
                        <div class="admin-kpi-card__value">@stats.Visits</div>
                        <div class="admin-kpi-card__label">Visits</div>
                    </div>
                    <div class="admin-kpi-card">
                        <div class="admin-kpi-card__value">@stats.Applications</div>
                        <div class="admin-kpi-card__label">Applications</div>
                    </div>
                    <div class="admin-kpi-card">
                        <div class="admin-kpi-card__value">@stats.ApprovedApplications</div>
                        <div class="admin-kpi-card__label">Approved</div>
                    </div>
                    <div class="admin-kpi-card">
                        <div class="admin-kpi-card__value">@purchases</div>
                        <div class="admin-kpi-card__label">Purchases <span class="admin-table__sub">(@stats.TicketPurchases tickets · @stats.MembershipPurchases memberships · @stats.SessionPurchases sessions)</span></div>
                    </div>
                    <div class="admin-kpi-card">
                        <div class="admin-kpi-card__value">@conversionRate.ToString("0.#")%</div>
                        <div class="admin-kpi-card__label">Visit → purchase</div>
                    </div>
                    @foreach (var (currency, amountMinor) in stats.RevenueByCurrency)
                    {
                        <div class="admin-kpi-card">
                            <div class="admin-kpi-card__value">@MoneyFormatter.Format(amountMinor, currency)</div>
                            <div class="admin-kpi-card__label">Revenue (@currency)</div>
                        </div>
                    }
                    @foreach (var (currency, amountMinor) in stats.CommissionByCurrency)
                    {
                        <div class="admin-kpi-card admin-kpi-card--accent">
                            <div class="admin-kpi-card__value">@MoneyFormatter.Format(amountMinor, currency)</div>
                            <div class="admin-kpi-card__label">Commission earned (@currency) <span class="admin-table__sub">net of refunds</span></div>
                        </div>
                    }
                </div>
            }

            @if (stats is { Targets.Count: > 0 })
            {
                <h3>Which link is working</h3>
                <table class="admin-table admin-table--compact">
                    <thead><tr><th>Link</th><th style="text-align:right;">Visits</th><th style="text-align:right;">Applications</th><th style="text-align:right;">Purchases</th></tr></thead>
                    <tbody>
                        @foreach (var t in stats.Targets)
                        {
                            <tr>
                                <td><span class="admin-badge admin-badge--draft">@t.Kind</span> @t.Title</td>
                                <td style="text-align:right;">@t.Visits</td>
                                <td style="text-align:right;">@t.Applications</td>
                                <td style="text-align:right;">@t.Purchases</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            <div class="referral-split">
                <section>
                    <h3>Visits by source</h3>
                    @if (Model.VisitSources.Count == 0)
                    {
                        <p class="admin-hint" style="margin-top:0;">No visits yet.</p>
                    }
                    else
                    {
                        <table class="admin-table admin-table--compact">
                            <thead><tr><th>Source</th><th>Medium</th><th style="text-align:right;">Visits</th></tr></thead>
                            <tbody>
                                @foreach (var s in Model.VisitSources)
                                {
                                    <tr>
                                        <td>@(s.Source ?? "direct / untagged")</td>
                                        <td>@(s.Medium ?? "—")</td>
                                        <td style="text-align:right;">@s.Visits</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </section>
                <section>
                    <h3>Recent activity</h3>
                    @if (Model.Conversions.Count == 0)
                    {
                        <p class="admin-hint" style="margin-top:0;">Nothing yet. Each application, approval and purchase through the link will appear here as it happens.</p>
                    }
                    else
                    {
                        <ol class="ambassador-timeline">
                            @foreach (var c in Model.Conversions)
                            {
                                <li class="ambassador-timeline__item">
                                    <time datetime="@c.OccurredAt.ToString("o")">@c.OccurredAt.ToString("d MMM yyyy, HH:mm")</time>
                                    <span class="ambassador-timeline__what">
                                        @KindLabel(c.Kind)
                                        @if (c.TargetKind != ReferralTargetKind.Site && titleByTarget.TryGetValue((c.TargetKind, c.TargetId), out var about))
                                        {
                                            <em class="ambassador-timeline__about">&middot; @about</em>
                                        }
                                    </span>
                                    @if (c.AmountMinor is { } amount && c.Currency is not null)
                                    {
                                        <span class="ambassador-timeline__money">
                                            @MoneyFormatter.Format(amount, c.Currency)
                                            @if (c.CommissionMinor is { } commission)
                                            {
                                                <em>&middot; commission @MoneyFormatter.Format(c.NetCommissionMinor, c.Currency)@if (c.CommissionReversedMinor > 0) { <text> (of @MoneyFormatter.Format(commission, c.Currency))</text> }</em>
                                            }
                                        </span>
                                        <span class="ambassador-timeline__flags" style="display:flex; gap:6px; flex-wrap:wrap; margin-top:4px;">
                                            @if (c.IsSelfReferral)
                                            {
                                                <span class="admin-badge admin-badge--danger" title="The buyer's account is the ambassador's own">Self-referral</span>
                                            }
                                            @if (c.ReversedAt is not null)
                                            {
                                                <span class="admin-badge admin-badge--draft">Refunded</span>
                                            }
                                            else if (c.RefundedMinor > 0)
                                            {
                                                <span class="admin-badge admin-badge--draft">Partly refunded (@MoneyFormatter.Format(c.RefundedMinor, c.Currency))</span>
                                            }
                                            @if (c.VoidedAt is not null)
                                            {
                                                <span class="admin-badge admin-badge--draft" title="@c.VoidReason">Commission withdrawn</span>
                                            }
                                            @if (c.PayoutId is not null)
                                            {
                                                <span class="admin-badge admin-badge--paid">Paid out</span>
                                            }
                                            else if (c.NetCommissionMinor > 0)
                                            {
                                                <span class="admin-badge admin-badge--pending">Owed</span>
                                            }
                                        </span>
                                        @if (c.VoidedAt is not null && c.VoidReason is not null)
                                        {
                                            <span class="admin-table__sub">Withdrawn @c.VoidedAt.Value.ToString("d MMM yyyy"): @c.VoidReason</span>
                                        }
                                        @if (Model.CanSettle && c.VoidedAt is null && c.NetCommissionMinor > 0)
                                        {
                                            <details style="margin-top:4px;">
                                                <summary class="admin-table__sub" style="cursor:pointer;">Withdraw commission…</summary>
                                                <form asp-action="VoidConversion" asp-route-id="@Model.Id" asp-route-conversionId="@c.Id" method="post" class="admin-form" style="margin-top:6px;">
                                                    <input name="reason" maxlength="300" required placeholder="Reason, e.g. self-referral" />
                                                    <button type="submit" class="admin-btn admin-btn--ghost admin-btn--sm">Withdraw</button>
                                                </form>
                                            </details>
                                        }
                                    }
                                </li>
                            }
                        </ol>
                    }
                </section>
            </div>
        </div>
    </div>

    <div class="admin-review-side">
        @* --- Commission: earned, paid, owed ------------------------------------------------------ *@
        <div class="admin-card">
            <h2>Commission</h2>
            @if (stats is null || stats.Balances.Count == 0)
            {
                <p class="admin-hint" style="margin-top:0;">Nothing earned yet.</p>
            }
            else
            {
                foreach (var b in stats.Balances)
                {
                    <dl class="admin-detail-list">
                        <div><dt>Earned (@b.Currency)</dt><dd>@MoneyFormatter.Format(b.EarnedMinor, b.Currency)</dd></div>
                        <div><dt>Paid</dt><dd>@MoneyFormatter.Format(b.PaidMinor, b.Currency)</dd></div>
                        <div>
                            <dt>@(b.OwedMinor < 0 ? "Overpaid" : "Owed")</dt>
                            <dd><strong>@MoneyFormatter.Format(Math.Abs(b.OwedMinor), b.Currency)</strong></dd>
                        </div>
                    </dl>
                    @if (b.OwedMinor < 0)
                    {
                        <p class="admin-hint">A refund landed after this was paid out. Recover it, or it nets off the next payout automatically.</p>
                    }
                    else if (b.OwedMinor > 0 && Model.CanSettle)
                    {
                        <form asp-action="RecordPayout" asp-route-id="@Model.Id" method="post" class="admin-form" style="margin-bottom:16px;">
                            <input type="hidden" name="currency" value="@b.Currency" />
                            <input type="hidden" name="expectedOwedMinor" value="@b.OwedMinor" />
                            <div class="admin-field">
                                <label for="payout-ref-@b.Currency">Transfer reference</label>
                                <input id="payout-ref-@b.Currency" name="reference" maxlength="100" placeholder="e.g. bank transfer ref." />
                            </div>
                            <div class="admin-field">
                                <label for="payout-note-@b.Currency">Note (optional)</label>
                                <input id="payout-note-@b.Currency" name="note" maxlength="500" />
                            </div>
                            <label class="admin-checkbox" style="display:flex; gap:8px; align-items:flex-start; margin-bottom:10px;">
                                <input type="checkbox" name="confirmed" value="true" required />
                                <span>I have sent @MoneyFormatter.Format(b.OwedMinor, b.Currency) to @Model.Name.</span>
                            </label>
                            <button type="submit" class="admin-btn" style="width:100%;">Mark @MoneyFormatter.Format(b.OwedMinor, b.Currency) as paid</button>
                        </form>
                    }
                }
                <p class="admin-hint" style="margin-top:0;">Commission is taken at the rate in force when each sale happened. Refunds take it back pro rata; withdrawn lines earn nothing.@(Model.CanSettle ? "" : " Finance records payouts.")</p>
            }

            @if (Model.Payouts.Count > 0)
            {
                <h3>Payouts</h3>
                <table class="admin-table admin-table--compact">
                    <thead><tr><th>Date</th><th>Reference</th><th style="text-align:right;">Amount</th></tr></thead>
                    <tbody>
                        @foreach (var p in Model.Payouts)
                        {
                            <tr>
                                <td>@p.PaidAt.ToLocalTime().ToString("d MMM yyyy")</td>
                                <td>@(p.Reference ?? "—")@if (p.Note is not null) { <div class="admin-table__sub">@p.Note</div> }</td>
                                <td style="text-align:right;">@MoneyFormatter.Format(p.AmountMinor, p.Currency)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        @* --- Fraud signals ---------------------------------------------------------------------- *@
        @if (Model.Signals is { } sig)
        {
            <div class="admin-card">
                <h2>Signals</h2>
                @if (sig.Warnings.Count == 0)
                {
                    <p class="admin-hint" style="margin-top:0;">Nothing unusual in the last @sig.WindowDays days.</p>
                }
                else
                {
                    <ul style="margin:0 0 12px; padding-left:18px;">
                        @foreach (var w in sig.Warnings)
                        {
                            <li style="margin-bottom:6px;">@w</li>
                        }
                    </ul>
                }
                <dl class="admin-detail-list">
                    <div><dt>Visits, @sig.WindowDays days</dt><dd>@sig.Visits</dd></div>
                    <div><dt>Distinct networks</dt><dd>@sig.DistinctNetworks</dd></div>
                    <div><dt>Busiest network</dt><dd>@sig.TopNetworkVisits (@sig.TopNetworkShare.ToString("P0"))</dd></div>
                    <div><dt>Automated-looking</dt><dd>@sig.AutomatedVisits</dd></div>
                    <div><dt>Own clicks</dt><dd>@sig.OwnVisits</dd></div>
                    <div><dt>Self-referrals</dt><dd>@sig.SelfReferrals</dd></div>
                </dl>
                <p class="admin-hint">IP addresses are stored only as a keyed hash. Repeat landings from one network on one link within 30 minutes count once.</p>
            </div>
        }

        <div class="admin-card">
            <h2>Settings</h2>
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="admin-form">
                <div asp-validation-summary="ModelOnly" class="field-validation-error"></div>
                <div class="admin-field">
                    <label asp-for="Name">Display name</label>
                    <input asp-for="Name" />
                    <span asp-validation-for="Name" class="field-validation-error"></span>
                </div>
                <div class="admin-field">
                    <label asp-for="CommissionPercent">Commission %</label>
                    <input asp-for="CommissionPercent" type="number" step="0.01" min="0" max="100" />
                    <p class="admin-field__hint">Applied to every purchase attributed to the link, at the rate in force when it happens.</p>
                    <span asp-validation-for="CommissionPercent" class="field-validation-error"></span>
                </div>
                <div class="admin-field">
                    <label asp-for="Status"></label>
                    <select asp-for="Status" asp-items="Html.GetEnumSelectList<AmbassadorStatus>()"></select>
                    <p class="admin-field__hint">Inactive: visits to the link stop being recorded; the account and history stay.</p>
                </div>
                @if (User.IsInRole(VIHouse.DataAccess.Identity.Roles.SuperAdmin) || User.IsInRole(VIHouse.DataAccess.Identity.Roles.Marketing))
                {
                    <button type="submit" class="admin-btn" style="width:100%;">Save changes</button>
                }
            </form>
        </div>

        <div class="admin-card">
            <h2>Account</h2>
            <dl class="admin-detail-list">
                <div><dt>Email</dt><dd>@(Model.Email ?? "—")</dd></div>
                <div><dt>Code</dt><dd><code>@Model.Code</code> <span class="admin-table__sub">(fixed — links already shared depend on it)</span></dd></div>
                <div><dt>Their dashboard</dt><dd><a asp-area="" asp-controller="Ambassador" asp-action="Index" target="_blank" rel="noopener">/ambassador</a> <span class="admin-table__sub">(what they see when signed in)</span></dd></div>
            </dl>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

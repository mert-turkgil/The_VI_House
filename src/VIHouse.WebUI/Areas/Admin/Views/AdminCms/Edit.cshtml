@model AdminContentPageViewModel
@{
    ViewData["Title"] = Model.Title;
}

@if (TempData["StatusMessage"] is string status)
{
    <div class="admin-status-message">@status</div>
}

<div class="admin-toolbar">
    <a class="admin-btn admin-btn--ghost" asp-action="Index">@Loc["Admin.Cms.AllPages"]</a>
    <a class="admin-btn admin-btn--ghost" asp-area="" asp-controller="Home" asp-action="Index" target="_blank" rel="noopener">@Loc["Admin.Cms.ViewThePage"]</a>
    @foreach (var c in SiteCultures.All.Where(c => c.Name != SiteCultures.Default))
    {
        <a class="admin-btn admin-btn--ghost admin-btn--sm" href="/@c.UrlCode" target="_blank" rel="noopener">@c.NativeLabel</a>
    }
</div>

<p class="admin-hint">
    @Loc["Admin.Cms.EditIntro"]
</p>

@foreach (var block in Model.Sections)
{
    var schema = block.Schema;
    var sectionTitle = schema is null ? block.SectionKey : Loc[schema.TitleKey].Value;
    <div class="admin-card" style="margin-bottom:20px;">
        <h2>@sectionTitle</h2>
        @if (schema is not null)
        {
            <p class="admin-hint" style="margin-top:-8px;">@Loc[schema.DescriptionKey]</p>
        }
        @if (block.SectionKey == "hero" && Model.HeroSlidesActive)
        {
            <div class="admin-notice">
                @Loc["Admin.Cms.HeroSlidesAreActiveSoThis"]
                <a asp-controller="AdminHeroSlides" asp-action="Index">@Loc["Admin.Cms.HeroSlides"]</a>.
            </div>
        }
        else
        {
            <p class="admin-hint" style="margin-top:-8px;">
                @Loc["Admin.Cms.ThisPanelHasNoFormFor"] <code>@block.SectionKey</code>@Loc["Admin.Cms.SoItIsEditedAsRaw"]
            </p>
        }

        @if (block.ParseError is not null)
        {
            @* Never silently show an empty editor over content that is still live: saving it would
               replace a working section with nothing. *@
            <div class="admin-notice">
                @Loc["Admin.Cms.ParseError", block.ParseError ?? ""]
            </div>
        }

        <form asp-action="UpdateSection" method="post" class="admin-form">
            <input type="hidden" name="Id" value="@block.Id" />
            <input type="hidden" name="PageId" value="@Model.PageId" />
            <input type="hidden" name="PageSlug" value="@Model.Slug" />
            <input type="hidden" name="SectionKey" value="@block.SectionKey" />
            <input type="hidden" name="SortOrder" value="@block.SortOrder" />

            @if (schema is null || schema.UsesHeading)
            {
                <div class="admin-field">
                    <label>@Loc["Admin.Cms.Heading"]</label>
                    <input name="Heading" value="@block.Heading" />
                </div>
            }

            @if (schema is null || schema.UsesSubheading)
            {
                <div class="admin-field">
                    <label>@Loc[block.SectionKey is "trust" or "ecosystem" ? "Admin.Cms.Eyebrow" : "Admin.Cms.Subheading"]</label>
                    <input name="Subheading" value="@block.Subheading" />
                </div>
            }

            @if (schema is null || schema.UsesBody)
            {
                <div class="admin-field">
                    <label>@Loc["Admin.Cms.Body"]</label>
                    <textarea name="BodyText" rows="3">@block.BodyText</textarea>
                </div>
            }

            @if (schema is null || schema.UsesCta)
            {
                <div class="admin-form__grid">
                    <div class="admin-field">
                        <label>@Loc["Admin.Cms.ButtonLabel"]</label>
                        <input name="CtaLabel" value="@block.CtaLabel" />
                    </div>
                    <div class="admin-field">
                        <label>@Loc["Admin.Cms.ButtonLink"]</label>
                        <input name="CtaUrl" value="@block.CtaUrl" placeholder="/experiences" />
                    </div>
                </div>
            }

            @if (schema?.Rows is { } rows)
            {
                <h3 class="admin-section-heading" style="font-size:0.9rem;">@Loc[rows.PluralKey]</h3>

                @* Existing rows, then one blank one. The blank row is the "add" button: fill it in
                   and save. No JavaScript, and nothing to go wrong with client-side row indexes. *@
                @for (var i = 0; i <= block.Rows.Count; i++)
                {
                    var row = i < block.Rows.Count ? block.Rows[i] : new AdminContentRowViewModel();
                    var isBlank = i == block.Rows.Count;

                    <div class="admin-panel" style="margin-bottom:12px;">
                        <div class="admin-form__grid">
                            @foreach (var field in rows.Fields)
                            {
                                var label = Loc[ContentSectionSchema.FieldKey(field)].Value;
                                var isLong = field is "description" or "quote";

                                <div class="admin-field" style="@(isLong ? "grid-column:1 / -1;" : null)">
                                    <label>@label</label>
                                    @if (isLong)
                                    {
                                        <textarea name="Rows[@i][@field]" rows="2">@row[field]</textarea>
                                    }
                                    else
                                    {
                                        <input name="Rows[@i][@field]" value="@row[field]"
                                               placeholder="@(isBlank && field == rows.Fields[0] ? Loc[rows.NewKey].Value : null)" />
                                    }
                                </div>
                            }
                        </div>
                        @if (!isBlank && row[rows.Fields[0]] is { Length: > 0 } primary)
                        {
                            <p class="admin-field__hint">@Loc[rows.RemoveHintKey, primary, Loc[ContentSectionSchema.FieldKey(rows.Fields[0])].Value]</p>
                        }
                    </div>
                }
            }

            @if (schema?.Rows is null)
            {
                <div class="admin-field">
                    <label>@Loc["Admin.Cms.ExtraJSON"]</label>
                    <textarea name="ExtraJson" rows="6" style="font-family:monospace; font-size:0.8125rem;">@block.ExtraJson</textarea>
                    <p class="admin-field__hint">@Loc["Admin.Cms.CheckedBeforeSavingInvalidJSONIs"]</p>
                </div>
            }

            <div style="display:flex; gap:10px; align-items:center;">
                <button type="submit" class="admin-btn">@Loc["Admin.Common.SaveNamed", sectionTitle]</button>
            </div>
        </form>

        @* --- Translations --------------------------------------------------------------------
           The English copy is the form above; these are the other three languages. Before this
           existed the homepage below the hero rendered in English no matter which language a
           visitor chose — the slider was translated, everything under it was not, because there
           was nowhere to put the words. *@
        <details class="admin-panel" style="margin-top:16px;" @(block.Translations.Any(t => t.IsWritten) ? "open" : null)>
            <summary style="cursor:pointer; font-weight:600;">
                @Loc["Admin.Nav.AdminTranslations"]
                @{ var written = block.Translations.Count(t => t.IsWritten); }
                <span class="admin-lang-chip">@written / @block.Translations.Count</span>
            </summary>

            <p class="admin-field__hint" style="margin-top:8px;">
                @Loc["Admin.Cms.EnglishIsTheSectionFormAbove"]
            </p>

            @foreach (var tab in block.Translations)
            {
                <details style="margin-top:10px; border-top:1px solid var(--vih-line-on-light); padding-top:10px;">
                    <summary style="cursor:pointer;">
                        @tab.Culture.NativeLabel
                        @if (tab.Overrides.Count > 0)
                        {
                            <span class="admin-lang-chip admin-lang-chip--on">@Loc["Admin.Cms.Replaces", string.Join(", ", tab.Overrides.Select(k => Loc[k].Value))]</span>
                        }
                        else
                        {
                            <span class="admin-lang-chip" title="@Loc["Admin.Cms.ShowsTheEnglish"]">@Loc["Admin.Cms.FollowsEnglish"]</span>
                        }
                    </summary>

                    @* Plain name/value rather than asp-for: these bind to AdminContentTranslationForm,
                       which is not this view's model, and the input tag helper would derive the
                       posted name from the expression instead of the field. *@
                    <form asp-action="SaveSectionTranslation" method="post" class="admin-form" style="margin-top:10px;">
                        <input type="hidden" name="ContentBlockId" value="@block.Id" />
                        <input type="hidden" name="Culture" value="@tab.Culture.Name" />
                        <input type="hidden" name="pageSlug" value="@Model.Slug" />

                        @if (schema is null || schema.UsesHeading)
                        {
                            <div class="admin-field">
                                <label>@Loc["Admin.Cms.Heading"]</label>
                                <input name="Heading" value="@tab.Form.Heading" placeholder="@block.Heading" />
                            </div>
                        }

                        @if (schema is null || schema.UsesSubheading)
                        {
                            <div class="admin-field">
                                <label>@Loc[block.SectionKey is "trust" or "ecosystem" ? "Admin.Cms.Eyebrow" : "Admin.Cms.Subheading"]</label>
                                <input name="Subheading" value="@tab.Form.Subheading" placeholder="@block.Subheading" />
                            </div>
                        }

                        @if (schema is null || schema.UsesBody)
                        {
                            <div class="admin-field">
                                <label>@Loc["Admin.Cms.Body"]</label>
                                <textarea name="BodyText" rows="3" placeholder="@block.BodyText">@tab.Form.BodyText</textarea>
                            </div>
                        }

                        @if (schema is null || schema.UsesCta)
                        {
                            <div class="admin-field">
                                <label>@Loc["Admin.Cms.ButtonLabel"]</label>
                                <input name="CtaLabel" value="@tab.Form.CtaLabel" placeholder="@block.CtaLabel" />
                                <p class="admin-field__hint">@Loc["Admin.Cms.TheLinkItselfIsNotTranslated"]</p>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(block.ExtraJson))
                        {
                            <div class="admin-field">
                                <label>@Loc["Admin.Cms.ListContentJSON"]</label>
                                <textarea name="ExtraJson" rows="8" style="font-family:monospace; font-size:0.8125rem;"
                                          placeholder="@Loc["Admin.Cms.EmptyThisLanguageShowsTheEnglish"]">@tab.Form.ExtraJson</textarea>
                                <p class="admin-field__hint">
                                    @Loc["Admin.Cms.LeaveEmptyToKeepTheEnglish"]
                                    <strong>@Loc["Admin.Cms.KeepTheKeysAndTheOrder"]</strong>@Loc["Admin.Cms.ATranslatedListReplacesTheWhole"]
                                </p>
                                <details>
                                    <summary style="cursor:pointer; font-size:0.8125rem;">@Loc["Admin.Cms.EnglishListForCopying"]</summary>
                                    <pre style="font-size:0.75rem; overflow:auto; background:#f6f5f1; padding:12px; border-radius:6px;">@block.ExtraJson</pre>
                                </details>
                            </div>
                        }

                        <div style="display:flex; gap:10px; align-items:center;">
                            <button type="submit" class="admin-btn">@Loc["Admin.Common.SaveNamed", tab.Culture.NativeLabel]</button>
                        </div>
                    </form>

                    @if (tab.IsWritten)
                    {
                        <form asp-action="RemoveSectionTranslation" method="post" style="margin-top:8px;"
                              data-confirm="@Loc["Admin.Cms.ResetConfirm", tab.Culture.NativeLabel]">
                            <input type="hidden" name="blockId" value="@block.Id" />
                            <input type="hidden" name="culture" value="@tab.Culture.Name" />
                            <input type="hidden" name="pageSlug" value="@Model.Slug" />
                            <button type="submit" class="admin-icon-btn" style="color:var(--vih-danger);">@Loc["Admin.Cms.ResetToEnglish", tab.Culture.NativeLabel]</button>
                        </form>
                    }
                </details>
            }
        </details>

        @if (schema?.Rows is not null && !string.IsNullOrWhiteSpace(block.ExtraJson))
        {
            @* Kept for the moments a form cannot help with: reordering a long list, or pasting a
               section wholesale from somewhere else. Read-only here — the form is the way in. *@
            <details style="margin-top:12px;">
                <summary style="cursor:pointer; font-size:0.8125rem; color:#666;">@Loc["Admin.Cms.StoredJSON"]</summary>
                <pre style="font-size:0.75rem; overflow:auto; background:#f6f5f1; padding:12px; border-radius:6px;">@block.ExtraJson</pre>
            </details>
        }

        <form asp-action="RemoveBlock" method="post" style="margin-top:12px;"
              data-confirm="@Loc["Admin.Cms.RemoveSectionConfirm", sectionTitle]">
            <input type="hidden" name="pageId" value="@Model.PageId" />
            <input type="hidden" name="blockId" value="@block.Id" />
            <input type="hidden" name="pageSlug" value="@Model.Slug" />
            <button type="submit" class="admin-btn admin-btn--danger">@Loc["Admin.Cms.RemoveSection"]</button>
        </form>
    </div>
}

@* --- Add a section ------------------------------------------------------------------------------ *@
@{
    var present = Model.Sections.Select(s => s.SectionKey).ToHashSet(StringComparer.OrdinalIgnoreCase);
    var missing = ContentSectionSchema.All.Where(s => !present.Contains(s.SectionKey)).ToList();
}

@if (missing.Count > 0)
{
    <div class="admin-card" style="margin-bottom:20px;">
        <h2>@Loc["Admin.Cms.AddASection"]</h2>
        <p class="admin-hint" style="margin-top:-8px;">@Loc["Admin.Cms.SectionsTheHomepageCanRenderThat"]</p>
        @foreach (var candidate in missing)
        {
            <form asp-action="AddBlock" method="post" class="admin-inline-form">
                <input type="hidden" name="PageId" value="@Model.PageId" />
                <input type="hidden" name="PageSlug" value="@Model.Slug" />
                <input type="hidden" name="SectionKey" value="@candidate.SectionKey" />
                <input type="hidden" name="SortOrder" value="@(Model.Sections.Count + 1)" />
                <button type="submit" class="admin-btn admin-btn--ghost">+ @Loc[candidate.TitleKey]</button>
            </form>
        }
    </div>
}

@* --- Images ------------------------------------------------------------------------------------- *@
<div class="admin-card">
    <h2>@Loc["Admin.Cms.Images"]</h2>
    <p class="admin-hint" style="margin-top:-8px;">
        @Loc["Admin.Cms.UploadOnceThenPasteTheAddress"]
    </p>

    <form asp-action="UploadAsset" method="post" enctype="multipart/form-data" class="admin-inline-form">
        <input type="hidden" name="pageSlug" value="@Model.Slug" />
        <input type="file" name="file" accept="image/jpeg,image/png,image/webp,image/avif,image/gif" required />
        <input type="text" name="title" maxlength="200" placeholder="@Loc["Admin.Cms.LabelOptional"]" />
        <button type="submit" class="admin-btn">@Loc["Admin.Common.Upload"]</button>
    </form>

    @if (Model.Assets.Count > 0)
    {
        <table class="admin-table" style="margin-top:16px;">
            <thead>
                <tr>
                    <th></th>
                    <th>@Loc["Admin.Cms.Image"]</th>
                    <th>@Loc["Admin.Cms.Address"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var asset in Model.Assets)
                {
                    var url = $"/media/asset/{asset.Id}";
                    <tr>
                        <td style="width:90px;">
                            <img src="@url" alt="" width="72" height="48"
                                 style="width:72px; height:48px; object-fit:cover; border-radius:4px; display:block;" />
                        </td>
                        <td>
                            @(asset.Title ?? asset.OriginalFileName)
                            <div style="font-size:0.72rem; opacity:0.6;">@((asset.SizeBytes / 1024).ToString("N0")) KB · @asset.CreatedAt.ToString("d MMM yyyy")</div>
                        </td>
                        <td><input value="@url" readonly onclick="this.select();" style="font-family:monospace; font-size:0.75rem;" /></td>
                        <td>
                            <form asp-action="DeleteAsset" method="post"
                                  data-confirm="@Loc["Admin.Cms.DeleteThisImageAnySectionStill"]">
                                <input type="hidden" name="id" value="@asset.Id" />
                                <input type="hidden" name="pageSlug" value="@Model.Slug" />
                                <button type="submit" class="admin-btn admin-btn--danger">@Loc["Admin.Common.Delete"]</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@model List<ContentPage>
@{
    ViewData["Title"] = "Content";
}

@if (Model.Count == 0)
{
    <p>No CMS pages seeded yet.</p>
}
else
{
    <table class="admin-table">
        <thead><tr><th>Page</th><th>Slug</th><th>Blocks</th><th>Published</th></tr></thead>
        <tbody>
            @foreach (var cmsPage in Model)
            {
                <tr>
                    <td><a asp-action="Edit" asp-route-id="@cmsPage.Slug">@cmsPage.Title</a></td>
                    <td>@cmsPage.Slug</td>
                    <td>@cmsPage.Blocks.Count</td>
                    <td>@(cmsPage.IsPublished ? "Yes" : "No")</td>
                </tr>
            }
        </tbody>
    </table>
}

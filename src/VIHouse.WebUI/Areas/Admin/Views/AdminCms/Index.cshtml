@model List<ContentPage>
@{
    ViewData["Title"] = Loc["Admin.Nav.AdminCms"].Value;
}

@if (Model.Count == 0)
{
    <p>@Loc["Admin.Cms.NoCMSPagesSeededYet"]</p>
}
else
{
    <div class="admin-table-scroll">
    <table class="admin-table" data-admin-table>
        <thead><tr><th>@Loc["Admin.Cms.Page"]</th><th>@Loc["Admin.Cms.Slug"]</th><th>@Loc["Admin.Cms.Blocks"]</th><th>@Loc["Admin.Common.Published"]</th></tr></thead>
        <tbody>
            @foreach (var cmsPage in Model)
            {
                <tr>
                    <td><a asp-action="Edit" asp-route-id="@cmsPage.Slug">@cmsPage.Title</a></td>
                    <td>@cmsPage.Slug</td>
                    <td>@cmsPage.Blocks.Count</td>
                    <td>@Loc[cmsPage.IsPublished ? "Admin.Common.Yes" : "Admin.Common.No"]</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = Loc["Auth.ResetDone.Title"].Value;
}

<div class="auth-card">
    <div class="auth-card__head auth-card__head--center">
        <partial name="_SuccessMark" />
        <span class="auth-card__eyebrow">@Loc["Auth.Security.Eyebrow"]</span>
        <h1 class="auth-card__title">@Loc["Auth.ResetDone.Heading"]</h1>
        <p class="auth-card__lede">@Loc["Auth.ResetDone.Lede"]</p>
    </div>

    <a class="btn btn--primary auth-form__submit" asp-page="./Login">@Loc["Auth.Login.Submit"]</a>
</div>

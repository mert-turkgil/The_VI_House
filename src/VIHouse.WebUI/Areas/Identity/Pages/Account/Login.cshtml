@page
@model LoginModel

@{
    ViewData["Title"] = "Log In";
}

@* No self-registration / external-login sections: membership is granted through the
   application-approval funnel (brief §25), not open sign-up. The .auth-page wrapper itself comes
   from Account/_Layout.cshtml, applied to every page under Account/. *@
<h1>Welcome back.</h1>
<section>
    <form id="account" method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>
        <div class="form-floating">
            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
            <label asp-for="Input.Email">Email</label>
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>
        <div class="form-floating">
            <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Password" />
            <label asp-for="Input.Password">Password</label>
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>
        <div class="checkbox">
            <label asp-for="Input.RememberMe">
                <input class="form-check-input" asp-for="Input.RememberMe" />
                @Html.DisplayNameFor(m => m.Input.RememberMe)
            </label>
        </div>
        <div>
            <button id="login-submit" type="submit" class="btn-primary">Log In</button>
        </div>
    </form>
    <hr />
    <section>
        <p><a id="forgot-password" asp-page="./ForgotPassword">Forgot your password?</a></p>
        <p>Not a member yet? <a href="/apply">Request access</a>.</p>
    </section>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

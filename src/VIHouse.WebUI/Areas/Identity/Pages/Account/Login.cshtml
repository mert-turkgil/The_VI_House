@page
@model LoginModel

@{
    ViewData["Title"] = Loc["Auth.Login.Title"].Value;
}

@*
    No self-registration anywhere on this page, and the Register pages have now been deleted
    entirely: membership is granted through the application-approval funnel (brief §25). Until this
    pass /Identity/Account/Register was still live, unrate-limited, and creating accounts — a way
    straight past the funnel for anyone who guessed the URL.

    External login (Google) IS offered: it can only sign in a Google account already linked to an
    existing local account — ExternalLogin.cshtml.cs rejects unrecognised accounts rather than
    offering to create one — so it cannot be used to self-register either.

    The .auth-shell wrapper comes from Account/_Layout.cshtml, which applies to everything under
    Account/.
*@
<div class="auth-card">
    <div class="auth-card__head">
        <span class="auth-card__eyebrow">@Loc["Nav.LogIn"]</span>
        <h1 class="auth-card__title">@Loc["Auth.Login.Heading"]</h1>
        <p class="auth-card__lede">@Loc["Auth.Login.Lede"]</p>
    </div>

    <form id="account" method="post" class="auth-form">
        <div asp-validation-summary="ModelOnly" class="vih-alert vih-alert--danger" role="alert"></div>

        <div class="auth-field">
            <label class="auth-field__label" asp-for="Input.Email">@Loc["Auth.Email"]</label>
            <input class="auth-field__input" asp-for="Input.Email" autocomplete="username"
                   aria-required="true" placeholder="name@example.com" />
            <span class="auth-field__error" asp-validation-for="Input.Email"></span>
        </div>

        <div class="auth-field">
            <label class="auth-field__label" asp-for="Input.Password">@Loc["Auth.Password"]</label>
            <div class="auth-password-toggle">
                <input class="auth-field__input" asp-for="Input.Password" autocomplete="current-password"
                       aria-required="true" placeholder="&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;" />
                <partial name="_PasswordToggleButton" />
            </div>
            <span class="auth-field__error" asp-validation-for="Input.Password"></span>
        </div>

        <div class="auth-field auth-field--check">
            <label>
                <input asp-for="Input.RememberMe" />
                <span>@Loc["Auth.RememberMe"]</span>
            </label>
        </div>

        <button id="login-submit" type="submit" class="btn btn--primary auth-form__submit">
            @Loc["Auth.Login.Submit"]
        </button>
    </form>

    <div class="auth-alt">
        <p><a id="forgot-password" asp-page="./ForgotPassword">@Loc["Auth.ForgotPassword"]</a></p>
        <p>@Loc["Auth.NotAMember"] <a asp-area="" asp-controller="Experiences" asp-action="Index" asp-route-status="@VIHouse.Entities.Experiences.ExperienceStatus.ApplicationsOpen">@Loc["Auth.RequestAccess"]</a></p>
    </div>

    @if ((Model.ExternalLogins?.Count ?? 0) > 0)
    {
        <div class="auth-divider"><span>@Loc["Auth.OrContinueWith"]</span></div>

        <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="auth-external">
            @foreach (var provider in Model.ExternalLogins ?? [])
            {
                <button type="submit" class="auth-external__btn" name="provider" value="@provider.Name"
                        title="@provider.DisplayName" data-loading-label="@Loc["Auth.Login.Redirecting"]">
                    @if (string.Equals(provider.Name, "Google", StringComparison.OrdinalIgnoreCase))
                    {
                        <svg class="auth-external__icon" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
                            <path fill="#4285F4" d="M45.12 24.5c0-1.56-.14-3.06-.4-4.5H24v8.51h11.84c-.51 2.75-2.06 5.08-4.39 6.64v5.52h7.11c4.16-3.83 6.56-9.47 6.56-16.17z"/>
                            <path fill="#34A853" d="M24 46c5.94 0 10.92-1.97 14.56-5.33l-7.11-5.52c-1.97 1.32-4.49 2.1-7.45 2.1-5.73 0-10.58-3.87-12.32-9.07H4.34v5.7C7.96 41.07 15.4 46 24 46z"/>
                            <path fill="#FBBC05" d="M11.68 28.18A11.96 11.96 0 0 1 11.03 24c0-1.45.25-2.86.65-4.18v-5.7H4.34A21.98 21.98 0 0 0 2 24c0 3.55.85 6.91 2.34 9.88l7.34-5.7z"/>
                            <path fill="#EA4335" d="M24 10.75c3.23 0 6.13 1.11 8.41 3.29l6.31-6.31C34.91 4.18 29.93 2 24 2 15.4 2 7.96 6.93 4.34 14.12l7.34 5.7c1.74-5.2 6.59-9.07 12.32-9.07z"/>
                        </svg>
                    }
                    <span class="auth-external__label">@Loc["Auth.Login.ContinueWith", provider.DisplayName ?? provider.Name]</span>
                </button>
            }
        </form>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

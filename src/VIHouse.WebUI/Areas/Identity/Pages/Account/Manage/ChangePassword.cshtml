@page
@model ChangePasswordModel
@{
    ViewData["Title"] = Loc["Manage.Password.Title"];
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<partial name="_StatusMessage" for="StatusMessage" />

<h1 class="account-security__title">@ViewData["Title"]</h1>
<p class="account-security__lede">@Loc["Manage.Password.Lede"]</p>

<form id="change-password-form" method="post" class="auth-form account-security__form">
    <div asp-validation-summary="ModelOnly" class="auth-field__error" role="alert"></div>

    <div class="auth-field">
        <label asp-for="Input.OldPassword" class="auth-field__label">@Loc["Manage.Password.Current"]</label>
        <div class="auth-password-toggle">
            <input asp-for="Input.OldPassword" class="auth-field__input" autocomplete="current-password" aria-required="true" />
            <partial name="_PasswordToggleButton" />
        </div>
        <span asp-validation-for="Input.OldPassword" class="auth-field__error"></span>
    </div>

    <div class="auth-field">
        <label asp-for="Input.NewPassword" class="auth-field__label">@Loc["Manage.Password.New"]</label>
        <div class="auth-password-toggle">
            <input asp-for="Input.NewPassword" class="auth-field__input" autocomplete="new-password" aria-required="true" />
            <partial name="_PasswordToggleButton" />
        </div>
        <span class="auth-field__hint">@Loc["Manage.Password.Rules"]</span>
        <span asp-validation-for="Input.NewPassword" class="auth-field__error"></span>
    </div>

    <div class="auth-field">
        <label asp-for="Input.ConfirmPassword" class="auth-field__label">@Loc["Manage.Password.Confirm"]</label>
        <div class="auth-password-toggle">
            <input asp-for="Input.ConfirmPassword" class="auth-field__input" autocomplete="new-password" aria-required="true" />
            <partial name="_PasswordToggleButton" />
        </div>
        <span asp-validation-for="Input.ConfirmPassword" class="auth-field__error"></span>
    </div>

    <div class="auth-form__submit-row">
        <button type="submit" class="btn btn--primary">@Loc["Manage.Password.Update"]</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

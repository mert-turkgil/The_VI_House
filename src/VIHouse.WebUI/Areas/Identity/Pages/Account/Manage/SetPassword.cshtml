@page
@model SetPasswordModel
@{
    ViewData["Title"] = Loc["Manage.SetPassword.Title"];
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

@* Reached by an account that signs in with Google only and has no password yet. Same parts as
   ChangePassword.cshtml, minus the current-password box. *@
<partial name="_StatusMessage" for="StatusMessage" />

<h1 class="account-security__title">@ViewData["Title"]</h1>
<p class="account-security__lede">@Loc["Manage.SetPassword.Lede"]</p>

<form id="set-password-form" method="post" class="auth-form account-security__form">
    <partial name="_ErrorSummary" model="@Loc["Manage.Password.ErrorTitle"].Value" />

    <div class="auth-field">
        <label asp-for="Input.NewPassword" class="auth-field__label">@Loc["Auth.NewPassword"]</label>
        <div class="auth-password-toggle">
            <input asp-for="Input.NewPassword" class="auth-field__input" autocomplete="new-password" aria-required="true"
                   aria-describedby="Input_NewPassword-rules" />
            <partial name="_PasswordToggleButton" />
        </div>
        <span asp-validation-for="Input.NewPassword" class="auth-field__error"></span>
        <partial name="_PasswordRules" model="@(("Input_NewPassword", (string?)"Input_ConfirmPassword"))" />
    </div>

    <div class="auth-field">
        <label asp-for="Input.ConfirmPassword" class="auth-field__label">@Loc["Auth.ConfirmPassword"]</label>
        <div class="auth-password-toggle">
            <input asp-for="Input.ConfirmPassword" class="auth-field__input" autocomplete="new-password" aria-required="true" />
            <partial name="_PasswordToggleButton" />
        </div>
        <span asp-validation-for="Input.ConfirmPassword" class="auth-field__error"></span>
    </div>

    <div class="auth-form__submit-row">
        <button type="submit" class="btn btn--primary">@Loc["Manage.SetPassword.Submit"]</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

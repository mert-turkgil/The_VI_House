@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = Loc["Auth.ForgotSent.Title"].Value;
}

@* Says the same thing whether or not the address has an account, so the page cannot be used to
   find out who is a member. *@
<div class="auth-card">
    <div class="auth-card__head auth-card__head--center">
        <span class="auth-status auth-status--mail" aria-hidden="true">
            <svg viewBox="0 0 24 24"><rect x="3.5" y="5.5" width="17" height="13" rx="2" pathLength="1" /><path d="M4 7l8 6 8-6" pathLength="1" /></svg>
        </span>
        <span class="auth-card__eyebrow">@Loc["Auth.Security.Eyebrow"]</span>
        <h1 class="auth-card__title">@Loc["Auth.ForgotSent.Heading"]</h1>
        <p class="auth-card__lede">@Loc["Auth.ForgotSent.Lede"]</p>
    </div>

    <ul class="auth-checklist">
        <li>@Loc["Auth.ForgotSent.Tip1"]</li>
        <li>@Loc["Auth.ForgotSent.Tip2"]</li>
    </ul>

    <a class="btn btn--primary auth-form__submit" asp-page="./Login">@Loc["Auth.BackToSignIn"]</a>

    <div class="auth-alt">
        <p>@Loc["Auth.ForgotSent.NothingArrived"] <a asp-page="./ForgotPassword">@Loc["Auth.ForgotSent.SendAgain"]</a></p>
    </div>
</div>

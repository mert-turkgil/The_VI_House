@page
@model ResetPasswordModel
@{
    ViewData["Title"] = Loc["Auth.Reset.Title"].Value;
}

@*
    The page the emailed reset (and first-time setup) link opens. Built on the same .auth-card parts
    as Login.cshtml; the old scaffold markup (row / col-md-4 / form-floating) is gone, which is also
    what let the card run off the right edge of a phone.

    Errors, in three layers:
      - _ErrorSummary at the top after a failed POST: a titled list, each item linked to its field,
        focused on load (modules/formFeedback.ts).
      - The same message under the field it is about (IdentityErrorMapping puts server errors there).
      - _PasswordRules: the rules up front, ticked live, so most errors never happen.
    An expired, reused or mangled link is not a form error at all; it gets its own state below.
*@
<div class="auth-card">
    @if (Model.LinkInvalid)
    {
        <div class="auth-card__head auth-card__head--center">
            <span class="auth-status auth-status--warning" aria-hidden="true">
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
            </span>
            <span class="auth-card__eyebrow">@Loc["Auth.Security.Eyebrow"]</span>
            <h1 class="auth-card__title">@Loc["Auth.Reset.Expired.Title"]</h1>
            <p class="auth-card__lede">@Loc["Auth.Reset.Expired.Body"]</p>
        </div>

        <a class="btn btn--primary auth-form__submit" asp-page="./ForgotPassword" asp-route-email="@Model.Input?.Email">
            @Loc["Auth.Reset.Expired.Action"]
        </a>

        <div class="auth-alt">
            <p><a asp-page="./Login">@Loc["Auth.BackToSignIn"]</a></p>
        </div>
    }
    else
    {
        <div class="auth-card__head">
            <span class="auth-card__eyebrow">@Loc["Auth.Security.Eyebrow"]</span>
            <h1 class="auth-card__title">@Loc["Auth.Reset.Heading"]</h1>
            <p class="auth-card__lede">@Loc["Auth.Reset.Lede"]</p>
        </div>

        <form method="post" class="auth-form" data-password-form>
            <partial name="_ErrorSummary" model="@Loc["Auth.Reset.ErrorTitle"].Value" />
            <input asp-for="Input.Code" type="hidden" />

            <div class="auth-field">
                <label class="auth-field__label" asp-for="Input.Email">@Loc["Auth.Email"]</label>
                <input class="auth-field__input" asp-for="Input.Email" autocomplete="username" inputmode="email"
                       aria-required="true" placeholder="name@example.com" />
                <span class="auth-field__error" asp-validation-for="Input.Email"></span>
            </div>

            <div class="auth-field">
                <label class="auth-field__label" asp-for="Input.Password">@Loc["Auth.NewPassword"]</label>
                <div class="auth-password-toggle">
                    <input class="auth-field__input" asp-for="Input.Password" autocomplete="new-password"
                           aria-required="true" aria-describedby="Input_Password-rules" />
                    <partial name="_PasswordToggleButton" />
                </div>
                <span class="auth-field__error" asp-validation-for="Input.Password"></span>
                <partial name="_PasswordRules" model="@(("Input_Password", (string?)"Input_ConfirmPassword"))" />
            </div>

            <div class="auth-field">
                <label class="auth-field__label" asp-for="Input.ConfirmPassword">@Loc["Auth.ConfirmPassword"]</label>
                <div class="auth-password-toggle">
                    <input class="auth-field__input" asp-for="Input.ConfirmPassword" autocomplete="new-password"
                           aria-required="true" />
                    <partial name="_PasswordToggleButton" />
                </div>
                <span class="auth-field__error" asp-validation-for="Input.ConfirmPassword"></span>
            </div>

            <button type="submit" class="btn btn--primary auth-form__submit">@Loc["Auth.Reset.Submit"]</button>
        </form>

        <div class="auth-alt">
            <p><a asp-page="./Login">@Loc["Auth.BackToSignIn"]</a></p>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

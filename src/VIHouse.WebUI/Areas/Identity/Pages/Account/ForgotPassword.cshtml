@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = Loc["Auth.Forgot.Title"].Value;
}

<div class="auth-card">
    <div class="auth-card__head">
        <span class="auth-card__eyebrow">@Loc["Auth.Security.Eyebrow"]</span>
        <h1 class="auth-card__title">@Loc["Auth.Forgot.Heading"]</h1>
        <p class="auth-card__lede">@Loc["Auth.Forgot.Lede"]</p>
    </div>

    <form method="post" class="auth-form">
        <partial name="_ErrorSummary" model="@Loc["Auth.Forgot.ErrorTitle"].Value" />

        <div class="auth-field">
            <label class="auth-field__label" asp-for="Input.Email">@Loc["Auth.Email"]</label>
            <input class="auth-field__input" asp-for="Input.Email" autocomplete="username" inputmode="email"
                   aria-required="true" placeholder="name@example.com" />
            <span class="auth-field__error" asp-validation-for="Input.Email"></span>
        </div>

        <button type="submit" class="btn btn--primary auth-form__submit">@Loc["Auth.Forgot.Submit"]</button>
    </form>

    <div class="auth-alt">
        <p><a asp-page="./Login">@Loc["Auth.BackToSignIn"]</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

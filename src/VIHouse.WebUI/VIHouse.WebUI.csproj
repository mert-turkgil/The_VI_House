<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\VIHouse.Entities\VIHouse.Entities.csproj" />
    <ProjectReference Include="..\VIHouse.DataAccess\VIHouse.DataAccess.csproj" />
    <ProjectReference Include="..\VIHouse.Business\VIHouse.Business.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="4.1.2" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>22cc579a-3536-4caa-b5f9-cb2b955e2e99</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Never ship the local Development settings (dev connection string, dev-only licence key). CI has
      no such file, but a `dotnet publish` from a developer machine would otherwise include it.
    -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <!-- ClientApp is built by Vite (see targets below), not by MSBuild directly. -->
    <Content Remove="ClientApp/**" />
    <Compile Remove="ClientApp/**" />
    <None Remove="ClientApp/**" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The .resx files are read at runtime as well as compiled, because Admin -> Translations edits
      the XML directly and ResxCatalog reads it back (see Localization/ResxCatalog.cs for why the
      compiled satellites cannot be used for that).

      Update rather than Include: the Web SDK already picks these up as EmbeddedResource, so this
      only adds the copy-to-output without disturbing the embedding. Both matter — the embedded
      copies stay as the fallback the localizer factory drops back to if the files are ever missing.
    -->
    <EmbeddedResource Update="Resources\*.resx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="NpmInstall" Condition="!Exists('ClientApp/node_modules')">
    <Exec Command="npm install" WorkingDirectory="ClientApp" />
  </Target>

  <!--
    Two things about this target are load-bearing, both learned from a deploy where every anonymous
    request for /dist/main.css was answered with the Coming Soon page.

    MapStaticAssets serves only what is in the static web assets manifest, and the SDK builds that
    manifest from @(Content) in ResolveProjectStaticWebAssets — which runs BeforeTargets=AssignTargetPaths,
    early in the build, and @(Content) itself is evaluated before any target runs at all. Hooking
    Vite BeforeTargets="Build" therefore ran it after the scan: on a developer machine wwwroot/dist
    already existed from the previous build and was picked up anyway, on a clean CI checkout it did
    not exist yet, so the manifest had no /dist/* entries and the gate saw "no endpoint" and redirected.

    So: run Vite before the scan, and add its output to Content ourselves, with the same metadata
    the SDK gives the rest of wwwroot (Sdk.StaticWebAssets.StaticAssets.ProjectSystem.props).
    Remove-then-Include rather than Exclude="@(Content)" so a local build, where the evaluation-time
    glob already found the stale dist files, ends up with exactly one item per file either way.

    Skipped for design-time builds: the IDE runs those constantly, and nothing in them needs the CSS.
  -->
  <Target Name="ViteBuild" BeforeTargets="ResolveProjectStaticWebAssets" DependsOnTargets="NpmInstall" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="npm run build" WorkingDirectory="ClientApp" />
    <ItemGroup>
      <Content Remove="wwwroot\dist\**" />
      <Content Include="wwwroot\dist\**" ExcludeFromSingleFile="true" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>

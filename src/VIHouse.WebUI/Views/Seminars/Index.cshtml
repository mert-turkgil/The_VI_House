@model List<SeminarCardViewModel>

<div class="content-hero">
    <div class="container">
        <span class="content-hero__eyebrow">@Loc["Seminars.Eyebrow"]</span>
        <h1>@Loc["Seminars.Heading"]</h1>
        <p class="content-hero__lede">@Loc["Seminars.Subheading"]</p>
    </div>
</div>

<div class="container">
    @if (Model.Count == 0)
    {
        <p class="seminar-empty">@Loc["Seminars.Empty"]</p>
    }
    else
    {
        <div class="seminar-grid">
            @foreach (var seminar in Model)
            {
                <a class="seminar-card" asp-action="Details" asp-route-slug="@seminar.Slug">
                    <div class="seminar-card__image">
                        @* Seminar covers stream through SeminarsController.Media rather than sitting
                           on disk under /img, so there is no -800/-1600 pair and srcset stays empty. *@
                        <partial name="_CoverImage" model="@(new CoverImageViewModel {
                            Url = seminar.HasCover ? Url.Action("Media", new { id = seminar.CoverMediaId }) : null,
                            Ratio = "16x9",
                            Sizes = "(min-width: 960px) 33vw, (min-width: 560px) 50vw, 100vw",
                        })" />
                        @if (seminar.IsArchived)
                        {
                            <span class="seminar-card__badge">@Loc["Seminars.Past"]</span>
                        }
                        else if (seminar.StartAtUtc is null)
                        {
                            <span class="seminar-card__badge">@Loc["Seminars.OnDemand"]</span>
                        }
                    </div>

                    <div class="seminar-card__body">
                        <h3 class="seminar-card__title">@seminar.Title</h3>

                        @if (!string.IsNullOrWhiteSpace(seminar.Summary))
                        {
                            <p class="seminar-card__summary">@seminar.Summary</p>
                        }

                        <div class="seminar-card__meta">
                            @if (seminar.StartAtUtc is not null)
                            {
                                <span>@seminar.StartAtUtc.Value.ToString("d MMMM yyyy, HH:mm") UTC</span>
                            }
                            <span>@(seminar.IsOnline ? Loc["Seminars.Online"].Value : seminar.Location ?? Loc["Seminars.InPerson"].Value)</span>
                            @if (!string.IsNullOrWhiteSpace(seminar.HostName))
                            {
                                <span>@seminar.HostName</span>
                            }
                        </div>

                        <div class="seminar-card__price">
                            @if (seminar.PriceMinor <= 0)
                            {
                                <span class="seminar-card__free">@Loc["Seminars.Free"]</span>
                            }
                            else
                            {
                                <span>@MoneyFormatter.Format(seminar.PriceMinor, seminar.Currency)</span>
                                @if (seminar.IncludedWithMembership)
                                {
                                    <span class="seminar-card__included">@Loc["Seminars.IncludedWithMembership"]</span>
                                }
                            }
                        </div>
                    </div>
                </a>
            }
        </div>
    }
</div>

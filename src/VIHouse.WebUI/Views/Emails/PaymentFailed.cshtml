@model PaymentFailedEmailModel
@{
    ViewData["Subject"] = Loc["Email.PaymentFailed.Subject"].Value;
    ViewData["Preheader"] = string.Format(Loc["Email.PaymentFailed.Preheader"].Value, Model.ExperienceTitle);
    ViewData["Footnote"] = Loc["Email.PaymentFailed.Footnote"].Value;
}
<partial name="/Views/Emails/_EmailHeading.cshtml" model="@(new Heading(Loc["Email.PaymentFailed.Eyebrow"].Value, Loc["Email.PaymentFailed.Heading"].Value, "warning"))" />
<p style="margin:0 0 16px;">@string.Format(Loc["Email.Common.Greeting"].Value, Model.FirstName)</p>
<p style="margin:0 0 16px;">
    @Html.Raw(string.Format(Loc["Email.PaymentFailed.Body1"].Value, $"<strong>{Model.ExperienceTitle}</strong>"))
</p>
<partial name="/Views/Emails/_EmailButton.cshtml" model="@(new Button(Model.InvitationUrl, Loc["Email.PaymentFailed.Button"].Value))" />
<partial name="/Views/Emails/_EmailSignoff.cshtml" model="@(Loc["Email.PaymentFailed.Signoff"].Value)" />

@model PaymentFailedEmailModel
@{
    ViewData["Preheader"] = $"Your checkout for {Model.ExperienceTitle} timed out — nothing was charged";
    ViewData["Footnote"] = "You're receiving this because you started a booking at The VI House.";
}
<partial name="/Views/Emails/_EmailHeading.cshtml" model="@(new Heading("Checkout not completed", "We couldn't complete your payment", "warning"))" />
<p style="margin:0 0 16px;">Hi @Model.FirstName,</p>
<p style="margin:0 0 16px;">
    Your checkout for <strong>@Model.ExperienceTitle</strong> wasn't completed in time, so no payment was taken and
    the place we were holding has been released. Your approval still stands — start a new checkout below.
</p>
<partial name="/Views/Emails/_EmailButton.cshtml" model="@(new Button(Model.InvitationUrl, "Try again"))" />
<partial name="/Views/Emails/_EmailSignoff.cshtml" model="@("If the card was declined, your bank may be able to say why; if you'd rather pay another way, reply to this email.")" />

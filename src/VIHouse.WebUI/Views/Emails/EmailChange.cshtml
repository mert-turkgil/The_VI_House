@model EmailChangeEmailModel
@{
    ViewData["Subject"] = Loc["Email.EmailChange.Subject"].Value;
    ViewData["Preheader"] = string.Format(Loc["Email.EmailChange.Preheader"].Value, Model.NewEmail);
    ViewData["Footnote"] = Loc["Email.EmailChange.Footnote"].Value;
}
<partial name="/Views/Emails/_EmailHeading.cshtml" model="@(new Heading(Loc["Email.Common.EyebrowYourAccount"].Value, Loc["Email.EmailChange.Heading"].Value))" />
<p style="margin:0 0 16px;">@string.Format(Loc["Email.Common.Greeting"].Value, Model.FirstName)</p>
<p style="margin:0 0 16px;">
    @Html.Raw(string.Format(Loc["Email.EmailChange.Body1"].Value, $"<strong>{Model.NewEmail}</strong>"))
</p>
<partial name="/Views/Emails/_EmailButton.cshtml" model="@(new Button(Model.ConfirmUrl, Loc["Email.EmailChange.Button"].Value))" />
<p style="margin:0 0 6px; font-size:13px; color:#5a5f55;">@Loc["Email.Common.ButtonFallbackHint"]</p>
<partial name="/Views/Emails/_EmailCode.cshtml" model="@(new Code(Model.ConfirmUrl, Href: Model.ConfirmUrl))" />
<partial name="/Views/Emails/_EmailSignoff.cshtml" model="@(Loc["Email.EmailChange.Signoff"].Value)" />

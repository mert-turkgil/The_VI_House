@model MembershipPaymentFailedEmailModel
@{
    ViewData["Preheader"] = "Your card was declined — nothing changes yet, but please update it";
}
<p style="margin:0 0 6px; color:#9a3324; font-size:11px; font-weight:bold; letter-spacing:2px; text-transform:uppercase;">Action needed</p>
<h1 style="font-family:Georgia,'Times New Roman',serif; font-size:26px; line-height:1.2; margin:0 0 18px; color:#00230a;">Your membership payment didn't go through</h1>
<p style="margin:0 0 16px;">Hi @Model.FirstName,</p>
<p style="margin:0 0 16px;">
    We tried to renew your <strong>@Model.PlanName</strong> membership, but the payment was declined.
    This usually means a card has expired or been replaced.
</p>
@{
    var rows = new List<(string, string)> { ("Plan", Model.PlanName) };
    if (Model.AccessUntil is { } until) rows.Add(("Access continues until", until.ToString("d MMMM yyyy")));
    if (Model.NextAttemptAt is { } next) rows.Add(("We'll try again on", next.ToString("d MMMM yyyy")));
}
<partial name="/Views/Emails/_EmailDetails.cshtml" model="rows" />
<p style="margin:0 0 8px;">To avoid an interruption, update your payment details before then:</p>
<partial name="/Views/Emails/_EmailButton.cshtml" model="@((Model.ActionUrl, "Update payment"))" />
<p style="margin:0;">&mdash; The VI House</p>

@model MembershipPaymentFailedEmailModel
@{
    ViewData["Preheader"] = Loc["Email.MembershipPaymentFailed.Preheader"].Value;
    ViewData["Footnote"] = Loc["Email.Common.FootnoteMembership"].Value;
    var rows = new List<(string, string)> { (Loc["Email.Common.DetailPlanLabel"].Value, Model.PlanName) };
    if (Model.AccessUntil is { } until) rows.Add((Loc["Email.Common.DetailAccessUntilLabel"].Value, until.ToString("d MMMM yyyy")));
    if (Model.NextAttemptAt is { } next) rows.Add((Loc["Email.Common.DetailNextAttemptLabel"].Value, next.ToString("d MMMM yyyy")));
}
<partial name="/Views/Emails/_EmailHeading.cshtml" model="@(new Heading(Loc["Email.Common.EyebrowActionNeeded"].Value, Loc["Email.MembershipPaymentFailed.Heading"].Value, "warning"))" />
<p style="margin:0 0 16px;">@string.Format(Loc["Email.Common.Greeting"].Value, Model.FirstName)</p>
<p style="margin:0 0 16px;">
    @Html.Raw(string.Format(Loc["Email.MembershipPaymentFailed.Body1"].Value, $"<strong>{Model.PlanName}</strong>"))
</p>
<partial name="/Views/Emails/_EmailDetails.cshtml" model="rows" />
<p style="margin:0 0 8px;">@Loc["Email.MembershipPaymentFailed.Body2"]</p>
<partial name="/Views/Emails/_EmailButton.cshtml" model="@(new Button(Model.ActionUrl, Loc["Email.MembershipPaymentFailed.Button"].Value))" />
<partial name="/Views/Emails/_EmailSignoff.cshtml" model="@(Loc["Email.MembershipPaymentFailed.Signoff"].Value)" />

@model MembershipPaymentFailedEmailModel

<h1 style="font-family:Georgia,serif; font-size:22px; margin:0 0 16px;">Your Membership Payment Didn't Go Through</h1>
<p style="margin:0 0 16px;">Hi @Model.FirstName,</p>
<p style="margin:0 0 16px;">
    We tried to renew your <strong>@Model.PlanName</strong> membership, but the payment was declined.
    This usually means a card has expired or been replaced.
</p>
@if (Model.AccessUntil is { } until)
{
    <p style="margin:0 0 16px;">
        Nothing changes straight away: your membership stays active until
        <strong>@until.ToString("d MMMM yyyy")</strong>, the end of the period you've already paid for.
    </p>
}
@if (Model.NextAttemptAt is { } next)
{
    <p style="margin:0 0 16px;">
        We'll try the card again on <strong>@next.ToString("d MMMM yyyy")</strong>. To avoid an
        interruption, update your payment details before then:
    </p>
}
else
{
    <p style="margin:0 0 16px;">To keep your membership, update your payment details:</p>
}
<p style="margin:0 0 16px;">
    <a href="@Model.ActionUrl" style="display:inline-block; padding:12px 24px; background-color:#b8955a; color:#001a02; text-decoration:none; font-family:Arial,Helvetica,sans-serif; font-size:13px; font-weight:bold; letter-spacing:1px; text-transform:uppercase; border-radius:24px;">
        Update Payment
    </a>
</p>
<p style="margin:0;">&mdash; The VI House</p>

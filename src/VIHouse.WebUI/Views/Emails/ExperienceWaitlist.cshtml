@model ExperienceWaitlistEmailModel
@{
    ViewData["Subject"] = Loc["Email.ApplicationWaitlisted.Subject"].Value;
    ViewData["Preheader"] = string.Format(Loc["Email.ExperienceWaitlist.Preheader"].Value, Model.Position, Model.ExperienceTitle);
    ViewData["Footnote"] = Loc["Email.ExperienceWaitlist.Footnote"].Value;
}
<partial name="/Views/Emails/_EmailHeading.cshtml" model="@(new Heading(Loc["Email.Common.EyebrowWaitlist"].Value, Loc["Email.ExperienceWaitlist.Heading"].Value))" />
<p style="margin:0 0 16px;">@string.Format(Loc["Email.Common.Greeting"].Value, Model.FirstName)</p>
<p style="margin:0 0 16px;">
    @Html.Raw(string.Format(Loc["Email.ExperienceWaitlist.Body1"].Value, $"<strong>{Model.ExperienceTitle}</strong>", Model.ExperienceCity))
</p>
<partial name="/Views/Emails/_EmailDetails.cshtml" model="@(new List<(string, string)> { (Loc["Email.Common.DetailExperienceLabel"].Value, Model.ExperienceTitle), (Loc["Email.Common.DetailCityLabel"].Value, Model.ExperienceCity), (Loc["Email.ExperienceWaitlist.PositionLabel"].Value, Model.Position.ToString()) })" />
<p style="margin:0 0 16px;">@Loc["Email.ExperienceWaitlist.Body2"]</p>
<partial name="/Views/Emails/_EmailSignoff.cshtml" model="@(Loc["Email.ExperienceWaitlist.Signoff"].Value)" />

@model ExperienceWaitlistEmailModel
@{
    ViewData["Preheader"] = $"You're number {Model.Position} in line for {Model.ExperienceTitle}";
    ViewData["Footnote"] = "You're receiving this because you joined a waitlist at The VI House.";
}
<partial name="/Views/Emails/_EmailHeading.cshtml" model="@(new Heading("Waitlist", "You're on the list"))" />
<p style="margin:0 0 16px;">Hi @Model.FirstName,</p>
<p style="margin:0 0 16px;">
    <strong>@Model.ExperienceTitle</strong> in @Model.ExperienceCity is full for this round, but you are on the waitlist.
</p>
<partial name="/Views/Emails/_EmailDetails.cshtml" model="@(new List<(string, string)> { ("Experience", Model.ExperienceTitle), ("City", Model.ExperienceCity), ("Your place in line", Model.Position.ToString()) })" />
<p style="margin:0 0 16px;">If a place opens up &mdash; and it often does &mdash; we will email you before anyone else hears about it.</p>
<partial name="/Views/Emails/_EmailSignoff.cshtml" model="@("Nothing to do now. We'll come to you.")" />

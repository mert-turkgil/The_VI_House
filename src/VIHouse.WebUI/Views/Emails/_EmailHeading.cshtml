@* Eyebrow + heading, the first thing in every email. Tone "gold" is the everyday one; "warning"
   turns the eyebrow red for a failed payment or a decision; "security" puts the eyebrow in an amber
   banner so an alert is unmistakable even with images off. Model: EmailParts.Heading. *@
@model VIHouse.WebUI.Helpers.EmailParts.Heading
@{
    var eyebrowColour = Model.Tone == "warning" ? "#9a3324" : Model.Tone == "security" ? "#7a5f2e" : "#b8955a";
}
@if (Model.Tone == "security")
{
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 22px; background-color:#fbf5e9; border-left:4px solid #b8955a; border-radius:0 8px 8px 0;">
        <tr>
            <td style="padding:12px 16px; color:@eyebrowColour; font-size:11px; font-weight:bold; letter-spacing:2px; text-transform:uppercase;">@Model.Eyebrow</td>
        </tr>
    </table>
}
else
{
    <p style="margin:0 0 6px; color:@eyebrowColour; font-size:11px; font-weight:bold; letter-spacing:2px; text-transform:uppercase;">@Model.Eyebrow</p>
}
<h1 class="vih-h1" style="font-family:Georgia,'Times New Roman',serif; font-size:26px; font-weight:normal; line-height:1.2; margin:0 0 18px; color:#00230a;">@Model.Title</h1>

@model ApplicationApprovedEmailModel
@{
    ViewData["Preheader"] = $"You're approved for The VI House — {Model.ExperienceCity}. Complete your booking by {Model.ExpiresAt:d MMMM}.";
    ViewData["Footnote"] = "You're receiving this because you applied to an experience at The VI House.";
}
<partial name="/Views/Emails/_EmailHeading.cshtml" model="@(new Heading("You're approved", $"Welcome to The VI House — {Model.ExperienceCity}"))" />
<p style="margin:0 0 16px;">Hi @Model.FirstName,</p>
<p style="margin:0 0 16px;">
    We would be glad to have you at <strong>@Model.ExperienceTitle</strong>. Your place is held for you now —
    complete the booking below to make it yours.
</p>
<partial name="/Views/Emails/_EmailDetails.cshtml" model="@(new List<(string, string)> { ("Experience", Model.ExperienceTitle), ("City", Model.ExperienceCity), ("Booking link valid until", Model.ExpiresAt.ToString("d MMMM yyyy")) })" />
<partial name="/Views/Emails/_EmailButton.cshtml" model="@(new Button(Model.InvitationUrl, "Complete your booking"))" />
<p style="margin:0 0 6px; font-size:13px; color:#5a5f55;">If the button doesn't work, copy this into your browser:</p>
<partial name="/Views/Emails/_EmailCode.cshtml" model="@(new Code(Model.InvitationUrl, Href: Model.InvitationUrl))" />
<partial name="/Views/Emails/_EmailSignoff.cshtml" model="@("The link is personal to you. If you need more time than it allows, reply to this email and we will extend it.")" />

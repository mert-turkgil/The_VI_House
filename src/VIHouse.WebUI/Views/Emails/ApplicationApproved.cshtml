@model ApplicationApprovedEmailModel
@{
    ViewData["Preheader"] = string.Format(Loc["Email.ApplicationApproved.Preheader"].Value, Model.ExperienceCity, Model.ExpiresAt.ToString("d MMMM"));
    ViewData["Footnote"] = Loc["Email.Common.FootnoteApplication"].Value;
}
<partial name="/Views/Emails/_EmailHeading.cshtml" model="@(new Heading(Loc["Email.ApplicationApproved.Eyebrow"].Value, string.Format(Loc["Email.ApplicationApproved.Heading"].Value, Model.ExperienceCity)))" />
<p style="margin:0 0 16px;">@string.Format(Loc["Email.Common.Greeting"].Value, Model.FirstName)</p>
<p style="margin:0 0 16px;">
    @Html.Raw(string.Format(Loc["Email.ApplicationApproved.Body1"].Value, $"<strong>{Model.ExperienceTitle}</strong>"))
</p>
<partial name="/Views/Emails/_EmailDetails.cshtml" model="@(new List<(string, string)> { (Loc["Email.Common.DetailExperienceLabel"].Value, Model.ExperienceTitle), (Loc["Email.Common.DetailCityLabel"].Value, Model.ExperienceCity), (Loc["Email.Common.DetailBookingLinkValidLabel"].Value, Model.ExpiresAt.ToString("d MMMM yyyy")) })" />
<partial name="/Views/Emails/_EmailButton.cshtml" model="@(new Button(Model.InvitationUrl, Loc["Email.ApplicationApproved.Button"].Value))" />
<p style="margin:0 0 6px; font-size:13px; color:#5a5f55;">@Loc["Email.Common.ButtonFallbackHint"]</p>
<partial name="/Views/Emails/_EmailCode.cshtml" model="@(new Code(Model.InvitationUrl, Href: Model.InvitationUrl))" />
<partial name="/Views/Emails/_EmailSignoff.cshtml" model="@(Loc["Email.ApplicationApproved.Signoff"].Value)" />

@model MembershipResumeEmailModel

<h1 style="font-family:Georgia,serif; font-size:22px; margin:0 0 16px;">Pick Up Where You Left Off</h1>
<p style="margin:0 0 16px;">Hi @Model.FirstName,</p>
<p style="margin:0 0 16px;">
    Your checkout for the <strong>@Model.PlanName</strong> membership wasn't completed in time, so no
    payment was taken and no account has been created. Everything you told us is saved &mdash; the
    link below reopens checkout without asking for it again.
</p>
<p style="margin:0 0 16px;">
    <a href="@Model.ResumeUrl" style="display:inline-block; padding:12px 24px; background-color:#b8955a; color:#001a02; text-decoration:none; font-family:Arial,Helvetica,sans-serif; font-size:13px; font-weight:bold; letter-spacing:1px; text-transform:uppercase; border-radius:24px;">
        Continue to Payment
    </a>
</p>
<p style="margin:0 0 16px; font-size:13px; color:#666;">
    If you've changed your mind, there's nothing to do &mdash; we won't charge you and we won't
    keep asking.
</p>
<p style="margin:0;">&mdash; The VI House</p>

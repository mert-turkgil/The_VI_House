@model MembershipResumeEmailModel
@{
    ViewData["Preheader"] = string.Format(Loc["Email.MembershipResume.Preheader"].Value, Model.PlanName);
    ViewData["Footnote"] = Loc["Email.MembershipResume.Footnote"].Value;
}
<partial name="/Views/Emails/_EmailHeading.cshtml" model="@(new Heading(Loc["Email.Common.EyebrowMembership"].Value, Loc["Email.MembershipResume.Heading"].Value))" />
<p style="margin:0 0 16px;">@string.Format(Loc["Email.Common.Greeting"].Value, Model.FirstName)</p>
<p style="margin:0 0 16px;">
    @Html.Raw(string.Format(Loc["Email.MembershipResume.Body1"].Value, $"<strong>{Model.PlanName}</strong>"))
</p>
<partial name="/Views/Emails/_EmailButton.cshtml" model="@(new Button(Model.ResumeUrl, Loc["Email.MembershipResume.Button"].Value))" />
<partial name="/Views/Emails/_EmailSignoff.cshtml" model="@(Loc["Email.MembershipResume.Signoff"].Value)" />

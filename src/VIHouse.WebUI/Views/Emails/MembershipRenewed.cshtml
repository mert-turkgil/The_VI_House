@model MembershipRenewedEmailModel
@{
    ViewData["Preheader"] = string.Format(Loc["Email.MembershipRenewed.Preheader"].Value, Model.PlanName, Model.ExpiresAt.ToString("d MMMM yyyy"));
    ViewData["Footnote"] = Loc["Email.Common.FootnoteMembership"].Value;
}
<partial name="/Views/Emails/_EmailHeading.cshtml" model="@(new Heading(Loc["Email.Common.EyebrowMembershipRenewed"].Value, Loc["Email.Common.HeadingMembershipRenewed"].Value))" />
<p style="margin:0 0 16px;">@string.Format(Loc["Email.Common.Greeting"].Value, Model.FirstName)</p>
<p style="margin:0 0 20px;">
    @Html.Raw(string.Format(Loc["Email.MembershipRenewed.Body"].Value, $"<strong>{Model.PlanName}</strong>"))
</p>
<partial name="/Views/Emails/_EmailDetails.cshtml" model="@(new List<(string, string)> { (Loc["Email.Common.DetailPlanLabel"].Value, Model.PlanName), (Loc["Email.Common.DetailRunsUntilLabel"].Value, Model.ExpiresAt.ToString("d MMMM yyyy")) })" />
<partial name="/Views/Emails/_EmailSignoff.cshtml" model="@(Loc["Email.MembershipRenewed.Signoff"].Value)" />

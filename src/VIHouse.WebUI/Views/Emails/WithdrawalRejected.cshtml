@model WithdrawalRejectedEmailModel
@{
    ViewData["Subject"] = Loc["Email.WithdrawalRejected.Subject"].Value;
    ViewData["Preheader"] = string.Format(Loc["Email.WithdrawalRejected.Preheader"].Value, Model.Amount);
    ViewData["Footnote"] = Loc["Email.Common.FootnoteAmbassador"].Value;
}
<partial name="/Views/Emails/_EmailHeading.cshtml" model="@(new Heading(Loc["Email.Common.EyebrowAmbassador"].Value, Loc["Email.WithdrawalRejected.Heading"].Value))" />
<p style="margin:0 0 16px;">@string.Format(Loc["Email.Common.Greeting"].Value, Model.Name)</p>
<p style="margin:0 0 16px;">@string.Format(Loc["Email.WithdrawalRejected.Body1"].Value, Model.Amount)</p>
<partial name="/Views/Emails/_EmailNote.cshtml" model="@(new Note(Model.Reason, "info", Loc["Email.Common.NoteFromTeamLabel"].Value))" />
<p style="margin:0 0 20px;">@Loc["Email.WithdrawalRejected.Body2"]</p>
<partial name="/Views/Emails/_EmailButton.cshtml" model="@(new Button(Model.DashboardUrl, Loc["Email.Common.ButtonOpenEarnings"].Value, Secondary: true))" />
<partial name="/Views/Emails/_EmailSignoff.cshtml" model="@((string?)null)" />

@model PasswordResetEmailModel
@{
    ViewData["Preheader"] = "Here is the link to choose a new password";
    ViewData["Footnote"] = "You're receiving this because a password reset was requested for your VI House account.";
}
<partial name="/Views/Emails/_EmailHeading.cshtml" model="@(new Heading("Your account", "Reset your password"))" />
<p style="margin:0 0 16px;">Hi @Model.FirstName,</p>
<p style="margin:0 0 16px;">
    Someone &mdash; hopefully you &mdash; asked to reset the password on your VI House account. Choose a new one below.
</p>
<partial name="/Views/Emails/_EmailButton.cshtml" model="@(new Button(Model.ResetUrl, "Choose a new password"))" />
<p style="margin:0 0 6px; font-size:13px; color:#5a5f55;">If the button doesn't work, copy this into your browser:</p>
<partial name="/Views/Emails/_EmailCode.cshtml" model="@(new Code(Model.ResetUrl, Href: Model.ResetUrl))" />
<partial name="/Views/Emails/_EmailNote.cshtml" model="@(new Note($"This link works once and expires in {Model.ExpiresInHours} hours. If you didn't ask for a reset, ignore this email — your password stays as it is and nobody can change it without this link.", "info"))" />
<partial name="/Views/Emails/_EmailSignoff.cshtml" model="@("We will never ask for your password by email.")" />

@model PasswordResetEmailModel
@{
    ViewData["Subject"] = Loc["Email.PasswordReset.Subject"].Value;
    ViewData["Preheader"] = Loc["Email.PasswordReset.Preheader"].Value;
    ViewData["Footnote"] = Loc["Email.PasswordReset.Footnote"].Value;
}
<partial name="/Views/Emails/_EmailHeading.cshtml" model="@(new Heading(Loc["Email.Common.EyebrowYourAccount"].Value, Loc["Email.PasswordReset.Heading"].Value))" />
<p style="margin:0 0 16px;">@string.Format(Loc["Email.Common.Greeting"].Value, Model.FirstName)</p>
<p style="margin:0 0 16px;">
    @Loc["Email.PasswordReset.Body1"]
</p>
<partial name="/Views/Emails/_EmailButton.cshtml" model="@(new Button(Model.ResetUrl, Loc["Email.PasswordReset.Button"].Value))" />
<p style="margin:0 0 6px; font-size:13px; color:#5a5f55;">@Loc["Email.Common.ButtonFallbackHint"]</p>
<partial name="/Views/Emails/_EmailCode.cshtml" model="@(new Code(Model.ResetUrl, Href: Model.ResetUrl))" />
<partial name="/Views/Emails/_EmailNote.cshtml" model="@(new Note(string.Format(Loc["Email.PasswordReset.Note"].Value, Model.ExpiresInHours), "info"))" />
<partial name="/Views/Emails/_EmailSignoff.cshtml" model="@(Loc["Email.PasswordReset.Signoff"].Value)" />

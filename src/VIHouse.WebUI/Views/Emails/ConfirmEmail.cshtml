@model ConfirmEmailAddressEmailModel
@{
    ViewData["Preheader"] = Loc["Email.ConfirmEmail.Preheader"].Value;
    ViewData["Footnote"] = Loc["Email.ConfirmEmail.Footnote"].Value;
}
<partial name="/Views/Emails/_EmailHeading.cshtml" model="@(new Heading(Loc["Email.Common.EyebrowYourAccount"].Value, Loc["Email.ConfirmEmail.Heading"].Value))" />
<p style="margin:0 0 16px;">@string.Format(Loc["Email.Common.Greeting"].Value, Model.FirstName)</p>
<p style="margin:0 0 16px;">
    @Loc["Email.ConfirmEmail.Body1"]
</p>
<partial name="/Views/Emails/_EmailButton.cshtml" model="@(new Button(Model.ConfirmUrl, Loc["Email.ConfirmEmail.Button"].Value))" />
<p style="margin:0 0 6px; font-size:13px; color:#5a5f55;">@Loc["Email.Common.ButtonFallbackHint"]</p>
<partial name="/Views/Emails/_EmailCode.cshtml" model="@(new Code(Model.ConfirmUrl, Href: Model.ConfirmUrl))" />
<partial name="/Views/Emails/_EmailSignoff.cshtml" model="@(Loc["Email.ConfirmEmail.Signoff"].Value)" />

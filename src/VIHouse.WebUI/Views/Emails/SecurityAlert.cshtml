@model SecurityAlertEmailModel
@{
    ViewData["Preheader"] = $"{Model.Event} on your VI House account";
    var rows = new List<(string, string)> { ("What", Model.Event), ("When", $"{Model.WhenUtc:d MMMM yyyy, HH:mm} UTC") };
    if (!string.IsNullOrWhiteSpace(Model.IpAddress)) rows.Add(("From", Model.IpAddress));
    if (!string.IsNullOrWhiteSpace(Model.UserAgent)) rows.Add(("Device", Model.UserAgent));
}

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 22px; background-color:#fbf5e9; border-left:4px solid #b8955a; border-radius:0 8px 8px 0;">
    <tr>
        <td style="padding:12px 16px; color:#7a5f2e; font-size:11px; font-weight:bold; letter-spacing:2px; text-transform:uppercase;">Security notice</td>
    </tr>
</table>
<h1 style="font-family:Georgia,'Times New Roman',serif; font-size:26px; line-height:1.2; margin:0 0 18px; color:#00230a;">@Model.Event</h1>
<p style="margin:0 0 16px;">Hi @Model.FirstName,</p>
<p style="margin:0 0 20px;">@Model.Detail</p>

<partial name="/Views/Emails/_EmailDetails.cshtml" model="rows" />

<p style="margin:0 0 6px;"><strong>Was this you?</strong> Then there is nothing to do.</p>
<p style="margin:0 0 8px;">If it wasn't, secure your account now:</p>
<partial name="/Views/Emails/_EmailButton.cshtml" model="@((Model.ActionUrl, Model.ActionLabel))" />

<p style="margin:0 0 16px; color:#4a4f45;">
    We will never ask for your password by email. If anything about this looks wrong, reply to this message and a person will look into it.
</p>
<p style="margin:0;">&mdash; The VI House</p>

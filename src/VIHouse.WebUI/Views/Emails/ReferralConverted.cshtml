@model ReferralConvertedEmailModel

<h1 style="font-family:Georgia,serif; font-size:22px; margin:0 0 16px;">Your link just worked</h1>
<p style="margin:0 0 16px;">Hi @Model.Name,</p>
<p style="margin:0 0 16px;">
    @Model.What
</p>

@if (Model.Amount is not null)
{
    <p style="margin:0 0 16px;">
        Amount: <strong>@Model.Amount</strong>@(Model.Commission is not null ? $" — your commission: {Model.Commission}" : "").
    </p>
}

<p style="margin:0 0 16px;">
    We don't share who it was; the numbers are all on your dashboard.
</p>

<p style="margin:0 0 16px;">
    <a href="@Model.DashboardUrl" style="color:#00230a;">Open your ambassador dashboard</a>
</p>

<p style="margin:0;">&mdash; The VI House</p>

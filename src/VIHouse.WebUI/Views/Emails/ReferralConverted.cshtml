@model ReferralConvertedEmailModel
@{
    ViewData["Preheader"] = Model.What;
    ViewData["Footnote"] = Loc["Email.Common.FootnoteAmbassador"].Value;
    var rows = new List<(string, string)>();
    if (Model.Amount is not null) rows.Add((Loc["Email.Common.DetailAmountLabel"].Value, Model.Amount));
    if (Model.Commission is not null) rows.Add((Loc["Email.Common.DetailCommissionLabel"].Value, Model.Commission));
}
<partial name="/Views/Emails/_EmailHeading.cshtml" model="@(new Heading(Loc["Email.Common.EyebrowAmbassador"].Value, Loc["Email.ReferralConverted.Heading"].Value))" />
<p style="margin:0 0 16px;">@string.Format(Loc["Email.Common.Greeting"].Value, Model.Name)</p>
<p style="margin:0 0 20px;">@Model.What</p>
@if (rows.Count > 0)
{
    <partial name="/Views/Emails/_EmailDetails.cshtml" model="rows" />
}
<partial name="/Views/Emails/_EmailButton.cshtml" model="@(new Button(Model.DashboardUrl, Loc["Email.Common.ButtonOpenDashboard"].Value))" />
<partial name="/Views/Emails/_EmailSignoff.cshtml" model="@(Loc["Email.ReferralConverted.Signoff"].Value)" />

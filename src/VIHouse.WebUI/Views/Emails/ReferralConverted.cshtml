@model ReferralConvertedEmailModel
@{
    ViewData["Preheader"] = Model.What;
    ViewData["Footnote"] = "You're receiving this because you are an ambassador for The VI House.";
    var rows = new List<(string, string)>();
    if (Model.Amount is not null) rows.Add(("Amount", Model.Amount));
    if (Model.Commission is not null) rows.Add(("Your commission", Model.Commission));
}
<partial name="/Views/Emails/_EmailHeading.cshtml" model="@(new Heading("Ambassador", "Your link just worked"))" />
<p style="margin:0 0 16px;">Hi @Model.Name,</p>
<p style="margin:0 0 20px;">@Model.What</p>
@if (rows.Count > 0)
{
    <partial name="/Views/Emails/_EmailDetails.cshtml" model="rows" />
}
<partial name="/Views/Emails/_EmailButton.cshtml" model="@(new Button(Model.DashboardUrl, "Open your dashboard"))" />
<partial name="/Views/Emails/_EmailSignoff.cshtml" model="@("We don't share who it was; the numbers are all on your dashboard.")" />

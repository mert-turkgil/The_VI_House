@* Key/value rows on a cream card. Two columns on desktop; the .vih-stack classes make each row
   stack on narrow screens (see _EmailLayout's one <style> block). Model: rows of (Label, Value). *@
@model List<(string Label, string Value)>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 24px; background-color:#f4f0e6; border-radius:8px;">
    <tr>
        <td style="padding:6px 18px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-family:Arial,Helvetica,sans-serif; font-size:14px;">
                @foreach (var (label, value) in Model)
                {
                    <tr>
                        <td class="vih-stack vih-stack-label" style="padding:10px 0; width:40%; color:#63685c; font-size:11px; letter-spacing:1.2px; text-transform:uppercase; border-bottom:1px solid #e9e3d3; vertical-align:top;">@label</td>
                        <td class="vih-stack vih-stack-value" style="padding:10px 0; text-align:right; color:#12160f; font-weight:bold; border-bottom:1px solid #e9e3d3; vertical-align:top;">@value</td>
                    </tr>
                }
            </table>
        </td>
    </tr>
</table>

@model PaymentProcessingEmailModel
@{
    ViewData["Preheader"] = string.Format(Loc["Email.PaymentProcessing.Preheader"].Value, Model.What);
    ViewData["Footnote"] = Loc["Email.PaymentProcessing.Footnote"].Value;
    var rows = new List<(string, string)>
    {
        (Loc["Email.Common.DetailForLabel"].Value, Model.What),
        (Loc["Email.Common.DetailAmountLabel"].Value, MoneyFormatter.Format(Model.AmountMinor, Model.Currency)),
        (Loc["Email.Common.DetailStatusLabel"].Value, Loc["Email.PaymentProcessing.WaitingValue"].Value),
    };
}
<partial name="/Views/Emails/_EmailHeading.cshtml" model="@(new Heading(Loc["Email.PaymentProcessing.Eyebrow"].Value, Loc["Email.PaymentProcessing.Heading"].Value))" />
<p style="margin:0 0 16px;">@string.Format(Loc["Email.Common.Greeting"].Value, Model.FirstName)</p>
<p style="margin:0 0 16px;">
    @Html.Raw(string.Format(Loc["Email.PaymentProcessing.Body1"].Value, $"<strong>{Model.What}</strong>"))
</p>
<partial name="/Views/Emails/_EmailDetails.cshtml" model="rows" />
<p style="margin:0 0 8px;">@Loc["Email.PaymentProcessing.Body2"]</p>
<partial name="/Views/Emails/_EmailButton.cshtml" model="@(new Button(Model.StatusUrl, Loc["Email.PaymentProcessing.Button"].Value))" />
<partial name="/Views/Emails/_EmailSignoff.cshtml" model="@(Loc["Email.PaymentProcessing.Signoff"].Value)" />

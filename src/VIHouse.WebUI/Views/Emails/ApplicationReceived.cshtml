@model ApplicationReceivedEmailModel
@{
    ViewData["Preheader"] = string.Format(Loc["Email.ApplicationReceived.Preheader"].Value, Model.ExperienceCity);
    ViewData["Footnote"] = Loc["Email.Common.FootnoteApplication"].Value;
}
<partial name="/Views/Emails/_EmailHeading.cshtml" model="@(new Heading(Loc["Email.ApplicationReceived.Eyebrow"].Value, Loc["Email.ApplicationReceived.Heading"].Value))" />
<p style="margin:0 0 16px;">@string.Format(Loc["Email.Common.Greeting"].Value, Model.FirstName)</p>
<p style="margin:0 0 16px;">
    @Html.Raw(string.Format(Loc["Email.ApplicationReceived.Body1"].Value, $"<strong>The VI House &mdash; {Model.ExperienceCity}</strong>", Model.ExperienceTitle))
</p>
<partial name="/Views/Emails/_EmailDetails.cshtml" model="@(new List<(string, string)> { (Loc["Email.Common.DetailExperienceLabel"].Value, Model.ExperienceTitle), (Loc["Email.Common.DetailCityLabel"].Value, Model.ExperienceCity), (Loc["Email.ApplicationReceived.NextStepsLabel"].Value, Loc["Email.ApplicationReceived.NextStepsValue"].Value) })" />
<p style="margin:0 0 16px; color:#4a4f45;">@Loc["Email.ApplicationReceived.Body2"]</p>
<partial name="/Views/Emails/_EmailSignoff.cshtml" model="@((string?)null)" />

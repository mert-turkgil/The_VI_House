@model ApplicationReceivedEmailModel

<h1 style="font-family:Georgia,serif; font-size:22px; margin:0 0 16px;">Application Received</h1>
<p style="margin:0 0 16px;">Hi @Model.FirstName,</p>
<p style="margin:0 0 16px;">
    Thank you for applying to <strong>The VI House &mdash; @Model.ExperienceCity</strong>.
    Every application is reviewed by hand — we'll be in touch within a few days.
</p>
<p style="margin:0;">&mdash; The VI House</p>

@model AdminInviteEmailModel
@{
    ViewData["Preheader"] = $"{Model.InvitedBy} has given you admin access — set your password to start";
    ViewData["Footnote"] = "You're receiving this because a VI House administrator created a staff account for you.";
}
<partial name="/Views/Emails/_EmailHeading.cshtml" model="@(new Heading("Admin access", "You've been given admin access"))" />
<p style="margin:0 0 16px;">Hi @Model.FirstName,</p>
<p style="margin:0 0 16px;">
    @Model.InvitedBy has created an admin account for you on The VI House.
</p>
<partial name="/Views/Emails/_EmailDetails.cshtml" model="@(new List<(string, string)> { ("Access", Model.RoleSummary), ("Invited by", Model.InvitedBy) })" />
<p style="margin:0 0 16px;">
    Set your password below. You'll then be asked to confirm this email address and set up two-factor
    authentication &mdash; both are required before the admin panel will open, and we'll walk you through the
    two-factor step with a QR code.
</p>
<partial name="/Views/Emails/_EmailButton.cshtml" model="@(new Button(Model.SetupUrl, "Set your password"))" />
<p style="margin:0 0 6px; font-size:13px; color:#5a5f55;">If the button doesn't work, copy this into your browser:</p>
<partial name="/Views/Emails/_EmailCode.cshtml" model="@(new Code(Model.SetupUrl, Href: Model.SetupUrl))" />
<partial name="/Views/Emails/_EmailNote.cshtml" model="@(new Note($"This link can only be used once. If it expires, use \"Forgot your password?\" on the sign-in page. If you weren't expecting this, tell {Model.InvitedBy} — don't use the link.", "warning"))" />
<partial name="/Views/Emails/_EmailSignoff.cshtml" model="@((string?)null)" />

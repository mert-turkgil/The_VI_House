@model AdminInviteEmailModel
@{
    ViewData["Preheader"] = string.Format(Loc["Email.AdminInvite.Preheader"].Value, Model.InvitedBy);
    ViewData["Footnote"] = Loc["Email.AdminInvite.Footnote"].Value;
}
<partial name="/Views/Emails/_EmailHeading.cshtml" model="@(new Heading(Loc["Email.AdminInvite.Eyebrow"].Value, Loc["Email.AdminInvite.Heading"].Value))" />
<p style="margin:0 0 16px;">@string.Format(Loc["Email.Common.Greeting"].Value, Model.FirstName)</p>
<p style="margin:0 0 16px;">
    @string.Format(Loc["Email.AdminInvite.Body1"].Value, Model.InvitedBy)
</p>
<partial name="/Views/Emails/_EmailDetails.cshtml" model="@(new List<(string, string)> { (Loc["Email.AdminInvite.DetailsAccessLabel"].Value, Model.RoleSummary), (Loc["Email.AdminInvite.DetailsInvitedByLabel"].Value, Model.InvitedBy) })" />
<p style="margin:0 0 16px;">
    @Loc["Email.AdminInvite.Body2"]
</p>
<partial name="/Views/Emails/_EmailButton.cshtml" model="@(new Button(Model.SetupUrl, Loc["Email.AdminInvite.ButtonSetPassword"].Value))" />
<p style="margin:0 0 6px; font-size:13px; color:#5a5f55;">@Loc["Email.Common.ButtonFallbackHint"]</p>
<partial name="/Views/Emails/_EmailCode.cshtml" model="@(new Code(Model.SetupUrl, Href: Model.SetupUrl))" />
<partial name="/Views/Emails/_EmailNote.cshtml" model="@(new Note(string.Format(Loc["Email.AdminInvite.NoteWarning"].Value, Model.InvitedBy), "warning"))" />
<partial name="/Views/Emails/_EmailSignoff.cshtml" model="@((string?)null)" />

@model WelcomeSetupEmailModel
@{
    ViewData["Preheader"] = Loc["Email.WelcomeSetup.Preheader"].Value;
    ViewData["Footnote"] = Loc["Email.WelcomeSetup.Footnote"].Value;
}
<partial name="/Views/Emails/_EmailHeading.cshtml" model="@(new Heading(Loc["Email.WelcomeSetup.Eyebrow"].Value, Loc["Email.WelcomeSetup.Heading"].Value))" />
<p style="margin:0 0 16px;">@string.Format(Loc["Email.Common.Greeting"].Value, Model.FirstName)</p>
<p style="margin:0 0 16px;">
    @(Model.PlanName is null ? Loc["Email.WelcomeSetup.Body1NoPlan"].Value : string.Format(Loc["Email.WelcomeSetup.Body1WithPlan"].Value, Model.PlanName))
    @Loc["Email.WelcomeSetup.Body1Suffix"]
</p>
<partial name="/Views/Emails/_EmailButton.cshtml" model="@(new Button(Model.SetupUrl, Loc["Email.WelcomeSetup.Button"].Value))" />
<p style="margin:0 0 6px; font-size:13px; color:#5a5f55;">@Loc["Email.Common.ButtonFallbackHint"]</p>
<partial name="/Views/Emails/_EmailCode.cshtml" model="@(new Code(Model.SetupUrl, Href: Model.SetupUrl))" />
<partial name="/Views/Emails/_EmailSignoff.cshtml" model="@(Loc["Email.WelcomeSetup.Signoff"].Value)" />

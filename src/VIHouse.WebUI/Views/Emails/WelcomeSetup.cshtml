@model WelcomeSetupEmailModel
@{
    ViewData["Preheader"] = "Choose your password and you're in";
    ViewData["Footnote"] = "You're receiving this because a payment opened an account for you at The VI House.";
}
<partial name="/Views/Emails/_EmailHeading.cshtml" model="@(new Heading("Welcome", "Set up your account"))" />
<p style="margin:0 0 16px;">Hi @Model.FirstName,</p>
<p style="margin:0 0 16px;">
    Your payment went through@(Model.PlanName is null ? "" : $" and your {Model.PlanName} is active").
    The last step is to choose a password, confirm this email address, and switch on two-factor
    authentication. We'll walk you through it &mdash; it takes about two minutes.
</p>
<partial name="/Views/Emails/_EmailButton.cshtml" model="@(new Button(Model.SetupUrl, "Choose your password"))" />
<p style="margin:0 0 6px; font-size:13px; color:#5a5f55;">If the button doesn't work, copy this into your browser:</p>
<partial name="/Views/Emails/_EmailCode.cshtml" model="@(new Code(Model.SetupUrl, Href: Model.SetupUrl))" />
<partial name="/Views/Emails/_EmailSignoff.cshtml" model="@("This link can only be used once. If it expires, use \"Forgot your password?\" on the sign-in page to get a new one.")" />

@model AmbassadorLinkEmailModel
@{
    ViewData["Subject"] = Loc["Email.AmbassadorLink.Subject"].Value;
    ViewData["Preheader"] = string.Format(Loc["Email.AmbassadorLink.Preheader"].Value, Model.ReferralUrl);
    ViewData["Footnote"] = Loc["Email.Common.FootnoteAmbassador"].Value;
}
<partial name="/Views/Emails/_EmailHeading.cshtml" model="@(new Heading(Loc["Email.Common.EyebrowAmbassador"].Value, Loc["Email.AmbassadorLink.Heading"].Value))" />
<p style="margin:0 0 16px;">@string.Format(Loc["Email.Common.Greeting"].Value, Model.Name)</p>
<p style="margin:0 0 16px;">
    @Loc["Email.AmbassadorLink.Body1"]
</p>
<partial name="/Views/Emails/_EmailCode.cshtml" model="@(new Code(Model.ReferralUrl, Loc["Email.AmbassadorLink.CodeLabel"].Value, Href: Model.ReferralUrl))" />
<p style="margin:0 0 16px;">
    @Loc["Email.AmbassadorLink.Body2"]
</p>
@if (!string.IsNullOrWhiteSpace(Model.Note))
{
    <partial name="/Views/Emails/_EmailNote.cshtml" model="@(new Note(Model.Note, "info", Loc["Email.Common.NoteFromTeamLabel"].Value))" />
}
<partial name="/Views/Emails/_EmailDetails.cshtml" model="@(new List<(string, string)> { (Loc["Email.AmbassadorLink.DetailCodeLabel"].Value, Model.Code), (Loc["Email.Common.DetailCommissionLabel"].Value, string.Format(Loc["Email.AmbassadorLink.CommissionValue"].Value, Model.CommissionPercent.ToString("0.##"))), (Loc["Email.AmbassadorLink.CreditedForLabel"].Value, Loc["Email.AmbassadorLink.CreditedForValue"].Value) })" />
<partial name="/Views/Emails/_EmailButton.cshtml" model="@(new Button(Model.DashboardUrl, Loc["Email.Common.ButtonOpenDashboard"].Value))" />
<partial name="/Views/Emails/_EmailSignoff.cshtml" model="@(Loc["Email.AmbassadorLink.Signoff"].Value)" />

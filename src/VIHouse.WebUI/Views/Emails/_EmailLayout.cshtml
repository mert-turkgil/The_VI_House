@* Fully qualified rather than relying on an inherited @using: the folder's _ViewImports.cshtml
   only brings in the email models and parts, and spelling the type out here means this file's
   correctness doesn't depend on what either ViewImports happens to contain today. *@
@inject VIHouse.WebUI.Helpers.SeoResolver Seo
@{
    // Deliberately plain, table-based, inline-styled HTML — brief §70: "logo -> short message -> CTA
    // -> contact is enough," and heavy/complex HTML risks spam filters. Every colour and font is
    // inline so it survives clients that strip <style>; the <style> block only collapses the
    // two-column detail rows on narrow screens and pins the light palette in dark-mode clients,
    // and losing it costs nothing but that. The MSO conditional gives Outlook a fixed-width table
    // to hang max-width on, which it otherwise ignores.
    //
    // The contact address is read from SiteSetting.ContactEmail — the one address an admin actually
    // edits (Admin > Site & SEO) — so changing it there moves every footer in the same deploy.
    var settings = await Seo.SettingsAsync();
    var contactEmail = settings.ContactEmail;
    // A line the inbox preview shows after the subject; set per template via ViewData["Preheader"].
    var preheader = ViewData["Preheader"] as string;
    // Why this person is getting this mail, in one line under the footer — set per template.
    var footnote = ViewData["Footnote"] as string ?? Loc["Email.Layout.DefaultFootnote"].Value;
    var lang = ViewData["Lang"] as string ?? "en";
}
<!DOCTYPE html>
<html lang="@lang" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="x-apple-disable-message-reformatting" />
    <meta name="color-scheme" content="light" />
    <meta name="supported-color-schemes" content="light" />
    <title>The VI House</title>
    <!--[if mso]>
    <xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml>
    <style>table, td { font-family: Arial, Helvetica, sans-serif !important; }</style>
    <![endif]-->
    <style>
        :root { color-scheme: light; supported-color-schemes: light; }
        body { margin: 0; padding: 0; }
        a[x-apple-data-detectors] { color: inherit !important; text-decoration: none !important; }
        @@media only screen and (max-width: 600px) {
            .vih-stack { display: block !important; width: 100% !important; text-align: left !important; }
            .vih-stack-label { padding-bottom: 2px !important; border-bottom: 0 !important; }
            .vih-stack-value { padding-top: 0 !important; padding-bottom: 12px !important; }
            .vih-pad { padding-left: 20px !important; padding-right: 20px !important; }
            .vih-h1 { font-size: 23px !important; }
        }
    </style>
</head>
<body style="margin:0; padding:0; background-color:#f4f0e6; font-family:Arial,Helvetica,sans-serif; color:#12160f; -webkit-text-size-adjust:100%; -ms-text-size-adjust:100%;">
    @if (!string.IsNullOrWhiteSpace(preheader))
    {
        <div style="display:none; max-height:0; overflow:hidden; font-size:1px; line-height:1px; color:#f4f0e6; opacity:0; mso-hide:all;">@preheader&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;</div>
    }
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f4f0e6;">
        <tr>
            <td align="center" style="padding:32px 16px;">
                <!--[if mso]><table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0"><tr><td><![endif]-->
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:600px; margin:0 auto; background-color:#ffffff; border-radius:10px; border-collapse:separate;">
                    @* Header: the wordmark on the House green, a gold hairline under it. *@
                    <tr>
                        <td class="vih-pad" style="background-color:#00230a; padding:26px 36px; border-bottom:2px solid #b8955a; border-radius:10px 10px 0 0;">
                            <table role="presentation" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td style="vertical-align:middle; padding-right:12px;">
                                        <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width:34px; height:34px; border:1px solid #b8955a; border-radius:17px;">
                                            <tr><td align="center" style="color:#d7bd8a; font-family:Georgia,'Times New Roman',serif; font-size:13px; font-weight:bold; letter-spacing:1px; line-height:32px;">VI</td></tr>
                                        </table>
                                    </td>
                                    <td style="vertical-align:middle; color:#f4f0e6; font-family:Georgia,'Times New Roman',serif; font-size:15px; letter-spacing:3px; text-transform:uppercase;">The VI House</td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td class="vih-pad" role="article" aria-roledescription="email" lang="@lang" style="padding:36px 36px 28px; font-family:Arial,Helvetica,sans-serif; font-size:15px; line-height:1.65; color:#12160f;">
                            @RenderBody()
                        </td>
                    </tr>
                    <tr>
                        <td class="vih-pad" style="padding:22px 36px 24px; background-color:#00230a; font-family:Arial,Helvetica,sans-serif; font-size:12px; line-height:1.6; color:#c7c9c2; border-radius:0 0 10px 10px;">
                            <span style="color:#d7bd8a; font-family:Georgia,'Times New Roman',serif; font-size:13px; letter-spacing:2px; text-transform:uppercase;">The VI House</span><br />
                            @Loc["Email.Layout.Tagline"]<br />
                            @if (string.IsNullOrWhiteSpace(contactEmail))
                            {
                                @Loc["Email.Layout.ReplyOnly"]
                            }
                            else
                            {
                                @Html.Raw(string.Format(Loc["Email.Layout.ReplyOrWrite"].Value, $"<a href=\"mailto:{contactEmail}\" style=\"color:#d7bd8a;\">{contactEmail}</a>"))
                            }
                            <br />
                            <span style="color:#8f948a; font-size:11px;">@footnote</span>
                        </td>
                    </tr>
                </table>
                <!--[if mso]></td></tr></table><![endif]-->
            </td>
        </tr>
    </table>
</body>
</html>

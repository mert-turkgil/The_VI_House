@{
    // Deliberately plain, table-free, inline-styled HTML — brief §70: "logo -> short message -> CTA
    // -> contact is enough," and heavy/complex HTML risks spam filters. Not pixel-perfect on every
    // legacy Outlook build, but renders cleanly on webmail/mobile, which covers the vast majority of
    // where these are actually opened.
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>The VI House</title>
</head>
<body style="margin:0; padding:0; background-color:#f4f0e6; font-family:Georgia,'Times New Roman',serif; color:#12160f;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f0e6; padding:32px 16px;">
        <tr>
            <td align="center">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px; background-color:#ffffff; border-radius:8px; overflow:hidden;">
                    <tr>
                        <td style="background-color:#00230a; padding:28px 32px;">
                            <span style="color:#f4f0e6; font-size:14px; letter-spacing:2px; text-transform:uppercase; font-family:Georgia,serif;">The VI House</span>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:36px 32px; font-family:Arial,Helvetica,sans-serif; font-size:15px; line-height:1.6; color:#12160f;">
                            @RenderBody()
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:20px 32px; background-color:#f4f0e6; font-family:Arial,Helvetica,sans-serif; font-size:12px; color:#666666; border-top:1px solid #e9e3d3;">
                            The VI House &mdash; a private global community for founders, operators and investors.<br />
                            Questions? Reply to this email or contact us at <a href="mailto:concierge@thevihouse.com" style="color:#7a5f2f;">concierge@thevihouse.com</a>.
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>

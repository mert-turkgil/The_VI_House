@model BookingConfirmedEmailModel
@{
    ViewData["Preheader"] = string.Format(Loc["Email.BookingConfirmed.Preheader"].Value, Model.ExperienceCity, Model.StartAtUtc.ToString("d MMM yyyy"), Model.BookingReference);
    ViewData["Footnote"] = Loc["Email.BookingConfirmed.Footnote"].Value;
    var sameDay = Model.StartAtUtc.Date == Model.EndAtUtc.Date;
    var when = sameDay
        ? $"{Model.StartAtUtc:dddd d MMMM yyyy}, {Model.StartAtUtc:HH:mm}–{Model.EndAtUtc:HH:mm} UTC"
        : $"{Model.StartAtUtc:d MMM} – {Model.EndAtUtc:d MMM yyyy}";
    var where = Model.IsOnline ? Loc["Email.BookingConfirmed.OnlineWhereValue"].Value : Model.Venue ?? Model.ExperienceCity;
    var rows = new List<(string, string)>
    {
        (Loc["Email.Common.DetailExperienceLabel"].Value, Model.ExperienceTitle),
        (Loc["Email.Common.DetailWhenLabel"].Value, when),
        (Loc["Email.Common.DetailWhereLabel"].Value, where),
        (Loc["Email.Common.DetailPaidLabel"].Value, MoneyFormatter.Format(Model.AmountMinor, Model.Currency)),
    };
}
<partial name="/Views/Emails/_EmailHeading.cshtml" model="@(new Heading(Loc["Email.BookingConfirmed.Eyebrow"].Value, string.Format(Loc["Email.BookingConfirmed.Heading"].Value, Model.ExperienceCity)))" />
<p style="margin:0 0 16px;">@string.Format(Loc["Email.Common.Greeting"].Value, Model.FirstName)</p>
<p style="margin:0 0 20px;">
    @Loc["Email.BookingConfirmed.Body1"]
</p>
<partial name="/Views/Emails/_EmailCode.cshtml" model="@(new Code(Model.BookingReference, Loc["Email.BookingConfirmed.CodeLabel"].Value))" />
<partial name="/Views/Emails/_EmailDetails.cshtml" model="rows" />
@if (Model.TicketUrl is not null)
{
    <partial name="/Views/Emails/_EmailButton.cshtml" model="@(new Button(Model.TicketUrl, Loc["Email.BookingConfirmed.Button"].Value))" />
}
<p style="margin:0 0 16px; color:#4a4f45;">
    @Loc["Email.BookingConfirmed.Body2"]
    @if (Model.ExperienceUrl is not null)
    {
        @Html.Raw(string.Format(Loc["Email.BookingConfirmed.ExperiencePageLinkText"].Value, $"<a href=\"{Model.ExperienceUrl}\" style=\"color:#00230a;\">{Loc["Email.BookingConfirmed.ExperiencePageLinkLabel"]}</a>"))
    }
</p>
<partial name="/Views/Emails/_EmailSignoff.cshtml" model="@((string?)null)" />

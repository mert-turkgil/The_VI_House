@model BookingConfirmedEmailModel

<h1 style="font-family:Georgia,serif; font-size:22px; margin:0 0 16px;">Welcome to The House</h1>
<p style="margin:0 0 16px;">Hi @Model.FirstName,</p>
<p style="margin:0 0 16px;">
    Your booking for <strong>The VI House &mdash; @Model.ExperienceCity</strong> is confirmed.
</p>
<table role="presentation" cellpadding="0" cellspacing="0" style="width:100%; margin:0 0 24px; font-family:Arial,Helvetica,sans-serif; font-size:14px;">
    <tr>
        <td style="padding:6px 0; color:#666666;">Booking Reference</td>
        <td style="padding:6px 0; text-align:right; font-weight:bold;">@Model.BookingReference</td>
    </tr>
    <tr>
        <td style="padding:6px 0; color:#666666;">Experience</td>
        <td style="padding:6px 0; text-align:right;">@Model.ExperienceTitle</td>
    </tr>
    <tr>
        <td style="padding:6px 0; color:#666666;">Dates</td>
        <td style="padding:6px 0; text-align:right;">@Model.StartAtUtc.ToString("d MMM")&ndash;@Model.EndAtUtc.ToString("d MMM yyyy")</td>
    </tr>
    <tr>
        <td style="padding:6px 0; color:#666666;">Amount Paid</td>
        <td style="padding:6px 0; text-align:right;">@MoneyFormatter.Format(Model.AmountMinor, Model.Currency)</td>
    </tr>
</table>
<p style="margin:0 0 16px;">We'll be in touch with full event details closer to the date.</p>
<p style="margin:0;">&mdash; The VI House</p>

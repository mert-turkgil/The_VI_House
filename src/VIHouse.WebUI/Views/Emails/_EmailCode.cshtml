@* A monospace box for something the reader may need to type or paste: a booking reference, a
   referral code, the fallback URL under a button. With Href the value is also a link.
   Model: EmailParts.Code. *@
@model VIHouse.WebUI.Helpers.EmailParts.Code
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 22px;">
    <tr>
        <td style="padding:12px 16px; background-color:#f4f0e6; border:1px solid #e9e3d3; border-radius:8px;">
            @if (!string.IsNullOrWhiteSpace(Model.Label))
            {
                <p style="margin:0 0 4px; color:#63685c; font-size:11px; letter-spacing:1.2px; text-transform:uppercase;">@Model.Label</p>
            }
            <p style="margin:0; font-family:'Courier New',Courier,monospace; font-size:14px; line-height:1.5; color:#00230a; word-break:break-all;">
                @if (Model.Href is not null)
                {
                    <a href="@Model.Href" style="color:#00230a; text-decoration:underline;">@Model.Value</a>
                }
                else
                {
                    @Model.Value
                }
            </p>
        </td>
    </tr>
</table>

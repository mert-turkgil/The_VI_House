@model ApplicationWaitlistedEmailModel

<h1 style="font-family:Georgia,serif; font-size:22px; margin:0 0 16px;">You're On The Waitlist</h1>
<p style="margin:0 0 16px;">Hi @Model.FirstName,</p>
<p style="margin:0 0 16px;">
    <strong>The VI House &mdash; @Model.ExperienceTitle</strong> is at capacity right now, but we've
    placed you on the waitlist. If a place opens up, we'll reach out directly.
</p>
<p style="margin:0;">&mdash; The VI House</p>

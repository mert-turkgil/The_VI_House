@model ApplicationWaitlistedEmailModel
@{
    ViewData["Subject"] = Loc["Email.ApplicationWaitlisted.Subject"].Value;
    ViewData["Preheader"] = string.Format(Loc["Email.ApplicationWaitlisted.Preheader"].Value, Model.ExperienceTitle);
    ViewData["Footnote"] = Loc["Email.Common.FootnoteApplication"].Value;
}
<partial name="/Views/Emails/_EmailHeading.cshtml" model="@(new Heading(Loc["Email.Common.EyebrowWaitlist"].Value, Loc["Email.ApplicationWaitlisted.Heading"].Value))" />
<p style="margin:0 0 16px;">@string.Format(Loc["Email.Common.Greeting"].Value, Model.FirstName)</p>
<p style="margin:0 0 16px;">
    @Html.Raw(string.Format(Loc["Email.ApplicationWaitlisted.Body1"].Value, $"<strong>{Model.ExperienceTitle}</strong>"))
</p>
<partial name="/Views/Emails/_EmailNote.cshtml" model="@(new Note(Loc["Email.ApplicationWaitlisted.NextStepsValue"].Value, "info", Loc["Email.ApplicationWaitlisted.NextStepsLabel"].Value))" />
<partial name="/Views/Emails/_EmailSignoff.cshtml" model="@((string?)null)" />

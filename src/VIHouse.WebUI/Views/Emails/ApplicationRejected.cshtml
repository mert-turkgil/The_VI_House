@model ApplicationRejectedEmailModel
@{
    ViewData["Preheader"] = string.Format(Loc["Email.ApplicationRejected.Preheader"].Value, Model.ExperienceCity);
    ViewData["Footnote"] = Loc["Email.Common.FootnoteApplication"].Value;
}
<partial name="/Views/Emails/_EmailHeading.cshtml" model="@(new Heading(Loc["Email.ApplicationRejected.Eyebrow"].Value, string.Format(Loc["Email.ApplicationRejected.Heading"].Value, Model.ExperienceCity)))" />
<p style="margin:0 0 16px;">@string.Format(Loc["Email.Common.Greeting"].Value, Model.FirstName)</p>
<p style="margin:0 0 16px;">
    @Html.Raw(string.Format(Loc["Email.ApplicationRejected.Body1"].Value, $"<strong>{Model.ExperienceTitle}</strong>"))
</p>
@if (!string.IsNullOrWhiteSpace(Model.Reason))
{
    <partial name="/Views/Emails/_EmailNote.cshtml" model="@(new Note(Model.Reason, "info", Loc["Email.Common.NoteFromTeamLabel"].Value))" />
}
<p style="margin:0 0 16px;">@Loc["Email.ApplicationRejected.Body2"]</p>
<partial name="/Views/Emails/_EmailButton.cshtml" model="@(new Button(Model.ExperiencesUrl, Loc["Email.ApplicationRejected.Button"].Value, Secondary: true))" />
<partial name="/Views/Emails/_EmailSignoff.cshtml" model="@((string?)null)" />

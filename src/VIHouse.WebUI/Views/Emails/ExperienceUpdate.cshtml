@model ExperienceUpdateEmailModel
@{
    ViewData["Preheader"] = $"{Model.ExperienceTitle}: {Model.Headline}";
    ViewData["Footnote"] = Loc["Email.ExperienceUpdate.Footnote"].Value;
}
<partial name="/Views/Emails/_EmailHeading.cshtml" model="@(new Heading(Model.ExperienceTitle, Model.Headline))" />
<p style="margin:0 0 16px;">@string.Format(Loc["Email.Common.Greeting"].Value, Model.FirstName)</p>
<p style="margin:0 0 20px; white-space:pre-line;">@Model.Body</p>
<partial name="/Views/Emails/_EmailButton.cshtml" model="@(new Button(Model.ExperienceUrl, Loc["Email.ExperienceUpdate.Button"].Value))" />
<partial name="/Views/Emails/_EmailSignoff.cshtml" model="@(Loc["Email.ExperienceUpdate.Signoff"].Value)" />

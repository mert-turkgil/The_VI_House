@model FounderWelcomeEmailModel
@{
    ViewData["Subject"] = Loc["Email.FounderWelcome.Subject"].Value;
    ViewData["Preheader"] = Loc["Email.FounderWelcome.Preheader"].Value;
    ViewData["Footnote"] = Loc["Email.Common.FootnoteMembership"].Value;
}
<partial name="/Views/Emails/_EmailHeading.cshtml" model="@(new Heading(Loc["Email.Common.EyebrowMembership"].Value, Loc["Email.FounderWelcome.Heading"].Value))" />
<p style="margin:0 0 16px;">@string.Format(Loc["Email.Common.Greeting"].Value, Model.FirstName)</p>
<p style="margin:0 0 16px;">@Loc["Email.FounderWelcome.Body"]</p>
<p style="margin:0 0 20px;">@Loc["Email.FounderWelcome.Body2"]</p>
<partial name="/Views/Emails/_EmailButton.cshtml" model="@(new Button(Model.BenefitsUrl, Loc["Email.FounderWelcome.Button"].Value))" />
<partial name="/Views/Emails/_EmailSignoff.cshtml" model="@(Loc["Email.FounderWelcome.Signoff"].Value)" />

@model MembershipEndedEmailModel
@{
    ViewData["Preheader"] = string.Format(Loc["Email.MembershipEnded.Preheader"].Value, Model.PlanName);
    ViewData["Footnote"] = Loc["Email.Common.FootnoteMembership"].Value;
}
<partial name="/Views/Emails/_EmailHeading.cshtml" model="@(new Heading(Loc["Email.Common.EyebrowMembership"].Value, Loc["Email.MembershipEnded.Heading"].Value))" />
<p style="margin:0 0 16px;">@string.Format(Loc["Email.Common.Greeting"].Value, Model.FirstName)</p>
<p style="margin:0 0 16px;">
    @if (Model.WasRevoked)
    {
        @Html.Raw(string.Format(Loc["Email.MembershipEnded.BodyRevoked"].Value, $"<strong>{Model.PlanName}</strong>", Model.EndedAt.ToString("d MMMM yyyy")))
    }
    else
    {
        @Html.Raw(string.Format(Loc["Email.MembershipEnded.BodyExpired"].Value, $"<strong>{Model.PlanName}</strong>", Model.EndedAt.ToString("d MMMM yyyy")))
    }
    @Loc["Email.MembershipEnded.BodySuffix"]
</p>
<p style="margin:0 0 16px;">@Loc["Email.MembershipEnded.Body2"]</p>
<partial name="/Views/Emails/_EmailButton.cshtml" model="@(new Button(Model.RejoinUrl, Loc["Email.MembershipEnded.Button"].Value, Secondary: true))" />
<partial name="/Views/Emails/_EmailSignoff.cshtml" model="@(Loc["Email.MembershipEnded.Signoff"].Value)" />

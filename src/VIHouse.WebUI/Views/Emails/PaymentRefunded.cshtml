@model PaymentRefundedEmailModel
@{
    ViewData["Subject"] = (Model.IsPartial ? Loc["Email.PaymentRefunded.SubjectPartial"] : Loc["Email.PaymentRefunded.Subject"]).Value;
    ViewData["Preheader"] = string.Format(Model.IsPartial ? Loc["Email.PaymentRefunded.PreheaderPartial"].Value : Loc["Email.PaymentRefunded.PreheaderFull"].Value, Model.What);
    ViewData["Footnote"] = Loc["Email.PaymentRefunded.Footnote"].Value;
    var rows = new List<(string, string)>
    {
        (Loc["Email.Common.DetailForLabel"].Value, Model.What),
        (Model.IsPartial ? Loc["Email.Common.DetailRefundedSoFarLabel"].Value : Loc["Email.Common.DetailRefundedLabel"].Value, MoneyFormatter.Format(Model.AmountRefundedMinor, Model.Currency)),
    };
}
<partial name="/Views/Emails/_EmailHeading.cshtml" model="@(new Heading(Model.IsPartial ? Loc["Email.PaymentRefunded.EyebrowPartial"].Value : Loc["Email.PaymentRefunded.EyebrowFull"].Value, Loc["Email.PaymentRefunded.Heading"].Value))" />
<p style="margin:0 0 16px;">@string.Format(Loc["Email.Common.Greeting"].Value, Model.FirstName)</p>
<p style="margin:0 0 16px;">
    @Html.Raw(string.Format(Loc["Email.PaymentRefunded.Body1"].Value, Model.IsPartial ? Loc["Email.PaymentRefunded.BodyPartial"].Value : Loc["Email.PaymentRefunded.BodyFull"].Value, $"<strong>{Model.What}</strong>"))
</p>
<partial name="/Views/Emails/_EmailDetails.cshtml" model="rows" />
<p style="margin:0 0 16px;">@Model.Effect</p>
<partial name="/Views/Emails/_EmailSignoff.cshtml" model="@(Loc["Email.PaymentRefunded.Signoff"].Value)" />

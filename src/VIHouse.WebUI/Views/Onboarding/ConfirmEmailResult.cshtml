@model ConfirmEmailResultViewModel

<div class="onboarding">
    <div class="container onboarding__inner onboarding__inner--narrow">
        @if (Model.Succeeded)
        {
            <span class="onboarding__eyebrow">@Loc["Onboarding.Confirm.Success.Eyebrow"]</span>
            <h1>@Loc["Onboarding.Confirm.Success.Heading"]</h1>
            <p class="onboarding__lede">@Loc["Onboarding.Confirm.Success.Body"]</p>
            <a class="btn btn--primary" asp-action="Index">@Loc["Onboarding.Confirm.Success.Cta"]</a>
        }
        else
        {
            <span class="onboarding__eyebrow">@Loc["Onboarding.Confirm.Fail.Eyebrow"]</span>
            <h1>@Loc["Onboarding.Confirm.Fail.Heading"]</h1>
            @* Already localised by the controller, which picks the reason. *@
            <p class="onboarding__lede">@Model.Error</p>
            <a class="btn btn--primary" asp-action="Index">@Loc["Onboarding.Confirm.Fail.Cta"]</a>
        }
    </div>
</div>

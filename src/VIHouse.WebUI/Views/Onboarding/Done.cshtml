@model OnboardingStatusViewModel

<div class="onboarding">
    <div class="container onboarding__inner onboarding__inner--narrow">
        <span class="onboarding__eyebrow">@Loc["Onboarding.Done.Eyebrow"]</span>
        <h1>@Loc["Onboarding.Done.Heading", Model.FirstName]</h1>

        @if (Model.IsStaff)
        {
            <p class="onboarding__lede">@Loc["Onboarding.Done.Admin.Lede"]</p>

            <div class="onboarding__next">
                <a class="btn btn--primary" asp-area="Admin" asp-controller="AdminDashboard" asp-action="Index">@Loc["Onboarding.Done.Admin.Cta"]</a>
            </div>

            <p class="onboarding__footnote">@Loc["Onboarding.Done.Admin.Footnote"]</p>
        }
        else if (Model.HasMembership)
        {
            <p class="onboarding__lede">@Loc["Onboarding.Done.Member.Lede", Model.PlanName ?? Loc["Onboarding.Done.Member.FallbackPlan"].Value]</p>

            <div class="onboarding__next">
                <a class="btn btn--primary" asp-controller="Account" asp-action="Community">@Loc["Onboarding.Done.Member.Cta1"]</a>
                <a class="btn btn--ghost" asp-controller="Account" asp-action="Card">@Loc["Onboarding.Done.Member.Cta2"]</a>
            </div>

            <p class="onboarding__footnote">@Loc["Onboarding.Done.Member.Footnote"]</p>
        }
        else
        {
            <p class="onboarding__lede">@Loc["Onboarding.Done.Ticket.Lede"]</p>

            <div class="onboarding__next">
                <a class="btn btn--primary" asp-controller="Account" asp-action="Bookings">@Loc["Onboarding.Done.Ticket.Cta1"]</a>
                <a class="btn btn--ghost" asp-controller="Membership" asp-action="Index">@Loc["Onboarding.Done.Ticket.Cta2"]</a>
            </div>

            <p class="onboarding__footnote">@Loc["Onboarding.Done.Ticket.Footnote"]</p>
        }
    </div>
</div>

@model OnboardingStatusViewModel
@{
    // Staff and members are told different things at every step: an admin arrived through an invite
    // (or a seeded bootstrap account) and must never be told their payment went through.
    var audience = Model.IsStaff ? "Admin" : "Member";
}

<div class="onboarding">
    <div class="container onboarding__inner">
        <span class="onboarding__eyebrow">@Loc["Onboarding.Eyebrow." + audience]</span>
        <h1>@Loc["Onboarding.Heading", Model.FirstName]</h1>
        <p class="onboarding__lede">@Loc["Onboarding.Lede." + audience]</p>

        @if (TempData["StatusMessage"] is string status)
        {
            <div class="onboarding__notice">@status</div>
        }

        <div class="onboarding__progress" role="group" aria-label="@Loc["Onboarding.Progress.AriaLabel"]">
            <div class="onboarding__progress-bar">
                <span style="width:@(Model.CompletedSteps * 100 / Model.TotalSteps)%"></span>
            </div>
            <span class="onboarding__progress-label">@Loc["Onboarding.Progress.Label", Model.CompletedSteps, Model.TotalSteps]</span>
        </div>

        <ol class="onboarding__steps">
            <li class="onboarding__step onboarding__step--done">
                <span class="onboarding__step-mark" aria-hidden="true">&#10003;</span>
                <div class="onboarding__step-body">
                    <h2>@Loc["Onboarding.Step1.Title"]</h2>
                    <p>@Loc["Onboarding.Step1.Body"]</p>
                </div>
            </li>

            <li class="onboarding__step @(Model.EmailConfirmed ? "onboarding__step--done" : "onboarding__step--active")">
                <span class="onboarding__step-mark" aria-hidden="true">@(Model.EmailConfirmed ? "✓" : "2")</span>
                <div class="onboarding__step-body">
                    <h2>@Loc["Onboarding.Step2.Title"]</h2>
                    @if (Model.EmailConfirmed)
                    {
                        <p>@Loc["Onboarding.Step2.Done", Model.Email]</p>
                    }
                    else
                    {
                        <p>@Loc["Onboarding.Step2.Body." + audience, Model.Email]</p>
                        <p class="onboarding__hint">@Loc["Onboarding.Step2.Hint"]</p>
                        <form asp-action="SendConfirmation" method="post">
                            <button type="submit" class="btn btn--primary">@Loc["Onboarding.Step2.Send"]</button>
                        </form>
                    }
                </div>
            </li>

            <li class="onboarding__step @(Model.TwoFactorEnabled ? "onboarding__step--done" : Model.EmailConfirmed ? "onboarding__step--active" : "")">
                <span class="onboarding__step-mark" aria-hidden="true">@(Model.TwoFactorEnabled ? "✓" : "3")</span>
                <div class="onboarding__step-body">
                    <h2>@Loc["Onboarding.Step3.Title"]</h2>
                    @if (Model.TwoFactorEnabled)
                    {
                        <p>@Loc["Onboarding.Step3.Done"]</p>
                    }
                    else
                    {
                        <p>@Loc["Onboarding.Step3.Body." + audience]</p>
                        <a class="btn btn--primary" asp-action="TwoFactor">@Loc["Onboarding.Step3.Cta"]</a>
                    }
                </div>
            </li>
        </ol>

        <p class="onboarding__footnote">
            @Loc["Onboarding.Footnote"] <a href="/contact">@Loc["Onboarding.Footnote.Link"]</a>
        </p>
    </div>
</div>

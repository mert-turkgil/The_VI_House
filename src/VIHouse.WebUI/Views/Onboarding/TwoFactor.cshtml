@model TwoFactorSetupViewModel

<div class="onboarding">
    <div class="container onboarding__inner onboarding__inner--narrow">
        <a class="onboarding__back" asp-action="Index">&larr; @Loc["Onboarding.TwoFactor.Back"]</a>
        <span class="onboarding__eyebrow">@Loc["Onboarding.TwoFactor.Eyebrow"]</span>
        <h1>@Loc["Onboarding.TwoFactor.Heading"]</h1>
        <p class="onboarding__lede">@Loc["Onboarding.TwoFactor.Lede"]</p>

        <div asp-validation-summary="ModelOnly" class="onboarding__error" role="alert"></div>

        <ol class="onboarding__instructions">
            <li>
                <h2>@Loc["Onboarding.TwoFactor.Step1.Title"]</h2>
                <p>@Loc["Onboarding.TwoFactor.Step1.Body"]</p>
            </li>

            <li>
                <h2>@Loc["Onboarding.TwoFactor.Step2.Title"]</h2>
                <p>@Loc["Onboarding.TwoFactor.Step2.Body"]</p>

                @* Rendered client-side from the otpauth:// URI (see ClientApp modules/qr.ts) so the
                   secret never travels through a third-party QR image service. *@
                <div class="onboarding__qr" data-qr-uri="@Model.AuthenticatorUri" aria-hidden="false"
                     data-qr-label="@Loc["Onboarding.TwoFactor.QrLabel"]"
                     data-qr-error="@Loc["Onboarding.TwoFactor.QrError"]"></div>

                <p class="onboarding__hint">@Loc["Onboarding.TwoFactor.Step2.CantScan"]</p>
                <p class="onboarding__key"><code>@Model.SharedKey</code></p>
            </li>

            <li>
                <h2>@Loc["Onboarding.TwoFactor.Step3.Title"]</h2>
                <p>@Loc["Onboarding.TwoFactor.Step3.Body"]</p>

                <form asp-action="TwoFactor" method="post" class="onboarding__form">
                    <div class="onboarding__field">
                        <label asp-for="VerificationCode">@Loc["Onboarding.TwoFactor.CodeLabel"]</label>
                        <input asp-for="VerificationCode" class="onboarding__code-input" autocomplete="one-time-code"
                               inputmode="numeric" placeholder="000000" autofocus />
                        <span asp-validation-for="VerificationCode" class="onboarding__field-error"></span>
                    </div>
                    <button type="submit" class="btn btn--primary">@Loc["Onboarding.TwoFactor.Submit"]</button>
                </form>
            </li>
        </ol>

        <p class="onboarding__footnote">@Loc["Onboarding.TwoFactor.Footnote"]</p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

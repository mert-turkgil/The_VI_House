@model RecoveryCodesViewModel

<div class="onboarding">
    <div class="container onboarding__inner onboarding__inner--narrow">
        <span class="onboarding__eyebrow">@Loc["Onboarding.Codes.Eyebrow"]</span>
        <h1>@Loc["Onboarding.Codes.Heading"]</h1>
        <p class="onboarding__lede">@Loc["Onboarding.Codes.Lede"]</p>

        <div class="onboarding__codes" data-recovery-codes>
            @foreach (var code in Model.Codes)
            {
                <code>@code</code>
            }
        </div>

        @* Saves the codes as a .txt from the codes already on the page — no round trip, so the
           plaintext set is never handed out a second time by the server. The button is added by
           script (see ClientApp modules/recoveryCodes.ts) rather than sitting in the markup, so it
           is never shown dead to someone with JavaScript off; for them the codes are still on
           screen to copy. *@
        <div class="onboarding__codes-actions"
             data-recovery-download="@Loc["Onboarding.Codes.Download"]"
             data-recovery-filename="@Loc["Onboarding.Codes.Filename"]"></div>

        <p class="onboarding__hint">@Loc["Onboarding.Codes.Hint"]</p>

        <form asp-action="RecoveryCodes" method="post" class="onboarding__form">
            <div class="onboarding__field onboarding__field--check">
                <label>
                    <input asp-for="Acknowledged" type="checkbox" />
                    <span>@Loc["Onboarding.Codes.Ack"]</span>
                </label>
                <span asp-validation-for="Acknowledged" class="onboarding__field-error"></span>
            </div>
            <button type="submit" class="btn btn--primary">@Loc["Onboarding.Codes.Confirm"]</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

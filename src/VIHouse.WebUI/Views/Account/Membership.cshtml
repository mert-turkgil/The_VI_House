@model AccountMembershipViewModel
@{
    ViewData["Title"] = Loc["Account.MembershipTitle"];
    var m = Model.Current;

    string BillingLabel(MembershipBillingPeriod period) => period switch
    {
        MembershipBillingPeriod.Monthly => Loc["Membership.PerMonth"].Value,
        MembershipBillingPeriod.Annual => Loc["Membership.PerYear"].Value,
        _ => Loc["Membership.OneTime"].Value,
    };

    string StatusKey(MembershipSummary s) => s.Membership.Status switch
    {
        MembershipStatus.Cancelled => "cancelled",
        MembershipStatus.PastDue when s.IsCurrent => "pastdue",
        _ when s.IsCurrent => "active",
        _ => "expired",
    };

    string StatusLabel(MembershipSummary s) => StatusKey(s) switch
    {
        "cancelled" => Loc["Account.Status.Cancelled"].Value,
        "pastdue" => Loc["Account.Status.PastDue"].Value,
        "active" => Loc["Account.Status.Active"].Value,
        _ => Loc["Account.Status.Expired"].Value,
    };
    // The benefit cards for a member — assembled here so the carousel below is just markup.
    var benefits = new List<(string Icon, string Title, string Body, string? Href, bool Included)>();
    if (m is not null)
    {
        var ent = m.Entitlements;
        benefits.Add(("calendar", Loc["Account.Benefit.Sessions"].Value, Loc["Account.Benefit.Sessions.Body"].Value, Url.Action("Index", "Seminars"), ent.Sessions));
        benefits.Add(("sparkles", Loc["Account.Benefit.Experiences"].Value, Loc["Account.Benefit.Experiences.Body"].Value, Url.Action("Index", "Experiences"), true));
        if (Model.CommunityEnabled) benefits.Add(("messages-square", Loc["Account.Benefit.Community"].Value, Loc["Account.Benefit.Community.Body"].Value, Url.Action("Community", "Account"), ent.Community));
        if (Model.DirectoryEnabled) benefits.Add(("users", Loc["Account.Benefit.Directory"].Value, Loc["Account.Benefit.Directory.Body"].Value, Url.Action("Index", "MemberDirectory"), ent.Directory));
        benefits.Add(("credit-card", Loc["Account.Benefit.Card"].Value, Loc["Account.Benefit.Card.Body"].Value, Url.Action("Card", "Account"), ent.MemberCard));
        foreach (var feature in m.Plan.Features?.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries) ?? [])
        {
            benefits.Add(("check", feature, "", null, true));
        }
    }
}

<div class="account-manage">
    <partial name="_AccountNav" />
    <div class="account-manage__content">
        <h1>@Loc["Account.MembershipTitle"]</h1>

        @if (TempData["MembershipError"] is string error)
        {
            <div class="apply-form__summary" role="alert" style="margin-bottom:20px;">@error</div>
        }

        @if (m is not null)
        {
            @if (m.IsPastDue)
            {
                @* A declined renewal. Access runs to the end of the paid period; the provider keeps
                   retrying the card, and "Manage billing" below is where a new one goes. *@
                <div class="account-notice account-notice--pastdue" role="alert">
                    <div>
                        <strong>@Loc["Account.PastDue.Title"]</strong>
                        <span>@Loc["Account.PastDue.Banner", m.Membership.ExpiresAt?.ToString("d MMMM yyyy") ?? ""]</span>
                    </div>
                    @if (Model.CanManageBilling)
                    {
                        <form asp-action="Billing" method="post">
                            <button type="submit" class="btn btn--primary">@Loc["Account.PastDue.Cta"]</button>
                        </form>
                    }
                </div>
            }
            <section class="account-membership" aria-labelledby="current-heading">
                <div class="account-membership__body">
                    <span class="account-membership__eyebrow">@Loc["Account.CurrentPlan"]</span>
                    <h2 id="current-heading">@m.Plan.Name</h2>
                    <p class="account-membership__term">
                        @MoneyFormatter.Format(m.Plan.PriceMinor, m.Plan.Currency) @BillingLabel(m.Plan.BillingPeriod)
                        @if (m.Membership.Status == MembershipStatus.Cancelled)
                        {
                            <text>&middot; @Loc["Account.Membership.Ended", m.Membership.ExpiresAt?.ToString("d MMMM yyyy") ?? ""]</text>
                        }
                        else if (m.IsPastDue && m.Membership.ExpiresAt is { } paidUntil)
                        {
                            <text>&middot; @Loc["Account.Membership.PaidUntil", paidUntil.ToString("d MMMM yyyy")]</text>
                        }
                        else if (m.HasProviderSubscription && m.Membership.RenewalAt is { } renews)
                        {
                            <text>&middot; @Loc["Account.Membership.Renews", renews.ToString("d MMMM yyyy")]</text>
                        }
                        else if (m.Membership.ExpiresAt is { } expires)
                        {
                            <text>&middot; @Loc["Account.MembershipValidUntil", expires.ToString("d MMMM yyyy")]</text>
                        }
                        else
                        {
                            <text>&middot; @Loc["Account.MembershipNoExpiry"]</text>
                        }
                    </p>
                    <dl class="account-membership__facts">
                        <div><dt>@Loc["Card.MemberNumber"]</dt><dd>@Model.MemberNumber</dd></div>
                        <div><dt>@Loc["Card.MemberSince"]</dt><dd>@m.Membership.StartAt.ToString("d MMMM yyyy")</dd></div>
                        <div><dt>@Loc["Account.Billing"]</dt><dd>@(m.IsRecurring ? Loc["Account.Billing.Recurring"] : Loc["Account.Billing.OneTime"])</dd></div>
                    </dl>
                    <div class="account-membership__actions">
                        <a class="btn btn--primary" asp-action="Card">@Loc["Card.ViewCard"]</a>
                        @if (Model.CanManageBilling)
                        {
                            <form asp-action="Billing" method="post">
                                <button type="submit" class="btn btn--ghost-dark">@Loc["Account.ManageBilling"]</button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn--ghost-dark" href="/contact">@Loc["Account.ContactAboutMembership"]</a>
                        }
                    </div>
                    @if (Model.CanManageBilling)
                    {
                        <p class="account-membership__note">@Loc["Account.ManageBilling.Note"]</p>
                    }
                    else if (m.IsRecurring)
                    {
                        <p class="account-membership__note">@Loc["Account.ManageBilling.Unavailable"]</p>
                    }
                </div>
            </section>

            @* --- What the tier opens, as cards -------------------------------------------------- *@
            @* Swiper: `data-swiper` is picked up by modules/carousel.ts (initCarousels), which reads
               `data-swiper-per-view` for the desktop count, wires the arrows and progress bar from
               the [data-swiper-controls] cluster inside this [data-swiper-scope], and hides that
               cluster whenever every card already fits. Without JS the cards sit in a wrapped row. *@
            <section class="account-carousel" data-swiper-scope aria-labelledby="benefits-heading">
                <header class="account-carousel__head">
                    <h2 id="benefits-heading" class="account-section-heading">@Loc["Account.MembershipUnlocks"]</h2>
                    <partial name="~/Views/Home/_CarouselControls.cshtml" model="@((Loc["Home.Hero.Previous"].Value, Loc["Home.Hero.Next"].Value))" />
                </header>
                <div class="swiper account-carousel__track" data-swiper data-swiper-per-view="3"
                     data-swiper-prev-label="@Loc["Home.Hero.Previous"]" data-swiper-next-label="@Loc["Home.Hero.Next"]">
                    <div class="swiper-wrapper">
                        @foreach (var b in benefits)
                        {
                            <div class="swiper-slide">
                                <article class="benefit-card @(b.Included ? "" : "benefit-card--locked")">
                                    <span class="benefit-card__icon"><partial name="_Icon" model="@b.Icon" /></span>
                                    <h3>@b.Title</h3>
                                    @if (!string.IsNullOrWhiteSpace(b.Body))
                                    {
                                        <p>@b.Body</p>
                                    }
                                    @if (!b.Included)
                                    {
                                        <a class="benefit-card__link benefit-card__link--upgrade" asp-controller="Membership" asp-action="Index" asp-fragment="membership-plans">@Loc["Account.Perk.NotInPlan"]</a>
                                    }
                                    else if (b.Href is not null)
                                    {
                                        <a class="benefit-card__link" href="@b.Href">@Loc["Account.Benefit.Open"] &rarr;</a>
                                    }
                                </article>
                            </div>
                        }
                    </div>
                </div>
            </section>

            @if (Model.Plans.Count(p => p.Id != m.Plan.Id) > 0)
            {
                <section class="account-carousel" data-swiper-scope aria-labelledby="other-plans-heading">
                    <header class="account-carousel__head">
                        <div>
                            <h2 id="other-plans-heading" class="account-section-heading">@Loc["Membership.Member.OtherPlans"]</h2>
                            <p class="account-carousel__lede">@Loc["Membership.Member.OtherPlans.Note"]</p>
                        </div>
                        <partial name="~/Views/Home/_CarouselControls.cshtml" model="@((Loc["Home.Hero.Previous"].Value, Loc["Home.Hero.Next"].Value))" />
                    </header>
                    <div class="swiper account-carousel__track" data-swiper data-swiper-per-view="2"
                         data-swiper-prev-label="@Loc["Home.Hero.Previous"]" data-swiper-next-label="@Loc["Home.Hero.Next"]">
                        <div class="swiper-wrapper">
                            @foreach (var plan in Model.Plans.Where(p => p.Id != m.Plan.Id))
                            {
                                <div class="swiper-slide">
                                    <partial name="_PlanCard" model="plan" view-data='@(new ViewDataDictionary(ViewData) { { "CurrentPlanId", m.Plan.Id }, { "HasMembership", true } })' />
                                </div>
                            }
                        </div>
                    </div>
                </section>
            }
        }
        else
        {
            <section class="account-membership account-membership--invite">
                <div class="account-membership__body">
                    <span class="account-membership__eyebrow">@Loc["Account.CurrentPlan"]</span>
                    <h2>@Loc["Account.NoMembership"]</h2>
                    <p class="account-membership__term">
                        @(Model.SalesOpen ? Loc["Account.NoMembership.Sales"] : Loc["Account.NoMembership.Apply"])
                    </p>
                    @if (!Model.SalesOpen)
                    {
                        <div class="account-membership__actions">
                            <a class="btn btn--primary" asp-controller="Experiences" asp-action="Index" asp-route-status="@ExperienceStatus.ApplicationsOpen">@Loc["Nav.ApplyToJoin"]</a>
                            <a class="btn btn--ghost-dark" asp-controller="Membership" asp-action="Index">@Loc["Account.WhatMembershipIs"]</a>
                        </div>
                    }
                </div>
            </section>

            @if (Model.Plans.Count > 0)
            {
                @* Same carousel as the member view — see the Swiper note above. *@
                <section class="account-carousel" data-swiper-scope aria-labelledby="choose-plan-heading">
                    <header class="account-carousel__head">
                        <h2 id="choose-plan-heading" class="account-section-heading">@Loc["Account.ChooseAPlan"]</h2>
                        <partial name="~/Views/Home/_CarouselControls.cshtml" model="@((Loc["Home.Hero.Previous"].Value, Loc["Home.Hero.Next"].Value))" />
                    </header>
                    <div class="swiper account-carousel__track" data-swiper data-swiper-per-view="2"
                         data-swiper-prev-label="@Loc["Home.Hero.Previous"]" data-swiper-next-label="@Loc["Home.Hero.Next"]">
                        <div class="swiper-wrapper">
                            @foreach (var plan in Model.Plans)
                            {
                                <div class="swiper-slide">
                                    <partial name="_PlanCard" model="plan" view-data='@(new ViewDataDictionary(ViewData) { { "HasMembership", false } })' />
                                </div>
                            }
                        </div>
                    </div>
                </section>
            }
        }

        @if (Model.History.Count > 0)
        {
            <h2 class="account-section-heading">@Loc["Account.MembershipHistory"]</h2>
            <div class="account-table-scroll">
                <table class="account-table">
                    <thead>
                        <tr>
                            <th>@Loc["Account.History.Plan"]</th>
                            <th>@Loc["Account.History.From"]</th>
                            <th>@Loc["Account.History.Until"]</th>
                            <th>@Loc["Account.History.Status"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var h in Model.History)
                        {
                            <tr>
                                <td>@h.Plan.Name</td>
                                <td>@h.Membership.StartAt.ToString("d MMM yyyy")</td>
                                <td>@(h.Membership.ExpiresAt?.ToString("d MMM yyyy") ?? Loc["Card.NoExpiry"].Value)</td>
                                <td><span class="account-status account-status--@StatusKey(h)">@StatusLabel(h)</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

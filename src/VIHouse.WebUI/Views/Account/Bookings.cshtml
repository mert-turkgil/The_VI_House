@model List<BookingListItemViewModel>
@{
    ViewData["Title"] = Loc["Account.BookingsTitle"];
}

<div class="account-manage">
    <partial name="_AccountNav" />
    <div class="account-manage__content">
        <h1>@Loc["Account.BookingsTitle"]</h1>

        @if (Model.Count == 0)
        {
            <p>@Loc["Account.NoBookings"]</p>
        }
        else
        {
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>@Loc["Account.BookingReference"]</th>
                        <th>@Loc["Account.BookingExperience"]</th>
                        <th>@Loc["Account.BookingDate"]</th>
                        <th>@Loc["Account.BookingStatus"]</th>
                        <th>@Loc["Account.BookingAmount"]</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model)
                    {
                        <tr>
                            <td><a asp-action="Ticket" asp-route-reference="@b.BookingReference">@b.BookingReference</a></td>
                            <td>@b.ExperienceLabel</td>
                            <td>@b.StartAtUtc.ToString("dd MMM yyyy")</td>
                            <td>@b.Status</td>
                            <td>@MoneyFormatter.Format(b.AmountMinor, b.Currency)</td>
                            <td><a class="btn btn--ghost btn--sm" asp-action="Ticket" asp-route-reference="@b.BookingReference">View ticket</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

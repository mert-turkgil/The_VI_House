@using VIHouse.DataAccess.Identity
@using VIHouse.Business.Abstract
@using VIHouse.Business.Options
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Options
@inject IMembershipService MembershipService
@inject UserManager<ApplicationUser> UserManager
@inject IOptions<FeatureOptions> Features
@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    string NavClass(string action) => string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase) ? "active" : "";

    // The Member role is granted to anyone who pays — including a single-event ticket holder — so it
    // can't decide whether to show the members-only links. Only an active Membership can. Showing a
    // link that immediately bounces the visitor back is worse than not showing it.
    var entitlements = await MemberAccess.GetEntitlementsAsync(User, MembershipService, UserManager);
    var hasMembership = entitlements is not null;
    var isAdmin = Roles.AdminRoles.Any(User.IsInRole);
    var isAmbassador = User.IsInRole(Roles.Ambassador);
}
<nav class="account-manage__nav" aria-label="Account">
    @if (isAdmin)
    {
        <a asp-area="Admin" asp-controller="AdminDashboard" asp-action="Index">@Loc["Account.NavAdminPanel"]</a>
    }
    <a class="@NavClass("Index")" asp-controller="Account" asp-action="Index">@Loc["Account.NavOverview"]</a>
    <a class="@NavClass("Profile")" asp-controller="Account" asp-action="Profile">@Loc["Account.NavProfile"]</a>
    <a class="@NavClass("Membership")" asp-controller="Account" asp-action="Membership">@Loc["Account.NavMembership"]</a>
    <a class="@NavClass("Bookings")" asp-controller="Account" asp-action="Bookings">@Loc["Account.NavBookings"]</a>
    <a class="@NavClass("Sessions")" asp-controller="Account" asp-action="Sessions">@Loc["Account.NavSessions"]</a>
    @* Each members-only door follows the tier (MembershipPlan's entitlement flags), not just
       "has a membership" — plans differ in what they include. *@
    @if (entitlements is { MemberCard: true })
    {
        <a class="@NavClass("Card")" asp-controller="Account" asp-action="Card">@Loc["Card.NavLabel"]</a>
    }
    @if (entitlements is { Community: true } && Features.Value.Community)
    {
        <a class="@NavClass("Community")" asp-controller="Account" asp-action="Community">@Loc["Account.NavCommunity"]</a>
    }
    @if (entitlements is { Directory: true } && Features.Value.MemberDirectory)
    {
        <a asp-controller="MemberDirectory" asp-action="Index">@Loc["Nav.Members"]</a>
    }
    @if (isAmbassador)
    {
        <a asp-controller="Ambassador" asp-action="Index">@Loc["Ambassador.Nav"]</a>
    }
    <a class="@NavClass("Notifications")" asp-controller="Account" asp-action="Notifications">@Loc["Notif.Title"]</a>
    @if (!hasMembership && !Features.Value.MembershipSales)
    {
        @* Membership is not sold; it is applied for. This points at the experiences that are open
           for applications rather than at a plan list — see Controllers/MembershipController and
           FeatureOptions.MembershipSales. *@
        <a asp-area="" asp-controller="Experiences" asp-action="Index" asp-route-status="@ExperienceStatus.ApplicationsOpen">@Loc["Account.NavJoinTheHouse"]</a>
    }
    <a asp-area="Identity" asp-page="/Account/Manage/Index">@Loc["Account.NavSecurity"]</a>
</nav>

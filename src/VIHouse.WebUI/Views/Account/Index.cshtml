@model ProfileFormViewModel
@{
    ViewData["Title"] = Loc["Account.ProfileTitle"];
    var membership = ViewData["Membership"] as AccountMembershipInfo;
}

<div class="account-manage">
    <partial name="_AccountNav" />
    <div class="account-manage__content">
        <h1>@Loc["Account.ProfileTitle"]</h1>

        @if (TempData["StatusMessage"] is string status)
        {
            <div class="contact-success" style="margin-bottom:20px;">@status</div>
        }

        <div class="account-membership-card">
            @if (membership is not null)
            {
                <span class="account-membership-card__badge">@membership.PlanName</span>
                <p>
                    @if (membership.ExpiresAt is not null)
                    {
                        @Loc["Account.MembershipValidUntil", membership.ExpiresAt.Value.ToString("d MMMM yyyy")]
                    }
                    else
                    {
                        @Loc["Account.MembershipNoExpiry"]
                    }
                    &middot; <a asp-controller="Account" asp-action="Card">@Loc["Card.ViewCard"]</a>
                </p>
            }
            else
            {
                <p>@Loc["Account.NoMembership"] <a asp-controller="Membership" asp-action="Index">@Loc["Account.ViewPlans"]</a></p>
            }
        </div>

        <form asp-action="Index" method="post" class="apply-form" novalidate>
            <div asp-validation-summary="ModelOnly" class="apply-form__summary"></div>
            <div class="apply-form__grid apply-form__grid--2">
                <div class="apply-field">
                    <label asp-for="CompanyName">@Loc["Account.CompanyLabel"]</label>
                    <input asp-for="CompanyName" />
                </div>
                <div class="apply-field">
                    <label asp-for="JobTitle">@Loc["Account.RoleLabel"]</label>
                    <input asp-for="JobTitle" />
                </div>
                <div class="apply-field">
                    <label asp-for="Industry">@Loc["Account.IndustryLabel"]</label>
                    <input asp-for="Industry" />
                </div>
                <div class="apply-field">
                    <label asp-for="LinkedInUrl">@Loc["Account.LinkedInLabel"]</label>
                    <input asp-for="LinkedInUrl" />
                    <span asp-validation-for="LinkedInUrl" class="apply-field__error"></span>
                </div>
                <div class="apply-field">
                    <label asp-for="WebsiteUrl">@Loc["Account.WebsiteLabel"]</label>
                    <input asp-for="WebsiteUrl" />
                    <span asp-validation-for="WebsiteUrl" class="apply-field__error"></span>
                </div>
            </div>
            <div class="apply-field">
                <label asp-for="Bio">@Loc["Account.BioLabel"]</label>
                <textarea asp-for="Bio" rows="4"></textarea>
            </div>

            <fieldset class="apply-form__section">
                <legend>@Loc["Account.DirectorySectionHeading"]</legend>
                <p class="apply-form__note" style="margin-top:-8px;">@Loc["Account.DirectorySectionNote"]</p>
                <div class="apply-form__grid apply-form__grid--2">
                    <div class="apply-field">
                        <label asp-for="Interests">@Loc["Account.InterestsLabel"]</label>
                        <input asp-for="Interests" />
                    </div>
                    <div class="apply-field">
                        <label asp-for="LookingFor">@Loc["Account.LookingForLabel"]</label>
                        <input asp-for="LookingFor" />
                    </div>
                </div>
                <div class="apply-field">
                    <label asp-for="CanHelpWith">@Loc["Account.CanHelpWithLabel"]</label>
                    <input asp-for="CanHelpWith" />
                </div>
                <div class="apply-field apply-field--checkbox">
                    <label>
                        <input asp-for="VisibleInDirectory" type="checkbox" />
                        <span>@Loc["Account.VisibleInDirectoryLabel"]</span>
                    </label>
                </div>
            </fieldset>

            <button type="submit" class="btn btn--primary apply-form__submit">@Loc["Account.SaveProfile"]</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

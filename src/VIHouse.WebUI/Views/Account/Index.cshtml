@model AccountDashboardViewModel
@{
    ViewData["Title"] = Loc["Account.DashboardTitle"];
    var m = Model.Membership;

    var standingClass = Model.Standing switch
    {
        AccountStanding.Member => "account-standing--member",
        AccountStanding.Staff => "account-standing--staff",
        AccountStanding.Guest => "account-standing--guest",
        _ => "account-standing--prospect",
    };

    string GrantLabel(SeminarAccessGrant grant) => grant switch
    {
        SeminarAccessGrant.Purchase => Loc["Sessions.Grant.Paid"].Value,
        SeminarAccessGrant.Membership => Loc["Sessions.Grant.Membership"].Value,
        SeminarAccessGrant.Comped => Loc["Sessions.Grant.Comped"].Value,
        _ => Loc["Sessions.Grant.Free"].Value,
    };
}

<div class="account-manage">
    <partial name="_AccountNav" />
    <div class="account-manage__content account-dash">

        @if (TempData["StatusMessage"] is string status)
        {
            <div class="contact-success" role="status">@status</div>
        }

        @* --- Who you are to the House ---------------------------------------------------- *@
        <header class="account-dash__hero">
            <span class="account-dash__eyebrow">@Loc["Account.WelcomeBack"]</span>
            <h1>@Model.FirstName @Model.LastName</h1>
            <div class="account-dash__standing">
                <span class="account-standing @standingClass">
                    @switch (Model.Standing)
                    {
                        case AccountStanding.Member: @m!.Plan.Name break;
                        case AccountStanding.Staff: @Loc["Account.Standing.Staff"] break;
                        case AccountStanding.Guest: @Loc["Account.Standing.Guest"] break;
                        default: @Loc["Account.Standing.Prospect"] break;
                    }
                </span>
                @if (Model.MemberNumber is not null)
                {
                    <span class="account-dash__number">@Loc["Card.MemberNumber"] @Model.MemberNumber</span>
                }
            </div>
        </header>

        @if (!Model.ProfileComplete)
        {
            <div class="account-notice" role="status">
                <div>
                    <strong>@Loc["Account.ProfileIncomplete.Heading"]</strong>
                    <p>@Loc["Account.ProfileIncomplete.Body"]</p>
                </div>
                <a class="btn btn--primary" asp-action="Profile">@Loc["Account.ProfileIncomplete.Cta"]</a>
            </div>
        }

        @* --- Membership: the panel the dashboard is built around ---------------------------- *@
        @if (m is not null)
        {
            @if (m.IsPastDue)
            {
                <div class="account-notice account-notice--pastdue" role="alert">
                    <div>
                        <strong>@Loc["Account.PastDue.Title"]</strong>
                        <span>@Loc["Account.PastDue.Banner", m.Membership.ExpiresAt?.ToString("d MMMM yyyy") ?? ""]</span>
                    </div>
                    @if (Model.CanManageBilling)
                    {
                        <form asp-action="Billing" method="post">
                            <button type="submit" class="btn btn--primary">@Loc["Account.PastDue.Cta"]</button>
                        </form>
                    }
                </div>
            }
            <section class="account-membership" aria-labelledby="membership-heading">
                <div class="account-membership__body">
                    <span class="account-membership__eyebrow">@Loc["Account.YourMembership"]</span>
                    <h2 id="membership-heading">@m.Plan.Name</h2>
                    <p class="account-membership__term">
                        @if (m.Membership.Status == MembershipStatus.Cancelled)
                        {
                            @Loc["Account.Membership.Ended", m.Membership.ExpiresAt?.ToString("d MMMM yyyy") ?? ""]
                        }
                        else if (m.IsPastDue && m.Membership.ExpiresAt is { } paidUntil)
                        {
                            @Loc["Account.Membership.PaidUntil", paidUntil.ToString("d MMMM yyyy")]
                        }
                        else if (m.HasProviderSubscription && m.Membership.RenewalAt is { } renews)
                        {
                            @Loc["Account.Membership.Renews", renews.ToString("d MMMM yyyy")]
                        }
                        else if (m.Membership.ExpiresAt is { } expires)
                        {
                            @Loc["Account.MembershipValidUntil", expires.ToString("d MMMM yyyy")]
                        }
                        else
                        {
                            @Loc["Account.MembershipNoExpiry"]
                        }
                        &middot; @Loc["Card.MemberSince"] @m.Membership.StartAt.ToString("MMMM yyyy")
                    </p>
                    <div class="account-membership__actions">
                        @if (Model.Entitlements is { MemberCard: true })
                        {
                            <a class="btn btn--primary" asp-action="Card">@Loc["Card.ViewCard"]</a>
                        }
                        <a class="btn btn--ghost-dark" asp-action="Membership">@Loc["Account.MembershipDetails"]</a>
                        @if (Model.CanManageBilling)
                        {
                            <form asp-action="Billing" method="post">
                                <button type="submit" class="btn btn--ghost-dark">@Loc["Account.ManageBilling"]</button>
                            </form>
                        }
                    </div>
                </div>
                @{
                    var ent = Model.Entitlements;
                }
                <ul class="account-membership__perks" aria-label="@Loc["Account.MembershipUnlocks"]">
                    @* What the tier opens is a link; what it does not is said plainly, with the way
                       up — a perk that silently bounces reads as a fault. *@
                    @if (ent is { Sessions: true })
                    {
                        <li><a asp-controller="Seminars" asp-action="Index">@Loc["Account.Perk.Sessions"]</a></li>
                    }
                    else
                    {
                        <li class="account-membership__perk--locked"><span>@Loc["Account.Perk.Sessions"]</span> <a asp-controller="Membership" asp-action="Index" asp-fragment="membership-plans">@Loc["Account.Perk.NotInPlan"]</a></li>
                    }
                    @if (Model.DirectoryEnabled)
                    {
                        @if (ent is { Directory: true })
                        {
                            <li><a asp-controller="MemberDirectory" asp-action="Index">@Loc["Account.Perk.Directory"]</a></li>
                        }
                        else
                        {
                            <li class="account-membership__perk--locked"><span>@Loc["Account.Perk.Directory"]</span> <a asp-controller="Membership" asp-action="Index" asp-fragment="membership-plans">@Loc["Account.Perk.NotInPlan"]</a></li>
                        }
                    }
                    @if (Model.CommunityEnabled)
                    {
                        @if (ent is { Community: true })
                        {
                            <li><a asp-action="Community">@Loc["Account.Perk.Community"]</a></li>
                        }
                        else
                        {
                            <li class="account-membership__perk--locked"><span>@Loc["Account.Perk.Community"]</span> <a asp-controller="Membership" asp-action="Index" asp-fragment="membership-plans">@Loc["Account.Perk.NotInPlan"]</a></li>
                        }
                    }
                    <li><a asp-controller="Experiences" asp-action="Index">@Loc["Account.Perk.Experiences"]</a></li>
                </ul>
            </section>
        }
        else if (Model.Standing == AccountStanding.Staff)
        {
            <section class="account-membership account-membership--muted">
                <div class="account-membership__body">
                    <span class="account-membership__eyebrow">@Loc["Account.Standing.Staff"]</span>
                    <h2>@Loc["Account.Staff.Heading"]</h2>
                    <p class="account-membership__term">@Loc["Account.Staff.Body"]</p>
                    <div class="account-membership__actions">
                        <a class="btn btn--primary" asp-area="Admin" asp-controller="AdminDashboard" asp-action="Index">@Loc["Account.NavAdminPanel"]</a>
                    </div>
                </div>
            </section>
        }
        else
        {
            @* A guest or a prospect: the same panel, addressed to someone who is not yet a member.
               What they already hold is acknowledged first — a ticket-holder is a guest of the
               House, not a stranger — and the route in follows. *@
            <section class="account-membership account-membership--invite">
                <div class="account-membership__body">
                    <span class="account-membership__eyebrow">@Loc["Account.YourMembership"]</span>
                    <h2>@(Model.Standing == AccountStanding.Guest ? Loc["Account.Guest.Heading"] : Loc["Account.Prospect.Heading"])</h2>
                    <p class="account-membership__term">
                        @if (Model.Standing == AccountStanding.Guest)
                        {
                            @Loc["Account.Guest.Body", Model.TotalBookingCount, Model.TotalSessionCount]
                        }
                        else
                        {
                            @Loc["Account.Prospect.Body"]
                        }
                    </p>
                    <div class="account-membership__actions">
                        @if (Model.Plans.Count > 0)
                        {
                            <a class="btn btn--primary" asp-action="Membership">@Loc["Account.SeePlans"]</a>
                        }
                        else
                        {
                            <a class="btn btn--primary" asp-controller="Experiences" asp-action="Index" asp-route-status="@ExperienceStatus.ApplicationsOpen">@Loc["Nav.ApplyToJoin"]</a>
                        }
                        <a class="btn btn--ghost-dark" asp-controller="Membership" asp-action="Index">@Loc["Account.WhatMembershipIs"]</a>
                    </div>
                </div>
            </section>
        }

        @* --- Live hubs: the online things they hold a place on ----------------------------- *@
        @if (Model.Hubs.Count > 0)
        {
            <section class="account-hubs" aria-labelledby="hubs-heading">
                <header class="account-panel__head">
                    <h2 id="hubs-heading">@Loc["Account.Hubs.Heading"]</h2>
                    <p>@Loc["Account.Hubs.Lede"]</p>
                </header>
                <div class="account-hubs__grid">
                    @foreach (var hub in Model.Hubs)
                    {
                        <article class="account-hub @(hub.IsLiveNow ? "account-hub--live" : "")">
                            <div class="account-hub__head">
                                <span class="account-hub__kind">@(hub.Kind == "session" ? Loc["Account.Hubs.Session"] : Loc["Account.Hubs.Experience"])</span>
                                @if (hub.IsLiveNow && hub.StartAtUtc is not null)
                                {
                                    <span class="account-hub__live"><span class="account-hub__dot" aria-hidden="true"></span> @Loc["Sessions.LiveNow"]</span>
                                }
                            </div>
                            <h3><a href="@hub.Href">@hub.Title</a></h3>
                            @if (hub.StartAtUtc is { } start)
                            {
                                <p class="account-hub__when">@start.ToString("ddd d MMM yyyy, HH:mm") UTC</p>
                            }
                            else
                            {
                                <p class="account-hub__when">@Loc["Account.Hubs.OnDemand"]</p>
                            }

                            @if (hub.LiveStreamUrl is not null && hub.IsLiveNow)
                            {
                                <div class="account-hub__stream">
                                    <partial name="_LiveStream" model="@((hub.LiveStreamUrl, Loc["Sessions.WatchLive"].Value))" />
                                </div>
                            }

                            <div class="account-hub__actions">
                                @if (hub.MeetingUrl is not null)
                                {
                                    <a class="btn btn--primary" href="@hub.MeetingUrl" target="_blank" rel="noopener">@Loc["Sessions.JoinLink"]</a>
                                }
                                @if (hub.LiveStreamUrl is not null && !hub.IsLiveNow)
                                {
                                    <span class="account-hub__pending">@Loc["Sessions.StreamLater"]</span>
                                }
                                @foreach (var link in hub.Links)
                                {
                                    @* Discord links are minted per person when the bot is configured
                                       (AccountController.CommunityInvite); the static URL is the fallback. *@
                                    <form asp-action="CommunityInvite" asp-route-linkId="@link.Id" method="post" class="account-hub__link">
                                        <button type="submit" class="btn btn--ghost">@link.Label</button>
                                    </form>
                                }
                            </div>
                        </article>
                    }
                </div>
            </section>
        }

        @* --- Referral link, for ambassadors ---------------------------------------------------- *@
        @if (Model.ReferralCode is { } referralCode)
        {
            var referralUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/r/{referralCode}";
            <section class="account-referral" aria-labelledby="referral-heading">
                <div class="account-referral__body">
                    <span class="account-dash__eyebrow">@Loc["Ambassador.Panel.Eyebrow"]</span>
                    <h2 id="referral-heading">@Loc["Ambassador.Panel.Title"]</h2>
                    <p>@Loc["Ambassador.Panel.Body"]</p>
                </div>
                <div class="account-referral__link">
                    <code data-copy-source>@referralUrl</code>
                    <button type="button" class="btn btn--primary" data-copy="@referralUrl" data-copied-label="@Loc["Ambassador.Panel.Copied"]">@Loc["Ambassador.Panel.Copy"]</button>
                    <a class="btn btn--ghost" asp-controller="Ambassador" asp-action="Index">@Loc["Ambassador.Panel.Dashboard"]</a>
                </div>
            </section>
        }

        @* --- What is coming up ----------------------------------------------------------- *@
        <div class="account-dash__grid">
            <section class="account-panel">
                <header class="account-panel__head">
                    <h2>@Loc["Account.NextSessions"]</h2>
                    <a asp-action="Sessions">@Loc["Account.SeeAll"] (@Model.TotalSessionCount)</a>
                </header>
                @if (Model.UpcomingSessions.Count == 0)
                {
                    <p class="account-panel__empty">
                        @if (Model.OnDemandSessionCount > 0)
                        {
                            @Loc["Account.NoLiveSessions", Model.OnDemandSessionCount]
                        }
                        else
                        {
                            @Loc["Account.NoSessions"]
                        }
                        <a asp-controller="Seminars" asp-action="Index">@Loc["Account.BrowseSessions"]</a>
                    </p>
                }
                else
                {
                    <ul class="account-list">
                        @foreach (var s in Model.UpcomingSessions)
                        {
                            <li class="account-list__item">
                                <div class="account-list__date">
                                    <span class="account-list__day">@s.StartAtUtc!.Value.ToString("dd")</span>
                                    <span class="account-list__month">@s.StartAtUtc.Value.ToString("MMM")</span>
                                </div>
                                <div class="account-list__body">
                                    <a class="account-list__title" asp-controller="Seminars" asp-action="Details" asp-route-slug="@s.Slug">@s.Title</a>
                                    <span class="account-list__meta">
                                        @s.StartAtUtc.Value.ToString("HH:mm") UTC &middot;
                                        @(s.IsOnline ? Loc["Seminars.Online"].Value : s.Location ?? Loc["Seminars.InPerson"].Value)
                                        &middot; <span class="account-grant account-grant--@s.GrantedVia.ToString().ToLowerInvariant()">@GrantLabel(s.GrantedVia)</span>
                                    </span>
                                </div>
                                @if (s.HasMeetingLink)
                                {
                                    <a class="btn btn--ghost-dark btn--sm" asp-controller="Seminars" asp-action="Details" asp-route-slug="@s.Slug">@Loc["Sessions.JoinLink"]</a>
                                }
                            </li>
                        }
                    </ul>
                }
            </section>

            <section class="account-panel">
                <header class="account-panel__head">
                    <h2>@Loc["Account.NextExperiences"]</h2>
                    <a asp-action="Bookings">@Loc["Account.SeeAll"] (@Model.TotalBookingCount)</a>
                </header>
                @if (Model.UpcomingBookings.Count == 0)
                {
                    <p class="account-panel__empty">
                        @Loc["Account.NoUpcomingBookings"]
                        <a asp-controller="Experiences" asp-action="Index">@Loc["Account.BrowseExperiences"]</a>
                    </p>
                }
                else
                {
                    <ul class="account-list">
                        @foreach (var b in Model.UpcomingBookings)
                        {
                            <li class="account-list__item">
                                <div class="account-list__date">
                                    <span class="account-list__day">@b.StartAtUtc.ToString("dd")</span>
                                    <span class="account-list__month">@b.StartAtUtc.ToString("MMM")</span>
                                </div>
                                <div class="account-list__body">
                                    <a class="account-list__title" asp-action="Ticket" asp-route-reference="@b.Reference">@b.ExperienceLabel</a>
                                    <span class="account-list__meta">@b.Reference &middot; @b.Status</span>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </section>
        </div>

        @* --- Everything else in the account, one tap away ------------------------------------ *@
        <nav class="account-quick" aria-label="@Loc["Account.QuickLinks"]">
            <a class="account-quick__item" asp-action="Profile">
                <strong>@Loc["Account.NavProfile"]</strong>
                <span>@(Model.ProfileComplete ? Loc["Account.Quick.ProfileComplete"] : Loc["Account.Quick.ProfileIncomplete"])</span>
            </a>
            <a class="account-quick__item" asp-action="Notifications">
                <strong>@Loc["Notif.Title"]</strong>
                <span>@(Model.UnreadNotifications > 0 ? Loc["Account.Quick.Unread", Model.UnreadNotifications] : Loc["Account.Quick.AllRead"])</span>
            </a>
            <a class="account-quick__item" asp-action="Bookings">
                <strong>@Loc["Account.NavBookings"]</strong>
                <span>@Loc["Account.Quick.Bookings", Model.TotalBookingCount]</span>
            </a>
            <a class="account-quick__item" asp-action="Sessions">
                <strong>@Loc["Account.NavSessions"]</strong>
                <span>@Loc["Account.Quick.Sessions", Model.TotalSessionCount]</span>
            </a>
            <a class="account-quick__item" asp-area="Identity" asp-page="/Account/Manage/Index">
                <strong>@Loc["Account.NavSecurity"]</strong>
                <span>@Model.Email</span>
            </a>
        </nav>
    </div>
</div>

@model List<Notification>
@{
    ViewData["Title"] = Loc["Notif.Title"];
}

<div class="account-manage">
    <partial name="_AccountNav" />
    <div class="account-manage__content">
        <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px;">
            <h1 style="margin:0;">@Loc["Notif.Title"]</h1>
            @if (Model.Any(n => !n.IsRead))
            {
                <form asp-controller="Account" asp-action="MarkAllNotificationsRead" method="post">
                    <input type="hidden" name="returnUrl" value="/account/notifications" />
                    <button type="submit" class="btn btn--ghost-dark" style="color:var(--vih-ink); border-color:var(--vih-line-on-light);">@Loc["Notif.MarkAllRead"]</button>
                </form>
            }
        </div>

        @if (Model.Count == 0)
        {
            <p style="color:#666; margin-top:24px;">@Loc["Notif.Empty"]</p>
        }
        else
        {
            <div class="notif-list" style="margin-top:24px;">
                @foreach (var n in Model)
                {
                    <a class="notif-list__item @(n.IsRead ? "" : "notif-list__item--unread")" asp-controller="Account" asp-action="OpenNotification" asp-route-id="@n.Id">
                        <div class="notif-list__body">
                            <span class="notif-list__title">@n.Title</span>
                            <span class="notif-list__text">@n.Body</span>
                        </div>
                        <span class="notif-list__time">@n.CreatedAt.ToString("dd MMM yyyy, HH:mm")</span>
                    </a>
                }
            </div>
        }
    </div>
</div>

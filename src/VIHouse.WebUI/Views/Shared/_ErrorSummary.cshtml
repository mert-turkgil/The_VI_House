@model string
@*
    Form-level error summary: a titled alert listing every problem on the form, each linked to the
    field it is about. Rendered after a failed POST (server-side), and focused on load by
    modules/formFeedback.ts, so the first thing seen and heard is what went wrong and where.
    The same messages also sit under their own fields (asp-validation-for), so the reader can fix
    each one in place.

    Model: the title, e.g. "We couldn't reset your password".
*@
@{
    var problems = ViewContext.ViewData.ModelState
        .Where(entry => entry.Value is { Errors.Count: > 0 })
        .SelectMany(entry => entry.Value!.Errors.Select(error => (entry.Key, Message: error.ErrorMessage)))
        .Where(p => !string.IsNullOrWhiteSpace(p.Message))
        .DistinctBy(p => p.Message)
        .ToList();
}
@if (problems.Count > 0)
{
    <div class="error-summary" role="alert" tabindex="-1" aria-labelledby="error-summary-title" data-error-summary>
        <span class="error-summary__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9.5" /><path d="M12 7.5v5.5M12 16.5v.01" /></svg>
        </span>
        <div class="error-summary__body">
            <h2 class="error-summary__title" id="error-summary-title">@Model</h2>
            <ul class="error-summary__list">
                @foreach (var problem in problems)
                {
                    <li>
                        @if (string.IsNullOrEmpty(problem.Key))
                        {
                            @problem.Message
                        }
                        else
                        {
                            <a href="#@Html.GenerateIdFromName(problem.Key)" data-error-link>@problem.Message</a>
                        }
                    </li>
                }
            </ul>
        </div>
    </div>
}

@using System.Globalization
<!DOCTYPE html>
@* The full tag ("en-GB"), not just the language ("en"): it must agree with the hreflang the page
   declares for itself, and a mismatch between them is a signal search engines act on. *@
<html lang="@CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    @* Title, description, canonical, hreflang, Open Graph, Twitter card and JSON-LD — all of it,
       for every page. The title used to be assembled here with a hardcoded English suffix; it is
       now built from the per-language template on the settings screen. *@
    <partial name="_Seo" />

    @* PWA — brief §65. Admin (_AdminLayout) deliberately doesn't get any of this; it's an internal
       tool, not something a member would install to their home screen. *@
    <link rel="manifest" href="~/manifest.json" />
    <link rel="icon" href="~/favicon.ico" />
    <link rel="apple-touch-icon" href="~/icons/apple-touch-icon.png" />
    <meta name="theme-color" content="#00230a" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="VI House" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/dist/main.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <partial name="_Nav" />

    <main id="main-content" role="main">
        @RenderBody()
    </main>

    <partial name="_Footer" />

    <script type="module" src="~/dist/main.js" asp-append-version="true"></script>
    @* jQuery is kept globally only for ASP.NET Core's unobtrusive client-side validation
       (per-page validation plugin scripts load via the page's own "Scripts" section, e.g.
       _ValidationScriptsPartial) — not pulled in as a general-purpose dependency. *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

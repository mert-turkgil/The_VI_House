@using System.Globalization
@using VIHouse.Business.Options
@using Microsoft.Extensions.Options
@inject IConfiguration Configuration
@inject IOptions<FeatureOptions> Features

@{
    var currentPath = Context.Request.Path + Context.Request.QueryString;
    string CultureUrl(string culture)
    {
        var bare = VIHouse.WebUI.Helpers.SeoResolver.StripCulture(Context.Request.Path.Value ?? "/");
        var target = VIHouse.WebUI.Helpers.SeoResolver.PathFor(culture, bare) + Context.Request.QueryString;
        return Url.Action("Set", "Culture", new { culture, returnUrl = target })!;
    }
    var currentCulture = SiteCultures.Describe(CultureInfo.CurrentUICulture.Name);

    var social = new (string Icon, string Key, string Label)[]
    {
        ("instagram", "Site:Social:Instagram", "Instagram"),
        ("linkedin", "Site:Social:LinkedIn", "LinkedIn"),
        ("twitter", "Site:Social:X", "X"),
        ("youtube", "Site:Social:YouTube", "YouTube"),
    }
    .Select(s => (s.Icon, s.Label, Url: Configuration[s.Key]))
    .Where(s => !string.IsNullOrWhiteSpace(s.Url))
    .ToList();
}

<footer class="site-footer">
    <div class="container">
        <div class="site-footer__grid">
            <div class="site-footer__brand">
                <div class="site-footer__brand-head">
                    <partial name="_Crest" />
                    <div class="site-footer__wordmark">The VI House</div>
                </div>
                <p class="site-footer__tagline">@Loc["Footer.Tagline"]</p>

                @if (social.Count > 0)
                {
                    <ul class="site-footer__social">
                        @foreach (var link in social)
                        {
                            <li>
                                @* The icon is aria-hidden by definition (see _Icon.cshtml), so the
                                   accessible name has to live on the link itself. *@
                                <a href="@link.Url" target="_blank" rel="noopener me" aria-label="@link.Label">
                                    <partial name="_Icon" model="@link.Icon" />
                                </a>
                            </li>
                        }
                    </ul>
                }
            </div>

            <div class="site-footer__col">
                <h4>@Loc["Footer.Explore"]</h4>
                <ul>
                    <li><a asp-area="" asp-controller="Experiences" asp-action="Index">@Loc["Nav.Experiences"]</a></li>
                    <li><a asp-area="" asp-controller="Seminars" asp-action="Index">@Loc["Footer.Sessions"]</a></li>
                    <li><a asp-area="" asp-controller="Journal" asp-action="Index">@Loc["Footer.Journal"]</a></li>
                    @* Only while the directory is open. A footer link to a page that answers 404 is
                       worse than a shorter footer — see FeatureOptions. *@
                    @if (Features.Value.MemberDirectory)
                    {
                        <li><a asp-area="" asp-controller="MemberDirectory" asp-action="Index">@Loc["Footer.Community"]</a>
                        </li>
                    }
                </ul>
            </div>

            <div class="site-footer__col">
                <h4>@Loc["Footer.Membership"]</h4>
                <ul>
                    <li><a asp-area="" asp-controller="Membership" asp-action="Index">@Loc["Footer.Benefits"]</a></li>
                    <li><a asp-area="" asp-controller="Experiences" asp-action="Index" asp-route-status="@ExperienceStatus.ApplicationsOpen">@Loc["Nav.ApplyToJoin"]</a></li>
                    <li><a asp-area="Identity" asp-page="/Account/Login">@Loc["Footer.MemberLogin"]</a></li>
                </ul>
            </div>

            <div class="site-footer__col">
                <h4>@Loc["Footer.Company"]</h4>
                <ul>
                    <li><a asp-area="" asp-controller="About" asp-action="Index">@Loc["Footer.AboutUs"]</a></li>
                    <li><a asp-area="" asp-controller="Contact" asp-action="Index">@Loc["Footer.Contact"]</a></li>
                </ul>
            </div>

            <div class="site-footer__col">
                <h4>@Loc["Footer.Support"]</h4>
                <ul>
                    <li><a asp-area="" asp-controller="Faq" asp-action="Index">@Loc["Footer.Faq"]</a></li>
                    <li><a asp-area="" asp-controller="Contact" asp-action="Index">@Loc["Footer.ContactUs"]</a></li>
                </ul>
            </div>

            <div class="site-footer__newsletter">
                <h4>@Loc["Footer.NewsletterHeading"]</h4>
                <p class="site-footer__newsletter-lede">@Loc["Footer.NewsletterLede"]</p>
                @* TODO: wire to a real newsletter endpoint once a mailing-list provider is chosen — inert for now
                rather than a dead POST. *@
                <form class="site-footer__newsletter-form" onsubmit="return false;">
                    <input type="email" placeholder="@Loc["Footer.NewsletterPlaceholder"]"
                           aria-label="@Loc["Footer.NewsletterPlaceholder"]" required />
                    <button type="submit" aria-label="@Loc["Footer.NewsletterSubmit"]">&rarr;</button>
                </form>
            </div>
        </div>

        <div class="site-footer__bottom">
            <span>&copy; @DateTime.UtcNow.Year The VI House Group Ltd. @Loc["Footer.RightsReserved"]</span>

            <ul class="site-footer__legal-links">
                <li><a asp-area="" asp-controller="Legal" asp-action="Terms">@Loc["Footer.Terms"]</a></li>
                <li><a asp-area="" asp-controller="Legal" asp-action="Privacy">@Loc["Footer.Privacy"]</a></li>
                <li><a asp-area="" asp-controller="Legal" asp-action="Cookies">@Loc["Footer.Cookies"]</a></li>
                <li><a asp-area="" asp-controller="Legal" asp-action="Refund">@Loc["Footer.RefundPolicy"]</a></li>
            </ul>

            <nav class="site-footer__lang" aria-label="@Loc["Nav.LanguageLabel"]">
                @foreach (var lang in SiteCultures.All)
                {
                    <a class="@(lang.Name == currentCulture.Name ? "site-footer__lang-link active" : "site-footer__lang-link")"
                       href="@CultureUrl(lang.Name)" lang="@lang.Name"
                       aria-current="@(lang.Name == currentCulture.Name ? "true" : null)">@lang.NativeLabel</a>
                }
            </nav>
        </div>
    </div>
</footer>

<footer class="site-footer">
    <div class="container">
        <div class="site-footer__grid">
            <div class="site-footer__brand">
                <partial name="_Crest" />
                <div>
                    <div class="site-footer__wordmark">The VI House</div>
                    <p>@Loc["Footer.Tagline"]</p>
                </div>
            </div>

            <div class="site-footer__col">
                <h4>@Loc["Footer.Explore"]</h4>
                <ul>
                    <li><a asp-controller="Experiences" asp-action="Index">@Loc["Nav.Experiences"]</a></li>
                    <li><a href="/membership">@Loc["Nav.Membership"]</a></li>
                    <li><a asp-controller="About" asp-action="Index">@Loc["Nav.About"]</a></li>
                </ul>
            </div>

            <div class="site-footer__col">
                <h4>@Loc["Footer.Company"]</h4>
                <ul>
                    <li><a asp-controller="About" asp-action="Index">@Loc["Footer.AboutUs"]</a></li>
                    <li><a asp-controller="Contact" asp-action="Index">@Loc["Footer.Contact"]</a></li>
                </ul>
            </div>

            <div class="site-footer__col">
                <h4>@Loc["Footer.Support"]</h4>
                <ul>
                    <li><a asp-controller="Faq" asp-action="Index">@Loc["Footer.Faq"]</a></li>
                    <li><a asp-controller="Contact" asp-action="Index">@Loc["Footer.ContactUs"]</a></li>
                </ul>
            </div>

            <div class="site-footer__newsletter">
                <h4>@Loc["Footer.NewsletterHeading"]</h4>
                @* TODO: wire to a real newsletter endpoint once a mailing-list provider is chosen — inert for now rather than a dead POST. *@
                <form class="site-footer__newsletter-form" onsubmit="return false;">
                    <input type="email" placeholder="@Loc["Footer.NewsletterPlaceholder"]" aria-label="@Loc["Footer.NewsletterPlaceholder"]" required />
                    <button type="submit" class="btn btn--primary" aria-label="@Loc["Footer.NewsletterSubmit"]">&rarr;</button>
                </form>
                <p class="site-footer__newsletter-note">@Loc["Footer.NewsletterNote"]</p>
            </div>
        </div>

        <div class="site-footer__bottom">
            <span>&copy; @DateTime.UtcNow.Year The VI House Group Ltd. @Loc["Footer.RightsReserved"]</span>
            <ul class="site-footer__legal-links">
                <li><a asp-controller="Legal" asp-action="Terms">@Loc["Footer.Terms"]</a></li>
                <li><a asp-controller="Legal" asp-action="Privacy">@Loc["Footer.Privacy"]</a></li>
                <li><a asp-controller="Legal" asp-action="Cookies">@Loc["Footer.Cookies"]</a></li>
                <li><a asp-controller="Legal" asp-action="Refund">@Loc["Footer.RefundPolicy"]</a></li>
            </ul>
        </div>
    </div>
</footer>

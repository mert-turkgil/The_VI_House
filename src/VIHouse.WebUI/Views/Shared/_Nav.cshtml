@using System.Globalization
@using System.Security.Claims
@using VIHouse.DataAccess.Identity
@inject INotificationService NotificationService
@{
    var currentCulture = CultureInfo.CurrentUICulture.Name;
    var currentPath = Context.Request.Path + Context.Request.QueryString;
    string CultureUrl(string culture) => Url.Action("Set", "Culture", new { culture, returnUrl = currentPath })!;
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isMember = User.IsInRole(Roles.Member);
    var isAmbassador = User.IsInRole(Roles.Ambassador);

    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    string NavLinkClass(string controller) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) ? "site-nav__link active" : "site-nav__link";
    string MobileNavLinkClass(string controller) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) ? "site-mobile-nav__link active" : "site-mobile-nav__link";
    string? AriaCurrent(string controller) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) ? "page" : null;

    var languages = new (string Code, string Short, string Label)[]
    {
        ("en-GB", "EN", "English"),
        ("de-DE", "DE", "Deutsch"),
        ("tr-TR", "TR", "Türkçe"),
        ("et-EE", "ET", "Eesti"),
    };
    var current = Array.Find(languages, l => l.Code == currentCulture);
    if (current.Code is null) current = languages[0];

    var unreadCount = 0;
    List<Notification> recentNotifications = [];
    if (isAuthenticated && Guid.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var currentUserId))
    {
        unreadCount = await NotificationService.GetUnreadCountAsync(currentUserId);
        recentNotifications = (await NotificationService.GetForUserAsync(currentUserId)).Take(6).ToList();
    }
}
<header class="site-header">
    <div class="container site-header__inner">
        <a class="site-brand" asp-controller="Home" asp-action="Index" aria-label="The VI House — Home">
            <span class="site-brand__crest">
                <partial name="_Crest" />
            </span>
            <span class="site-brand__wordmark">The VI House</span>
        </a>

        <nav class="site-nav" aria-label="Primary">
            <ul class="site-nav__list">
                <li><a class="@NavLinkClass("Home")" asp-controller="Home" asp-action="Index" aria-current="@AriaCurrent("Home")">@Loc["Nav.Home"]</a></li>
                <li><a class="@NavLinkClass("Experiences")" asp-controller="Experiences" asp-action="Index" aria-current="@AriaCurrent("Experiences")">@Loc["Nav.Experiences"]</a></li>
                <li><a class="@NavLinkClass("Membership")" asp-controller="Membership" asp-action="Index" aria-current="@AriaCurrent("Membership")">@Loc["Nav.Membership"]</a></li>
                <li><a class="@NavLinkClass("About")" asp-controller="About" asp-action="Index" aria-current="@AriaCurrent("About")">@Loc["Nav.About"]</a></li>
                <li><a class="@NavLinkClass("Journal")" asp-controller="Journal" asp-action="Index" aria-current="@AriaCurrent("Journal")">@Loc["Nav.Journal"]</a></li>
                @if (isMember)
                {
                    <li><a class="@NavLinkClass("MemberDirectory")" asp-controller="MemberDirectory" asp-action="Index" aria-current="@AriaCurrent("MemberDirectory")">@Loc["Nav.Members"]</a></li>
                }
            </ul>
        </nav>

        <div class="site-header__actions">
            <details class="site-search">
                <summary class="site-search__toggle" aria-label="Search">
                    <svg class="site-search__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.6" />
                        <line x1="15.3" y1="15.3" x2="21" y2="21" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                    </svg>
                </summary>
                <div class="site-search__menu">
                    <form action="/search" method="get" class="site-search__form">
                        <input type="text" name="q" class="site-search__input" placeholder="Search experiences, journal…" autocomplete="off" data-search-input />
                    </form>
                    <div class="site-search__results" data-search-results>
                        <p class="search-results__hint">Search experiences and journal entries.</p>
                    </div>
                </div>
            </details>

            <details class="lang-switch">
                <summary class="lang-switch__toggle" aria-label="@Loc["Nav.LanguageLabel"]: @current.Label">
                    <svg class="lang-switch__globe" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.4" />
                        <ellipse cx="12" cy="12" rx="3.6" ry="8.5" fill="none" stroke="currentColor" stroke-width="1.4" />
                        <line x1="3.5" y1="12" x2="20.5" y2="12" stroke="currentColor" stroke-width="1.4" />
                    </svg>
                    <span class="lang-switch__code">@current.Short</span>
                    <svg class="lang-switch__chevron" viewBox="0 0 10 6" aria-hidden="true" focusable="false">
                        <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </summary>
                <div class="lang-switch__menu" role="menu">
                    @foreach (var lang in languages)
                    {
                        <a role="menuitem" class="@(lang.Code == current.Code ? "lang-switch__option active" : "lang-switch__option")" href="@CultureUrl(lang.Code)">
                            <span>@lang.Label</span>
                            @if (lang.Code == current.Code)
                            {
                                <svg viewBox="0 0 12 10" aria-hidden="true" focusable="false"><path d="M1 5l3.5 3.5L11 1" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                            }
                        </a>
                    }
                </div>
            </details>

            @if (isAuthenticated)
            {
                <details class="notif-bell">
                    <summary class="notif-bell__toggle" aria-label="@Loc["Notif.Title"]">
                        <svg class="notif-bell__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M12 3.5a5 5 0 0 0-5 5v3.2c0 .45-.14.9-.4 1.27L5 15.5h14l-1.6-2.53a2.3 2.3 0 0 1-.4-1.27V8.5a5 5 0 0 0-5-5Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
                            <path d="M9.5 18a2.5 2.5 0 0 0 5 0" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                        </svg>
                        @if (unreadCount > 0)
                        {
                            <span class="notif-bell__badge">@(unreadCount > 9 ? "9+" : unreadCount.ToString())</span>
                        }
                    </summary>
                    <div class="notif-bell__menu">
                        <div class="notif-bell__header">
                            <span>@Loc["Notif.Title"]</span>
                            @if (unreadCount > 0)
                            {
                                <form asp-controller="Account" asp-action="MarkAllNotificationsRead" method="post">
                                    <input type="hidden" name="returnUrl" value="@currentPath" />
                                    <button type="submit" class="notif-bell__mark-all">@Loc["Notif.MarkAllRead"]</button>
                                </form>
                            }
                        </div>
                        @if (recentNotifications.Count == 0)
                        {
                            <p class="notif-bell__empty">@Loc["Notif.Empty"]</p>
                        }
                        else
                        {
                            @foreach (var n in recentNotifications)
                            {
                                <a class="@(n.IsRead ? "notif-bell__item" : "notif-bell__item notif-bell__item--unread")" asp-controller="Account" asp-action="OpenNotification" asp-route-id="@n.Id">
                                    <span class="notif-bell__item-title">@n.Title</span>
                                    <span class="notif-bell__item-text">@n.Body</span>
                                </a>
                            }
                        }
                        <a class="notif-bell__view-all" asp-controller="Account" asp-action="Notifications">@Loc["Notif.ViewAll"]</a>
                    </div>
                </details>

                @if (isAmbassador)
                {
                    <a class="site-header__login" asp-controller="Ambassador" asp-action="Index">@Loc["Nav.AmbassadorDashboard"]</a>
                }
                <a class="site-header__login" asp-controller="Account" asp-action="Index">@Loc["Nav.MyAccount"]</a>
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post" class="site-header__logout-form">
                    <button type="submit" class="btn btn--primary site-header__cta">@Loc["Nav.LogOut"]</button>
                </form>
            }
            else
            {
                <a class="site-header__login" href="/Identity/Account/Login">@Loc["Nav.LogIn"]</a>
                <a class="btn btn--primary site-header__cta" href="/join">@Loc["Nav.ApplyToJoin"]</a>
            }
            <button type="button" class="site-header__burger" data-nav-burger aria-label="@Loc["Nav.OpenMenu"]" aria-expanded="false" aria-controls="mobile-nav">
                <span></span><span></span><span></span>
            </button>
        </div>
    </div>
</header>

<div class="site-mobile-nav" id="mobile-nav" data-nav-panel data-open="false">
    <nav aria-label="Mobile">
        <ul class="site-mobile-nav__list">
            <li><a class="@MobileNavLinkClass("Home")" asp-controller="Home" asp-action="Index" aria-current="@AriaCurrent("Home")">@Loc["Nav.Home"]</a></li>
            <li><a class="@MobileNavLinkClass("Experiences")" asp-controller="Experiences" asp-action="Index" aria-current="@AriaCurrent("Experiences")">@Loc["Nav.Experiences"]</a></li>
            <li><a class="@MobileNavLinkClass("Membership")" asp-controller="Membership" asp-action="Index" aria-current="@AriaCurrent("Membership")">@Loc["Nav.Membership"]</a></li>
            <li><a class="@MobileNavLinkClass("About")" asp-controller="About" asp-action="Index" aria-current="@AriaCurrent("About")">@Loc["Nav.About"]</a></li>
            <li><a class="@MobileNavLinkClass("Journal")" asp-controller="Journal" asp-action="Index" aria-current="@AriaCurrent("Journal")">@Loc["Nav.Journal"]</a></li>
            @if (isMember)
            {
                <li><a class="@MobileNavLinkClass("MemberDirectory")" asp-controller="MemberDirectory" asp-action="Index" aria-current="@AriaCurrent("MemberDirectory")">@Loc["Nav.Members"]</a></li>
            }
        </ul>
    </nav>

    <div class="site-mobile-nav__lang">
        <span class="site-mobile-nav__lang-label">@Loc["Nav.LanguageLabel"]</span>
        <div class="site-mobile-nav__lang-options">
            @foreach (var lang in languages)
            {
                <a class="@(lang.Code == current.Code ? "site-mobile-nav__lang-option active" : "site-mobile-nav__lang-option")" href="@CultureUrl(lang.Code)">
                    @lang.Short
                </a>
            }
        </div>
    </div>

    <div class="site-mobile-nav__actions">
        @if (isAuthenticated)
        {
            @if (isAmbassador)
            {
                <a class="btn btn--ghost-dark" asp-controller="Ambassador" asp-action="Index">@Loc["Nav.AmbassadorDashboard"]</a>
            }
            <a class="btn btn--primary" asp-controller="Account" asp-action="Index">@Loc["Nav.MyAccount"]</a>
            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                <button type="submit" class="btn btn--ghost-dark" style="width:100%;">@Loc["Nav.LogOut"]</button>
            </form>
        }
        else
        {
            <a class="btn btn--primary" href="/join">@Loc["Nav.ApplyToJoin"]</a>
            <a class="btn btn--ghost-dark" href="/Identity/Account/Login">@Loc["Nav.LogIn"]</a>
        }
    </div>
</div>

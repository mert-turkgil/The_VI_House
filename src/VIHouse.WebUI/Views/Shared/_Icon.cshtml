@model string
@*
    Inline SVG icons, rendered server-side.

    Chosen over an icon npm package (Lucide et al) deliberately: the whole site needs about eight
    glyphs, a JS-injected icon is invisible to anyone whose bundle fails, and _Crest.cshtml already
    establishes exactly this pattern. Cost here is 0 KB of JavaScript and it works with scripting
    off. The path data is drawn in Lucide's style at the 1.5 stroke weight the header already uses,
    so these sit with the existing hand-tuned nav icons rather than looking heavier than them.

    Every icon is aria-hidden. They are decorative without exception — anywhere one appears next to
    a control, that control carries its own accessible text. An icon that needs a label is a sign the
    surrounding markup is missing one.

    Usage:  <partial name="_Icon" model="check" />
*@

<svg class="icon icon--@Model" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
     aria-hidden="true" focusable="false">
    @switch (Model)
    {
        @* Social glyphs, drawn at the same stroke weight as the rest rather than dropped in as the
           brands' filled marks — a filled logo beside these reads as a foreign object, and the
           footer only needs to say "we are here", not reproduce anyone's trademark. *@
        case "instagram":
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" />
            break;

        case "linkedin":
            <path d="M4.5 9.5v10M4.5 5.5v.01" />
            <path d="M10 19.5v-10" />
            <path d="M10 13.5a4 4 0 0 1 8 0v6" />
            break;

        case "twitter":
            <path d="m4 4 7.5 9.5L4.5 20" />
            <path d="M20 4h-3.5L4 20h3.5" />
            <path d="M20 20 8.5 4" />
            break;

        case "youtube":
            <rect x="2.5" y="6" width="19" height="12" rx="4" />
            <path d="m10.5 9.75 5 2.25-5 2.25Z" />
            break;

        case "check":
            <path d="M20 6 9 17l-5-5" />
            break;

        case "layout-dashboard":
            <rect x="3" y="3" width="8" height="8" rx="2" />
            <rect x="13" y="3" width="8" height="5" rx="2" />
            <rect x="13" y="10" width="8" height="11" rx="2" />
            <rect x="3" y="13" width="8" height="8" rx="2" />
            break;

        case "file-text":
            <path d="M14 2H7a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7Z" />
            <path d="M14 2v5h5" />
            <path d="M9 13h6M9 17h6M9 9h2" />
            break;

        case "user-round":
            <circle cx="12" cy="8" r="4" />
            <path d="M5 20a7 7 0 0 1 14 0" />
            break;

        case "sparkles":
            <path d="m12 3 1.6 4.4L18 9l-4.4 1.6L12 15l-1.6-4.4L6 9l4.4-1.6Z" />
            <path d="M19 4v4M21 6h-4M5 16v4M7 18H3" />
            break;

        case "credit-card":
            <rect x="2.5" y="5" width="19" height="14" rx="2.5" />
            <path d="M2.5 10h19" />
            <path d="M7 15h3" />
            break;

        case "tag":
            <path d="m20 10-8.6 8.6a2 2 0 0 1-2.8 0L3 13V4h9l8 8a2 2 0 0 1 0 2.8Z" />
            <circle cx="8" cy="8" r="1" fill="currentColor" />
            break;

        case "megaphone":
            <path d="M3 11v2a1 1 0 0 0 1 1h2l3 5h2l-1.5-5H13l6 3V7l-6 3H4a1 1 0 0 0-1 1Z" />
            break;

        case "layers":
            <path d="m12 3 9 4.5-9 4.5-9-4.5Z" />
            <path d="m3 12 9 4.5 9-4.5" />
            <path d="m3 16.5 9 4.5 9-4.5" />
            break;

        case "pen-square":
            <path d="M11 4H5a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h13a2 2 0 0 0 2-2v-6" />
            <path d="m15 3 6 6" />
            <path d="m9 15 8.5-8.5a2.1 2.1 0 1 1 3 3L12 18l-4 1Z" />
            break;

        case "image":
            <rect x="3" y="4" width="18" height="16" rx="2" />
            <circle cx="8.5" cy="9" r="1.5" />
            <path d="m21 15-5-5L5 21" />
            break;

        case "book-open":
            <path d="M12 7a4 4 0 0 0-4-4H5a2 2 0 0 0-2 2v13a2 2 0 0 1 2-2h3a4 4 0 0 1 4 4" />
            <path d="M12 7a4 4 0 0 1 4-4h3a2 2 0 0 1 2 2v13a2 2 0 0 0-2-2h-3a4 4 0 0 0-4 4" />
            break;

        case "messages-square":
            <path d="M7 17 3 21V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2Z" />
            <path d="M8 8h8M8 12h5" />
            break;

        case "mail":
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="m4 7 8 6 8-6" />
            break;

        case "bell":
            <path d="M15 17H5a2 2 0 0 1-2-2c0-1.7 1-3.4 2.7-4.2V8a6.3 6.3 0 1 1 12.6 0v2.8c1.7.8 2.7 2.5 2.7 4.2a2 2 0 0 1-2 2h-4" />
            <path d="M9 21a3 3 0 0 0 6 0" />
            break;

        case "languages":
            <path d="M4 5h7M7.5 5c0 6-3 11-5.5 13" />
            <path d="M4 12c1.6 2 3.7 3.8 6 5" />
            <path d="M14 7h6" />
            <path d="m17 7-3 10" />
            <path d="m20 17-3-10-3 10" />
            break;

        case "settings":
            <circle cx="12" cy="12" r="3" />
            <path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.2a1.7 1.7 0 0 0-1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.2a1.7 1.7 0 0 0 1.5-1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3h.1a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.2a1.7 1.7 0 0 0 1 1.5h.1a1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8v.1a1.7 1.7 0 0 0 1.5 1.1H21a2 2 0 1 1 0 4h-.2a1.7 1.7 0 0 0-1.4.9Z" />
            break;

        case "search":
            <circle cx="11" cy="11" r="7" />
            <path d="m21 21-4.3-4.3" />
            break;

        case "panel-left-close":
            <rect x="3" y="4" width="18" height="16" rx="2" />
            <path d="M9 4v16" />
            <path d="m15 9-3 3 3 3" />
            break;

        case "panel-left-open":
            <rect x="3" y="4" width="18" height="16" rx="2" />
            <path d="M9 4v16" />
            <path d="m12 9 3 3-3 3" />
            break;

        case "arrow-up-right":
            <path d="M7 17 17 7" />
            <path d="M8 7h9v9" />
            break;

        case "x":
            <path d="M18 6 6 18M6 6l12 12" />
            break;

        case "chevron-down":
            <path d="m6 9 6 6 6-6" />
            break;

        case "map-pin":
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
            <circle cx="12" cy="10" r="3" />
            break;

        case "calendar":
            <rect x="3" y="4" width="18" height="18" rx="2" />
            <path d="M16 2v4M8 2v4M3 10h18" />
            break;

        case "clock":
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7v5l3 2" />
            break;

        case "users":
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
            <circle cx="9" cy="7" r="4" />
            <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
            break;

        case "ticket":
            <path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z" />
            <path d="M13 5v14" stroke-dasharray="2 3" />
            break;

        default:
            @* An unknown name renders nothing rather than a broken glyph — a missing decorative icon
               is invisible, which is the right failure for something with no semantic role. *@
            break;
    }
</svg>

@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Options
@model (string PasswordId, string? ConfirmId)
@inject IOptions<IdentityOptions> IdentityOptions
@*
    The password rules as a live checklist under a new-password field. modules/passwordRules.ts ticks
    each one as it is met, and turns the unmet ones red when the form is submitted, so a rule and its
    error appear in the same place.

    The list is built from IdentityOptions, the same object the server checks against
    (Program.cs, AddIdentity), so the two cannot drift: change the policy there and this list follows.
    The server stays the authority; this only says in advance what it will ask for.

    Model: the id of the new-password input, and of its confirmation input when there is one.
*@
@{
    var policy = IdentityOptions.Value.Password;
    var rules = new List<(string Rule, string Text)> { ("length", Loc["Auth.Rules.Length", policy.RequiredLength].Value) };
    if (policy.RequireUppercase) rules.Add(("upper", Loc["Auth.Rules.Upper"].Value));
    if (policy.RequireLowercase) rules.Add(("lower", Loc["Auth.Rules.Lower"].Value));
    if (policy.RequireDigit) rules.Add(("digit", Loc["Auth.Rules.Digit"].Value));
    if (policy.RequireNonAlphanumeric) rules.Add(("symbol", Loc["Auth.Rules.Symbol"].Value));
    if (Model.ConfirmId is not null) rules.Add(("match", Loc["Auth.Rules.Match"].Value));
}
<div class="password-rules" id="@(Model.PasswordId)-rules" data-password-rules
     data-for="@Model.PasswordId" data-confirm="@Model.ConfirmId" data-min="@policy.RequiredLength"
     data-met="@Loc["Auth.Rules.Met"]" data-unmet="@Loc["Auth.Rules.Unmet"]">
    <p class="password-rules__title">@Loc["Auth.Rules.Title"]</p>
    <ul class="password-rules__list">
        @foreach (var (rule, text) in rules)
        {
            <li class="password-rules__item" data-rule="@rule">
                <span class="password-rules__mark" aria-hidden="true">
                    <svg viewBox="0 0 16 16"><path d="M3.5 8.5l3 3 6-7" pathLength="1" /></svg>
                </span>
                <span class="password-rules__text">@text</span>
                <span class="visually-hidden" data-rule-state>@Loc["Auth.Rules.Unmet"]</span>
            </li>
        }
    </ul>
</div>

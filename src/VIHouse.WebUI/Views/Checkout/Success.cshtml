@model CheckoutSuccessViewModel
@{
    ViewData["Title"] = Model.Info.IsConfirmed ? "Booking Confirmed" : "Processing Payment";
}

@if (!Model.Info.IsConfirmed && !Model.Info.AwaitingBank && !Model.Info.RequiresAction)
{
    @section Styles {
        <meta http-equiv="refresh" content="3" />
    }
}

<div class="apply-confirmation">
    <div class="container apply-confirmation__inner">
        @if (Model.Info.IsConfirmed)
        {
            <span class="apply-confirmation__mark">&#10003;</span>
            <h1>Booking Confirmed</h1>
            <p>
                You're in — <strong>@Model.Info.ExperienceTitle</strong> in @Model.Info.ExperienceCity.
                Your booking reference is <strong>@Model.Info.BookingReference</strong>.
            </p>
            <p>
                Your confirmation is on its way to your inbox. If this is your first booking, a second
                email, “@Loc["Email.WelcomeSetup.Subject"]”, carries the link to choose your password &mdash;
                you'll need it to open your ticket.
            </p>
            <div class="apply-confirmation__actions">
                <a class="btn btn--primary" href="/">Back to Home</a>
            </div>
        }
        else if (Model.Info.RequiresAction)
        {
            <span class="apply-confirmation__mark">&hellip;</span>
            <h1>Your Bank Needs A Confirmation</h1>
            <p>
                Your bank has asked you to confirm this payment before it goes through — look for its message or app
                prompt. Your place is held while you do. We'll email your confirmation as soon as the payment clears.
            </p>
            <div class="apply-confirmation__actions">
                <a class="btn btn--primary" href="/">Back to Home</a>
            </div>
        }
        else if (Model.Info.AwaitingBank)
        {
            <span class="apply-confirmation__mark">&hellip;</span>
            <h1>Payment In Progress</h1>
            <p>
                Your checkout is complete and your bank is confirming the payment — with the method you chose
                this can take a few days. Your place is held in the meantime, and we'll email your confirmation
                the moment the money lands. Nothing further is needed from you.
            </p>
            <div class="apply-confirmation__actions">
                <a class="btn btn--primary" href="/">Back to Home</a>
            </div>
        }
        else
        {
            <span class="apply-confirmation__mark">&hellip;</span>
            <h1>Confirming Your Payment</h1>
            <p>This usually takes just a few seconds. This page will refresh automatically.</p>
        }
    </div>
</div>

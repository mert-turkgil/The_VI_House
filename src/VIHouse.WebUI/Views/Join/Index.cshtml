@using VIHouse.Entities.Membership
@model JoinFormViewModel
@{
    string PeriodLabel(MembershipBillingPeriod period) => period switch
    {
        MembershipBillingPeriod.Monthly => Loc["Membership.PerMonth"].Value,
        MembershipBillingPeriod.Annual => Loc["Membership.PerYear"].Value,
        _ => Loc["Membership.OneTime"].Value,
    };
}

<div class="join">
    <div class="container join__inner">
        <span class="join__eyebrow">@Loc["Nav.Membership"]</span>
        <h1>@Loc["Join.Heading"]</h1>
        <p class="join__lede">@Loc["Join.Lede"]</p>

        @* The two routes differ in more than price — one completes now, the other is reviewed by
           hand — so the choice is stated up front rather than discovered halfway through. *@
        <div class="join__routes" role="group" aria-label="@Loc["Join.Routes.Label"]">
            <div class="join__route join__route--active">
                <span class="join__route-tag">@Loc["Nav.Membership"]</span>
                <p>@Loc["Join.Route.Membership"]</p>
            </div>
            <a class="join__route" href="#single-event">
                <span class="join__route-tag">@Loc["Join.Route.Single.Tag"]</span>
                <p>@Loc["Join.Route.Single"]</p>
            </a>
        </div>

        <div asp-validation-summary="ModelOnly" class="join__error" role="alert"></div>

        @{
            var preselected = Model.Plans.FirstOrDefault(p => p.Id == Model.PlanId);
        }
        @if (preselected is not null)
        {
            @* Arriving from a plan card on /membership. Confirming the choice here means the visitor
               can see it carried over instead of wondering whether the click registered. *@
            <div class="join__preselected" role="status">
                <strong>@preselected.Name</strong> @Loc["Join.Preselected"]
            </div>
        }

        <form asp-action="Index" method="post" class="join__form" novalidate>
            <input type="hidden" asp-for="ReferralCode" />

            <fieldset class="join__plans">
                <legend>@Loc["Join.ChoosePlan"]</legend>
                <span asp-validation-for="PlanId" class="join__field-error"></span>

                @if (Model.Plans.Count == 0)
                {
                    <p class="join__empty">@Loc["Join.NoPlans"]</p>
                }

                @foreach (var plan in Model.Plans)
                {
                    <label class="join__plan">
                        <input type="radio" asp-for="PlanId" value="@plan.Id" />
                        <span class="join__plan-body">
                            <span class="join__plan-name">@plan.Name</span>
                            <span class="join__plan-price">
                                @MoneyFormatter.Format(plan.PriceMinor, plan.Currency)
                                <em>@PeriodLabel(plan.BillingPeriod)</em>
                            </span>
                            @if (!string.IsNullOrWhiteSpace(plan.Description))
                            {
                                <span class="join__plan-desc">@plan.Description</span>
                            }
                            @if (plan.BillingPeriod != MembershipBillingPeriod.OneTime)
                            {
                                <span class="join__plan-note">@Loc["Join.RenewsNote"]</span>
                            }
                        </span>
                    </label>
                }
            </fieldset>

            <fieldset class="join__details">
                <legend>@Loc["Form.Section.You"]</legend>

                <div class="join__row">
                    <div class="join__field">
                        <label asp-for="FirstName">@Loc["Form.FirstName"]</label>
                        <input asp-for="FirstName" autocomplete="given-name" />
                        <span asp-validation-for="FirstName" class="join__field-error"></span>
                    </div>
                    <div class="join__field">
                        <label asp-for="LastName">@Loc["Form.LastName"]</label>
                        <input asp-for="LastName" autocomplete="family-name" />
                        <span asp-validation-for="LastName" class="join__field-error"></span>
                    </div>
                </div>

                <div class="join__row">
                    <div class="join__field">
                        <label asp-for="Email">@Loc["Form.Email"]</label>
                        <input asp-for="Email" type="email" autocomplete="email" />
                        <span class="join__hint">@Loc["Join.EmailHint"]</span>
                        <span asp-validation-for="Email" class="join__field-error"></span>
                    </div>
                    <div class="join__field">
                        <label asp-for="JobTitle">@Loc["Form.JobTitle"]</label>
                        <input asp-for="JobTitle" autocomplete="organization-title" placeholder="@Loc["Form.JobTitle.Placeholder"]" />
                        <span asp-validation-for="JobTitle" class="join__field-error"></span>
                    </div>
                </div>
            </fieldset>

            <fieldset class="join__details">
                <legend>@Loc["Form.Section.Address"]</legend>

                <div class="join__row">
                    <div class="join__field">
                        <label asp-for="AddressLine1">@Loc["Form.AddressLine1"]</label>
                        <input asp-for="AddressLine1" autocomplete="address-line1" />
                        <span asp-validation-for="AddressLine1" class="join__field-error"></span>
                    </div>
                    <div class="join__field">
                        <label asp-for="AddressLine2">@Loc["Form.AddressLine2"]</label>
                        <input asp-for="AddressLine2" autocomplete="address-line2" />
                        <span asp-validation-for="AddressLine2" class="join__field-error"></span>
                    </div>
                </div>

                <div class="join__row">
                    <div class="join__field">
                        <label asp-for="PostalCode">@Loc["Form.PostalCode"]</label>
                        <input asp-for="PostalCode" autocomplete="postal-code" />
                        <span asp-validation-for="PostalCode" class="join__field-error"></span>
                    </div>
                    <div class="join__field">
                        <label asp-for="City">@Loc["Form.City"]</label>
                        <input asp-for="City" autocomplete="address-level2" />
                        <span asp-validation-for="City" class="join__field-error"></span>
                    </div>
                </div>

                <div class="join__field">
                    <label asp-for="Country">@Loc["Form.Country"]</label>
                    <select asp-for="Country" asp-items='@Countries.SelectList(Model.Country, Loc["Form.ChooseCountry"].Value)' autocomplete="country"></select>
                    <span asp-validation-for="Country" class="join__field-error"></span>
                </div>
            </fieldset>

            <fieldset class="join__details">
                <legend>@Loc["Form.Section.About"]</legend>

                <div class="join__field">
                    <label asp-for="About">@Loc["Form.About"] <span class="join__required" aria-hidden="true">*</span></label>
                    <textarea asp-for="About" rows="4" placeholder="@Loc["Form.About.Placeholder"]" required></textarea>
                    <span asp-validation-for="About" class="join__field-error"></span>
                </div>

                <div class="join__field">
                    <label asp-for="Expectations">@Loc["Form.Expectations"] <span class="join__required" aria-hidden="true">*</span></label>
                    <textarea asp-for="Expectations" rows="4" placeholder="@Loc["Form.Expectations.Placeholder"]" required></textarea>
                    <span asp-validation-for="Expectations" class="join__field-error"></span>
                </div>

                <div class="join__row">
                    <div class="join__field">
                        <label asp-for="EarningsBand">@Loc["Form.EarningsBand"]</label>
                        <select asp-for="EarningsBand">
                            <option value="">@Loc["Form.EarningsBand.Choose"]</option>
                            @foreach (var band in EarningsBand.All)
                            {
                                <option value="@band.Code" selected="@(band.Code == Model.EarningsBand)">@band.Label</option>
                            }
                        </select>
                        <span class="join__hint">@Loc["Form.EarningsBand.Hint"]</span>
                        <span asp-validation-for="EarningsBand" class="join__field-error"></span>
                    </div>
                </div>
            </fieldset>

            @* The text is wrapped in one span on purpose: the label is a flex row, and bare text
               nodes beside the anchors each became their own flex item — which is how "I agree to
               the / Terms & Conditions / and / Privacy Policy" ended up spread across the width. *@
            <div class="join__consent">
                <label>
                    <input asp-for="AgreeToTerms" />
                    <span>@Loc["Form.AgreePrefix"] <a href="/legal/terms" target="_blank" rel="noopener">@Loc["Form.Terms"]</a> @Loc["Form.And"] <a href="/legal/privacy" target="_blank" rel="noopener">@Loc["Form.Privacy"]</a>.</span>
                </label>
                <span asp-validation-for="AgreeToTerms" class="join__field-error"></span>
            </div>

            <button type="submit" class="btn btn--primary join__submit">@Loc["Join.Submit"]</button>
            <p class="join__secure">@Loc["Join.Secure"]</p>
        </form>

        <section class="join__single" id="single-event">
            <span class="join__eyebrow">@Loc["Join.Route.Single.Tag"]</span>
            <h2>@Loc["Join.Single.Heading"]</h2>
            <p class="join__single-lede">@Loc["Join.Single.Lede"]</p>

            @if (Model.OpenExperiences.Count == 0)
            {
                <p class="join__empty">
                    @Loc["Join.Single.None"]
                    <a href="/experiences">@Loc["Join.Single.SeeUpcoming"]</a>.
                </p>
            }
            else
            {
                <ul class="join__experiences">
                    @foreach (var exp in Model.OpenExperiences)
                    {
                        <li class="join__experience">
                            <div class="join__experience-body">
                                <span class="join__experience-date">
                                    @exp.StartAtUtc.ToString("d MMM")&ndash;@exp.EndAtUtc.ToString("d MMM yyyy")
                                </span>
                                <h3>The VI House &mdash; @exp.City</h3>
                                <span class="join__experience-meta">
                                    @exp.City, @Countries.NameFor(exp.Country)
                                    @if (exp.FromPriceMinor is not null)
                                    {
                                        <text>&middot; @Loc["Join.From"] @MoneyFormatter.Format(exp.FromPriceMinor.Value, exp.Currency!)</text>
                                    }
                                </span>
                            </div>
                            @* Carries the chosen experience through to the application form, so the
                               visitor never has to pick it a second time. *@
                            <a class="btn btn--ghost" href="/apply?experience=@exp.Slug">@Loc["Join.ApplyForThis"]</a>
                        </li>
                    }
                </ul>
            }
        </section>

        <p class="join__alt">
            @Loc["Join.AlreadyHaveAccount"] <a asp-area="Identity" asp-page="/Account/Login">@Loc["Nav.LogIn"]</a>.
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

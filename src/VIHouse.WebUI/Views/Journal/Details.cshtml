@model JournalPostDetailViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="content-hero">
    <div class="container">
        <span class="content-hero__eyebrow">@Model.CategoryLabel</span>
        <h1>@Model.Title</h1>
        <div class="journal-article__meta">
            @if (Model.PublishedAt is not null)
            {
                <span>@Model.PublishedAt.Value.ToString("d MMMM yyyy")</span>
            }
            @if (!string.IsNullOrWhiteSpace(Model.AuthorName))
            {
                <span>@Model.AuthorName</span>
            }
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.CoverImageUrl))
{
    @* Eager + full width: this is the article's lead image, above the fold on most screens, so it
       should not be lazy-loaded. Decorative — the headline above it already carries the meaning. *@
    <div class="journal-article__cover">
        <partial name="_CoverImage" model="@(new CoverImageViewModel {
            Url = Model.CoverImageUrl,
            Alt = Model.CoverImageAlt,
            Ratio = "21x9",
            Sizes = "100vw",
            Eager = true,
        })" />
    </div>
}

@* Sanitised on write by JournalService (see EditorHtml), so the stored HTML is already safe. Video
   markers were turned into click-to-play facades on the way here by ArticleHtml — the player itself
   is built in the browser by modules/video.ts, only once a reader asks for it. *@
<div class="container content-body journal-article__body">
    @Html.Raw(Model.BodyHtml)
</div>

<div class="container journal-article__back">
    <a href="/journal">&larr; Back to The Journal</a>
</div>

@model JournalPostDetailViewModel
@{
    ViewData["Title"] = Model.Title;
}

@{
    var hasCover = !string.IsNullOrEmpty(Model.CoverImageUrl);
}

@* Editorial header: where the story sits (Journal / category), the headline, the standfirst and a
   meta row, on the brand green. With a cover, the photograph is a contained frame that straddles
   the bottom edge of the band, rather than a full-bleed banner whose height grew with the screen. *@
<header class="article-hero @(hasCover ? "article-hero--with-cover" : "")">
    <div class="container article-hero__inner">
        <nav class="article-hero__crumbs" aria-label="@Loc["Journal.Breadcrumb"]">
            <a asp-area="" asp-controller="Journal" asp-action="Index">@Loc["Journal.Heading"]</a>
            <span aria-hidden="true">/</span>
            <a asp-area="" asp-controller="Journal" asp-action="Index" asp-route-category="@Model.Category">@Loc[$"Journal.Category.{Model.Category}"]</a>
        </nav>

        <h1 class="article-hero__title">@Model.Title</h1>

        @if (Model.Excerpt is not null)
        {
            <p class="article-hero__lede">@Model.Excerpt</p>
        }

        <div class="article-hero__meta">
            @if (!string.IsNullOrWhiteSpace(Model.AuthorName))
            {
                <span class="article-hero__author">
                    <span class="article-hero__mark" aria-hidden="true"><partial name="_Crest" /></span>
                    @Model.AuthorName
                </span>
            }
            @if (Model.PublishedAt is not null)
            {
                <time datetime="@Model.PublishedAt.Value.ToString("yyyy-MM-dd")">@Model.PublishedAt.Value.ToString("d MMMM yyyy")</time>
            }
            <span>@Loc["Journal.ReadingTime", Model.ReadingMinutes]</span>
        </div>
    </div>
</header>

@if (hasCover)
{
    @* Eager: the article's lead image, above the fold on most screens. Decorative — the headline
       above it already carries the meaning. *@
    <div class="container article-cover">
        <partial name="_CoverImage" model="@(new CoverImageViewModel {
            Url = Model.CoverImageUrl,
            Alt = Model.CoverImageAlt,
            Ratio = "16x9",
            Sizes = "(min-width: 1120px) 1040px, calc(100vw - 32px)",
            Eager = true,
        })" />
    </div>
}

@* Sanitised on write by JournalService (see EditorHtml), so the stored HTML is already safe. Video
   markers were turned into click-to-play facades on the way here by ArticleHtml — the player itself
   is built in the browser by modules/video.ts, only once a reader asks for it. *@
<div class="container content-body rich-content journal-article__body">
    @Html.Raw(Model.BodyHtml)
</div>

@if (Model.Gallery.Count > 0)
{
    var total = Model.Gallery.Count;

    @* The photographs from the post's media library, in the order the admin arranged them.
       modules/carousel.ts makes the track a slider (arrows and progress bar in the header, hidden
       while everything fits); modules/lightbox.ts opens any photograph full size. Without script the
       track is a wrapped row of the same figures, and each opens the file itself. *@
    <section class="journal-gallery" aria-labelledby="journal-gallery-title" data-swiper-scope data-lightbox-scope>
        <div class="container">
            <header class="journal-gallery__head">
                <div>
                    <span class="journal-gallery__eyebrow">@Loc["Journal.Gallery.Eyebrow"]</span>
                    <h2 id="journal-gallery-title" class="journal-gallery__title">@Loc["Journal.Gallery.Title"]</h2>
                    <p class="journal-gallery__count">@Loc[total == 1 ? "Journal.Gallery.CountOne" : "Journal.Gallery.Count", total]</p>
                </div>
                <partial name="~/Views/Home/_CarouselControls.cshtml" model="@((Loc["Journal.Gallery.Prev"].Value, Loc["Journal.Gallery.Next"].Value))" />
            </header>

            <div class="swiper journal-gallery__track" data-swiper data-swiper-per-view="3"
                 data-swiper-prev-label="@Loc["Journal.Gallery.Prev"]" data-swiper-next-label="@Loc["Journal.Gallery.Next"]">
                <div class="swiper-wrapper">
                    @for (var i = 0; i < total; i++)
                    {
                        var photo = Model.Gallery[i];
                        var number = (i + 1).ToString("00");
                        <div class="swiper-slide">
                            <figure class="journal-gallery__item">
                                <a class="journal-gallery__open" href="@photo.Url" target="_blank" rel="noopener"
                                   data-lightbox-item data-lightbox-caption="@photo.Caption"
                                   aria-label="@Loc["Journal.Gallery.Open", i + 1, total]">
                                    @* The caption is the alt text: it is what the photograph shows, in
                                       the reader's language. No caption means nothing to add. *@
                                    <img class="journal-gallery__img" src="@photo.Url" alt="@(photo.Caption ?? string.Empty)"
                                         width="1200" height="900" loading="lazy" decoding="async" />
                                    <span class="journal-gallery__index" aria-hidden="true">@number<small>/@total.ToString("00")</small></span>
                                    <span class="journal-gallery__zoom" aria-hidden="true">
                                        <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5" /><path d="M16 16l4.5 4.5M11 8.5v5M8.5 11h5" /></svg>
                                    </span>
                                </a>
                                @if (!string.IsNullOrWhiteSpace(photo.Caption))
                                {
                                    <figcaption class="journal-gallery__caption">@photo.Caption</figcaption>
                                }
                            </figure>
                        </div>
                    }
                </div>
            </div>
        </div>

        <partial name="_Lightbox" model="@((Loc["Journal.Gallery.Title"].Value, total > 1))" />
    </section>
}

@if (Model.Author is { } author)
{
    <aside class="container" aria-labelledby="author-box-name">
        <div class="author-box">
            @if (author.PhotoUrl is not null)
            {
                <img class="author-box__photo" src="@author.PhotoUrl" alt="" width="88" height="88" loading="lazy" />
            }
            <div>
                <p class="author-box__eyebrow">@Loc["Journal.Author.Eyebrow"]</p>
                <h2 class="author-box__name" id="author-box-name">@author.Name</h2>
                @if (author.Niche is not null)
                {
                    <p class="author-box__eyebrow" style="text-transform:none; letter-spacing:0;">@author.Niche</p>
                }
                @if (author.Bio is not null)
                {
                    <p class="author-box__bio">@author.Bio</p>
                }
                @if (author.Channels.Count > 0)
                {
                    <ul class="author-box__channels">
                        @foreach (var channel in author.Channels)
                        {
                            <li><a href="@channel.Url" target="_blank" rel="noopener noreferrer nofollow">@Loc.Label(channel.Platform) · @SocialLinks.Handle(channel.Url)</a></li>
                        }
                    </ul>
                }
                @if (author.JoinUrl is not null)
                {
                    @* Through their own link, so a reader who joins counts toward their earnings. *@
                    <a class="btn btn--primary" href="@author.JoinUrl">@Loc["Journal.Author.JoinVia", author.Name]</a>
                }
            </div>
        </div>
    </aside>
}

<div class="container journal-article__back">
    <a asp-area="" asp-controller="Journal" asp-action="Index">&larr; @Loc["Journal.Back"]</a>
</div>

@model List<JournalPostCardViewModel>
@{
    ViewData["Title"] = Loc["Journal.Heading"].Value;
    var activeCategory = Context.Request.Query["category"].ToString();
    var filtered = !string.IsNullOrEmpty(activeCategory);
}

<div class="journal-header">
    <h1>@Loc["Journal.Heading"]</h1>
    <p>@Loc["Journal.Lede"]</p>
</div>

<div class="container">
    <div class="journal-filter">
        <a class="@(filtered ? "journal-filter__link" : "journal-filter__link active")" asp-area="" asp-controller="Journal" asp-action="Index">@Loc["Journal.Filter.All"]</a>
        @foreach (var cat in Enum.GetValues<JournalCategory>())
        {
            <a class="@(activeCategory == cat.ToString() ? "journal-filter__link active" : "journal-filter__link")" asp-area="" asp-controller="Journal" asp-action="Index" asp-route-category="@cat">@Loc[$"Journal.Category.{cat}"]</a>
        }
    </div>

    @if (Model.Count == 0 && !filtered)
    {
        @* Nothing published yet: the same designed empty section as Experiences and Sessions. *@
        <partial name="_EmptyStage" model="@(new VIHouse.WebUI.ViewModels.Shared.EmptyStageViewModel("journal"))" />
    }
    else if (Model.Count == 0)
    {
        <div class="experience-empty">
            <span class="experience-empty__mark" aria-hidden="true"><partial name="_Crest" /></span>
            <h2 class="experience-empty__title">@Loc["Journal.EmptyCategory.Title"]</h2>
            <p class="experience-empty__body">@Loc["Journal.EmptyCategory.Body"]</p>
            <a class="btn btn--ghost" asp-area="" asp-controller="Journal" asp-action="Index">@Loc["Journal.Filter.AllStories"]</a>
        </div>
    }
    else
    {
        <div class="journal-grid">
            @foreach (var post in Model)
            {
                <a class="journal-card" asp-area="" asp-controller="Journal" asp-action="Details" asp-route-slug="@post.Slug">
                    <div class="journal-card__image">
                        <partial name="_CoverImage" model="@(new CoverImageViewModel {
                            Url = post.CoverImageUrl,
                            Ratio = "4x3",
                            Sizes = "(min-width: 960px) 33vw, (min-width: 560px) 50vw, 100vw",
                        })" />
                        <span class="journal-card__badge">@Loc[$"Journal.Category.{post.Category}"]</span>
                    </div>
                    <div class="journal-card__body">
                        <h3 class="journal-card__title">@post.Title</h3>
                        @if (!string.IsNullOrWhiteSpace(post.Excerpt))
                        {
                            <p class="journal-card__excerpt">@post.Excerpt</p>
                        }
                        <div class="journal-card__meta">
                            @if (post.PublishedAt is not null)
                            {
                                <span>@post.PublishedAt.Value.ToString("d MMMM yyyy")</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(post.AuthorName))
                            {
                                <span>@post.AuthorName</span>
                            }
                        </div>
                    </div>
                </a>
            }
        </div>
    }
</div>

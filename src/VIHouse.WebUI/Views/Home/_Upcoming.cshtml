@model List<ExperienceCardViewModel>

@if (Model.Count > 0)
{
    <section class="home-section" data-reveal>
        <div class="container home-section__header">
            <h2>Upcoming Experiences</h2>
            <a class="home-section__viewall" href="/experiences">View All Experiences &rarr;</a>
        </div>
        <div class="container">
            <div class="swiper home-carousel" data-swiper data-swiper-per-view="4">
                <div class="swiper-wrapper">
                    @foreach (var e in Model)
                    {
                        <div class="swiper-slide">
                            <a class="home-upcoming__card" href="/experiences/@e.Slug">
                                <div class="home-upcoming__image">
                                    @* Decorative: the card's own heading names the experience, so a
                                       described image would just repeat it to a screen reader. *@
                                    <partial name="_CoverImage" model="@(new CoverImageViewModel {
                                        Url = e.CoverImageUrl,
                                        Ratio = "4x3",
                                        Sizes = "(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw",
                                    })" />
                                    <span class="home-upcoming__badge">@Loc[e.StatusKey]</span>
                                </div>
                                <div class="home-upcoming__body">
                                    <span class="home-upcoming__date">@e.StartAtUtc.ToString("d MMM")–@e.EndAtUtc.ToString("d MMM yyyy")</span>
                                    <h3>The VI House — @e.City</h3>
                                    <span class="home-upcoming__meta">@e.City, @e.Country</span>
                                </div>
                            </a>
                        </div>
                    }
                </div>
                <div class="swiper-button-prev"></div>
                <div class="swiper-button-next"></div>
                <div class="swiper-pagination"></div>
            </div>
        </div>
    </section>
}

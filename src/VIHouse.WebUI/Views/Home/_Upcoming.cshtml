@model List<ExperienceCardViewModel>
@{
    // The carousel shows 4 across at desktop width (data-swiper-per-view below), and it earns its
    // keep at that count or above: even a set that fits desktop exactly (4) is still worth
    // swiping through on a phone, where Swiper only ever shows ~1.1 at a time regardless of the
    // total. Below 4, though, there is nothing left to scroll on ANY screen size — Swiper would
    // still lay the cards out left-aligned in a track sized for 4, leaving a lone card stranded
    // with a dead gap beside it. Below that count there's no reason to pay for the carousel at
    // all: a plain grid that centers and sizes itself to however many cards actually exist looks
    // intentional, including at one.
    const int perView = 4;
    var useCarousel = Model.Count >= perView;
}

@if (Model.Count > 0)
{
    <section class="home-section" data-reveal>
        <div class="container home-section__header">
            <h2>@Loc["Home.Upcoming.Heading"]</h2>
            <a class="home-section__viewall" href="/experiences">@Loc["Home.ViewAll"] &rarr;</a>
        </div>
        <div class="container">
            @if (useCarousel)
            {
                <div class="swiper home-carousel" data-swiper data-swiper-per-view="@perView">
                    <div class="swiper-wrapper">
                        @foreach (var e in Model)
                        {
                            <div class="swiper-slide">
                                <partial name="_UpcomingCard" model="e" />
                            </div>
                        }
                    </div>
                    <div class="swiper-button-prev"></div>
                    <div class="swiper-button-next"></div>
                    <div class="swiper-pagination"></div>
                </div>
            }
            else
            {
                <div class="home-upcoming__grid">
                    @foreach (var e in Model)
                    {
                        <partial name="_UpcomingCard" model="e" />
                    }
                </div>
            }
        </div>
    </section>
}

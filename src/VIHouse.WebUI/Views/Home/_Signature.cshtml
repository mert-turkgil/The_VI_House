@model List<ExperienceCardViewModel>

@if (Model.Count > 0)
{
    <section class="home-section home-section--tinted">
        <div class="container home-section__header">
            <h2>Signature Experiences</h2>
            <a class="home-section__viewall" href="/experiences">View All Experiences &rarr;</a>
        </div>
        <div class="container home-signature__grid">
            @foreach (var e in Model)
            {
                <a class="home-signature__card" href="/experiences/@e.Slug">
                    <div class="home-signature__image" style="@(string.IsNullOrEmpty(e.CoverImageUrl) ? "" : $"background-image:url('{e.CoverImageUrl}')")">
                        <span class="home-signature__badge">Signature</span>
                    </div>
                    <div class="home-signature__body">
                        <h3>The VI House — @e.City</h3>
                        <span class="home-signature__meta">@e.City, @e.Country &middot; @e.DurationDays Days</span>
                        @if (e.FromPriceMinor is not null)
                        {
                            <span class="home-signature__price">From @MoneyFormatter.Format(e.FromPriceMinor.Value, e.Currency!)</span>
                        }
                    </div>
                </a>
            }
        </div>
    </section>
}

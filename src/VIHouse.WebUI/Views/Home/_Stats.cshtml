@model List<StatItem>

@if (Model.Count > 0)
{
    <section class="home-stats" data-reveal>
        <div class="container home-stats__row">
            @foreach (var stat in Model)
            {
                <div class="home-stats__item">
                    @* data-count-up animates the numeric part of the CMS-authored value on first
                       scroll into view; a non-numeric value (e.g. a placeholder dash) is left as-is. *@
                    <span class="home-stats__value" data-count-up>@stat.Value</span>
                    <span class="home-stats__label">@stat.Label</span>
                </div>
            }
        </div>
    </section>
}

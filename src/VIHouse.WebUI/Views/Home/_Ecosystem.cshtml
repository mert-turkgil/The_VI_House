@model EcosystemContent
@using VIHouse.WebUI.ViewModels.Shared

@if (!string.IsNullOrWhiteSpace(Model.Heading) || Model.Pillars.Count > 0)
{
    <section class="home-ecosystem" data-reveal>
        <div class="container home-ecosystem__inner">
            <div class="home-ecosystem__intro">
                <p class="home-ecosystem__eyebrow">The VI House Ecosystem</p>
                @if (!string.IsNullOrWhiteSpace(Model.Heading))
                {
                    <h2>@Model.Heading</h2>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Body))
                {
                    <p>@Model.Body</p>
                }
                @if (!string.IsNullOrWhiteSpace(Model.CtaLabel) && !string.IsNullOrWhiteSpace(Model.CtaUrl))
                {
                    <a class="btn btn--ghost-dark" href="@Model.CtaUrl">@Model.CtaLabel</a>
                }
            </div>

            @if (Model.Pillars.Count > 0)
            {
                <div class="home-ecosystem__grid">
                    @{ var pillarIndex = 0; }
                    @foreach (var pillar in Model.Pillars)
                    {
                        <article class="home-ecosystem__card" data-reveal data-reveal-delay="@(pillarIndex++ * 90)">
                            @* The photograph sits above the title that names the card, so it is decorative
                               unless the block author wrote alt text that says something the title does not. *@
                            <partial name="_CoverImage" model="@(new CoverImageViewModel
                                                                {
                                                                    Url = pillar.ImageUrl,
                                                                    Alt = pillar.ImageAlt,
                                                                    Ratio = "4x3",
                                                                    Sizes = "(min-width: 1100px) 22vw, (min-width: 560px) 44vw, 88vw",
                                                                })" />
                            <div class="home-ecosystem__card-body">
                                <h3>@pillar.Title</h3>
                                <p>@pillar.Description</p>
                                @if (!string.IsNullOrWhiteSpace(pillar.LinkLabel) && !string.IsNullOrWhiteSpace(pillar.LinkUrl))
                                {
                                    <a class="home-ecosystem__link" href="@pillar.LinkUrl">
                                        @pillar.LinkLabel
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                            <path d="M4 12h15M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
                                        </svg>
                                    </a>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
        </div>
    </section>
}

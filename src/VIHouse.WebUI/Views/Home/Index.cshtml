@model HomeViewModel
@{
    @* No ViewData["Title"]. The homepage title comes from Site & SEO (or, until that is filled
       in, from the Seo.Home.Title resource) — see HomeController. Setting it here produced
       "Home | The VI House", which spends the sixty characters a search result shows on the word
       "Home" and silently overrode whatever an admin had typed. *@
}

<partial name="_Hero" model="Model.Hero" />
<partial name="_FilterBar" />
<partial name="_FeatureStrip" model="Model" />
<partial name="_Ecosystem" model="Model.Ecosystem" />
<partial name="_Stats" model="Model.Stats" />
<partial name="_Upcoming" model="Model.Upcoming" />
<partial name="_Signature" model="Model.Signature" />
@if (Model.Upcoming.Count == 0 && Model.Signature.Count == 0)
{
    @* Both experience rows hide themselves when nothing is published; without this the page would
       jump straight from the numbers to the testimonials. The same designed section as the empty
       Experiences page, with its notify-me form. *@
    <section class="home-empty-stage">
        <div class="container">
            <partial name="_EmptyStage" model="@(new VIHouse.WebUI.ViewModels.Shared.EmptyStageViewModel("experiences"))" />
        </div>
    </section>
}
<partial name="_Trust" model="Model.Trust" />

@model HomeViewModel
@{
    // Small self-contained line-icon set keyed by label — avoids pulling in an icon library for
    // five glyphs. Falls back to a plain diamond mark for any label the CMS adds that isn't listed.
    string IconPath(string label) => label.Trim().ToLowerInvariant() switch
    {
        "learn" => "<path d=\"M12 6c-2-1.2-4.4-1.8-7-1.8v13.6c2.6 0 5 .6 7 1.8 2-1.2 4.4-1.8 7-1.8V4.2c-2.6 0-5 .6-7 1.8Z\"/><path d=\"M12 6v13.6\"/>",
        "connect" => "<circle cx=\"9\" cy=\"10\" r=\"4.5\"/><circle cx=\"15\" cy=\"15\" r=\"4.5\"/>",
        "grow" => "<path d=\"M4 16l5-5 4 4 7-8\"/><path d=\"M15 6h5v5\"/>",
        "experience" => "<rect x=\"4\" y=\"6\" width=\"16\" height=\"12\" rx=\"2\"/><path d=\"M14 6v12\" stroke-dasharray=\"2 2.4\"/>",
        "belong" => "<path d=\"M12 20s-7-4.4-9.5-9C.8 7.6 2.6 4 6 4c2 0 3.4 1 6 3 2.6-2 4-3 6-3 3.4 0 5.2 3.6 3.5 7-2.5 4.6-9.5 9-9.5 9Z\"/>",
        _ => "<rect x=\"7.5\" y=\"7.5\" width=\"9\" height=\"9\" rx=\"1\" transform=\"rotate(45 12 12)\"/>",
    };
}

@if (Model.Features.Count > 0)
{
    <section class="home-features">
        <div class="container">
            <h2 class="visually-hidden">@Model.FeatureStripHeading</h2>
            <div class="home-features__grid">
                @foreach (var f in Model.Features)
                {
                    <div class="home-features__item">
                        <span class="home-features__icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                @Html.Raw(IconPath(f.Label))
                            </svg>
                        </span>
                        <span class="home-features__label">@f.Label</span>
                        <span class="home-features__desc">@f.Description</span>
                    </div>
                }
            </div>
        </div>
    </section>
}

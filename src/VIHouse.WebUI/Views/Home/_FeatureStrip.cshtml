@model HomeViewModel
@{
    // Small self-contained line-icon set keyed by label — avoids pulling in an icon library for
    // five glyphs. Falls back to a plain diamond mark for any label the CMS adds that isn't listed.
    //
    // Every glyph is drawn to the same optical box — roughly x/y 5..19 of the 24 viewBox — and at one
    // stroke weight, so no icon reads heavier or larger than its neighbours in the strip. Keep new
    // glyphs inside those bounds; a path that runs to the viewBox edge will look oversized next to
    // the rest even though the SVG element itself is the same size.
    //
    // pathLength="1" normalises every shape to a length of 1 so the hover draw-in animation in
    // _home.scss runs at the same speed on all of them — without it a short line would finish long
    // before a long outline and the icons would appear to animate at different rates.
    string IconPath(string label) => label.Trim().ToLowerInvariant() switch
    {
        "learn" => "<path pathLength=\"1\" d=\"M12 7.4c-1.8-1.1-4-1.7-6.4-1.7v11.2c2.4 0 4.6.6 6.4 1.7 1.8-1.1 4-1.7 6.4-1.7V5.7c-2.4 0-4.6.6-6.4 1.7Z\"/><path pathLength=\"1\" d=\"M12 7.4v11.2\"/>",
        "connect" => "<circle pathLength=\"1\" cx=\"9.4\" cy=\"9.4\" r=\"2.5\"/><circle pathLength=\"1\" cx=\"15.6\" cy=\"10.9\" r=\"2.1\"/><path pathLength=\"1\" d=\"M5.6 18.6c0-2.5 1.8-4.2 3.8-4.2s3.8 1.7 3.8 4.2\"/><path pathLength=\"1\" d=\"M15.6 15c1.8 0 3.2 1.4 3.2 3.4\"/>",
        "grow" => "<path pathLength=\"1\" d=\"M5.6 16.6l4.3-4.3 3.2 3.2 5.3-5.9\"/><path pathLength=\"1\" d=\"M14.7 9.6h3.9v3.9\"/><path pathLength=\"1\" d=\"M5.6 5.8v13h13\"/>",
        "experience" => "<rect pathLength=\"1\" x=\"5.8\" y=\"10.6\" width=\"12.4\" height=\"8\" rx=\"1.2\"/><path pathLength=\"1\" d=\"M5.2 10.6h13.6\"/><path pathLength=\"1\" d=\"M12 10.6v8\"/><path pathLength=\"1\" d=\"M12 10.6C10.3 10.6 9.1 9.7 9.1 8.5S9.9 6.4 10.8 6.4 12 8.3 12 10.6Z\"/><path pathLength=\"1\" d=\"M12 10.6c1.7 0 2.9-.9 2.9-2.1s-.8-2.1-1.7-2.1S12 8.3 12 10.6Z\"/>",
        "belong" => "<path pathLength=\"1\" d=\"M12 18C12 18 5.5 13.8 5.5 10.1 5.5 8 7.1 6.4 9 6.4c1.5 0 2.6 1 3 1.8.4-.8 1.5-1.8 3-1.8 1.9 0 3.5 1.6 3.5 3.7 0 3.7-6.5 7.9-6.5 7.9Z\"/>",
        _ => "<rect pathLength=\"1\" x=\"7.4\" y=\"7.4\" width=\"9.2\" height=\"9.2\" rx=\"1.2\" transform=\"rotate(45 12 12)\"/>",
    };
}

@if (Model.Features.Count > 0)
{
    <section class="home-features" data-reveal>
        <div class="container">
            <h2 class="visually-hidden">@Model.FeatureStripHeading</h2>
            <div class="home-features__grid">
                @{ var featureIndex = 0; }
                @foreach (var f in Model.Features)
                {
                    @* Icon and label share a row; the description sits underneath, spanning both.
                       The dividers between items are the grid's own 1px gap showing through — see
                       _home.scss — which is why they become vertical when the items sit side by side
                       and horizontal the moment the grid collapses to a single column. *@
                    <div class="home-features__item" data-reveal data-reveal-delay="@(featureIndex++ * 90)">
                        <div class="home-features__head">
                            <span class="home-features__icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    @Html.Raw(IconPath(f.Label))
                                </svg>
                            </span>
                            <span class="home-features__label">@f.Label</span>
                        </div>
                        <p class="home-features__desc">@f.Description</p>
                    </div>
                }
            </div>
        </div>
    </section>
}

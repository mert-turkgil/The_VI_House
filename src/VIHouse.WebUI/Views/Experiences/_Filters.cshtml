@model ExperienceIndexViewModel
@*
    City select + status chips + trending topics, in one panel.

    Everything here is a plain <form> and plain <a href>, so the page filters correctly with
    JavaScript disabled. filters.ts upgrades it to fetch-and-swap on top; it is an enhancement, not
    the mechanism. A few things it depends on, so do not move them:

      - the form keeps data-experience-filters.
      - status and topic each carry a hidden input inside the form, always rendered (never
        conditional) — filters.ts reads the whole form via FormData to build a request, and a field
        that only sometimes exists in the DOM is a field JS sometimes cannot find.
      - the chips themselves — status AND trending — stay OUTSIDE [data-experience-results]. A chip
        inside the swapped region would lose its click handler on the next AJAX swap.
      - every chip carries data-filter-field/data-filter-value rather than relying on its href
        alone. filters.ts reads those to know which hidden input to update and to what, so clicking
        a chip never depends on — and can never go stale relative to — whatever the OTHER two
        controls happened to be set to at the last full page load.

    The city control is a <select> of cities that actually exist rather than the free-text box it
    replaces. A text box against an exact-match query could only ever produce an empty page for a
    typo, and "no experiences match" reads to a visitor exactly like "this site has nothing on".

    Trending has no Experience.Topic column behind it — see EfExperienceRepository. A chip here is
    a keyword search against each experience's own copy, in every language it has been translated
    into. That is also why it can legitimately return zero results: "Trading" only matches an
    experience if something currently listed actually says "trading" somewhere in its description.
*@

@{
    string ChipUrl(ExperienceStatus? status) =>
        Url.Action("Index", "Experiences", new
        {
            area = "",
            city = Model.SelectedCity,
            status = status?.ToString(),
            topic = Model.SelectedTopic,
        })!;

    // Topics toggle: clicking the one that is already active drops it, the way clicking an
    // already-ticked checkbox would. Status has no equivalent because it already has its own "off"
    // position — the "All" chip — so there is nothing to toggle there.
    string TopicUrl(string label) =>
        Url.Action("Index", "Experiences", new
        {
            area = "",
            city = Model.SelectedCity,
            status = Model.SelectedStatus?.ToString(),
            topic = string.Equals(Model.SelectedTopic, label, StringComparison.Ordinal) ? null : label,
        })!;
}

<div class="experience-filters-bar">
    <form class="experience-filters"
          method="get"
          asp-area=""
          asp-controller="Experiences"
          asp-action="Index"
          data-experience-filters
          aria-label="@Loc["Experiences.Filters.Label"]">

        <div class="experience-filters__field">
            <label class="experience-filters__label" for="filter-city">@Loc["Experiences.Filters.City"]</label>

            @* The chevron is a sibling rather than a background-image on the select: as a background
               it could not be given its own colour, so it was stuck inheriting the text colour and
               reading as heavily as the city name next to it. *@
            <div class="experience-filters__select-wrap">
                <select class="experience-filters__select" id="filter-city" name="city">
                    <option value="">@Loc["Experiences.Filters.AnyCity"]</option>
                    @foreach (var city in Model.Cities)
                    {
                        <option value="@city" selected="@(string.Equals(city, Model.SelectedCity, StringComparison.OrdinalIgnoreCase))">@city</option>
                    }
                </select>
                <svg class="experience-filters__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M6 9l6 6 6-6" />
                </svg>
            </div>
        </div>

        @* Always rendered — see the header comment. Carries status/topic through a plain city
           change, since this <form> only has one visible field of its own. *@
        <input type="hidden" name="status" value="@Model.SelectedStatus" data-experience-hidden="status" />
        <input type="hidden" name="topic" value="@Model.SelectedTopic" data-experience-hidden="topic" />

        @* Shown only without JS — filters.ts hides it, because with the enhancement the select applies
           on change and a submit button is then just a dead control sitting there. *@
        <noscript>
            <button type="submit" class="btn btn--ghost btn--sm">@Loc["Experiences.Filters.Apply"]</button>
        </noscript>
    </form>

    @* Scrolls sideways on a narrow screen instead of wrapping into three ragged rows. The rail is
       the same one .experience-subnav uses. *@
    <div class="experience-filters__chips-scroll">
        <div class="experience-filters__chips" role="group" aria-label="@Loc["Experiences.Filters.Status"]">
            <a class="experience-filters__chip @(Model.SelectedStatus is null ? "experience-filters__chip--active" : "")"
               href="@ChipUrl(null)"
               data-filter-field="status" data-filter-value=""
               aria-current="@(Model.SelectedStatus is null ? "true" : null)">
                @Loc["Experiences.Filters.AnyStatus"]
            </a>

            @foreach (var status in ExperienceIndexViewModel.FilterableStatuses)
            {
                var isActive = Model.SelectedStatus == status;
                <a class="experience-filters__chip @(isActive ? "experience-filters__chip--active" : "")"
                   href="@ChipUrl(status)"
                   data-filter-field="status" data-filter-value="@status"
                   aria-current="@(isActive ? "true" : null)">
                    @Loc[status.ToResourceKey()]
                </a>
            }
        </div>
    </div>

    @* Always rendered, hidden via the boolean attribute rather than omitted, so filters.ts has
       something in the DOM to reveal after an AJAX-applied filter — the element cannot be shown
       later if it was never sent down in the first place. data-experience-clear is the JS hook;
       the CSS class stays for styling only. *@
    <a class="experience-filters__clear" data-experience-clear
       hidden="@(!Model.HasFilters)"
       href="@Url.Action("Index", "Experiences", new { area = "" })">
        @Loc["Experiences.Filters.Clear"]
    </a>

    @* --- Trending -------------------------------------------------------------------------------
       A full-width row of its own: flex: 1 0 100% forces it onto a new line under the city/status
       row regardless of how much space either leaves — the usual technique for making one flex
       child span the whole container. Same seven keys the homepage's hero filter bar offers — see
       ExperienceIndexViewModel.TrendingTopicKeys for why they are shared rather than duplicated. *@
    <div class="experience-filters__trending">
        <span class="experience-filters__label">@Loc["Home.Filter.Trending"]</span>

        <div class="experience-filters__chips-scroll">
            <div class="experience-filters__chips" role="group" aria-label="@Loc["Home.Filter.Trending"]">
                @foreach (var key in ExperienceIndexViewModel.TrendingTopicKeys)
                {
                    var label = Loc[key].Value;
                    var isActive = string.Equals(Model.SelectedTopic, label, StringComparison.Ordinal);
                    <a class="experience-filters__chip @(isActive ? "experience-filters__chip--active" : "")"
                       href="@TopicUrl(label)"
                       data-filter-field="topic" data-filter-value="@label"
                       aria-current="@(isActive ? "true" : null)">
                        @label
                    </a>
                }
            </div>
        </div>
    </div>
</div>

@model ExperienceIndexViewModel
@{
    ViewData["Title"] = Loc["Experiences.Title"].Value;
}

<div class="content-hero experiences-header">
    <div class="container">
        <span class="content-hero__eyebrow">@Loc["Experiences.Eyebrow"]</span>
        <h1>@Loc["Experiences.Heading"]</h1>
        <p class="content-hero__lede">@Loc["Experiences.Subheading"]</p>
    </div>
</div>

<div class="container experiences-body">
    <partial name="_Filters" model="Model" />

    @* Everything inside is re-rendered server-side and swapped in by modules/filters.ts. Keeping the
       results in their own element is what lets the enhanced path reuse the exact same Razor. *@
    <div data-experience-results>
        <partial name="_ExperienceGrid" model="Model" />
    </div>
</div>

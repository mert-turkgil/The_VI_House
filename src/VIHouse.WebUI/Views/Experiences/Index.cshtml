@model List<ExperienceCardViewModel>
@{
    ViewData["Title"] = "Experiences";
}

<div class="experiences-header">
    <h1>Experiences</h1>
    <p>Curated rooms for founders, operators and investors — not a booking engine, a network.</p>
</div>

<div class="container">
    @if (Model.Count == 0)
    {
        <p style="text-align:center; padding: 48px 0;">No experiences are open right now — check back soon.</p>
    }
    else
    {
        <div class="experience-grid">
            @foreach (var e in Model)
            {
                <a class="experience-card" href="/experiences/@e.Slug">
                    <div class="experience-card__image" style="@(string.IsNullOrEmpty(e.CoverImageUrl) ? "" : $"background-image:url('{e.CoverImageUrl}')")">
                        <span class="experience-card__badge">@e.StatusLabel</span>
                    </div>
                    <div class="experience-card__body">
                        <h3 class="experience-card__title">The VI House — @e.City</h3>
                        <div class="experience-card__meta">
                            <span>@e.StartAtUtc.ToString("d MMM")–@e.EndAtUtc.ToString("d MMM yyyy")</span>
                            <span>@e.DurationLabel</span>
                            <span>@e.City, @e.Country</span>
                        </div>
                        @if (e.FromPriceMinor is not null)
                        {
                            <div class="experience-card__price">From @MoneyFormatter.Format(e.FromPriceMinor.Value, e.Currency!)</div>
                        }
                    </div>
                </a>
            }
        </div>
    }
</div>

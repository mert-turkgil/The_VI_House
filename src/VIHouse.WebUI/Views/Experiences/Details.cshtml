@model ExperienceDetailViewModel
@{
    ViewData["Title"] = Model.Title;

    var hasProgramme = Model.ProgramDays.Count > 0;
    var hasInclusions = Model.Included.Count > 0 || Model.NotIncluded.Count > 0;
    var hasFaqs = Model.Faqs.Count > 0;
    var hasGallery = Model.Gallery.Count > 0;
    var hasAudience = Model.AudienceTags.Count > 0;

    // Only sections that actually rendered get a sub-nav entry — a link to an anchor that is not on
    // the page is worse than no link.
    var navItems = new List<(string Id, string Key)> { ("about", "Experiences.Section.About") };
    if (hasAudience) navItems.Add(("audience", "Experiences.Section.Audience"));
    if (hasProgramme) navItems.Add(("programme", "Experiences.Section.Programme"));
    if (hasInclusions) navItems.Add(("included", "Experiences.Section.Included"));
    if (hasGallery) navItems.Add(("gallery", "Experiences.Section.Gallery"));
    if (hasFaqs) navItems.Add(("faq", "Experiences.Section.Faq"));

    // FAQPage structured data, serialised here rather than inline in the section below.
    //
    // Two reasons it cannot be an anonymous type: schema.org requires the literal keys "@context"
    // and "@type", and C#'s @context is merely an escaped identifier that serialises as "context" —
    // silently producing JSON that looks right and validates as nothing. A dictionary is the only
    // way to emit a property name that starts with @.
    string? faqJson = null;
    if (hasFaqs)
    {
        faqJson = System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "FAQPage",
            ["mainEntity"] = Model.Faqs.Select(f => new Dictionary<string, object>
            {
                ["@type"] = "Question",
                ["name"] = f.Question,
                ["acceptedAnswer"] = new Dictionary<string, object>
                {
                    ["@type"] = "Answer",
                    ["text"] = f.Answer,
                },
            }).ToList(),
        });
    }
}

@* The meta description used to be emitted here. It now comes from _Seo, which the layout renders
   for every page — leaving this one in place produced two description tags on the same page, and a
   crawler reading the second one would have got a different sentence from the first. *@

<section class="experience-hero">
    <div class="experience-hero__media" data-motion="hero-parallax">
        <partial name="_CoverImage" model="@(new CoverImageViewModel
                 {
                     Url = Model.CoverImageUrl,
                     Alt = Model.CoverImageAlt,
                     Ratio = "hero",
                     Sizes = "100vw",
                     Eager = true,
                     TransitionName = "experience-cover",
                 })" />
        <div class="experience-hero__scrim"></div>
    </div>

    <div class="container experience-hero__inner">
        <div class="experience-hero__eyebrow">
            <span
            class="experience-card__badge experience-card__badge--@Model.StatusModifier">@Loc[Model.StatusKey]</span>
            <span>@Model.City, @Model.Country</span>
        </div>

        <h1>@Model.Title</h1>

        <div class="experience-hero__meta">
            <span>@Model.StartAtUtc.ToString("d MMMM")&ndash;@Model.EndAtUtc.ToString("d MMMM yyyy")</span>
            <span>@Loc[Model.DurationKey, Model.DurationDays]</span>
            @if (!string.IsNullOrWhiteSpace(Model.Venue))
            {
                <span>@Model.Venue</span>
            }
        </div>

        @* data-hero-actions: modules/mobileCta.ts shows the sticky phone bar once this has scrolled
           out of view, so the two buttons are never on screen at the same time. *@
        <div class="experience-hero__actions" data-hero-actions>
            @if (Model.CanApply)
            {
                <a class="btn btn--primary" href="/apply?experience=@Model.Slug">@Loc["Experiences.Apply"]</a>
            }
            else
            {
                <partial name="_ExperienceGate" model="@Model.Gate(ExperienceGateVariant.Hero)" />
            }
        </div>
    </div>
</section>

@if (TempData["StatusMessage"] is string joinStatus)
{
    @* The join POST redirects back here with its result. Without this the outcome — confirmed,
       already booked, or no longer entitled — was set and silently dropped, so a refused join looked
       identical to nothing happening. *@
    <div class="container">
        <p class="alert alert-info" role="status">@joinStatus</p>
    </div>
}

@* Key facts, the four things a visitor scans for, as tiles that overlap the bottom of the hero on
   a wide screen and sit in a 2x2 grid on a phone. The icon redraws itself on hover. *@
<div class="container experience-facts-wrap">
    <ul class="experience-facts">
        <li class="experience-fact" data-reveal>
            <span class="experience-fact__icon"><partial name="_Icon" model="@("calendar")" /></span>
            <span class="experience-fact__label">@Loc["Experiences.Facts.When"]</span>
            <strong class="experience-fact__value">@Model.StartAtUtc.ToString("d MMM")&ndash;@Model.EndAtUtc.ToString("d MMM yyyy")</strong>
        </li>
        <li class="experience-fact" data-reveal data-reveal-delay="80">
            <span class="experience-fact__icon"><partial name="_Icon" model="@("clock")" /></span>
            <span class="experience-fact__label">@Loc["Experiences.Facts.Length"]</span>
            <strong class="experience-fact__value">@Loc[Model.DurationKey, Model.DurationDays]</strong>
        </li>
        <li class="experience-fact" data-reveal data-reveal-delay="160">
            <span class="experience-fact__icon"><partial name="_Icon" model="@("map-pin")" /></span>
            <span class="experience-fact__label">@Loc["Experiences.Facts.Where"]</span>
            <strong class="experience-fact__value">@Model.City</strong>
            @if (!string.IsNullOrWhiteSpace(Model.Venue))
            {
                <span class="experience-fact__note">@Model.Venue</span>
            }
        </li>
        <li class="experience-fact" data-reveal data-reveal-delay="240">
            <span class="experience-fact__icon"><partial name="_Icon" model="@("ticket")" /></span>
            @if (Model.CheapestTicket is { } fromTicket)
            {
                <span class="experience-fact__label">@Loc["Experiences.From"]</span>
                <strong class="experience-fact__value">@MoneyFormatter.Format(fromTicket.PriceMinor, fromTicket.Currency)</strong>
            }
            else
            {
                <span class="experience-fact__label">@Loc["Experiences.Facts.Status"]</span>
                <strong class="experience-fact__value">@Loc[Model.StatusKey]</strong>
            }
        </li>
    </ul>
</div>

@* The sub-nav sits outside .container so it is full width on its own, with the links aligned to
   the grid by an inner container. It used to bleed out of the container with calc(50% - 50vw),
   which on Windows (100vw includes the scrollbar) made every experience page scroll sideways.
   The wrapper is what the sticky bar sticks within, so it lets go before the footer. *@
<div class="experience-main">
    <nav class="experience-subnav" aria-label="@Model.Title" data-subnav>
        <div class="container">
            <ul class="experience-subnav__list">
                @foreach (var item in navItems)
                {
                    <li>
                        <a class="experience-subnav__link" href="#@item.Id" data-subnav-link="@item.Id">
                            @Loc[item.Key]
                        </a>
                    </li>
                }
            </ul>
        </div>
    </nav>

<div class="container">
    <div class="experience-body">
        <div>
            @* The broadcast, for confirmed attendees only — the controller sets StreamUrl for nobody
               else, so the link never reaches anyone else's page source. *@
            @if (Model.StreamUrl is { } streamUrl)
            {
                <section class="experience-section experience-stream" id="watch">
                    <h2><span class="session-row__live">@Loc["Sessions.LiveNow"]</span> @Loc["Experiences.Stream.Heading"]</h2>
                    <partial name="_LiveStream" model="@((streamUrl, Loc["Sessions.WatchLive"].Value))" />
                    <p class="experience-ticket-panel__note">@Loc["Experiences.Stream.Private"]</p>
                </section>
            }
            else if (Model.StreamOpensAtUtc is { } streamOpens)
            {
                <section class="experience-section experience-stream" id="watch">
                    <h2>@Loc["Experiences.Stream.Heading"]</h2>
                    <p class="account-note">@Loc["Experiences.Stream.OpensAt", streamOpens.ToString("dddd d MMMM yyyy, HH:mm")]</p>
                </section>
            }

            <section class="experience-section" id="about" data-subnav-section="about">
                <h2>@Loc["Experiences.Section.About"]</h2>
                @if (!string.IsNullOrWhiteSpace(Model.ShortSummary))
                {
                    <p><strong>@Model.ShortSummary</strong></p>
                }
                <div class="content-body rich-content">@Html.Raw(Model.Description)</div>
            </section>

            @if (hasAudience)
            {
                <section class="experience-section" id="audience" data-subnav-section="audience">
                    <h2>@Loc["Experiences.Section.Audience"]</h2>
                    @* Per-experience now (Experience.AudienceTags) rather than the same five words
                       hardcoded onto every page, which quietly claimed every room draws the same
                       people on a site whose whole proposition is curation. *@
                    <ul class="experience-audience">
                        @foreach (var tag in Model.AudienceTags)
                        {
                            <li class="experience-audience__tag">@tag</li>
                        }
                    </ul>
                </section>
            }

            @if (hasProgramme)
            {
                <section class="experience-section" id="programme" data-subnav-section="programme">
                    <h2>@Loc["Experiences.Section.Programme"]</h2>

                    @foreach (var day in Model.ProgramDays)
                    {
                        <div class="experience-program__day" data-reveal>
                            <div class="experience-program__day-head">
                                <span class="experience-program__day-num">@Loc["Experiences.Programme.Day",
                                                                day.DayNumber]</span>
                                    <h3 class="experience-program__day-title">@day.Title</h3>
                                </div>

                                <ul class="experience-program__sessions">
                                    @foreach (var session in day.Sessions.OrderBy(s => s.SortOrder))
                                    {
                                        <li class="experience-program__session">
                                            @* Rendered exactly as stored, in the experience's own zone —
                                           see the note below the list. EndTime, SpeakerName and
                                           Description are all on the entity and were previously
                                           loaded and then thrown away. *@
                                            <span class="experience-program__time">
                                                @session.StartTime.ToString(@"hh\:mm")&ndash;@session.EndTime.ToString(@"hh\:mm")
                                            </span>
                                            <p class="experience-program__session-title">
                                                @session.Title
                                                @if (!string.IsNullOrWhiteSpace(session.SpeakerName))
                                                {
                                                    <span class="experience-program__speaker"> &middot; @session.SpeakerName</span>
                                                }
                                            </p>
                                            @if (!string.IsNullOrWhiteSpace(session.Description))
                                            {
                                                <p class="experience-program__session-desc">@session.Description</p>
                                            }
                                        </li>
                                    }
                                </ul>
                            </div>
                        }

                        @* Sessions are bare TimeSpans understood to be in Experience.TimeZoneId. Saying
                       so is the honest option: converting them to the visitor's browser timezone
                       would show a Berlin reader "18:00" for a 19:00 Istanbul dinner. *@
                        <p class="experience-program__tz-note">@Loc["Experiences.Programme.LocalTimes", Model.City]</p>
                    </section>
                }

                @if (hasInclusions)
                {
                    <section class="experience-section" id="included" data-subnav-section="included">
                        <h2>@Loc["Experiences.Section.Included"]</h2>

                        <div class="experience-inclusions">
                            @if (Model.Included.Count > 0)
                            {
                                <div class="experience-inclusions__col experience-inclusions__col--included" data-reveal>
                                    <h3 class="experience-inclusions__heading">@Loc["Experiences.Included"]</h3>
                                    <ul class="experience-inclusions__list">
                                        @foreach (var item in Model.Included)
                                        {
                                            <li class="experience-inclusions__item">
                                                @* Was a literal ✓, which a screen reader announces as
                                               "check mark" on every single row. The heading above
                                               already carries the meaning, so the icon is decorative. *@
                                                <span class="experience-inclusions__mark">
                                                    <partial name="_Icon" model="@("check")" />
                                                </span>
                                                <span>@item.Text</span>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }

                            @if (Model.NotIncluded.Count > 0)
                            {
                                <div class="experience-inclusions__col experience-inclusions__col--excluded" data-reveal data-reveal-delay="120">
                                    <h3 class="experience-inclusions__heading">@Loc["Experiences.NotIncluded"]</h3>
                                    <ul class="experience-inclusions__list">
                                        @foreach (var item in Model.NotIncluded)
                                        {
                                            <li class="experience-inclusions__item">
                                                <span class="experience-inclusions__mark">
                                                    <partial name="_Icon" model="@("x")" />
                                                </span>
                                                <span>@item.Text</span>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                        </div>
                    </section>
                }

                @if (hasGallery)
                {
                    var shown = Model.Gallery.Count;
                    // A bento on wide screens shows five tiles; the fifth carries "+N" when there are
                    // more. Every photograph is still a link in the lightbox's list, so the arrows
                    // there reach all of them.
                    var bentoTiles = 5;

                    <section class="experience-section" id="gallery" data-subnav-section="gallery" data-lightbox-scope>
                        <div class="experience-section__head">
                            <h2>@Loc["Experiences.Section.Gallery"]</h2>
                            <span class="experience-gallery__count">@Loc[shown == 1 ? "Journal.Gallery.CountOne" : "Journal.Gallery.Count", shown]</span>
                        </div>

                        @* A native scroll-snap row on a phone (swipe, no library) and a bento grid from
                           the medium breakpoint. Each tile opens the shared lightbox (_Lightbox). *@
                        <div class="experience-gallery" data-count="@Math.Min(shown, bentoTiles)">
                            @for (var g = 0; g < shown; g++)
                            {
                                var image = Model.Gallery[g];
                                var url = ExperienceService.GalleryImageUrl(image);
                                var extra = shown - bentoTiles;
                                <a class="experience-gallery__item @(g >= bentoTiles ? "experience-gallery__item--overflow" : null)"
                                   href="@url" target="_blank" rel="noopener"
                                   data-lightbox-item data-lightbox-caption="@image.AltText"
                                   aria-label="@Loc["Journal.Gallery.Open", g + 1, shown]">
                                    @* Real alt here, unlike the covers: these sit away from any heading
                                       that describes them. A null AltText becomes alt="" (decorative),
                                       never the experience title. *@
                                    <img class="experience-gallery__img" src="@url" alt="@(image.AltText ?? string.Empty)"
                                         loading="lazy" decoding="async" width="1200" height="900" />
                                    @if (!string.IsNullOrWhiteSpace(image.AltText))
                                    {
                                        <span class="experience-gallery__caption" aria-hidden="true">@image.AltText</span>
                                    }
                                    @if (g == bentoTiles - 1 && extra > 0)
                                    {
                                        <span class="experience-gallery__more" aria-hidden="true">+@extra</span>
                                    }
                                </a>
                            }
                        </div>

                        <partial name="_Lightbox" model="@((Loc["Experiences.Section.Gallery"].Value, shown > 1))" />
                    </section>
                }

                @if (hasFaqs)
                {
                    <section class="experience-section" id="faq" data-subnav-section="faq">
                        <h2>@Loc["Experiences.Section.Faq"]</h2>

                        @* <details> rather than a JS accordion: it opens with no script, is keyboard
                       operable for free, and is findable by the browser's own in-page search. *@
                        @foreach (var faq in Model.Faqs)
                        {
                            <details class="experience-faq__item">
                                <summary class="experience-faq__q">
                                    @faq.Question
                                    <span class="experience-faq__chevron">
                                        <partial name="_Icon" model="@("chevron-down")" />
                                    </span>
                                </summary>
                                <p class="experience-faq__a">@faq.Answer</p>
                            </details>
                        }
                    </section>
                }
            </div>

            @* id so the sticky mobile bar can send someone to the waitlist form, which is too tall to
           render inside the bar itself. *@
            <aside class="experience-ticket-panel" id="tickets" data-ticket-panel>
                <h2 class="experience-ticket-panel__title">@Loc["Experiences.Tickets.Title"]</h2>
                @if (Model.MemberDiscountPercent > 0 && Model.TicketTypes.Count > 0)
                {
                    <p class="experience-ticket-panel__member-note">@Loc["Experiences.Tickets.MemberDiscount", Model.MemberDiscountPercent]</p>
                }

                @if (Model.TicketTypes.Count == 0)
                {
                    <p class="experience-ticket-panel__note">@Loc["Experiences.Tickets.None"]</p>
                }
                else
                {
                    foreach (var ticket in Model.TicketTypes)
                    {
                        @* A ticket stub: notched edges and a perforation between what it is and what it
                           costs. *@
                        <div class="experience-ticket">
                            <div class="experience-ticket__main">
                            <p class="experience-ticket__title">@ticket.Title</p>

                            @if (!string.IsNullOrWhiteSpace(ticket.PerksText))
                            {
                                <p class="experience-ticket__perks">@ticket.PerksText</p>
                            }

                            @* Genuine scarcity, from TicketType.Inventory, and only near the end. Never
                           shown at zero — the status badge already says waitlist or closed there,
                           and "0 places left" as a nudge would be invented urgency (brief §15). *@
                            @if (ticket.Inventory > 0 && ticket.Inventory <= 5)
                            {
                                <span class="experience-ticket__inventory"><i aria-hidden="true"></i>@Loc["Experiences.Tickets.PlacesLeft",
                                                        ticket.Inventory]</span>
                            }
                            </div>
                            <span class="experience-ticket__price">@MoneyFormatter.Format(ticket.PriceMinor, ticket.Currency)</span>
                            </div>
                        }
                    }

                    @* One panel, four outcomes, decided entirely by the server — see
               ExperienceService.GetAccessAsync. Nothing about the entitlement is posted from here. *@
                    @switch (Model.Access?.Outcome)
                    {
                        case ExperienceAccessOutcome.AlreadyBooked:
                            <p class="experience-ticket-panel__note">
                                <strong>@Loc["Experiences.Join.Booked", Model.Access.BookingReference ?? ""]</strong>
                            </p>
                            @if (Model.StreamUrl is not null)
                            {
                                <a class="btn btn--primary experience-ticket-panel__cta" href="#watch">@Loc["Sessions.WatchLive"]</a>
                            }
                            else if (Model.IsStreamed && !Model.Access.BookingConfirmed)
                            {
                                <p class="experience-ticket-panel__note">@Loc["Experiences.Stream.AfterConfirm"]</p>
                            }
                            <a class="btn btn--ghost experience-ticket-panel__cta" asp-controller="Account"
                               asp-action="Bookings">@Loc["Account.NavBookings"]</a>
                            break;

                        case ExperienceAccessOutcome.IncludedInMembership:
                            <p class="experience-ticket-panel__note">
                                <strong>@Loc["Experiences.Join.Heading"]</strong><br />
                                @Loc["Experiences.Join.Body"]
                            </p>
                            <form asp-action="Join" asp-route-slug="@Model.Slug" method="post">
                                @if (Model.AttendanceMode == ExperienceAttendanceMode.Both)
                                {
                                    <fieldset class="experience-join__attendance">
                                        <legend>@Loc["Experiences.Join.Attendance"]</legend>
                                        <label>
                                            <input type="radio" name="attendance" value="@BookingAttendance.InPerson" checked />
                                            @Loc["Experiences.Join.InPerson"]
                                        </label>
                                        <label>
                                            <input type="radio" name="attendance" value="@BookingAttendance.Online" />
                                            @Loc["Experiences.Join.Online"]
                                        </label>
                                    </fieldset>
                                }
                                <button type="submit" class="btn btn--primary experience-ticket-panel__cta">
                                    @Loc["Experiences.Join.Button"]
                                </button>
                            </form>
                            break;

                        case ExperienceAccessOutcome.NeedsSignIn:
                            <a class="btn btn--primary experience-ticket-panel__cta" asp-area="Identity" asp-page="/Account/Login"
                               asp-route-returnUrl="@Url.Action("Details", "Experiences", new { area = "", slug = Model.Slug })">
                                @Loc["Experiences.Join.SignIn"]
                            </a>
                            break;

                        case ExperienceAccessOutcome.NotOpen when Model.Access?.OpensAtUtc is { } opensAt:
                            @* Admitted on their plan, but members are let in from a date (Founders earlier). *@
                            <p class="experience-ticket-panel__note">
                                <strong>@Loc["Experiences.Join.OpensAt", opensAt.ToString("d MMMM yyyy, HH:mm")]</strong>
                                @if (Model.Access.FounderOpensAtUtc is { } founderOpens)
                                {
                                    <br />@Loc["Experiences.Join.FoundersFrom", founderOpens.ToString("d MMMM yyyy, HH:mm")]
                                }
                            </p>
                            break;

                        default:
                            @* The route every experience took before memberships could join one. *@
                            if (Model.CanApply)
                            {
                                <a class="btn btn--primary experience-ticket-panel__cta" href="/apply?experience=@Model.Slug">
                                    @Loc["Experiences.Apply"]
                                </a>
                            }
                            else
                            {
                                @* Not open. Until now this branch rendered nothing at all, so the sidebar
                           listed prices under a heading and then simply stopped. *@
                                <partial name="_ExperienceGate" model="@Model.Gate(ExperienceGateVariant.Panel)" />
                            }
                            break;
                    }

                    @if (Model.IsStreamed && Model.Access?.Outcome != ExperienceAccessOutcome.AlreadyBooked)
                    {
                        <p class="experience-ticket-panel__note">@Loc["Experiences.Stream.ForAttendees"]</p>
                    }
                    <p class="experience-ticket-panel__note">@Loc["Experiences.Tickets.Note"]</p>
                </aside>
            </div>

            <p class="seminar-detail__back">
                <a asp-area="" asp-controller="Experiences" asp-action="Index">&larr; @Loc["Experiences.BackToAll"]</a>
            </p>
        </div>
</div>

        @*
    The sticky bar. This used to be wrapped in @if (Model.CanApply), so a Coming Soon experience had
    no bottom bar at all — on a phone you scrolled the entire page and arrived at nothing. It now
    renders in both cases and carries the gate when there is nothing to buy.
*@
        <div class="experience-mobile-cta" data-mobile-cta>
            @if (Model.CanApply)
            {
                <span class="experience-mobile-cta__price">
                    @if (Model.CheapestTicket is { } cheapest)
                    {
                        <text>@Loc["Experiences.From"]</text>
                        <strong>@MoneyFormatter.Format(cheapest.PriceMinor, cheapest.Currency)</strong>
                    }
                    else
                    {
                        <strong>@Model.City</strong>
                    }
                </span>
                <a class="btn btn--primary btn--sm" href="/apply?experience=@Model.Slug">@Loc["Experiences.Apply"]</a>
            }
            else
            {
                <partial name="_ExperienceGate" model="@Model.Gate(ExperienceGateVariant.Mobile)" />
            }
        </div>

        @section Scripts {
            @if (faqJson is not null)
            {
                @* Already serialised above — JsonSerializer escapes the values, so Html.Raw here is
           emitting known-safe JSON rather than trusting model content. *@
                <script type="application/ld+json">@Html.Raw(faqJson)</script>
            }
        }

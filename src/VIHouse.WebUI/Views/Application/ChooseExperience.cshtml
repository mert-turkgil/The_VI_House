@model List<ExperienceCardViewModel>
@{
    ViewData["Title"] = "Request Access";
}

<div class="apply-header">
    <div class="container">
        <span class="apply-header__eyebrow">Request Access</span>
        <h1>Choose an Experience</h1>
        <p>Pick the room you'd like to apply for — every application is reviewed by hand.</p>
    </div>
</div>

<div class="container">
    @if (Model.Count == 0)
    {
        <p style="text-align:center; padding: 48px 0;">Applications aren't open right now — check back soon.</p>
    }
    else
    {
        <div class="experience-grid">
            @foreach (var e in Model)
            {
                <a class="experience-card" href="/apply?experience=@e.Slug">
                    <div class="experience-card__image" style="@(string.IsNullOrEmpty(e.CoverImageUrl) ? "" : $"background-image:url('{e.CoverImageUrl}')")">
                        <span class="experience-card__badge">@e.StatusLabel</span>
                    </div>
                    <div class="experience-card__body">
                        <h3 class="experience-card__title">The VI House — @e.City</h3>
                        <div class="experience-card__meta">
                            <span>@e.StartAtUtc.ToString("d MMM")–@e.EndAtUtc.ToString("d MMM yyyy")</span>
                            <span>@e.City, @e.Country</span>
                        </div>
                    </div>
                </a>
            }
        </div>
    }
</div>

@model ApplicationStatusListViewModel
@{
    ViewData["Title"] = Loc["Status.Title"];
}

<div class="content-hero">
    <div class="container">
        <h1>@Loc["Status.Title"]</h1>
        @if (Model.Items.Count > 0)
        {
            <p>@Loc["Status.Intro", Model.Items[0].FirstName]</p>
        }
    </div>
</div>

<div class="container content-body">
    @if (Model.Items.Count == 0)
    {
        @* Deliberately says nothing about whether any application exists — only where to look. *@
        <div class="status-card">
            <h2>@Loc["Status.None"]</h2>
            <p>@Loc["Status.NoneHint"]</p>
            @if (!Model.SignedIn)
            {
                <p style="margin-top:16px;"><a class="btn btn--primary" asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Url.Action("Status", "Application")">@Loc["Nav.LogIn"]</a></p>
            }
        </div>
    }
    else
    {
        foreach (var item in Model.Items)
        {
            <partial name="_ApplicationStatusCard" model="item" />
        }
        @if (!Model.SignedIn)
        {
            <p style="font-size:0.8125rem; color:#999;">@Loc["Status.BrowserOnly"]</p>
        }
    }
</div>

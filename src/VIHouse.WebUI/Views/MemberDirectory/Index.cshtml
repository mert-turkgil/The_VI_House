@model List<MemberCardViewModel>
@{
    ViewData["Title"] = Loc["Directory.Title"];
    var hasFilter = ViewData["Search"] is not null || ViewData["Profession"] is not null || ViewData["City"] is not null || ViewData["Country"] is not null;
}

<div class="content-hero">
    <div class="container">
        <span class="content-hero__eyebrow">@Loc["Directory.Eyebrow"]</span>
        <h1>@Loc["Directory.Heading"]</h1>
        <p>@Loc["Directory.Subheading"]</p>
    </div>
</div>

<div class="container member-directory">
    <form method="get" class="member-directory__filters">
        <div class="apply-field">
            <label for="search">@Loc["Directory.SearchLabel"]</label>
            <input id="search" name="search" value="@ViewData["Search"]" placeholder="@Loc["Directory.SearchPlaceholder"]" />
        </div>
        <div class="apply-field">
            <label for="profession">@Loc["Directory.ProfessionLabel"]</label>
            <input id="profession" name="profession" value="@ViewData["Profession"]" />
        </div>
        <div class="apply-field">
            <label for="city">@Loc["Directory.CityLabel"]</label>
            <input id="city" name="city" value="@ViewData["City"]" />
        </div>
        <div class="apply-field">
            <label for="country">@Loc["Directory.CountryLabel"]</label>
            <select id="country" name="country" asp-items='@Countries.SelectList(ViewData["Country"] as string, Loc["Form.AnyCountry"].Value)'></select>
        </div>
        <button type="submit" class="btn btn--primary">@Loc["Directory.FilterSubmit"]</button>
        @if (hasFilter)
        {
            <a class="member-directory__clear" asp-action="Index">@Loc["Directory.ClearFilters"]</a>
        }
    </form>

    @if (Model.Count == 0)
    {
        <p class="member-directory__empty">@Loc["Directory.NoResults"]</p>
    }
    else
    {
        <div class="member-directory__grid">
            @foreach (var m in Model)
            {
                <a class="member-card" asp-action="Details" asp-route-id="@m.UserId">
                    <div class="member-card__avatar">
                        @if (!string.IsNullOrWhiteSpace(m.PhotoUrl))
                        {
                            <img src="@m.PhotoUrl" alt="" />
                        }
                        else
                        {
                            <span>@m.FullName.Substring(0, 1)</span>
                        }
                    </div>
                    <div class="member-card__body">
                        <h3>@m.FullName</h3>
                        @if (!string.IsNullOrWhiteSpace(m.JobTitle))
                        {
                            <p class="member-card__role">@m.JobTitle</p>
                        }
                        <p class="member-card__meta">
                            @if (!string.IsNullOrWhiteSpace(m.City)) { @($"{m.City}, ") }@Countries.NameFor(m.Country)
                        </p>
                        @if (m.AboutSnippet is not null)
                        {
                            <p class="member-card__bio">@m.AboutSnippet</p>
                        }
                    </div>
                </a>
            }
        </div>
    }
</div>

@{
    ViewData["Title"] = Loc["About.Title"];
}

<div class="content-hero">
    <div class="container">
        <span class="content-hero__eyebrow">@Loc["About.Eyebrow"]</span>
        <h1>@Loc["About.Heading"]</h1>
        <p>@Loc["About.Subheading"]</p>
    </div>
</div>

<div class="container content-body">
    <p>@Loc["About.Paragraph1"]</p>
    <p>@Loc["About.Paragraph2"]</p>
    <p>@Loc["About.Paragraph3"]</p>

    <h2>@Loc["About.ValuesHeading"]</h2>
    <div class="content-values">
        <div class="content-value">
            <h3>@Loc["About.Value1Title"]</h3>
            <p>@Loc["About.Value1Body"]</p>
        </div>
        <div class="content-value">
            <h3>@Loc["About.Value2Title"]</h3>
            <p>@Loc["About.Value2Body"]</p>
        </div>
        <div class="content-value">
            <h3>@Loc["About.Value3Title"]</h3>
            <p>@Loc["About.Value3Body"]</p>
        </div>
    </div>

    <p style="margin-top:32px;">
        <a class="btn btn--primary" href="/apply">@Loc["Nav.ApplyToJoin"]</a>
    </p>
</div>

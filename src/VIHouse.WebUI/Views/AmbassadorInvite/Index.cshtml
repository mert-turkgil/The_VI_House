@model AmbassadorInviteViewModel

<div class="join">
    <div class="container join__inner">
        <header class="join__head">
            <span class="join__eyebrow">@Loc["AmbassadorInvite.Eyebrow"]</span>
            <h1>@Loc["AmbassadorInvite.Heading", Model.AmbassadorName]</h1>
            <p class="join__lede">@Loc["AmbassadorInvite.Lede"]</p>
            <ul class="ambassador-invite__facts">
                <li>@Loc["AmbassadorInvite.Fact.Code"] <strong>@Model.Code</strong></li>
                <li>@Loc["AmbassadorInvite.Fact.Rate"] <strong>@Model.CommissionPercent.ToString("0.##")%</strong></li>
                <li>@Loc["AmbassadorInvite.Fact.Email"] <strong>@Model.Email</strong></li>
                <li>@Loc["AmbassadorInvite.Fact.Expires"] <strong>@Model.ExpiresAt.ToLocalTime().ToString("d MMMM yyyy")</strong></li>
            </ul>
        </header>

        <div asp-validation-summary="ModelOnly" class="join__error" role="alert"></div>

        <div class="join__layout join__layout--single">
            @* No action: it posts back to this same address (token and language prefix included). *@
            <form method="post" class="join__form" novalidate asp-antiforgery="true">

                @* --- What the House entered: shown back, changed only by the House --------------- *@
                <section class="join__step join__details" aria-labelledby="onfile-heading">
                    <h2 class="join__legend" id="onfile-heading" style="display:block;">@Loc["AmbassadorInvite.Section.OnFile"]</h2>
                    <dl class="ambassador-invite__onfile">
                        @if (Model.LegalName is not null)
                        {
                            <div><dt>@Loc["AmbassadorInvite.OnFile.LegalName"]</dt><dd>@Model.LegalName</dd></div>
                        }
                        @if (Model.BillingPlace is not null)
                        {
                            <div><dt>@Loc["AmbassadorInvite.OnFile.Billing"]</dt><dd>@Model.BillingPlace</dd></div>
                        }
                        @if (Model.MaskedIban is not null)
                        {
                            <div><dt>@Loc["AmbassadorInvite.OnFile.Bank"]</dt><dd class="ambassador-invite__mono">@Model.MaskedIban</dd></div>
                        }
                        @if (Model.Channels.Count > 0)
                        {
                            <div>
                                <dt>@Loc["AmbassadorInvite.OnFile.Channels"]</dt>
                                <dd>
                                    <ul class="ambassador-invite__channels">
                                        @foreach (var channel in Model.Channels)
                                        {
                                            <li>
                                                <span>@Loc.Label(channel.Platform)</span>
                                                <a href="@channel.Url" rel="noopener noreferrer nofollow" target="_blank">@SocialLinks.Handle(channel.Url)</a>
                                                @if (channel.Audience is { } audience)
                                                {
                                                    <span class="ambassador-invite__audience">@Loc["Influencer.Audience", audience.ToString("N0")]</span>
                                                }
                                            </li>
                                        }
                                    </ul>
                                </dd>
                            </div>
                        }
                    </dl>
                    <p class="join__hint">@Loc["AmbassadorInvite.OnFile.Hint"]</p>
                </section>

                @* --- 1. Password ------------------------------------------------------------- *@
                <fieldset class="join__step join__details">
                    <legend class="join__legend">
                        <span class="join__legend-num" aria-hidden="true">1</span>
                        <span class="join__legend-text">@Loc["AmbassadorInvite.Section.Password"]</span>
                    </legend>
                    @if (Model.NeedsPassword)
                    {
                        <div class="join__row">
                            <div class="join__field">
                                <label asp-for="Password">@Loc["AmbassadorInvite.Password"]</label>
                                <input asp-for="Password" autocomplete="new-password" aria-describedby="Password-rules" />
                                <span asp-validation-for="Password" class="join__field-error"></span>
                            </div>
                            <div class="join__field">
                                <label asp-for="ConfirmPassword">@Loc["AmbassadorInvite.ConfirmPassword"]</label>
                                <input asp-for="ConfirmPassword" autocomplete="new-password" />
                                <span asp-validation-for="ConfirmPassword" class="join__field-error"></span>
                            </div>
                        </div>
                        <partial name="_PasswordRules" model="@(("Password", (string?)"ConfirmPassword"))" />
                    }
                    else
                    {
                        <p class="join__hint">@Loc["AmbassadorInvite.SignedIn", Model.Email]</p>
                    }
                </fieldset>

                @* --- 2. Terms ----------------------------------------------------------------- *@
                <div class="join__step join__pay">
                    <h2 class="join__legend" style="display:block;">
                        <span class="join__legend-num" aria-hidden="true">2</span>
                        <span class="join__legend-text">@Loc["AmbassadorInvite.Section.Terms"]</span>
                    </h2>
                    <ol class="ambassador-invite__terms" tabindex="0" aria-label="@Loc["AmbassadorInvite.Section.Terms"]">
                        @foreach (var term in Model.Terms)
                        {
                            <li>@term</li>
                        }
                    </ol>
                    <div class="join__consent">
                        <label>
                            <input asp-for="AcceptTerms" />
                            <span>@Loc["AmbassadorInvite.Accept"]</span>
                        </label>
                        <span asp-validation-for="AcceptTerms" class="join__field-error"></span>
                    </div>

                    <button type="submit" class="btn btn--primary join__submit">
                        <span class="join__submit-label">@Loc["AmbassadorInvite.Submit"]</span>
                        <svg class="join__submit-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

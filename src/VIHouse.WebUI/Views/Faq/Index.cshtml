@{
    ViewData["Title"] = Loc["Faq.Title"];
    const int QuestionCount = 10;
    // Questions 9 and 10 are about the influencer programme and point to its page.
    const int FirstInfluencerQuestion = 9;
}

<div class="content-hero">
    <div class="container">
        <span class="content-hero__eyebrow">@Loc["Faq.Eyebrow"]</span>
        <h1>@Loc["Faq.Heading"]</h1>
        <p>@Loc["Faq.Subheading"]</p>
    </div>
</div>

<div class="container content-body">
    <div class="faq-list">
        @for (var i = 1; i <= QuestionCount; i++)
        {
            <details class="faq-item" id="q@(i)">
                <summary>@Loc[$"Faq.Q{i}"]</summary>
                <p>@Loc[$"Faq.A{i}"]</p>
                @if (i >= FirstInfluencerQuestion)
                {
                    <p><a asp-controller="Influencers" asp-action="Index">@Loc["Faq.InfluencersLink"] &rarr;</a></p>
                }
            </details>
        }
    </div>

    <h2 class="about-section__title" style="margin-top:var(--vih-space-2xl);">@Loc["Faq.StillHaveQuestions"]</h2>
    <partial name="_WriteToUs" />
    <p style="margin-top:16px; text-align:center;">
        <a asp-controller="Contact" asp-action="Index">@Loc["HouseGuide.Link.ContactForm"]</a>
    </p>
</div>

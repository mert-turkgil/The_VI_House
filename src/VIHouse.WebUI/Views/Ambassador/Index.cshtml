@using VIHouse.Entities.Referrals
@model AmbassadorDashboardViewModel
@{
    ViewData["Title"] = "Ambassador Dashboard";
    var stats = Model.Stats;
    var titleByTarget = stats.Targets.ToDictionary(t => (t.Kind, t.Id), t => t.Title);

    string KindLabel(ReferralConversionKind kind) => kind switch
    {
        ReferralConversionKind.Application => Loc["Ambassador.Conversions.Application"].Value,
        ReferralConversionKind.Approved => Loc["Ambassador.Conversions.Approved"].Value,
        ReferralConversionKind.TicketPurchase => Loc["Ambassador.Conversions.Ticket"].Value,
        ReferralConversionKind.SessionPurchase => Loc["Ambassador.Conversions.Session"].Value,
        _ => Loc["Ambassador.Conversions.Membership"].Value,
    };
}

<div class="content-hero">
    <div class="container">
        <span class="content-hero__eyebrow">@Loc["Ambassador.Panel.Eyebrow"]</span>
        <h1>@Loc["Ambassador.Dashboard.Welcome", Model.Name]</h1>
        <p>@Loc["Ambassador.Dashboard.Intro", Model.CommissionPercent.ToString("0.##")]</p>
    </div>
</div>

<div class="container content-body">
    @if (TempData["StatusMessage"] is string status)
    {
        <div class="contact-success" role="status">@status</div>
    }
    @* --- Links --------------------------------------------------------------------------------- *@
    <section class="ambassador-section" id="referral-links">
        <h2>@Loc["Ambassador.Links.Title"]</h2>
        <p class="ambassador-section__lede">@Loc["Ambassador.Links.Intro"]</p>
        <partial name="_ReferralLinks" model="Model.Links" />
    </section>

    @* --- Performance ---------------------------------------------------------------------------- *@
    <section class="ambassador-section">
        <h2>@Loc["Ambassador.Performance.Heading"]</h2>
        <p class="ambassador-section__lede">@Loc["Ambassador.Performance.Privacy"]</p>

        <div class="admin-kpi-grid">
            <div class="admin-kpi-card">
                <div class="admin-kpi-card__value">@stats.Visits</div>
                <div class="admin-kpi-card__label">@Loc["Ambassador.Links.Visits"]</div>
            </div>
            <div class="admin-kpi-card">
                <div class="admin-kpi-card__value">@stats.Applications</div>
                <div class="admin-kpi-card__label">@Loc["Ambassador.Links.Applications"]</div>
            </div>
            <div class="admin-kpi-card">
                <div class="admin-kpi-card__value">@stats.ApprovedApplications</div>
                <div class="admin-kpi-card__label">@Loc["Ambassador.Conversions.Approved"]</div>
            </div>
            <div class="admin-kpi-card">
                <div class="admin-kpi-card__value">@stats.Purchases</div>
                <div class="admin-kpi-card__label">@Loc["Ambassador.Links.Purchases"] <span class="admin-table__sub">(@stats.TicketPurchases &middot; @stats.MembershipPurchases &middot; @stats.SessionPurchases)</span></div>
            </div>
            @foreach (var (currency, amountMinor) in stats.RevenueByCurrency)
            {
                <div class="admin-kpi-card">
                    <div class="admin-kpi-card__value">@MoneyFormatter.Format(amountMinor, currency)</div>
                    <div class="admin-kpi-card__label">@Loc["Ambassador.Performance.Revenue"] (@currency)</div>
                </div>
            }
            @foreach (var b in stats.Balances)
            {
                <div class="admin-kpi-card admin-kpi-card--accent">
                    <div class="admin-kpi-card__value">@MoneyFormatter.Format(b.EarnedMinor, b.Currency)</div>
                    <div class="admin-kpi-card__label">@Loc["Ambassador.Performance.Commission"] (@b.Currency)</div>
                </div>
                <div class="admin-kpi-card">
                    <div class="admin-kpi-card__value">@MoneyFormatter.Format(b.PaidMinor, b.Currency)</div>
                    <div class="admin-kpi-card__label">@Loc["Ambassador.Performance.Paid"] (@b.Currency)</div>
                </div>
                <div class="admin-kpi-card">
                    <div class="admin-kpi-card__value">@MoneyFormatter.Format(Math.Max(0, b.OwedMinor), b.Currency)</div>
                    <div class="admin-kpi-card__label">@Loc["Ambassador.Performance.Owed"] (@b.Currency)</div>
                </div>
            }
        </div>

        @if (stats.Targets.Count > 0)
        {
            <h3 class="ambassador-section__sub">@Loc["Ambassador.Targets.Heading"]</h3>
            <div class="table-scroll">
                <table class="referral-targets">
                    <thead>
                        <tr>
                            <th>@Loc["Ambassador.Targets.Link"]</th>
                            <th class="is-num">@Loc["Ambassador.Links.Visits"]</th>
                            <th class="is-num">@Loc["Ambassador.Links.Applications"]</th>
                            <th class="is-num">@Loc["Ambassador.Links.Purchases"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in stats.Targets)
                        {
                            <tr>
                                <td>
                                    <span class="referral-targets__kind">@(t.Kind == ReferralTargetKind.Site ? Loc["Ambassador.Links.Site"].Value : t.Kind == ReferralTargetKind.Experience ? Loc["Ambassador.Links.Experience"].Value : Loc["Ambassador.Links.Session"].Value)</span>
                                    @t.Title
                                </td>
                                <td class="is-num">@t.Visits</td>
                                <td class="is-num">@t.Applications</td>
                                <td class="is-num">@t.Purchases</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="ambassador-section__empty">@Loc["Ambassador.Performance.Empty"]</p>
        }
    </section>

    @* --- Timeline ------------------------------------------------------------------------------- *@
    <section class="ambassador-section">
        <h2>@Loc["Ambassador.Conversions.Heading"]</h2>
        @if (Model.Conversions.Count == 0)
        {
            <p class="ambassador-section__empty">@Loc["Ambassador.Conversions.None"]</p>
        }
        else
        {
            <ol class="ambassador-timeline">
                @foreach (var c in Model.Conversions)
                {
                    titleByTarget.TryGetValue((c.TargetKind, c.TargetId), out var about);
                    <li class="ambassador-timeline__item ambassador-timeline__item--@c.Kind.ToString().ToLowerInvariant()">
                        <time datetime="@c.OccurredAt.ToString("o")">@c.OccurredAt.ToString("d MMM yyyy, HH:mm")</time>
                        <span class="ambassador-timeline__what">
                            @KindLabel(c.Kind)
                            @if (about is not null && c.TargetKind != ReferralTargetKind.Site)
                            {
                                <em class="ambassador-timeline__about">&middot; @about</em>
                            }
                        </span>
                        @if (c.AmountMinor is { } amount && c.Currency is not null)
                        {
                            <span class="ambassador-timeline__money">
                                @MoneyFormatter.Format(amount, c.Currency)
                                @if (c.CommissionMinor is not null)
                                {
                                    <em>&middot; @Loc["Ambassador.Conversions.Commission"] @MoneyFormatter.Format(c.NetCommissionMinor, c.Currency)</em>
                                }
                                @{
                                    var state = c.VoidedAt is not null ? Loc["Ambassador.Conversions.Withdrawn"].Value
                                        : c.ReversedAt is not null ? Loc["Ambassador.Conversions.Refunded"].Value
                                        : c.RefundedMinor > 0 ? Loc["Ambassador.Conversions.PartRefunded"].Value
                                        : c.PayoutId is not null ? Loc["Ambassador.Conversions.PaidOut"].Value
                                        : null;
                                }
                                @if (state is not null)
                                {
                                    <em>&middot; @state</em>
                                }
                            </span>
                        }
                    </li>
                }
            </ol>
        }
    </section>
</div>
